--user=root
-c
18
-m
42g
-v
oe-build-tmp:/build
-e
KAS_BUILD_DIR=/build
-v
oe-build-dl:/downloads
-e
DL_DIR=/downloads
-v
oe-build-sstate:/sstate
-e
SSTATE_DIR=/sstate
ghcr.io/siemens/kas/kas:5.5
