shell_usage() {
	cat <<EOF
${C_BLD}$SCRIPT_CMD shell${C_RST} -- drop into a kas shell for the project's kas config.

${C_BLD}USAGE${C_RST}
  $SCRIPT_CMD shell

Runs \`kas shell\` with the same volumes, runtime args and kas fragment a real
build would use, so \`bitbake -e bash | grep ^TUNE_FEATURES\` and similar
interactive poking see the real, mounted TMPDIR/DL_DIR/SSTATE_DIR -- not a
bind-mounted host directory. Exits back to macOS when the shell exits.

For a single read-only command instead of an interactive session, prefer
'$SCRIPT_CMD exec CMD' -- it bakes in the repo-preserving --skip flags;
'shell' deliberately runs kas's full setup (checkout, patch, config), which
is what an interactive session should get.

Options: --dry-run, -y/--yes (or -f/--force) and -v/--verbose work here too,
though shell has nothing to confirm and nothing --dry-run would print instead
of doing.

${C_BLD}ONE-VM RULE${C_RST}
  Only one VM may access an ext4 image at a time. shell refuses while a
  running build ($SCRIPT_CMD smoketest, another shell, or a raw
  kas-container) still holds any of the three volumes -- stop it first.
EOF
}

cmd_shell() {
	require_mackas_root
	ensure_workspace_attached   # see cmd_smoketest for why this is not left to run_kas
	ensure_kas_container_installed
	ensure_project_checked_out
	info "Dropping into a kas shell for $KAS_FILES_ARG ..."
	run_kas "" shell "$KAS_FILES_ARG"
}

# ---------------------------------------------------------------------------
# exec -- a one-off command against the checkout, safe by construction
# ---------------------------------------------------------------------------
#
# The reason this exists: bitbake_getvar() (via kas_shell_ro(), above) has
# always been safe for MACKAS'S OWN internal read-only queries, but nothing
# stopped a hand-typed 'kas-container shell <files> -c "..."' for a quick
# manual check from doing kas's normal repo-checkout/patch-apply dance --
# exactly what -k/--skip exists to prevent, and exactly what a real checkout
# has been reset by, more than once, from someone reaching for a raw
# kas-container invocation under time pressure mid-investigation. Docs said
# "use --skip" already; this makes the safe path the one you'd actually type.
exec_usage() {
	cat <<EOF
${C_BLD}$SCRIPT_CMD exec${C_RST} -- run a one-off, read-only command against the
checkout, with kas's repo-mutating setup steps always skipped.

${C_BLD}USAGE${C_RST}
  $SCRIPT_CMD exec CMD [ARGS...]
  $SCRIPT_CMD exec -- CMD [ARGS...]   (only needed if CMD itself starts with '-',
                                     or collides with one of exec's own flags)

Runs \`kas-container shell <files> $KAS_SKIP_REPO_STEPS -c "CMD ARGS..."\` --
the exact skip set \`bitbake_getvar()\` already uses internally for retrieve/
buildstats/clean. No flag adds '-k' back or drops a skip: that is the entire
point. See the '-k' explanation in docs/architecture.md for why dropping
those steps by hand, even briefly, can reset a layer to its pinned revision
and wipe local commits.

${C_BLD}WHAT THIS DOES NOT DO${C_RST}
This protects against KAS's OWN setup steps, not against your command:
\`$SCRIPT_CMD exec touch openembedded-core/foo\` still creates the file --
/repo and the volumes are mounted read-write, necessarily. There is no
sandbox here, only a guarantee that kas itself will not touch a repo.

${C_BLD}EXAMPLES${C_RST}
  $SCRIPT_CMD exec du -sh openembedded-core
  $SCRIPT_CMD exec bitbake -e virtual/kernel
  $SCRIPT_CMD exec git -C openembedded-core status

Options: --dry-run, -y/--yes (or -f/--force) and -v/--verbose work here too,
but only BEFORE the command starts -- anything after CMD is passed to CMD
verbatim, never parsed as a mackas flag (so e.g. \`exec du -v\` passes '-v'
to du, not to mackas).

${C_BLD}ONE-VM RULE${C_RST}
  Only one VM may access an ext4 image at a time. exec refuses while a
  running build (smoketest/shell) still holds any of the three volumes --
  stop it first.
EOF
}

# cmd_exec [flags] CMD [ARGS...] -- see exec_usage. Parses its OWN flags only
# until the first token that isn't one of them (or '--'); everything from
# there on is the user's command, verbatim, never re-interpreted as a mackas
# flag no matter what it looks like. This is deliberately NOT the same
# parsing shape as retrieve/clean (a closed set of object/target words) --
# CMD is arbitrary, so "stop recognizing our own flags" has to be structural,
# not a fixed word list.
cmd_exec() {
	local cmd_words=() want_help=0 started=0 a
	while [ $# -gt 0 ]; do
		if [ "$started" -eq 1 ]; then
			cmd_words+=("$1"); shift; continue
		fi
		a="$1"
		case "$a" in
			--dry-run)     DRY_RUN=1; shift ;;
			-y|-f|--yes|--force)  ASSUME_YES=1; shift ;;
			-v|--verbose)  VERBOSE=1; shift ;;
			-h|--help)     want_help=1; shift ;;
			help)          want_help=1; shift ;;
			--version)     echo "$SCRIPT_NAME $SCRIPT_VERSION"; exit 0 ;;
			--config|--config=*|--project|--project=*|--set|--set=*) die_on_misplaced_global_flag "$a" exec ;;
			--)            started=1; shift ;;
			-*) die "unknown option for 'exec': $a" "$SCRIPT_CMD exec --help" ;;
			*)  started=1; cmd_words+=("$a"); shift ;;
		esac
	done

	if [ "$want_help" -eq 1 ]; then
		exec_usage
		return 0
	fi

	[ "${#cmd_words[@]}" -ge 1 ] || die "'exec' needs a command to run" \
		"$SCRIPT_CMD exec du -sh openembedded-core"

	require_mackas_root
	ensure_workspace_attached
	ensure_kas_container_installed
	ensure_project_checked_out

	# One-VM rule: kas_shell_ro() attaches all three volumes via
	# kas_runtime_args(), and unlike bitbake_getvar()'s other callers
	# (retrieve/clean/sstate prune), nothing upstream of exec has already
	# checked this -- so exec must, or a second attach fails with an opaque
	# Virtualization.framework error instead of a clear refusal.
	require_volumes_free "$SCRIPT_CMD exec"

	local joined w
	joined=""
	for w in "${cmd_words[@]}"; do
		joined="$joined $(printf '%q' "$w")"
	done
	joined="${joined# }"

	if [ "$DRY_RUN" -eq 1 ]; then
		info "${C_BLD}mackas exec${C_RST} -- would run (repo-mutating steps skipped):"
		info "  $(quote_cmd kas-container shell $KAS_SKIP_REPO_STEPS "$KAS_FILES_ARG" -c "$joined")"
		return 0
	fi

	local rc=0
	kas_shell_ro "$joined" || rc=$?
	return "$rc"
}

# ---------------------------------------------------------------------------
# lock / dump -- reproducibility artifacts (item 13). Both are kas-container's
# own TOP-LEVEL subcommands (like build/shell), never run through
# kas_shell_ro() -- that helper wraps a shell COMMAND inside a configured
# bitbake environment ('shell -c "..."'), which is not what dump/lock are;
# they resolve/pin the kas config itself and need no bitbake environment at
# all. Both still go through the full runtime-args/gitconfig/one-VM
# machinery every other real kas-container invocation in this file uses --
# neither touches TMPDIR/DL_DIR/SSTATE_DIR, but attaching the volumes
# unconditionally, like retrieve/exec/clean do, keeps this file's one
# invariant ("every real invocation always gets real ext4 volumes") intact
# rather than carving out a volume-less exception for two commands.
# ---------------------------------------------------------------------------

# kas_project_subcommand_preflight -- shared by cmd_lock/cmd_dump: the
# project-checkout/gitconfig/one-VM checks every direct kas-container
# subcommand invocation in this file needs, before running it. Sets
# $rt_args/$gitconfig for the caller (not local to this function -- callers
# declare them and read them straight after calling this).
kas_project_subcommand_preflight() {
	local cmd_name="$1"
	require_mackas_root
	ensure_workspace_attached
	ensure_kas_container_installed
	ensure_project_checked_out
	# The daemon does not survive a reboot; start it before the volume_in_use
	# checks below so a merely-stopped daemon reads as "not in use" for the
	# right reason (queried and confirmed) rather than by the down-daemon
	# short-circuit in volume_in_use() itself.
	ensure_container_running

	require_volumes_free "$SCRIPT_CMD $cmd_name"

	rt_args="$(kas_runtime_args)"
	gitconfig="${GITCONFIG_FILE:-$MACKAS_GITCONFIG}"
	if [ ! -r "$gitconfig" ] || ! has_safe_directory_star "$gitconfig"; then
		die "gitconfig for the container's dubious-ownership workaround is missing or incomplete: $gitconfig" \
			"$SCRIPT_CMD setup"
	fi
}

lock_usage() {
	cat <<EOF
${C_BLD}$SCRIPT_CMD lock${C_RST} -- pin every declared repo to its exact current commit.

${C_BLD}USAGE${C_RST}
  $SCRIPT_CMD lock

Runs \`kas-container lock\` against the project's kas config -- kas's own
reproducibility mechanism, writing a resolved lockfile INTO the checkout
next to the kas config it locked (see kas's own output above for the exact
path; the name and location are kas's choice, not mackas's). /repo is a
host bind mount, not an ext4 volume, so the lockfile is immediately visible
on the Mac, no retrieve needed.

Read-only from mackas's own perspective -- nothing here touches TMPDIR/
DL_DIR/SSTATE_DIR -- but kas lock itself writes into the checkout, so this
is NOT wrapped in the repo-preserving --skip flags '$SCRIPT_CMD exec' uses;
run it when you actually want a fresh lock, not as a casual query.

Options: --dry-run, -y/--yes (or -f/--force) and -v/--verbose work here too.

${C_BLD}ONE-VM RULE${C_RST}
  Only one VM may access an ext4 image at a time. lock refuses while a
  running build (smoketest/shell) still holds any of the three volumes.
EOF
}

cmd_lock() {
	# No argument parsing here: 'lock' is dispatched bare, like check/status/
	# shell/destroy -- the outer parser already consumed --dry-run/-y/-v/
	# --help (and --config/--set, which must come before the command word
	# anyway) as GLOBAL flags before this ever runs. See lock_usage.
	local rt_args gitconfig
	kas_project_subcommand_preflight lock

	if [ "$DRY_RUN" -eq 1 ]; then
		info "${C_BLD}mackas lock${C_RST} -- would run:"
		printf '%s+ (cd %s && %s %s --runtime-args %s %s)%s\n' \
			"$C_DIM" "$(printf '%q' "$MACKAS_PROJECT")" \
			"$(kas_env_vars 0)" "$(printf '%q' "$KAS_CONTAINER_REAL")" \
			"$(printf '%q' "$rt_args")" "$(quote_cmd lock "$KAS_FILES_ARG")" "$C_RST"
		return 0
	fi

	local rc=0
	(
		cd "$MACKAS_PROJECT" 2>/dev/null || exit 1
		kas_invoke_env "$rt_args" "$gitconfig" 0 lock "$KAS_FILES_ARG"
	) || rc=$?
	[ "$rc" -eq 0 ] || die "kas lock failed (rc=$rc)" "$SCRIPT_CMD shell to investigate"
	did "kas lock finished -- see its own output above for the lockfile's path"
}

dump_usage() {
	cat <<EOF
${C_BLD}$SCRIPT_CMD dump${C_RST} -- write the fully-resolved kas config next to the logs.

${C_BLD}USAGE${C_RST}
  $SCRIPT_CMD dump

Runs \`kas-container dump --skip repos_checkout --skip repos_apply_patches
--resolve-env --resolve-local --resolve-refs\` against the project's kas
config and saves the resolved YAML it prints to
\$MACKAS_LOGS/dump-<timestamp>.yml -- every env var, every local override
and every repo ref resolved to its exact value, a reproducibility record
next to a build's own logs (see item 13 in TODO.md). Purely read-only:
kas dump writes nothing into the checkout itself -- the two --skip flags are
load-bearing for that claim, not decorative. Resolving a branch/tag still
needs kas to know the repo (cloning one that is missing, same as a real
build), so setup_dir/finish_setup_repos are NOT skipped; only the two steps
that would force-checkout or patch an EXISTING clone are.

Options: --dry-run, -y/--yes (or -f/--force) and -v/--verbose work here too.

${C_BLD}ONE-VM RULE${C_RST}
  Only one VM may access an ext4 image at a time. dump refuses while a
  running build (smoketest/shell) still holds any of the three volumes.
EOF
}

# kas's dump plugin subclasses its checkout one, so --resolve-refs does not
# just read state -- to turn a floating branch/tag into an exact commit it
# runs the SAME repos_checkout task a build does, which force-resets a clean
# repo to that resolved commit exactly like build/lock do. Confirmed against
# real kas (5.5): a local-only commit on an otherwise-clean sibling repo is
# silently gone after a bare `kas dump --resolve-refs`, no different from
# what kas_shell_ro's own header describes hitting mackas retrieve before it
# was wrapped. --skip repos_checkout stops that reset while still letting kas
# clone a repo that is not there yet and fetch/resolve the ref -- confirmed
# that resolution still works and still yields the real commit with the skip
# in place. --skip repos_apply_patches is paired with it on the same
# reasoning as everywhere else in this file (and is a no-op today -- dump
# never reaches the patch step even unskipped -- kept for when that changes
# out from under us). Do NOT drop either flag: this is the one thing Step 1
# of the --skip decision procedure in skills/mackas/SKILL.md relies on dump
# being safe to run before Step 2 has even looked at the repo.
cmd_dump() {
	# No argument parsing here: 'dump' is dispatched bare, like check/status/
	# shell/destroy -- the outer parser already consumed --dry-run/-y/-v/
	# --help as GLOBAL flags before this ever runs. See dump_usage.
	local rt_args gitconfig
	kas_project_subcommand_preflight dump

	# MACKAS_DUMP_TS: an undocumented test seam for a deterministic filename
	# in tests, same convention as MACKAS_RETRIEVE_TS/MACKAS_OVERHEAD_BIN.
	local ts out
	ts="${MACKAS_DUMP_TS:-$(date +%Y%m%d%H%M%S)}"
	out="$MACKAS_LOGS/dump-${ts}.yml"

	if [ "$DRY_RUN" -eq 1 ]; then
		info "${C_BLD}mackas dump${C_RST} -- would run:"
		printf '%s+ (cd %s && %s %s --runtime-args %s %s)%s\n' \
			"$C_DIM" "$(printf '%q' "$MACKAS_PROJECT")" \
			"$(kas_env_vars 0)" "$(printf '%q' "$KAS_CONTAINER_REAL")" \
			"$(printf '%q' "$rt_args")" \
			"$(quote_cmd dump --skip repos_checkout --skip repos_apply_patches \
				--resolve-env --resolve-local --resolve-refs "$KAS_FILES_ARG")" "$C_RST"
		info "  writing resolved config to: $out"
		return 0
	fi

	mkdir -p "$MACKAS_LOGS"
	local rc=0
	(
		cd "$MACKAS_PROJECT" 2>/dev/null || exit 1
		kas_invoke_env "$rt_args" "$gitconfig" 0 dump --skip repos_checkout --skip repos_apply_patches \
			--resolve-env --resolve-local --resolve-refs "$KAS_FILES_ARG"
	) > "$out" || rc=$?
	if [ "$rc" -ne 0 ]; then
		rm -f "$out"
		die "kas dump failed (rc=$rc)" "$SCRIPT_CMD shell to investigate"
	fi
	did "wrote resolved config to $out"
}

# ---------------------------------------------------------------------------
# retrieve -- copy build outputs out of the ext4 TMPDIR volume
# buildstats -- work with buildstats already retrieved
# ---------------------------------------------------------------------------
#
# tmp/buildstats, tmp/log, tmp/deploy and buildhistory live inside the
# oe-build-tmp ext4 image and are invisible from macOS (that is the deliberate
# cost of real Linux filesystem semantics -- see the "Known limitations"
# section of the README). This copies them out with a throwaway container that
# bind-mounts a host directory as /out. The recipe is the one proven by hand:
#
#   container run --rm -u 0:0 -v oe-build-tmp:/build -v <dest>:/out \
#       ghcr.io/siemens/kas/kas:5.5 sh -c 'cp -r /build/tmp/buildstats /out/'
#
# -u 0:0 is required: the kas image's default user (uid 30000) cannot read the
# root-owned build tree cleanly, and it matches ensure_volume()'s reasoning. No
# chown inside -- Apple's virtiofs forces host-user ownership on the /out bind
# mount, so files land owned by the invoking user already and a `chown -R`
# there fails "Operation not permitted".

# fetch_volume_subdir VOL MOUNT SUB DEST VAR DEFAULT [EXTRA] [MACHINE] [NEWER]
# -- copy the guest directory VAR resolves to, out of the ext4 volume VOL
# mounted at MOUNT, into DEST/SUB[/EXTRA]. Returns non-zero (with a clear
# message) when that directory is absent -- e.g. no build has run, so there is
# no tmp/buildstats -- rather than letting a raw `cp` error surface.
# Idempotent within one EXTRA: re-copying the same EXTRA overwrites in place.
#
# VOL/MOUNT are parameters because publication reads a DIFFERENT volume than
# retrieval does: `sstate push` stages out of MACKAS_VOL_SSTATE at /sstate,
# every retrieve object out of MACKAS_VOL_TMP at /build. Nothing in the
# mechanism was ever tmp-specific. MOUNT is the whole `-v` suffix, so it can
# carry a `:ro` -- push has no business writing to what it publishes.
#
# An empty VAR means "use DEFAULT verbatim, ask bitbake nothing": push needs
# no project checkout and no kas-container context, exactly like sstate_prune.
# NEWER, if set, is an epoch cutoff -- only files modified after it are copied,
# and the source manifest covers exactly that subset. sstate objects are NOT
# write-once (bitbake touches one on every reuse -- the same os.utime()
# 'sstate prune' relies on), so this over-selects rather than misses: what it
# names is everything recent builds wrote or reused.
#
# The three failure-ish returns are deliberately distinct, because `sstate
# push` ADVANCES ITS STAMP on one of them: 1 is "the directory is not there",
# 2 is "the scan ran and matched nothing" (a normal outcome, safe to stamp),
# 3 is "the scan did not produce a trustworthy answer" (never stamp).
#
# Nothing here requires the source to sit under /build/tmp either, and
# several retrieve objects do not. A distro may move DEPLOY_DIR anywhere it
# likes (Angstrom points it at ${TOPDIR}/deploy), buildhistory
# lives at ${TOPDIR}/buildhistory (a sibling of tmp/), and the SPDX tree
# lives under DEPLOY_DIR/spdx/${SPDX_VERSION} (inheriting DEPLOY_DIR's
# relocatability). Only the FALLBACK used when bitbake-getvar cannot answer
# was ever tmp-shaped, which is why DEFAULT is a parameter: hardcoding
# "/build/tmp/$sub" here would have sent every buildhistory/sbom probe to
# paths that cannot exist. SUB stays the mackas-facing object key and names
# the destination, whatever the source path turns out to be.
#
# EXTRA exists for buildstats specifically (see cmd_retrieve): a fresh,
# mackas-generated timestamp per retrieve, so successive retrievals land in
# their OWN directory instead of merging into the same DEST/buildstats/ every
# time. Without it, a project whose BUILDNAME does not vary (e.g. Angstrom's
# `BUILDNAME = "Angstrom ${DISTRO_VERSION}"`) would have every retrieval
# overwrite/merge into the identical host path on top of what a PRIOR
# retrieval already put there -- on top of the accumulation buildstats.bbclass
# itself already does guest-side (see check_buildstats_accumulation).
# Print the POSIX-sh script that, run from inside the directory being
# verified, emits a sorted "<relpath>#<chunk>\t<cksum-line>" manifest of
# every regular file under it -- fetch_volume_subdir's way of checking a cp -r
# copy actually matches its source instead of trusting it blind. A file over
# 256M (keep in sync with retrieve_verify_local()'s own threshold) is split
# into up to 8 whole-MiB byte-range chunks so one huge deploy image
# checksums in parallel instead of serially; everything else is checksummed
# in BATCHES, many files per cksum invocation (see retrieve_verify_local()'s
# own comment for why -- issue #94, a process-per-file spawn was the
# dominant cost against a real 650k-file deploy dir, not the checksumming
# itself). `dd bs=1M skip=N count=M` chunk boundaries are deliberately
# whole-MiB so the identical invocation shape works against both GNU dd
# (here) and BSD dd (retrieve_verify_local, the host side) -- verified live
# to produce byte-identical output for the same tree, sub-file chunks
# included. cksum (POSIX CRC) over md5sum/sha*sum: measured ~5x faster than
# md5sum on a real 10G file on this runtime, and ARM64's SHA hardware
# extensions only help the sha*sum tools it has no equivalent for; cksum
# also has the property the batching below depends on -- given multiple
# paths on one invocation, it labels each line with the exact path it was
# given, so a batch's own internal ordering is never load-bearing.
#
# $1, if given, is an extra `find` predicate (mackas-generated, always
# `-newermt @<epoch>`) restricting the manifest to the same subset a staged
# copy took -- empty for every retrieve, which verifies whole trees. It is
# emitted as a quoted assignment and expanded UNQUOTED below so it splits back
# into find's two arguments; BOTH find passes below carry it or the batched
# small-file half would checksum the whole tree. Empty leaves find as it was.
retrieve_verify_script() {
	printf 'newer="%s"\n' "${1:-}"
	cat <<'EOS'
: > /tmp/.mackas-verify-jobs
mkdir -p /tmp/.mackas-verify-batches
find . -type f $newer -size +268435456c -printf '%s %p\n' | while read -r size path; do
	rel="${path#./}"
	size_mb=$(( (size + 1048575) / 1048576 ))
	chunk_mb=$(( (size_mb + 7) / 8 ))
	i=0
	while [ "$i" -lt 8 ]; do
		skip_mb=$(( i * chunk_mb ))
		if [ "$skip_mb" -lt "$size_mb" ]; then
			printf '%s %s %s %s %s\n' "$rel" "$i" "$path" "$skip_mb" "$chunk_mb" >> /tmp/.mackas-verify-jobs
		fi
		i=$((i+1))
	done
done
{
	LC_ALL=C sort /tmp/.mackas-verify-jobs | xargs -r -P 8 -L 1 sh -c '
		sum=$(dd if="$3" bs=1M skip="$4" count="$5" 2>/dev/null | cksum)
		printf "%s#%s\t%s\n" "$1" "$2" "$sum"
	' _
	find . -type f $newer ! -size +268435456c -print0 | \
		xargs -0 -r -P 8 -n 256 sh -c 'cksum "$@" >> "$0/c.$$"' /tmp/.mackas-verify-batches
	find /tmp/.mackas-verify-batches -type f -exec cat {} + | \
		LC_ALL=C awk '{ c = $1; s = $2; sub(/^[0-9]+ [0-9]+ \.\//, ""); printf "%s#0\t%s %s\n", $0, c, s }'
} | LC_ALL=C sort
EOS
}

# Host-side (macOS/BSD) counterpart to retrieve_verify_script() above: the
# SAME manifest algorithm against a plain directory (retrieve's --dest is
# always a real host path, never a volume, so this needs no container at
# all) -- stat -f%z instead of find -printf (BSD find has neither), sort/dd
# invoked the same way BSD and GNU agree on. Verified live to produce
# byte-identical output against the guest-side script for the same tree.
# Every sort here and in retrieve_verify_script() is LC_ALL=C: without it,
# GNU sort collates under whatever locale the kas image ships (en_US.utf8)
# while BSD sort here follows the user's own shell locale (observed:
# nl_NL.UTF-8) -- two different, non-C collation orders for the exact same
# filename set. The final comparison is a literal string compare of the
# whole manifest, so a same-content, different-ORDER pair of "identical"
# sorted outputs reads as a mismatch and triggers the tar fallback on every
# retrieve of a directory with more than one sort-order-sensitive filename,
# with zero data actually wrong. Verified live: real deploy/images filenames
# (dots, hyphens, mixed case) reorder under nl_NL.UTF-8 vs en_US.utf8, and
# LC_ALL=C converges GNU and BSD sort on byte order regardless of locale.
# The same LC_ALL=C pinning now also covers the awk below, for the same
# reason: sub() against a non-UTF-8 filename byte sequence is exactly the
# kind of thing that diverges between the container's locale and this
# Mac's own (verified identical under LC_ALL=C, en_US.UTF-8, nl_NL.UTF-8).
#
# The <=256M files below are batched, many per cksum invocation, instead of
# one process per file (issue #94: a real ~650k-file deploy dir, mostly
# per-recipe SPDX/SBOM json, took 35+ minutes to verify -- profiling showed
# well under 1 of the 8 parallel slots ever busy, i.e. dominated by
# fork/exec overhead, not real checksum work; a prototype of this exact
# batching measured 89x on a 30k-file tree, byte-identical manifests).
# `xargs -P 8 -n 256 cksum | awk` (piping every worker's output through one
# shared pipe) looks like the obvious form but silently corrupts the
# manifest: concurrent workers' multi-line output can interleave at stdio
# flush boundaries, reproduced 3/3 runs on a tree with long paths. Each
# xargs worker instead appends to a file named for its OWN pid
# ("$0/c.$$" -- $0 is the batch directory, passed as xargs' fixed initial
# argument); pids are unique among live processes, so two concurrent
# workers never share a file, and a later, reused pid just appends after
# the previous holder already exited. `-r` on every xargs here and in
# retrieve_verify_script() (both the batched one and the existing chunk
# one): without it, an empty directory hits GNU xargs' "run once even on
# empty input" behavior on the guest side while BSD xargs does not, so an
# empty directory's guest and host manifests disagreed and fell back to
# tar before failing outright.
retrieve_verify_local() {
	local root="$1"
	local batchdir rc=0
	# A plain host tmpdir, not under $root -- it must never end up inside
	# the tree being verified and checksum itself. Created before the cd
	# below for that same reason.
	batchdir="$(mktemp -d "${TMPDIR:-/tmp}/mackas-verify.XXXXXX")" || return 1
	# Job generation AND the xargs workers below run in ONE subshell so a
	# relative $path resolves the same way throughout -- splitting these
	# across two subshells (an earlier version of this function did) loses
	# the cd on the second one, and a dd/cksum against a now-wrong relative
	# path fails silently under 2>/dev/null: every chunk reads as empty
	# instead of erroring, which is worse than not verifying at all.
	(
		cd "$root" || exit 1
		find . -type f -size +268435456c | while IFS= read -r path; do
			local size rel size_mb chunk_mb i skip_mb
			size="$(stat -f%z "$path")"
			rel="${path#./}"
			size_mb=$(( (size + 1048575) / 1048576 ))
			chunk_mb=$(( (size_mb + 7) / 8 ))
			i=0
			while [ "$i" -lt 8 ]; do
				skip_mb=$(( i * chunk_mb ))
				[ "$skip_mb" -lt "$size_mb" ] && printf '%s %s %s %s %s\n' "$rel" "$i" "$path" "$skip_mb" "$chunk_mb"
				i=$((i+1))
			done
		done | LC_ALL=C sort | xargs -r -P 8 -L 1 sh -c '
			sum=$(dd if="$3" bs=1M skip="$4" count="$5" 2>/dev/null | cksum)
			printf "%s#%s\t%s\n" "$1" "$2" "$sum"
		' _
		find . -type f ! -size +268435456c -print0 | \
			xargs -0 -r -P 8 -n 256 sh -c 'cksum "$@" >> "$0/c.$$"' "$batchdir"
		find "$batchdir" -type f -exec cat {} + | \
			LC_ALL=C awk '{ c = $1; s = $2; sub(/^[0-9]+ [0-9]+ \.\//, ""); printf "%s#0\t%s %s\n", $0, c, s }'
	) | LC_ALL=C sort || rc=$?
	rm -rf "$batchdir"
	return $rc
}

fetch_volume_subdir() {
	local vol="$1" mount="$2" sub="$3" dest="$4" var="$5" default="$6"
	local extra="${7:-}" machine="${8:-}" newer="${9:-}"
	local guest destsub quiet_undefined=0 rc

	# NEWER is an epoch, not a file: the throwaway container mounts the
	# volume and the staging directory, nothing else, so there is no host
	# stamp file in there to point `find -newer` at.
	local find_newer=""
	[ -n "$newer" ] && find_newer="-newermt @$newer"

	# buildhistory and sbom are the objects whose variables are only ever
	# defined by an optional bbclass (see bitbake_getvar): BUILDHISTORY_DIR
	# by buildhistory.bbclass, DEPLOY_DIR_SPDX by spdx-common.bbclass (pulled
	# in by create-spdx). Opt into the quiet-undefined signal so "this project
	# doesn't INHERIT it" is explained once, below, rather than as a generic
	# bitbake-getvar warning first.
	case "$sub" in
		buildhistory|sbom) quiet_undefined=1 ;;
	esac

	if [ -z "$var" ]; then
		# 'sstate push': the guest path IS the mount point, and there is no
		# project checkout to ask -- exactly like sstate_prune, which also
		# only runs `find` against a mounted volume. Skipping bitbake_getvar
		# is what keeps push usable with no kas-container context at all.
		guest="$default"
	else
		# Distros can redefine where these actually land (e.g. Angstrom sets
		# DEPLOY_DIR to $TOPDIR/deploy, not OE-core's $TMPDIR/deploy default) --
		# ask bitbake itself rather than assume the default layout.
		guest="$(bitbake_getvar "$var" "$quiet_undefined")"; rc=$?
		if [ "$rc" -eq 2 ]; then
			guest="$default"
		elif [ "$rc" -ne 0 ]; then
			guest="$default"
			warn "  could not resolve $var via bitbake-getvar; assuming the default ($guest)"
		elif [ -n "$machine" ]; then
			# 'retrieve deploy images MACHINE' (item 24): DEPLOY_DIR_IMAGE was just
			# resolved for real, for the PROJECT's currently configured MACHINE --
			# bitbake has no CLI knob to re-resolve it under a different one
			# without reconfiguring the checkout. OE-core's bitbake.conf always
			# names this directory's final path component literally ${MACHINE}
			# regardless of how a distro redefines DEPLOY_DIR itself (the
			# multiconfig/SDK machinery across the ecosystem depends on that), so
			# swapping only the trailing component of the REAL resolved path is a
			# distro-safe substitution -- never a blind 'DEPLOY_DIR/images/
			# $machine' guess built without asking bitbake first. Only done on
			# the rc=0 (real answer) path -- $default above is already built with
			# $machine appended where it belongs, by the caller.
			guest="${guest%/*}/$machine"
		fi
	fi

	# Existence probe AND a real size measurement in the SAME container hop --
	# a VM boot is the expensive part, not the extra `du`. Always runs for
	# real, dry-run or not (same reasoning as clean_tmp_deploy/sstate_prune's
	# own probes): a --dry-run preview is more useful showing the REAL
	# transfer size than an assumed yes. A `du` failure (permissions, an
	# exotic guest fs) never masks a directory that DOES exist -- size
	# reporting is a nicety, not a precondition; only a missing directory
	# (the `[ -d ] || exit 1`) is treated as absent.
	# printf %q quotes $guest safely for the sh -c string. `|| rc=$?` (never a
	# bare `rc=$?` on the next line) -- under this script's set -euo
	# pipefail, a failing substitution trips set -e before a later bare
	# `rc=$?` line ever runs, same idiom sstate_prune/attach_workspace_image
	# already use. NOT `2>/dev/null` on the outer command: a genuine runtime
	# failure (the VM never started, the image is missing) must still reach
	# the user, not be silently folded into "no such directory".
	#
	# With NEWER set, `du -sk` would report the whole 40G sstate volume when
	# a handful of objects is what is actually about to move, so the subset
	# is summed instead -- printed in du's own "<kb><TAB>..." shape so the
	# parse below stays one code path. The object COUNT rides along in the
	# second field, and is what distinguishes "nothing new" from "absent".
	#
	# Exit 1 stays reserved for "the directory is not there"; every other
	# non-zero code is a probe that BROKE, and gets its own return below.
	# The two have to stay distinguishable from each other and from an empty
	# answer, because push stamps on the empty one (see sstate_push) and must
	# never stamp on a broken one. Both probe shapes therefore end in the
	# same MACKAS-SCAN-OK marker, checked unconditionally below: whether the
	# push is incremental, --full or the very first one, a probe that exited
	# clean without reaching its end must not read as an answer.
	local probe rc=0 size_kb="" newer_count="" probe_cmd q_guest
	q_guest="$(printf '%q' "$guest")"
	if [ -n "$find_newer" ]; then
		# Not a `find | awk` pipeline: the guest sh is dash, which has no
		# pipefail, so a find that dies mid-scan still leaves the pipeline
		# exiting 0 and reads as "nothing newer" -- the one answer that
		# advances the stamp. find's status is checked on its own, and
		# MACKAS-SCAN-OK is printed only once awk has also finished, so a
		# truncated or half-run scan cannot pass for an empty one.
		probe_cmd="[ -d $q_guest ] || exit 1; cd $q_guest || exit 8; find . -type f $find_newer -printf '%s\\n' > /tmp/.mackas-scan || exit 9; LC_ALL=C awk '{ s += \$1; n++ } END { printf \"%d\\t%d objects\\n\", (s + 1023) / 1024, n }' /tmp/.mackas-scan || exit 10; printf 'MACKAS-SCAN-OK\\n'"
	else
		# The SAME completion marker, never a trailing `exit 0`, even though
		# this branch has no scan to truncate: `sstate push` reaches it on
		# --full and on every FIRST push (no stamp yet, so no cutoff and no
		# find), and stamps afterwards exactly as the incremental path does.
		# A guard that only covered the incremental path would leave the
		# never-stamp rule off the path a new user hits first. printf, not
		# `exit 0`, is also what keeps du's own failure a nicety: du writes
		# nothing, printf still succeeds, and only the size is lost.
		probe_cmd="[ -d $q_guest ] || exit 1; du -sk $q_guest 2>/dev/null; printf 'MACKAS-SCAN-OK\\n'"
	fi
	probe="$(container run --rm -u 0:0 -v "$vol:$mount" "$KAS_IMAGE" \
		sh -c "$probe_cmd")" || rc=$?
	if [ "$rc" -eq 0 ] && ! printf '%s\n' "$probe" | grep -q '^MACKAS-SCAN-OK$'; then
		rc=11
	fi
	if [ "$rc" -eq 1 ]; then
		case "$sub" in
			buildstats)
				warn "  no $guest in '$vol' -- has a build run yet? ($SCRIPT_CMD smoketest)"
				;;
			buildhistory)
				# By far the likeliest reason, and one a bare "no such
				# directory" hides completely: buildhistory.bbclass is NOT
				# inherited by default, and nothing whatsoever is written
				# until a project asks for it. BUILDHISTORY_DIR is also
				# undefined until the class is inherited, so bitbake-getvar
				# has nothing to return either and the probe above ran
				# against the class default -- the same "absent" symptom
				# from a completely different cause. Say what to add and
				# where, so this is one edit away from working rather than
				# a hunt through the manual.
				warn "  no $guest in '$vol' -- this project does not INHERIT buildhistory."
				warn "  Nothing records it unless you ask: add to your kas config's local_conf_header"
				warn "  (or conf/local.conf):  INHERIT += \"buildhistory\""
				warn "  then run a build ($SCRIPT_CMD smoketest) and retrieve again."
				;;
			sbom)
				# Unlike buildhistory, create-spdx IS inherited by default on
				# modern OE-core (INHERIT_DISTRO in
				# meta/conf/distro/defaultsetup.conf lists it), so "absent"
				# usually means one of: no build has produced SPDX yet, a
				# distro dropped the class, or this is an older release where
				# it was opt-in. DEPLOY_DIR_SPDX is defined nowhere but
				# spdx-common.bbclass, so bitbake-getvar has nothing to return
				# either when the class is not inherited -- the same "absent"
				# symptom from a different cause. Name both, and the one-line
				# fix, rather than a bare "no such directory".
				warn "  no $guest in '$vol' -- no SPDX/SBOM output has been generated."
				warn "  OE-core inherits create-spdx by default, but a distro can drop it and older"
				warn "  releases did not have it. If it is not inherited, add to your kas config's"
				warn "  local_conf_header (or conf/local.conf):  INHERIT += \"create-spdx\""
				warn "  then run a build ($SCRIPT_CMD smoketest) and retrieve again."
				;;
			*)
				warn "  no $guest in '$vol'; skipping $sub"
				;;
		esac
		return 1
	fi
	if [ "$rc" -ne 0 ]; then
		# The probe itself failed, which is NOT the same answer as an empty
		# scan -- see the return-code note in this function's header.
		warn "  could not scan '$vol' for $sub (rc=$rc)${probe:+: $probe}"
		return 3
	fi

	# NOT the first line: $probe is captured through $(...), not a real TTY,
	# so Apple container's own boot-progress reporting ("[3/6] Fetching
	# kernel [0s]", see volume_fstrim_one's identical noise) can precede the
	# real `du -sk` line here too. Only a line actually shaped like `du`'s
	# own "SIZE<TAB-or-space>PATH" output -- starting with digits -- is a
	# candidate; the LAST such line wins, in case more than one appears.
	size_kb="$(printf '%s\n' "$probe" | awk '/^[0-9]+[ \t]/ { v = $1 } END { print v }')"
	case "$size_kb" in ''|*[!0-9]*) size_kb="" ;; esac
	if [ -n "$find_newer" ]; then
		newer_count="$(printf '%s\n' "$probe" | awk '/^[0-9]+[ \t]/ { v = $2 } END { print v }')"
		case "$newer_count" in
			# NEVER a 0 fallback here: 0 is the answer that advances the
			# stamp, so an unreadable count has to be a failure instead.
			''|*[!0-9]*)
				warn "  could not read $sub's object count from the scan of '$vol'"
				return 3 ;;
		esac
		if [ "$newer_count" -eq 0 ]; then
			info "  $sub: nothing newer than the stamp -- nothing to stage"
			return 2
		fi
	fi
	if [ -n "$size_kb" ]; then
		info "  $sub: $(fmt_kb "$size_kb")${newer_count:+ in $newer_count object(s)} to transfer to $dest"

		# Warn, never refuse: retrieve is a copy, not a destructive operation,
		# and a df estimate can be wrong (sparse files, other things writing
		# to the same filesystem concurrently) -- a real ENOSPC failing the
		# transfer partway is an acceptable fallback for what is fundamentally
		# just a heads-up. Walk up to the nearest existing ancestor: $dest
		# itself may not be created yet (the mkdir -p below, or --dry-run,
		# which never creates it at all).
		local df_target="$dest" free_kb
		while [ -n "$df_target" ] && [ ! -d "$df_target" ]; do
			df_target="$(dirname "$df_target")"
		done
		free_kb="$(df -k "$df_target" 2>/dev/null | awk 'NR==2{print $4}')"
		case "$free_kb" in
			''|*[!0-9]*) ;;
			*) [ "$free_kb" -ge "$size_kb" ] || \
				warn "  $dest may not have enough free space for $sub ($(fmt_kb "$free_kb") free, $(fmt_kb "$size_kb") needed)" ;;
		esac
	fi

	# cp -r, VERIFIED, with a slower fallback: a real >18G deploy image was
	# once retrieved with the right size but WRONG content (full-file md5
	# diverged deep in the file; a 1MB-prefix check missed it) -- while
	# `cat`-streaming the same source, same volume, was correct. An isolated
	# retest of plain `cp -r` against that same file afterwards did NOT
	# reproduce it, so this looks conditional (likely concurrent
	# volume/container activity at the time) rather than a deterministic
	# property of `cp -r` -- the exact trigger is still unconfirmed. Giving
	# up cp -r's speed unconditionally (a tar pipe measured ~7-16x slower on
	# a real 10G file, live) is a worse trade than checking its work: cksum
	# each retrieved file (POSIX CRC, ~5x faster than md5sum here, measured)
	# and only pay tar's cost on the rare mismatch.
	destsub="$sub${extra:+/$extra}"
	run mkdir -p "$dest"
	# cp -r never deletes a destination file that is absent from the
	# source -- a destination directory that accumulates across retrieves
	# without being cleaned between builds (a real case: image-oci.bbclass's
	# content-addressed blobs/sha256/ tree, which grows or changes shape
	# build to build) keeps stale files the fresh source manifest no longer
	# lists, and retrieve_verify_local()'s comparison correctly reports that
	# as a mismatch -- not corruption, not a race, just an unswept
	# destination. Clear it first so cp -r starts from empty, exactly like
	# the fallback below already does; this stops the primary path from
	# ever paying the slow fallback just because old content was left
	# lying around.
	run rm -rf "${dest:?}/${destsub:?}"
	run mkdir -p "$dest/$destsub"

	# `cp -r` has no subset form, so a NEWER staging pass lists the matching
	# files once and hands that list to tar. NUL-delimited: a 40G cache is
	# no place to discover that one object's name contains a newline. The
	# same predicate goes to retrieve_verify_script below, so the source
	# manifest covers exactly the set that was copied -- the two `find` runs
	# agree because the volume is provably idle (volume_in_use refused
	# otherwise), so no mtime can move between them.
	local copy_cmd fallback_cmd
	if [ -n "$find_newer" ]; then
		copy_cmd="mkdir -p $(printf '%q' "/out/$destsub") && cd $(printf '%q' "$guest") && find . -type f $find_newer -print0 > /tmp/.mackas-stage-list || exit 11; rm -f /tmp/.mackas-tar-src; { tar -S -C $(printf '%q' "$guest") --null -T /tmp/.mackas-stage-list -cf - || echo bad > /tmp/.mackas-tar-src; } | tar -S -C $(printf '%q' "/out/$destsub") -xf - || exit 12; [ ! -s /tmp/.mackas-tar-src ] || exit 13"
		# No cp -r to fall back FROM: tar IS the safer mechanism here, so a
		# mismatch retries it once and then dies, rather than pretending a
		# third algorithm exists.
		fallback_cmd="$copy_cmd"
	else
		copy_cmd="mkdir -p $(printf '%q' "/out/$destsub") && cp -r $(printf '%q' "$guest/.") $(printf '%q' "/out/$destsub/")"
		fallback_cmd="tar -S -C $(printf '%q' "$guest") -cf - . | tar -S -C $(printf '%q' "/out/$destsub") -xf -"
	fi

	# DRY_RUN, its own early branch, same shape volume_fsck_one()'s STEP E
	# uses: the real path below captures container run's output via command
	# substitution to compare it, which -- unlike a plain `run container
	# run ...` -- does not go through run()'s own dry-run short-circuit, so
	# it needs one of its own.
	if [ "$DRY_RUN" -eq 1 ]; then
		run container run --rm -u 0:0 \
			-v "$vol:$mount" -v "$dest:/out" "$KAS_IMAGE" \
			sh -c "$copy_cmd && cd $(printf '%q' "$guest") && $(retrieve_verify_script "$find_newer")"
		if [ -n "$find_newer" ]; then
			info "  (dry-run: nothing was copied or verified; a real run retries the copy once on a checksum mismatch, then fails)"
		else
			info "  (dry-run: nothing was copied or verified; a real run falls back to a slower tar copy on a checksum mismatch)"
		fi
		return 0
	fi
	local src_manifest dst_manifest
	# The container's own status was never checked, and set -e is suspended
	# here because both call sites invoke this function in a condition. A copy
	# container that died before printing its manifest left src_manifest empty
	# -- and the staging dir, already created empty above, made
	# retrieve_verify_local return empty too, so the two compared EQUAL and a
	# dead copy read as a verified one. On the push path that then stamps, and
	# the objects are never offered to the mirror again. Refuse instead: the
	# guest script exits 11/12/13 for a find, an extract or a source-tar
	# failure, the last of which no pipeline status would have surfaced.
	local copy_rc=0
	src_manifest="$(container run --rm -u 0:0 \
		-v "$vol:$mount" -v "$dest:/out" "$KAS_IMAGE" \
		sh -c "$copy_cmd && cd $(printf '%q' "$guest") && $(retrieve_verify_script "$find_newer")")" || copy_rc=$?
	if [ "$copy_rc" -ne 0 ]; then
		warn "  copying '$sub' out of '$vol' failed (exit $copy_rc) -- not treating this as a verified copy"
		return 3
	fi
	dst_manifest="$(retrieve_verify_local "$dest/$destsub")"
	if [ "$src_manifest" != "$dst_manifest" ]; then
		if [ -n "$find_newer" ]; then
			warn "  '$sub' failed verification after the staged copy -- retrying it"
		else
			warn "  '$sub' failed verification after cp -r -- falling back to a slower, safer copy"
		fi
		# Diagnostic, not a fix: this mismatch has been seen both as a
		# deterministic locale-collation artifact (fixed -- see LC_ALL=C
		# above) and, separately, as a genuinely intermittent failure even
		# with that fix in place -- still unexplained. Since the fallback
		# already makes this run safe regardless of cause, spend a cheap
		# `diff` on the two (small, text) manifests now rather than
		# discarding the only evidence of what actually diverged: same file
		# set with different cksums (real content difference, or a source
		# file that changed between cp -r's read and the verify read) looks
		# nothing like mismatched file sets (a file present on one side and
		# not the other, e.g. a build still writing when retrieve started).
		local mdiff_line
		diff <(printf '%s' "$src_manifest") <(printf '%s' "$dst_manifest") 2>/dev/null | head -20 | \
			while IFS= read -r mdiff_line; do warn "    $mdiff_line"; done
		run rm -rf "${dest:?}/${destsub:?}"
		run mkdir -p "$dest/$destsub"
		run container run --rm -u 0:0 \
			-v "$vol:$mount" -v "$dest:/out" "$KAS_IMAGE" \
			sh -c "$fallback_cmd"
		dst_manifest="$(retrieve_verify_local "$dest/$destsub")"
		[ "$src_manifest" = "$dst_manifest" ] || die "'$sub' still fails verification after the tar fallback" \
			"something is genuinely wrong -- $dest/$destsub was left in place for inspection"
		if [ -n "$find_newer" ]; then
			warn "  '$sub' needed a second attempt -- the first staged copy produced wrong content"
		else
			warn "  '$sub' needed the tar fallback -- cp -r produced wrong content this time"
		fi
	fi
	if [ -n "$find_newer" ]; then
		did "staged $sub -> $dest/$destsub"
	else
		did "retrieved $sub -> $dest/$destsub"
	fi

	[ "$sub" = "buildstats" ] && check_buildstats_accumulation "$dest/$destsub" "$guest"
	return 0
}

# check_buildstats_accumulation DIR GUEST -- DIR is what fetch_volume_subdir just
# retrieved (one or more BUILDNAME subdirs); GUEST is their guest-side parent
# (e.g. /build/tmp/buildstats). buildstats.bbclass opens build_stats in
# APPEND mode at both BuildStarted and BuildCompleted and never truncates or
# clears a BUILDNAME dir (bb.utils.mkdirhier is mkdir -p, not a reset) -- so a
# project whose BUILDNAME does not vary per build (confirmed live: Angstrom's
# distro conf hardcodes `BUILDNAME = "Angstrom ${DISTRO_VERSION}"`) silently
# accumulates every build it has ever run into ONE build_stats file. More
# than one "Build Started:" line in that file is an ironclad sign this has
# happened -- ironclad because it is read directly off THIS retrieval's own
# data, not inferred from a directory-naming coincidence across retrievals.
# Warns, and OFFERS (confirm()-gated, never automatic -- this is a real rm -rf
# in the volume) to clear the guest BUILDNAME dir so the next build starts
# clean. See docs/storage.md#buildstats-and-a-constant-buildname.
check_buildstats_accumulation() {
	local dir="$1" guest="$2" bs n bn
	for bs in "$dir"/*/build_stats; do
		[ -f "$bs" ] || continue
		n="$(grep -c '^Build Started:' "$bs" 2>/dev/null || true)"
		[ "${n:-0}" -gt 1 ] || continue
		bn="$(basename "$(dirname "$bs")")"
		warn "  '$bn' has $n builds' data accumulated in one build_stats -- this"
		warn "  project's BUILDNAME looks constant across builds, so bitbake never"
		warn "  resets tmp/buildstats/$bn (docs/storage.md#buildstats-and-a-constant-buildname)."
		warn "  Numbers in '$SCRIPT_CMD buildstats analyze' may be inflated by carryover."
		if confirm "Clear tmp/buildstats/$bn in the volume so the next build starts fresh?"; then
			run container run --rm -u 0:0 -v "$MACKAS_VOL_TMP:/build" "$KAS_IMAGE" \
				rm -rf "$guest/$bn"
			did "cleared tmp/buildstats/$bn in $MACKAS_VOL_TMP"
		fi
	done
}

retrieve_usage() {
	cat <<EOF
${C_BLD}$SCRIPT_CMD retrieve${C_RST} -- copy build outputs out of the ext4 TMPDIR
volume, where macOS cannot see them, via a throwaway container.

${C_BLD}USAGE${C_RST}
  $SCRIPT_CMD retrieve <object> [<object>...] [--dest DIR]

${C_BLD}OBJECTS${C_RST} (at least one required, repeatable, order does not matter)
  buildstats           tmp/buildstats -- per-task timing (bitbake -m stats).
                       Each retrieval lands in its OWN timestamped
                       subdirectory (buildstats/<retrieve-time>/<BUILDNAME>/)
                       so successive retrievals never merge together.
  logs                 tmp/log -- cooker.log and friends.
  deploy               tmp/deploy -- the images and ipks. Can be tens of GB.
  deploy images [MACHINE]
                       Just DEPLOY_DIR_IMAGE (\${DEPLOY_DIR}/images/\${MACHINE})
                       -- the boot images for one board, without every
                       ipk/rpm feed and every MACHINE a multiconfig build has
                       ever produced. MACHINE defaults to the project's
                       currently configured one; an explicit override
                       substitutes only the resolved path's trailing
                       component, never a blind DEPLOY_DIR/images/MACHINE
                       guess. Lands at \$dest/deploy/images.
  buildhistory         buildhistory/ -- what each build produced: package and
                       image contents, sizes, dependencies, sysroot listings.
                       Only exists if the project INHERITs buildhistory; most
                       do not, and retrieve says so rather than reporting a
                       missing directory. Note it sits at \${TOPDIR}/buildhistory
                       -- inside the same volume '$SCRIPT_CMD clean' discards --
                       so retrieve it before cleaning if you want to keep it.
  sbom                 DEPLOY_DIR_SPDX (\${DEPLOY_DIR}/spdx/\${SPDX_VERSION})
                       -- the SPDX SBOM tree create-spdx writes: one
                       .spdx.json per recipe and per package, under
                       <arch>/{builds,packages,static}/. OE-core inherits
                       create-spdx by default, but a distro can drop it and
                       older releases did not have it, so retrieve says
                       "no SBOM output" rather than reporting a missing
                       directory. It lives under DEPLOY_DIR, which
                       '$SCRIPT_CMD clean' and 'clean tmp+deploy' both
                       discard -- retrieve it before cleaning. (The single
                       per-image SBOM, <image>-<machine>.spdx.json, is
                       deployed alongside the images instead, so
                       'retrieve deploy images' already brings that one.)
                       Lands at \$dest/sbom.

${C_BLD}OPTIONS${C_RST}
  --dest DIR      Where to copy (default \$MACKAS_BASE/artifacts).

Options: --dry-run, -y/--yes (or -f/--force) and -v/--verbose work here too;
put them before or after 'retrieve', e.g. '$SCRIPT_CMD --dry-run retrieve buildstats'.

${C_BLD}A CONSTANT BUILDNAME${C_RST}
  If the retrieved build_stats shows more than one build's data accumulated
  in it (this project's BUILDNAME does not vary per build -- bitbake never
  resets tmp/buildstats itself when that happens), retrieve warns and offers
  to clear it in the volume so the next build starts clean. See
  MACKAS_BUILDSTATS_ACCUMULATE (see mackas.conf.example) to manage this
  yourself instead, and docs/storage.md#buildstats-and-a-constant-buildname.

${C_BLD}ONE-VM RULE${C_RST}
  Only one VM may access an ext4 image at a time. retrieve refuses while a
  running build (smoketest/shell) still holds the TMPDIR volume -- stop it first.

${C_BLD}TRANSFER SIZE${C_RST}
  Each object's real size is measured (not guessed) before it is copied, and
  printed as e.g. 'deploy: 4.2G to transfer to \$dest' -- this also runs under
  --dry-run. If \$dest's filesystem looks too small for it, retrieve warns
  (never refuses); a du/df failure never blocks the retrieval either, size
  reporting is a nicety, not a precondition.
EOF
}

# retrieve <object>... [--dest DIR] -- copy one or more build-output directories
# out of the TMPDIR volume. Each object names a bitbake variable that resolves
# to the real guest path (never a guessed one -- see fetch_volume_subdir), plus the
# name it lands under on the host: 'logs' is the CLI-facing plural of tmp/log,
# and 'buildhistory' resolves to ${TOPDIR}/buildhistory, outside tmp/ entirely.
cmd_retrieve() {
	local dest="" objects=() want_help=0 idx
	while [ $# -gt 0 ]; do
		case "$1" in
			--dry-run)     DRY_RUN=1; shift ;;
			-y|-f|--yes|--force)  ASSUME_YES=1; shift ;;
			-v|--verbose)  VERBOSE=1; shift ;;
			-h|--help)     want_help=1; shift ;;
			help)          want_help=1; shift ;;
			--version)     echo "$SCRIPT_NAME $SCRIPT_VERSION"; exit 0 ;;
			--config|--config=*|--project|--project=*|--set|--set=*) die_on_misplaced_global_flag "$1" retrieve ;;
			--dest)        dest="${2:-}"; [ -n "$dest" ] || die "--dest needs a DIR"; shift 2 ;;
			--dest=*)      dest="${1#*=}"; shift ;;
			deploy)
				# 'deploy' optionally takes its own sub-scope: 'images
				# [MACHINE]' narrows the whole-DEPLOY_DIR copy down to just
				# DEPLOY_DIR_IMAGE (boot images for one board), instead of
				# every ipk/rpm feed and every MACHINE a multiconfig build
				# has ever produced. Encoded into the object token itself
				# ('deploy:images' / 'deploy:images:MACHINE') rather than a
				# separate array, so the rest of this function's per-object
				# loop stays a flat list of strings.
				objects+=("deploy"); shift
				if [ "${1:-}" = "images" ]; then
					shift
					idx=$((${#objects[@]} - 1))
					case "${1:-}" in
						# Not a MACHINE: either nothing follows, another flag,
						# or the next object keyword entirely.
						''|-*|buildstats|logs|deploy|buildhistory|sbom|help)
							objects[$idx]="deploy:images" ;;
						*)
							# A MACHINE substitutes straight into the trailing
							# path component of a resolved guest path (see
							# fetch_volume_subdir), which is now %q-quoted for the
							# guest sh -c -- but a shell metacharacter surviving
							# that quoting intact (e.g. embedded in the printed
							# --dry-run preview, or in warn/die/info messages)
							# is still a typo trap, and '..' would still walk
							# the resolved path up a directory. Pin the shape to
							# what a real MACHINE looks like instead of trying
							# to enumerate what's dangerous.
							case "$1" in
								*[!A-Za-z0-9._-]*|*..*)
									die "MACHINE '$1' looks unsafe (must be letters, digits, '.', '_', '-' only, no '..')" \
										"a MACHINE is a plain name, e.g. 'qemuarm64', not a path" ;;
							esac
							objects[$idx]="deploy:images:$1"; shift ;;
					esac
				fi
				;;
			buildstats|logs|buildhistory|sbom) objects+=("$1"); shift ;;
			-*) die "unknown option for 'retrieve': $1" "$SCRIPT_CMD retrieve --help" ;;
			*) die "unknown object for 'retrieve': $1" \
				"$SCRIPT_CMD retrieve --help  (objects: buildstats logs deploy buildhistory sbom)" ;;
		esac
	done

	if [ "$want_help" -eq 1 ]; then
		retrieve_usage
		return 0
	fi

	[ "${#objects[@]}" -ge 1 ] || die "'retrieve' needs at least one object" \
		"$SCRIPT_CMD retrieve <buildstats|logs|deploy|buildhistory|sbom> [<object>...] [--dest DIR]"

	require_mackas_root

	dest="${dest:-$MACKAS_BASE/artifacts}"

	# dest becomes the host side of a -v "$dest:/out" bind mount, so it has two
	# constraints Apple container imposes. A ':' in the path breaks the mount
	# spec outright. And a RELATIVE path is read as a named-volume source, not a
	# host directory, so files would vanish into a fresh volume instead of
	# landing in ./out -- absolutise it against $PWD so --dest out means what it
	# reads like.
	case "$dest" in
		*:*) die "--dest must not contain ':' (it is a bind-mount path)" \
			"choose a destination without a colon" ;;
	esac
	case "$dest" in
		/*) ;;
		*)  dest="$PWD/$dest" ;;
	esac

	# The daemon does not survive a reboot; start it before the volume_in_use
	# and volume_exists checks below, otherwise a merely-stopped daemon reads
	# as "does not exist yet" (volume_exists' 'container volume ls' returns
	# nothing useful with the daemon down) instead of the actual problem.
	ensure_container_running

	# One-VM rule: bitbake_getvar() goes through kas_shell_ro(), which attaches
	# ALL THREE volumes via kas_runtime_args() -- not just TMPDIR -- so all
	# three must be checked, same as cmd_exec/kas_project_subcommand_preflight.
	require_volumes_free "$SCRIPT_CMD retrieve"
	# fetch_volume_subdir's existence+size probe now always attaches the volume
	# for real, dry-run or not (item 33) -- refuse before that if it does not
	# exist yet at all, the same guard clean_tmp_deploy/sstate_prune already
	# have, rather than let a bind-mount of a not-yet-created named volume
	# have whatever side effect Apple's runtime gives one during a mere
	# preview.
	if ! volume_exists "$MACKAS_VOL_TMP"; then
		warn "Nothing to retrieve -- '$MACKAS_VOL_TMP' does not exist yet ($SCRIPT_CMD setup)"
		return 1
	fi

	info "${C_BLD}mackas retrieve${C_RST}"
	info "  volume  : $MACKAS_VOL_TMP"
	info "  objects : ${objects[*]}"
	info "  dest    : $dest"
	info ""

	# One retrieve-generated timestamp for buildstats specifically (see
	# fetch_volume_subdir's own comment): every OTHER object overwrites its dest
	# in place on purpose (latest logs, latest deploy IS what you want), but
	# buildstats needs a fresh subdirectory per retrieval so successive
	# retrievals never merge into the same host path -- MACKAS_RETRIEVE_TS is
	# an undocumented test seam (cf. MACKAS_OVERHEAD_BIN) for a deterministic
	# value in tests.
	local retrieve_ts="${MACKAS_RETRIEVE_TS:-$(date +%Y%m%d%H%M%S)}"

	# default is the guest path to fall back on when bitbake-getvar cannot
	# answer (no checkout wired up, a query that failed, a variable the project
	# never defines). It is per-object because the objects do NOT share a
	# layout: buildstats/logs/deploy are children of TMPDIR (or elsewhere if
	# TMPDIR is redefined), buildhistory.bbclass puts BUILDHISTORY_DIR at
	# ${TOPDIR}/buildhistory, and DEPLOY_DIR_SPDX lives under DEPLOY_DIR
	# (which Angstrom points at ${TOPDIR}/deploy, not the default's tmp/deploy)
	# -- so their defaults may be siblings of tmp/ or off the TMPDIR volume
	# entirely, depending on what each project configures.
	local it sub var extra default machine fetched=0 got_buildstats=0 got_buildhistory=0
	for it in "${objects[@]}"; do
		sub="$it"
		var="DEPLOY_DIR"
		extra=""
		default="/build/tmp/$it"
		machine=""
		case "$it" in
			logs)         sub="log"; var="LOG_DIR"; default="/build/tmp/log" ;;
			buildstats)   var="BUILDSTATS_BASE"; extra="$retrieve_ts" ;;
			buildhistory) var="BUILDHISTORY_DIR"; default="/build/buildhistory" ;;
			sbom)         var="DEPLOY_DIR_SPDX"; default="/build/tmp/deploy/spdx" ;;
			deploy:images|deploy:images:*)
				var="DEPLOY_DIR_IMAGE"
				# Everything after the second ':' is the optional MACHINE
				# override (empty when the user just wrote 'deploy images'
				# with none), see fetch_volume_subdir's own comment for how it
				# is applied to a REAL bitbake-getvar answer. Appended here
				# too, to the FALLBACK default -- unlike the real answer, the
				# fallback has no existing trailing MACHINE component to
				# substitute, so it must be built with one already in place.
				machine="${it#deploy:images}"
				machine="${machine#:}"
				default="/build/tmp/deploy/images${machine:+/$machine}"
				# destsub (below) is named after sub, so it must ALSO carry
				# the machine -- otherwise 'deploy images boardA' followed by
				# 'deploy images boardB' would both land in the same
				# $dest/deploy/images, silently merging two boards' outputs.
				sub="deploy/images${machine:+/$machine}"
				;;
		esac
		# fetch_volume_subdir itself now measures and prints the real size to
		# transfer (and warns if $dest looks too small) -- replacing what used
		# to be one hardcoded "deploy can be large" guess that said nothing
		# about the other three objects and nothing real about this
		# project's actual deploy/ contents.
		if fetch_volume_subdir "$MACKAS_VOL_TMP" /build \
			"$sub" "$dest" "$var" "$default" "$extra" "$machine"; then
			fetched=$((fetched + 1))
			[ "$it" = "buildstats" ] && got_buildstats=1
			[ "$it" = "buildhistory" ] && got_buildhistory=1
		fi
	done

	if [ "$fetched" -eq 0 ]; then
		warn "Nothing retrieved."
		return 1
	fi

	hdr "Retrieved to $dest"
	if [ "$got_buildstats" -eq 1 ]; then
		info "  Summarise with: $SCRIPT_CMD buildstats analyze $(printf '%q' "$dest/buildstats")"
	fi
	if [ "$got_buildhistory" -eq 1 ]; then
		# buildhistory.bbclass commits each build into the directory itself
		# when BUILDHISTORY_COMMIT is on, so what was just copied out may well
		# be a git repository with one commit per build -- readable on the Mac
		# with plain git, no container needed. Phrased conditionally because
		# that setting is a project decision, not something mackas asserts:
		# with it off the directory is still there, just without the history.
		info "  Inspect with: git -C $(printf '%q' "$dest/buildhistory") log --oneline   (when BUILDHISTORY_COMMIT is on)"

		# Auto-run the summary layer (never --detail -- that boots a
		# container per call, which retrieve itself never does) on what was
		# JUST copied, since it is warm in cache and a handful of host `git`
		# reads costs a fraction of the copy it follows. Never lets a failure
		# here affect retrieve's own exit code -- this is a bonus, not part
		# of what retrieve promised to do.
		hdr "buildhistory changes"
		buildhistory_analyze "$dest/buildhistory" || true
		info "  Re-run without re-copying: $SCRIPT_CMD buildhistory analyze"
	fi
	return 0
}

buildstats_usage() {
	cat <<EOF
${C_BLD}$SCRIPT_CMD buildstats${C_RST} -- work with buildstats already retrieved
from the TMPDIR volume ('$SCRIPT_CMD retrieve buildstats').

${C_BLD}USAGE${C_RST}
  $SCRIPT_CMD buildstats analyze [PATH] [--json] [--top N] [-o FILE] [--chart|--no-chart]

${C_BLD}SUBCOMMANDS${C_RST}
  analyze [PATH]   Summarise the NEWEST build in a buildstats directory (wall
                   time, parallelism, io-bound tasks) via
                   tools/mackas-buildstats-analyze, then render pybootchartgui's
                   bootchart SVG for EVERY build under PATH not already charted
                   -- one <BUILDNAME>.svg per build, next to it. PATH defaults
                   to \$MACKAS_BASE/artifacts/buildstats -- the default
                   '$SCRIPT_CMD retrieve buildstats' destination.

    --json         Machine-readable JSON instead of the text digest.
    --top N        How many entries per top-N table (default 25).
    -o FILE        Write the summary to FILE instead of stdout.
    --chart        Render the bootchart SVG and fail the command if that
                   render fails (the default silently tolerates a chart
                   failure -- it is a bonus, not something you asked for).
    --no-chart     Skip the SVG render entirely -- no throwaway container.

The SVG needs pycairo, which this Mac's own Python does not have, so it runs
INSIDE a throwaway kas-image container instead -- best-effort by default:
silently skipped (not an error) with no checkout yet, or if
pybootchartgui.py cannot be found under it, or on any other render failure,
unless --chart asked for it explicitly. A build with a chart already on disk
is skipped, so re-running 'analyze' after one more build only charts the new
one.

Options: --dry-run, -y/--yes (or -f/--force) and -v/--verbose work here too;
put them before or after the subcommand.
EOF
}

# resolve_buildstats_dir PATH -- print the BUILDNAME dir PATH itself resolves
# to: PATH unchanged if it directly has a build_stats file, else every
# directory AT ANY DEPTH under PATH that does, sorted by full path and the
# lexically last one taken (see list_buildstats_dirs for why this searches
# recursively rather than one fixed level: `retrieve buildstats` nests each
# retrieval under its own timestamp, so a build_stats file can sit one level
# deeper than it used to). Prints nothing if none matches.
resolve_buildstats_dir() {
	list_buildstats_dirs "$1" | tail -1
}

# list_buildstats_dirs PATH -- print every directory AT ANY DEPTH under PATH
# with a real build_stats file in it, one per line, oldest first (both
# BUILDNAME and the retrieve timestamp `retrieve buildstats` now wraps it in
# sort lexically as plain digit strings). PATH itself counts as one build dir
# when it directly has build_stats. Recursive, not one fixed level, because
# the retrieved shape can be PATH/<BUILDNAME>/build_stats (older data, or any
# other tool that hands this a flat dir) OR
# PATH/<retrieve-timestamp>/<BUILDNAME>/build_stats (what `retrieve
# buildstats` produces now -- see fetch_volume_subdir/cmd_retrieve) -- and should
# not need to hardcode a depth at all. Unlike a single "newest wins" pick, the
# SVG chart is cheap and per-build charts should not be merged into one
# answer -- each build gets its own SVG, named after it.
list_buildstats_dirs() {
	local path="$1"
	if [ -f "$path/build_stats" ]; then
		printf '%s\n' "$path"
		return 0
	fi
	[ -d "$path" ] || return 0
	find "$path" -type f -name build_stats 2>/dev/null | sed 's#/build_stats$##' | sort
}

# buildstats_render_svg PATH -- best-effort: render pybootchartgui's bootchart
# SVG for every BUILDNAME dir under PATH into a throwaway container, next to
# the build_stats each was read from -- one SVG per build (list_buildstats_dirs),
# skipping any build already charted so re-running 'buildstats analyze' after
# a fresh build does not re-render history. Never fatal -- buildstats_analyze's
# JSON/text summary is the useful part on its own (see TODO.md item 12):
# pybootchartgui needs pycairo, a native dependency this Mac's host Python does
# not have and mackas is not going to require via Homebrew (item 9), so this
# only ever runs INSIDE the kas image, which is assumed to carry it. Silently
# skips (one info line, never a warning) when there is no checkout yet, no
# pybootchartgui.py, or no BUILDNAME dir at all -- all ordinary, not error,
# states for a fresh retrieve or an empty fixture.
buildstats_render_svg() {
	local path="$1" bsdir pbc dirs pending=() svg_dir svg_base svg_name stage rc=0

	dirs="$(list_buildstats_dirs "$path")"
	[ -n "$dirs" ] || { info "  no BUILDNAME dir with build_stats under $path; skipping the SVG chart"; return 0; }

	[ -d "$MACKAS_WORK" ] || { info "  no checkout under $MACKAS_WORK yet; skipping the SVG chart"; return 0; }
	pbc="$(find "$MACKAS_WORK" -maxdepth 4 -type f -name pybootchartgui.py 2>/dev/null | head -1)"
	[ -n "$pbc" ] || { info "  pybootchartgui.py not found under $MACKAS_WORK; skipping the SVG chart"; return 0; }
	pbc="$(dirname "$pbc")"

	# Skip builds already charted -- re-running 'buildstats analyze' after
	# one more build should only render the new one, not redo every past run.
	while IFS= read -r bsdir; do
		[ -n "$bsdir" ] || continue
		if [ -f "${bsdir%/*}/${bsdir##*/}.svg" ]; then
			info "  ${bsdir##*/}.svg already exists; skipping"
		else
			pending+=("$bsdir")
		fi
	done <<-EOF
	$dirs
	EOF
	[ "${#pending[@]}" -gt 0 ] || { info "  every build under $path is already charted; nothing to do"; return 0; }

	for bsdir in "${pending[@]}"; do
		# pybootchartgui's own main() does `f = filename + "." + options.format`
		# UNCONDITIONALLY (main.py's _get_filename) -- it always appends
		# ".svg" itself, so -o must get the BARE base name or the result is
		# "<name>.svg.svg".
		svg_base="${bsdir##*/}"
		svg_name="$svg_base.svg"
		svg_dir="${bsdir%/*}"

		# _get_filename ALSO does `os.path.isdir(-o's value)` to decide
		# filename vs. output-DIRECTORY mode. Mounting svg_dir (bsdir's own
		# parent) straight as /out means "/out/$svg_base" is bsdir itself --
		# an existing directory, right there under the same mount -- so
		# pybootchartgui silently takes its directory branch and writes
		# "$svg_base/bootchart.svg" instead of "$svg_base.svg" (confirmed
		# live: reported path and real path disagreed). An empty staging dir
		# has no such collision; move its one output file into place after.
		stage="$(mktemp -d "$svg_dir/.mackas-svg.XXXXXX" 2>/dev/null)" || {
			warn "  could not create a staging dir under $svg_dir; skipping $svg_base"
			rc=1
			continue
		}

		# Three host bind-mounts, no named volume: bsdir, svg_dir and stage
		# are already plain host directories (buildstats analyze works on
		# what `retrieve buildstats` already copied out), so unlike
		# fetch_volume_subdir this never touches oe-build-tmp and needs no
		# one-VM check.
		if ! run container run --rm \
			-v "$pbc:/pbc:ro" -v "$bsdir:/in:ro" -v "$stage:/out" \
			"$KAS_IMAGE" python3 /pbc/pybootchartgui.py -f svg -M -T \
				-o "/out/$svg_base" /in
		then
			warn "  pybootchartgui failed on $svg_base (non-fatal); the kas image may be missing pycairo"
			rm -rf "$stage"
			rc=1
			continue
		fi

		if ! run mv "$stage/$svg_name" "$svg_dir/$svg_name"; then
			warn "  pybootchartgui ran but did not produce $svg_name (non-fatal)"
			rm -rf "$stage"
			rc=1
			continue
		fi
		rm -rf "$stage"

		did "chart: $svg_dir/$svg_name"
	done

	return "$rc"
}

# buildstats analyze [PATH] [--json] [--top N] [-o FILE] [--chart|--no-chart]
# -- summarise a buildstats dir already on disk (see cmd_retrieve). Non-fatal
# on a missing analyzer or a failed summary run: this is a read-only summary,
# never worth taking the process down over. The chart step's own exit code is
# only ever allowed to fail the command when --chart was passed explicitly --
# see the case below for why.
buildstats_analyze() {
	local path="" json=0 topn="" outfile="" chart="default"
	while [ $# -gt 0 ]; do
		case "$1" in
			--json)        json=1; shift ;;
			--top)         topn="${2:-}"
				[ -n "$topn" ] || die "--top needs a value" "$SCRIPT_CMD buildstats --help"
				shift 2 ;;
			--top=*)       topn="${1#*=}"; shift ;;
			-o|--output)   outfile="${2:-}"
				[ -n "$outfile" ] || die "-o/--output needs a value" "$SCRIPT_CMD buildstats --help"
				shift 2 ;;
			-o=*|--output=*) outfile="${1#*=}"; shift ;;
			--chart)       chart="on"; shift ;;
			--no-chart)    chart="off"; shift ;;
			-*) die "unknown option for 'buildstats analyze': $1" "$SCRIPT_CMD buildstats --help" ;;
			*) if [ -z "$path" ]; then path="$1"; else
				die "'buildstats analyze' takes at most one PATH" \
					"$SCRIPT_CMD buildstats analyze [PATH]"
			fi; shift ;;
		esac
	done
	path="${path:-$MACKAS_BASE/artifacts/buildstats}"

	# A relative PATH would be read as a NAMED VOLUME source, not a host
	# directory, the moment buildstats_render_svg bind-mounts it -- same
	# footgun cmd_retrieve's --dest guards against. Absolutise against $PWD.
	case "$path" in
		/*) ;;
		*)  path="$PWD/$path" ;;
	esac
	case "$path" in
		*:*) die "buildstats analyze PATH must not contain ':' (it becomes a bind-mount path)" \
			"choose a path without a colon" ;;
	esac

	local analyzer="$SCRIPT_DIR/tools/mackas-buildstats-analyze" rc=0
	if [ ! -f "$analyzer" ] || [ ! -x /usr/bin/python3 ]; then
		warn "analyzer not found at $analyzer; skipping"
		rc=1
	else
		hdr "buildstats summary"
		local pyargs
		pyargs=("$path")
		if [ "$json" -eq 1 ]; then pyargs+=(--json); else pyargs+=(--summary); fi
		[ -n "$topn" ] && pyargs+=(--top "$topn")
		[ -n "$outfile" ] && pyargs+=(-o "$outfile")
		/usr/bin/python3 "$analyzer" "${pyargs[@]}" \
			|| { warn "analyze failed (non-fatal); check $path"; rc=1; }
	fi

	# Charting boots a throwaway container per uncharted build dir -- on by
	# default (existing behaviour), but its own failure only turns into a
	# command failure when the user explicitly asked for it with --chart.
	# Left at the default, or explicitly skipped with --no-chart, a chart
	# problem stays a silent skip -- the same "unrequested bonus, never
	# fatal" reasoning buildhistory_detail_diff's exit-code propagation
	# already applies to something the user DID ask for.
	case "$chart" in
		off) : ;;
		on)
			hdr "bootchart SVG"
			# buildstats_render_svg already warns per build on its own
			# failures; no need to add a second, generic warning on top.
			buildstats_render_svg "$path" || rc=1
			;;
		default)
			hdr "bootchart SVG"
			buildstats_render_svg "$path" || true
			;;
	esac

	return "$rc"
}

cmd_buildstats() {
	local sub="" rest=() a want_help=0
	for a in "$@"; do
		case "$a" in
			--dry-run)     DRY_RUN=1 ;;
			-y|-f|--yes|--force)  ASSUME_YES=1 ;;
			-v|--verbose)  VERBOSE=1 ;;
			-h|--help)     want_help=1 ;;
			--version)     echo "$SCRIPT_NAME $SCRIPT_VERSION"; exit 0 ;;
			--config|--config=*|--project|--project=*|--set|--set=*) die_on_misplaced_global_flag "$a" buildstats ;;
			*) if [ -z "$sub" ]; then sub="$a"; else rest+=("$a"); fi ;;
		esac
	done

	if [ "$want_help" -eq 1 ]; then
		buildstats_usage
		return 0
	fi

	case "${sub:-help}" in
		analyze)  buildstats_analyze ${rest+"${rest[@]}"} ;;
		help)     buildstats_usage ;;
		*) die "unknown 'buildstats' subcommand: $sub" \
			"$SCRIPT_CMD buildstats --help  (analyze)" ;;
	esac
}

# buildhistory_repo_state PATH FROM TO FROM_EXPLICIT -- classify PATH's
# usability for a build-to-build diff, and (when usable) resolve FROM/TO into
# concrete SHAs. Bash 3.2 has no `local -n` or associative arrays, so instead
# of returning a value this sets a fixed set of globals every call (reset at
# the top, so a stale value from an earlier call never survives an early
# return); BH_STATE is the one word the caller switches on:
#   missing   PATH does not exist
#   notree    PATH exists but has neither packages/, images/ nor sdk/
#   nogitbin  PATH has a .git dir but no `git` binary is on PATH
#   nogit     no .git dir -- BUILDHISTORY_COMMIT is off (snapshot mode)
#   empty     .git exists but has zero commits (a bare `git init`)
#   single    only one commit so far -- nothing to diff against yet
#   badrev    FROM or TO (as given) does not resolve
#   ok        >= 2 commits and FROM/TO both resolve -- diff mode
# BH_FROM / BH_TO are the resolved SHAs (state ok only). BH_FROM_REV is the
# revision name actually used -- FROM itself, or "HEAD~1" if FROM was left at
# its default ("build-minus-1") and did not resolve (a non-default
# BUILDHISTORY_TAG, or a copy that lost its tags): FROM_EXPLICIT=1 means the
# caller typed --from themselves, so no silent fallback happens for them -- an
# unresolvable USER-SUPPLIED revision is 'badrev', not a quiet substitution.
# BH_FROM_FELL_BACK flags that substitution for the caller's own info line.
# BH_N_COMMITS/BH_LAST_SUBJECT are read once here so the caller does not need
# a second git invocation for the "No changes:" check.
#
# A command substitution `$(buildhistory_repo_state ...)` would run this
# function in a SUBSHELL, discarding every global it sets -- so, unlike a
# function that only prints its result, this one is always called PLAINLY
# (never wrapped in `$()`) and communicates entirely through BH_STATE and
# friends.
buildhistory_repo_state() {
	local path="$1" from="${2:-build-minus-1}" to="${3:-HEAD}" from_explicit="${4:-0}"
	BH_STATE="" BH_FROM="" BH_TO="" BH_FROM_REV="$from" BH_FROM_FELL_BACK=0
	BH_N_COMMITS=0 BH_LAST_SUBJECT=""

	if [ ! -d "$path" ]; then
		BH_STATE="missing"; return 0
	fi
	if [ ! -d "$path/packages" ] && [ ! -d "$path/images" ] && [ ! -d "$path/sdk" ]; then
		BH_STATE="notree"; return 0
	fi
	if [ ! -d "$path/.git" ]; then
		BH_STATE="nogit"; return 0
	fi
	if ! command -v git >/dev/null 2>&1; then
		BH_STATE="nogitbin"; return 0
	fi
	if ! git -C "$path" rev-parse --verify -q HEAD >/dev/null 2>&1; then
		BH_STATE="empty"; return 0
	fi

	BH_N_COMMITS="$(git -C "$path" rev-list --count HEAD 2>/dev/null || echo 0)"
	BH_LAST_SUBJECT="$(git -C "$path" log -1 --format=%s HEAD 2>/dev/null || true)"

	if [ "$BH_N_COMMITS" -le 1 ]; then
		BH_STATE="single"; return 0
	fi

	BH_TO="$(git -C "$path" rev-parse --verify -q "${to}^{commit}" 2>/dev/null || true)"
	if [ -z "$BH_TO" ]; then
		BH_STATE="badrev"; return 0
	fi

	BH_FROM="$(git -C "$path" rev-parse --verify -q "${from}^{commit}" 2>/dev/null || true)"
	if [ -z "$BH_FROM" ] && [ "$from_explicit" -eq 0 ] && [ "$from" = "build-minus-1" ]; then
		# Our own default didn't resolve -- a non-default BUILDHISTORY_TAG, or
		# a copy that lost its tags. Fall back to the last two builds rather
		# than fail outright; a USER-supplied --from never falls back (see
		# the from_explicit guard above).
		BH_FROM="$(git -C "$path" rev-parse --verify -q "HEAD~1^{commit}" 2>/dev/null || true)"
		if [ -n "$BH_FROM" ]; then
			BH_FROM_REV="HEAD~1"
			BH_FROM_FELL_BACK=1
		fi
	fi
	if [ -z "$BH_FROM" ]; then
		BH_STATE="badrev"; return 0
	fi

	BH_STATE="ok"
}

# buildhistory_detail_diff PATH FROM TO -- run openembedded-core's own
# scripts/buildhistory-diff against the retrieved tree, inside a throwaway
# kas-image container, and print its per-field output. Best-effort, modelled
# on buildstats_render_svg()'s skip-vs-warn discipline (mackas:6918): `info`
# for an ordinary absence (no checkout yet), `warn` for tried-and-failed,
# never fatal to the caller by itself -- buildhistory_analyze() decides
# whether its own exit code reflects this one's failure.
buildhistory_detail_diff() {
	local path="$1" from="$2" to="$3" bhd oecore bbroot out

	if [ ! -d "$MACKAS_WORK" ]; then
		info "  no checkout under $MACKAS_WORK yet; skipping buildhistory-diff"
		return 0
	fi

	bhd="$(find "$MACKAS_WORK" -maxdepth 4 -type f -name buildhistory-diff 2>/dev/null | head -1)"
	if [ -z "$bhd" ]; then
		warn "  scripts/buildhistory-diff not found under $MACKAS_WORK; skipping"
		return 1
	fi
	# buildhistory-diff lives at <oe-core>/scripts/buildhistory-diff --
	# scriptpath's add_oe_lib_path() needs <oe-core>/meta/lib, so the OE-CORE
	# ROOT must be mounted, not just scripts/.
	oecore="$(dirname "$(dirname "$bhd")")"

	bbroot="$(find "$MACKAS_WORK" -maxdepth 5 -type d -path '*/bitbake/lib/bb' 2>/dev/null | head -1)"
	if [ -z "$bbroot" ]; then
		warn "  bitbake not found under $MACKAS_WORK; skipping buildhistory-diff"
		return 1
	fi
	# In a kas checkout, bitbake is a SIBLING of oe-core, so scriptpath's own
	# nested <oe-core>/bitbake/lib/bb probe fails and its $PATH-walk fallback
	# is what actually fires -- the container command below prepends
	# /bitbake/bin to PATH, or buildhistory-diff exits 1 with "Unable to find
	# bitbake". .../bitbake/lib/bb -> the bitbake root, two levels up.
	bbroot="$(dirname "$(dirname "$bbroot")")"

	# run()'s dry-run branch prints "+ <cmd>" to STDOUT and returns 0 --
	# out="$(run container run ...)" would capture that banner and print it
	# as if it were diff output. Branch on DRY_RUN and return before any
	# output capture, rather than fall into the capturing path below.
	if [ "$DRY_RUN" -eq 1 ]; then
		run container run --rm \
			-v "$oecore:/oe-core:ro" -v "$bbroot:/bitbake:ro" -v "$path:/bh:ro" \
			-e GIT_CONFIG_COUNT=1 -e GIT_CONFIG_KEY_0=safe.directory -e GIT_CONFIG_VALUE_0='*' \
			"$KAS_IMAGE" \
			sh -c 'PATH=/bitbake/bin:$PATH exec python3 /oe-core/scripts/buildhistory-diff -p /bh -c no "$1" "$2"' \
			sh "$from" "$to"
		return 0
	fi

	# Three host bind-mounts, no named volume, no one-VM check (same
	# reasoning as buildstats_render_svg's comment at mackas:6966-6970): this
	# never touches oe-build-tmp. Revisions go through 'sh -c "..." sh "$1"
	# "$2"' positionals rather than string interpolation, since they are
	# user-supplied.
	vrb "+ $(quote_cmd container run --rm -v "$oecore:/oe-core:ro" \
		-v "$bbroot:/bitbake:ro" -v "$path:/bh:ro" "$KAS_IMAGE" \
		sh -c 'PATH=/bitbake/bin:$PATH buildhistory-diff -p /bh -c no' "$from" "$to")"
	if ! out="$(container run --rm \
		-v "$oecore:/oe-core:ro" -v "$bbroot:/bitbake:ro" -v "$path:/bh:ro" \
		-e GIT_CONFIG_COUNT=1 -e GIT_CONFIG_KEY_0=safe.directory -e GIT_CONFIG_VALUE_0='*' \
		"$KAS_IMAGE" \
		sh -c 'PATH=/bitbake/bin:$PATH exec python3 /oe-core/scripts/buildhistory-diff -p /bh -c no "$1" "$2"' \
		sh "$from" "$to")"
	then
		warn "  buildhistory-diff failed (non-fatal); the kas image may be missing GitPython"
		warn "  host-side fallback:"
		git -C "$path" log --oneline "$from..$to" 2>/dev/null || true
		git -C "$path" diff --stat "$from" "$to" 2>/dev/null | tail -1 || true
		return 1
	fi

	if [ -z "$out" ]; then
		info "  no significant changes between $from and $to (buildhistory-diff's own"
		info "  filters; the summary above counts everything)"
	else
		printf '%s\n' "$out"
	fi
	return 0
}

# buildhistory_usage() -- buildstats_usage()'s shape (mackas:6845), naming
# the two layers, the defaults, and the BUILDHISTORY_COMMIT requirement.
buildhistory_usage() {
	cat <<EOF
${C_BLD}$SCRIPT_CMD buildhistory${C_RST} -- work with a buildhistory tree already retrieved
from the TMPDIR volume ('$SCRIPT_CMD retrieve buildhistory').

${C_BLD}USAGE${C_RST}
  $SCRIPT_CMD buildhistory analyze [PATH] [--from REV] [--to REV] [--detail]
                          [--json] [--top N] [--all]

${C_BLD}SUBCOMMANDS${C_RST}
  analyze [PATH]   Summarise what changed between two builds -- recipes
                   added/removed/upgraded, the biggest PKGSIZE movers, and
                   per-image size/content deltas -- via
                   tools/mackas-buildhistory-analyze, a stdlib-only host
                   Python tool that reads the retrieved git repo directly
                   (no container, no bitbake). PATH defaults to
                   \$MACKAS_BASE/artifacts/buildhistory -- the default
                   '$SCRIPT_CMD retrieve buildhistory' destination.

Options:
  --from REV   left side of the comparison (default: build-minus-1, the tag
               buildhistory.bbclass rotates before each commit)
  --to REV     right side of the comparison (default: HEAD)
  --detail     also run upstream openembedded-core's own buildhistory-diff,
               INSIDE a throwaway kas-image container, and print its
               per-field output underneath the summary -- best-effort: needs
               a checkout under \$MACKAS_WORK with bitbake and
               scripts/buildhistory-diff under it.
  --json       emit the summary as JSON instead of the text digest. Refuses
               --detail (its output would corrupt the JSON stream).
  --top N      how many size movers to list (default 10)
  --all        disable the summary's own small-change threshold (>1% or
               >64 KiB) -- every changed package is listed

BUILDHISTORY_COMMIT must be "1" (in the project's kas config's
local_conf_header, or conf/local.conf) for there to be any build-to-build
history to compare -- otherwise this shows the CURRENT state instead
(snapshot mode), which is still useful but is not a diff.

Options: --dry-run, -y/--yes (or -f/--force) and -v/--verbose work here too;
put them before or after the subcommand.
EOF
}

# buildhistory_analyze [PATH] [FLAGS...] -- the buildstats_analyze()
# analogue (mackas:6999) for a retrieved buildhistory tree. Never die()s from
# inside the analysis itself -- die is reserved for argument-shape errors
# (too many positionals, a PATH containing ':', --detail combined with
# --json); everything the analysis can find wrong about the TREE (missing,
# not a git repo, only one build, an unresolvable revision, ...) is an
# ordinary degraded state, reported with info/warn and a non-zero return,
# never a hard exit.
buildhistory_analyze() {
	local args=() from="" to="" from_explicit=0 top="10"
	local want_json=0 want_detail=0 want_all=0 named_path=0 path rc=0 state

	while [ $# -gt 0 ]; do
		case "$1" in
			--from)   from="${2:-}"; from_explicit=1; shift 2 ;;
			--from=*) from="${1#--from=}"; from_explicit=1; shift ;;
			--to)     to="${2:-}"; shift 2 ;;
			--to=*)   to="${1#--to=}"; shift ;;
			--top)    top="${2:-}"; shift 2 ;;
			--top=*)  top="${1#--top=}"; shift ;;
			--json)   want_json=1; shift ;;
			--detail) want_detail=1; shift ;;
			--all)    want_all=1; shift ;;
			*)        args+=("$1"); shift ;;
		esac
	done

	[ "${#args[@]}" -le 1 ] || die "'buildhistory analyze' takes at most one PATH" \
		"$SCRIPT_CMD buildhistory analyze [PATH]"
	if [ "$want_detail" -eq 1 ] && [ "$want_json" -eq 1 ]; then
		die "'--detail' and '--json' cannot be combined" \
			"detail output would corrupt the JSON stream -- run them separately"
	fi

	if [ "${#args[@]}" -eq 1 ]; then
		path="${args[0]}"
		named_path=1
	else
		path="$MACKAS_BASE/artifacts/buildhistory"
	fi
	[ -n "$from" ] || from="build-minus-1"
	[ -n "$to" ] || to="HEAD"

	# A relative PATH would be read as a NAMED VOLUME source, not a host
	# directory, the moment --detail bind-mounts it -- same footgun
	# buildstats_analyze() guards against (mackas:7008). Absolutise against
	# $PWD, and reject ':' UNCONDITIONALLY (not just under --detail) so the
	# error is identical regardless of which flags are given.
	case "$path" in
		/*) ;;
		*)  path="$PWD/$path" ;;
	esac
	case "$path" in
		*:*) die "buildhistory analyze PATH must not contain ':' (it becomes a bind-mount path)" \
			"choose a path without a colon" ;;
	esac

	buildhistory_repo_state "$path" "$from" "$to" "$from_explicit"
	state="$BH_STATE"

	# --json means the caller wants a clean, parseable stdout stream (the
	# same reasoning --detail+--json is refused above) -- info() writes to
	# stdout, so every informational line below is suppressed under --json.
	# warn() writes to stderr already, so those stay unconditional.
	case "$state" in
		missing)
			if [ "$named_path" -eq 1 ]; then
				warn "buildhistory analyze: no such directory: $path"
				return 1
			fi
			if [ "$want_json" -eq 0 ]; then
				info "  $path does not exist yet -- nothing has been retrieved."
				info "  If the project inherits buildhistory: $SCRIPT_CMD retrieve buildhistory"
				info "  If not: add INHERIT += \"buildhistory\" to local_conf_header (or"
				info "  conf/local.conf), build, then retrieve again."
			fi
			return 0
			;;
		notree)
			if [ "$named_path" -eq 1 ]; then
				warn "buildhistory analyze: $path does not look like a buildhistory tree"
				return 1
			fi
			[ "$want_json" -eq 1 ] || \
				info "  $path does not look like a buildhistory tree (no packages/, images/ or sdk/)"
			return 0
			;;
		nogitbin)
			warn "buildhistory analyze: host git not found -- install it (e.g. 'xcode-select --install')"
			return 1
			;;
		badrev)
			warn "buildhistory analyze: revision '$from'..'$to' did not resolve in $path"
			return 1
			;;
		empty)
			[ "$want_json" -eq 1 ] || info "  no builds recorded yet in $path"
			return 0
			;;
		nogit)
			if [ "$want_json" -eq 0 ]; then
				info "  not a git repository -- BUILDHISTORY_COMMIT is off, so no per-build history"
				info "  is recorded and there is nothing to compare. Showing the CURRENT state instead."
				info "  Turn history on in your kas config's local_conf_header (or conf/local.conf):"
				info "    BUILDHISTORY_COMMIT = \"1\""
			fi
			;;
		single)
			[ "$want_json" -eq 1 ] || \
				info "  only one build recorded so far; nothing to compare against yet"
			;;
		ok)
			if [ "$want_json" -eq 0 ]; then
				[ "$BH_FROM_FELL_BACK" -eq 0 ] || \
					info "  '$from' not found; comparing the last two builds instead ($BH_FROM_REV..$to)"
				case "$BH_LAST_SUBJECT" in
					"No changes:"*) info "  the last build changed nothing (\"$BH_LAST_SUBJECT\")" ;;
				esac
			fi
			;;
	esac

	[ "$want_json" -eq 1 ] || hdr "buildhistory summary"
	local analyzer="$SCRIPT_DIR/tools/mackas-buildhistory-analyze"
	if [ ! -f "$analyzer" ] || [ ! -x /usr/bin/python3 ]; then
		warn "analyzer not found at $analyzer; skipping"
		rc=1
	else
		local pyargs=("$path" --top "$top")
		case "$state" in
			# Pass the REVISION NAME, not the already-resolved SHA -- the
			# python tool re-resolves it itself (cheap: one more rev-parse in
			# the same repo), which is what lets its report's "rev" field
			# show "build-minus-1"/"HEAD" (or the HEAD~1 fallback) instead of
			# a bare hash.
			ok) pyargs+=(--from "$BH_FROM_REV" --to "$to") ;;
			*)  pyargs+=(--snapshot) ;;
		esac
		[ "$want_json" -eq 0 ] || pyargs+=(--json)
		[ "$want_all" -eq 0 ] || pyargs+=(--all)
		/usr/bin/python3 "$analyzer" "${pyargs[@]}" \
			|| { warn "analyze failed (non-fatal); check $path"; rc=1; }
	fi

	if [ "$want_detail" -eq 1 ]; then
		if [ "$state" = "ok" ]; then
			hdr "buildhistory-diff"
			buildhistory_detail_diff "$path" "$BH_FROM" "$BH_TO" || rc=1
		else
			info "  --detail skipped: no build-to-build history to diff yet"
		fi
	fi

	return "$rc"
}

cmd_buildhistory() {
	local sub="" rest=() a want_help=0
	for a in "$@"; do
		case "$a" in
			--dry-run)     DRY_RUN=1 ;;
			-y|-f|--yes|--force)  ASSUME_YES=1 ;;
			-v|--verbose)  VERBOSE=1 ;;
			-h|--help)     want_help=1 ;;
			--version)     echo "$SCRIPT_NAME $SCRIPT_VERSION"; exit 0 ;;
			--config|--config=*|--project|--project=*|--set|--set=*) die_on_misplaced_global_flag "$a" buildhistory ;;
			*) if [ -z "$sub" ]; then sub="$a"; else rest+=("$a"); fi ;;
		esac
	done

	if [ "$want_help" -eq 1 ]; then
		buildhistory_usage
		return 0
	fi

	case "${sub:-help}" in
		analyze)  buildhistory_analyze ${rest+"${rest[@]}"} ;;
		help)     buildhistory_usage ;;
		*) die "unknown 'buildhistory' subcommand: $sub" \
			"$SCRIPT_CMD buildhistory --help  (analyze)" ;;
	esac
}

sstate_usage() {
	cat <<EOF
${C_BLD}$SCRIPT_CMD sstate${C_RST} -- manage and publish the sstate cache volume.

${C_BLD}USAGE${C_RST}
  $SCRIPT_CMD sstate prune --older-than N[d]
  $SCRIPT_CMD sstate push [--dest USER@HOST:/PATH] [--full]

${C_BLD}SUBCOMMANDS${C_RST}
  prune --older-than N[d]   Delete sstate objects bitbake has not reused in
                            at least N days. Reports what would go and how
                            much space it frees first; only deletes after
                            confirmation (or with -y/--yes).
  push [--dest ...]         Publish sstate objects to a mirror over rsync/ssh.
                            --dest defaults to MACKAS_SSTATE_PUSH_DEST; --full
                            ignores the incremental stamp and offers the whole
                            volume again.

${C_BLD}PRUNE${C_RST}
bitbake touches (updates the mtime of) an sstate object every time it finds
and reuses it -- see sstate.bbclass's sstate_eventhandler and the
setscene-valid check, both call oe.utils.touch()/os.utime() on a hit. So
"N days old" here really means "nothing built in N days has needed this",
not merely "created N days ago".

sstate's own hash-addressing makes this safe to prune conservatively: an
object pruned here that turns out still to be needed just gets rebuilt, at
the one-time cost of that task, never a correctness risk.

For more surgical pruning -- keep only what a SPECIFIC checkout's stamps/
still reference, or drop older duplicates of the same package/arch/task
signature -- see openembedded-core's own scripts/sstate-cache-management.py,
run inside a project checkout. '$SCRIPT_CMD sstate prune' does not replace
it; it solves the coarser "nothing has touched this in months" case.

${C_BLD}PUSH${C_RST}
Objects newer than this volume+destination's own stamp are copied out of the
volume into a host staging directory (MACKAS_SSTATE_PUSH_STAGE, default
\$MACKAS_BASE/sstate-push) and verified there with the same checksum manifest
'$SCRIPT_CMD retrieve' uses, before anything touches the network. The volume is
released before the transfer, which then runs as two rsync passes -- every
object first, the .siginfo files second, so a consumer reading the mirror
mid-push never finds a signature whose object is missing.

Everything is sent with --ignore-existing and never --inplace: a published
object is immutable, the first writer wins, and each one appears at the
destination atomically. Re-running a push is therefore always safe, and a
lost stamp costs a full rescan rather than a wrong result. So does a scan
that could not answer: only a scan that provably ran and provably matched
nothing moves the stamp forward.

The stamp selects on mtime, and bitbake touches an sstate object every time
it REUSES it -- so a push offers everything recent builds wrote or reused,
not only what is new. Nothing is missed that way, and --ignore-existing makes
a re-offer free on the wire, but every re-offered object is still staged and
checksummed on the host: size MACKAS_SSTATE_PUSH_STAGE for the reuse set.

Push before you prune. Once an object is on the mirror, pruning it locally
costs an HTTP refetch instead of a rebuild.

The destination is an rsync/ssh target, not an HTTP URL: mackas-mirrord serves
the read path anonymously and read-only, and that is a property worth keeping
-- so the write path is authenticated out of band, over ssh.

Options: --dry-run, -y/--yes (or -f/--force) and -v/--verbose work here too;
put them before or after the subcommand.

${C_BLD}ONE-VM RULE${C_RST}
  Only one VM may access an ext4 image at a time. Both prune and push
  refuse while a running build (smoketest/shell) still holds the sstate
  volume.
EOF
}

# sstate_prune -- delete sstate objects bitbake has not touched (reused) in
# at least N days, inside a throwaway container mounting the sstate volume --
# sstate lives inside the ext4 volume, invisible on the host, the same
# constraint item 5/retrieve already work around. No project/kas-container
# context is needed (unlike bitbake_getvar): this only ever runs `find`
# against the mounted volume, never bitbake itself.
sstate_prune() {
	local older_than="" days report rc=0 count=0 total_kb=0

	while [ $# -gt 0 ]; do
		case "$1" in
			--older-than)   older_than="${2:-}"
				[ -n "$older_than" ] || die "--older-than needs a value, e.g. 90d" \
					"$SCRIPT_CMD sstate prune --older-than N[d]"
				shift 2 ;;
			--older-than=*) older_than="${1#*=}"; shift ;;
			-*) die "unknown option for 'sstate prune': $1" "$SCRIPT_CMD sstate --help" ;;
			*) die "unexpected argument for 'sstate prune': $1" \
				"$SCRIPT_CMD sstate prune --older-than N[d]" ;;
		esac
	done

	[ -n "$older_than" ] || die "'sstate prune' needs --older-than N[d]" \
		"$SCRIPT_CMD sstate prune --older-than N[d]  (e.g. --older-than 90d)"

	days="${older_than%d}"
	case "$days" in
		''|*[!0-9]*) die "--older-than must be a whole number of days, e.g. 90d (got '$older_than')" \
			"$SCRIPT_CMD sstate --help" ;;
	esac

	require_mackas_root
	# The daemon does not survive a reboot; start it before the volume_in_use
	# check below and the 'container run' scan further down, same reasoning
	# as run_kas()/kas_shell_ro().
	ensure_container_running

	# One-VM rule: never attach the volume a build might still hold. Refuse
	# loudly rather than corrupt an ext4 image mounted by two VMs at once.
	if volume_in_use "$MACKAS_VOL_SSTATE"; then
		die "volume '$MACKAS_VOL_SSTATE' is attached to a running container" \
			"only ONE VM may touch an ext4 image at a time; stop the build first (mackas volume list), then re-run '$SCRIPT_CMD sstate prune'"
	fi

	info "${C_BLD}mackas sstate prune${C_RST}"
	info "  volume     : $MACKAS_VOL_SSTATE"
	info "  older than : ${days}d"
	info ""

	# Always runs for real, dry-run or not -- a read-only scan, and --dry-run
	# needs the REAL count/size to be worth anything (same reasoning as
	# bitbake_getvar()).
	# `|| rc=$?` (never a bare `rc=$?` on the next line) so a failing scan
	# doesn't trip `set -e` before the die() below can run -- same idiom as
	# attach_workspace_image()/volume_fstrim_one(). 2>&1 (not 2>/dev/null)
	# merges stderr into $report so a real failure's text reaches die();
	# harmless for the success-path parsing below, since a clean `find` run
	# that exits 0 writes nothing to stderr.
	report="$(container run --rm -u 0:0 -v "$MACKAS_VOL_SSTATE:/sstate" "$KAS_IMAGE" \
		find /sstate -type f -mtime "+$days" -printf '%s\n' 2>&1)" || rc=$?
	[ "$rc" -eq 0 ] || die "could not scan '$MACKAS_VOL_SSTATE' (rc=$rc)${report:+: $report}" \
		"check the container runtime: $SCRIPT_CMD status"

	if [ -n "$report" ]; then
		count="$(printf '%s\n' "$report" | grep -c .)"
		total_kb="$(printf '%s\n' "$report" | LC_ALL=C awk '{s+=$1} END{printf "%d", s/1024}')"
	fi

	if [ "$count" -eq 0 ]; then
		info "Nothing to prune -- no sstate objects untouched for ${days}+ days."
		return 0
	fi

	info "  found      : $count object(s), $(fmt_kb "$total_kb") reclaimable"
	info ""

	if ! confirm "Delete $count sstate object(s) untouched for ${days}+ days ($(fmt_kb "$total_kb"))?"; then
		info "Declined -- nothing deleted."
		return 1
	fi

	run container run --rm -u 0:0 -v "$MACKAS_VOL_SSTATE:/sstate" "$KAS_IMAGE" \
		find /sstate -type f -mtime "+$days" -delete
	did "pruned $count sstate object(s), freed $(fmt_kb "$total_kb")"

	# The delete above ran IN PLACE inside the volume that was already
	# attached for the scan/delete -- like clean_tmp_deploy's in-place rm, the
	# freed ext4 blocks stay allocated on the host image until something
	# discards them (docs/storage.md's "Reclaiming disk"), so unlike a fresh
	# 'volume create' this needs an explicit fstrim or the space just sits
	# there until someone remembers 'volume fstrim sstate' by hand. Same
	# MACKAS_FSTRIM_AUTO knob and non-fatal `|| true` clean_tmp_deploy/run_kas
	# already use: fstrim failing (a non-hole-punching host filesystem) must
	# never turn a successful prune into a reported failure.
	if [ "${MACKAS_FSTRIM_AUTO:-1}" = "1" ]; then
		volume_fstrim_one "$MACKAS_VOL_SSTATE" 1 || true
	fi
}

# push_stamp_key VOL DEST -- a filesystem-safe name for one volume+destination
# pair's push stamp. The readable prefix says what the file belongs to; the
# cksum of the exact pair is what makes it correct, since two destinations
# differing only in punctuation sanitize to the same prefix -- and a shared
# stamp would silently skip objects the OTHER mirror never received.
push_stamp_key() {
	local pair="$1|$2" slug sum
	slug="$(printf '%s' "$pair" | LC_ALL=C tr -c 'A-Za-z0-9._-' '_' | cut -c1-64)"
	sum="$(printf '%s' "$pair" | cksum | awk '{print $1}')"
	printf '%s-%s\n' "$slug" "$sum"
}

# push_stamp_write FILE EPOCH -- record a completed push.
#
# The epoch is the moment the SCAN started, not the moment rsync finished, so
# an object written while the push ran is picked up by the next one rather
# than skipped; --ignore-existing makes re-offering it free. It is stored as
# the file's CONTENT, never as its mtime: copying, restoring or syncing the
# state directory rewrites mtimes, and a stamp that silently jumped forward
# would skip objects the mirror never got. A stamp that is lost or unreadable
# costs a full rescan -- slow, never wrong.
push_stamp_write() {
	local file="$1" epoch="$2"
	if [ "$DRY_RUN" -eq 1 ]; then
		return 0
	fi
	mkdir -p "$(dirname "$file")"
	printf '%s\n' "$epoch" > "$file"
}

# container_epoch_now -- the wall clock as read INSIDE a throwaway container,
# not the Mac's own (issue #107). The sstate object mtimes an incremental
# push compares its stamp against are set by whatever wrote them on the BUILD
# VM's clock; stamping with the HOST's `date +%s` instead is only safe while
# the two clocks agree, and Apple's `container` VM is known to lag the host's
# after a sleep/wake -- sometimes by minutes, with nothing surfacing it. An
# object written in that window then gets an mtime the next push's `find
# -newermt @<host-epoch-stamp>` reads as "older than the cutoff", and it is
# silently, permanently skipped until someone thinks to run --full. Reading
# "now" from the same clock domain as the mtimes it will later be compared
# against removes the skew instead of trying to bound or detect it.
#
# One more lightweight `container run` per push, not another VM boot -- the
# VM is already up by the time sstate_push calls this (ensure_container_
# running ran first), so this is just another hop through it, the same cost
# `du -sk`'s own probe already pays for a size estimate nobody strictly needs.
#
# Never calls die(): like bitbake_getvar, every caller invokes this through
# command substitution, and `exit` inside that subshell would only kill the
# subshell, leaving the script to carry on with an empty "now" -- so failure
# is a bare non-zero return, and the caller decides what to say and whether
# to stop.
container_epoch_now() {
	local out rc=0
	out="$(container run --rm -u 0:0 "$KAS_IMAGE" date +%s)" || rc=$?
	[ "$rc" -eq 0 ] || return "$rc"
	# Apple's own container tool can interleave boot-progress lines ("[3/6]
	# Fetching kernel [0s]") ahead of the real output -- the identical noise
	# fetch_volume_subdir's own probe already defends against (see its
	# du -sk comment). Take the LAST line that is purely digits, never the
	# first line unconditionally.
	out="$(printf '%s\n' "$out" | awk '/^[0-9]+$/ { v = $0 } END { print v }')"
	case "$out" in
		''|*[!0-9]*) return 1 ;;
	esac
	printf '%s\n' "$out"
}

# sstate_push -- publish new sstate objects to a mirror, over rsync/ssh.
#
# The order of the steps is the design, not an implementation detail:
#
#   1. refuse a volume a running build still holds (the one-VM rule);
#   2. stage only what is newer than THIS volume+destination's stamp into a
#      host directory, and verify that copy with the same chunked-cksum
#      manifest `retrieve` uses;
#   3. release the volume -- the staging container has exited by the time
#      anything touches the network;
#   4. rsync in two passes, payload before siginfo;
#   5. write the stamp only once rsync has exited clean.
#
# Staging on the host instead of pushing from inside the container is the
# whole point of (2): the verified-copy path exists only here, and it exists
# because a real >18G artifact was once copied with the right size and the
# wrong content -- a shared mirror is the last place to skip that. It also
# keeps push credentials on the host (the throwaway container stays
# network-free and credential-free) and keeps a long transfer out of the
# window where the volume is held.
sstate_push() {
	local dest="" full=0 key stamp since="" since_desc now stage stage_root rc=0

	while [ $# -gt 0 ]; do
		case "$1" in
			--dest)   dest="${2:-}"
				[ -n "$dest" ] || die "--dest needs a value, e.g. user@host:/srv/mackas/sstate" \
					"$SCRIPT_CMD sstate push --dest USER@HOST:/PATH"
				shift 2 ;;
			--dest=*) dest="${1#*=}"
				[ -n "$dest" ] || die "--dest needs a value, e.g. user@host:/srv/mackas/sstate" \
					"$SCRIPT_CMD sstate push --dest USER@HOST:/PATH"
				shift ;;
			--full)   full=1; shift ;;
			-*) die "unknown option for 'sstate push': $1" "$SCRIPT_CMD sstate --help" ;;
			*) die "unexpected argument for 'sstate push': $1" \
				"$SCRIPT_CMD sstate push [--dest USER@HOST:/PATH] [--full]" ;;
		esac
	done

	[ -n "$dest" ] || dest="$MACKAS_SSTATE_PUSH_DEST"
	[ -n "$dest" ] || die "'sstate push' needs a destination" \
		"set MACKAS_SSTATE_PUSH_DEST=user@host:/srv/mackas/sstate in $(config_hint), or pass --dest"
	case "$dest" in
		# rsync reads a leading '-' as an option, and the write path is the
		# one place a typo reaches another machine.
		-*) die "the push destination may not start with '-' (got '$dest')" \
			"$SCRIPT_CMD sstate push --dest USER@HOST:/PATH" ;;
		*:*) ;;
		*) die "the push destination must be a remote rsync target, e.g. user@host:/srv/mackas/sstate (got '$dest')" \
			"the mirror's READ path is anonymous and read-only on purpose, so the write path goes over ssh; that split is the design (docs/storage.md)" ;;
	esac

	require_mackas_root
	command -v rsync >/dev/null 2>&1 || die "rsync is not on PATH" \
		"'sstate push' transfers with rsync over ssh; macOS ships one at /usr/bin/rsync"
	# The daemon does not survive a reboot; start it before the volume_in_use
	# and volume_exists checks below, same reasoning as sstate_prune/run_kas
	# and cmd_retrieve: with the daemon down, volume_exists' 'container volume
	# ls' reads as "does not exist yet" rather than the actual problem.
	ensure_container_running

	# One-VM rule: never attach the volume a build might still hold. Refuse
	# loudly rather than corrupt an ext4 image mounted by two VMs at once --
	# read-only is no exemption, the staging mount below is `:ro` for content
	# safety, not for concurrency.
	if volume_in_use "$MACKAS_VOL_SSTATE"; then
		die "volume '$MACKAS_VOL_SSTATE' is attached to a running container" \
			"only ONE VM may touch an ext4 image at a time; stop the build first (mackas volume list), then re-run '$SCRIPT_CMD sstate push'"
	fi

	# fetch_volume_subdir's probe attaches the volume for real, --dry-run or
	# not -- the same guard cmd_retrieve has. die rather than warn: an
	# absent volume bind-mounts as an EMPTY one, which scans as "nothing
	# newer" and is exactly the answer that would move the stamp past
	# objects nothing ever read.
	volume_exists "$MACKAS_VOL_SSTATE" || \
		die "volume '$MACKAS_VOL_SSTATE' does not exist yet" \
			"nothing was pushed and the stamp is unchanged ($SCRIPT_CMD setup)"

	key="$(push_stamp_key "$MACKAS_VOL_SSTATE" "$dest")"
	stamp="$MACKAS_BASE/state/sstate-push/$key.stamp"
	if [ "$full" -eq 0 ] && [ -f "$stamp" ]; then
		since="$(head -1 "$stamp" 2>/dev/null || true)"
		case "$since" in
			''|*[!0-9]*)
				since=""
				warn "  unreadable push stamp ($stamp) -- rescanning everything" ;;
		esac
	fi
	# The build VM's own clock, not the Mac's -- see container_epoch_now's
	# header. Every "now" this command captures (this one, and since_desc
	# below) has to come from here: it is what gets written to the stamp,
	# and the stamp is later compared against mtimes that clock produced.
	now="$(container_epoch_now)" || rc=$?
	[ "$rc" -eq 0 ] || die "could not read the clock inside the build VM (rc=$rc)" \
		"nothing was staged and the push stamp is unchanged; check 'container system status' and retry"
	since_desc="everything (no usable stamp yet)"
	[ -n "$since" ] && since_desc="objects newer than $(date -r "$since" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || printf '@%s' "$since")"

	# One staging tree per volume+destination, wiped before use and after a
	# clean transfer: it holds a second copy of every NEW object, so a
	# leftover would quietly grow. A failed push deliberately leaves it for
	# inspection.
	stage_root="${MACKAS_SSTATE_PUSH_STAGE:-$MACKAS_BASE/sstate-push}"
	stage="$stage_root/$key"

	info "${C_BLD}mackas sstate push${C_RST}"
	info "  volume     : $MACKAS_VOL_SSTATE"
	info "  destination: $dest"
	info "  pushing    : $since_desc"
	info "  staging in : $stage"
	info ""

	run rm -rf "${stage:?}"
	run mkdir -p "$stage"

	# An empty VAR: no bitbake, no project, no kas-container context -- the
	# guest path IS the mount point. `:ro` because publishing must not be able
	# to write to what it publishes.
	fetch_volume_subdir "$MACKAS_VOL_SSTATE" "/sstate:ro" \
		sstate "$stage" "" /sstate "" "" "$since" || rc=$?
	# rc=2 is the ONLY non-zero code that stamps, and that is the whole point
	# of fetch_volume_subdir keeping 1/2/3 apart: it means the scan really ran
	# and really matched nothing, so nothing can be missed by moving the stamp
	# forward -- and doing so keeps the next push's scan cheap. A failed or
	# unparseable scan (3) is indistinguishable from "nothing new" only if you
	# let it be; stamping there would drop the objects that DO exist below the
	# cutoff permanently, which is the opposite of what the stamp is for.
	case "$rc" in
		0) ;;
		2)	push_stamp_write "$stamp" "$now"
			run rm -rf "${stage:?}"
			info "Nothing to push -- '$dest' is already current for '$MACKAS_VOL_SSTATE'."
			return 0 ;;
		*) die "could not stage '$MACKAS_VOL_SSTATE' for push (rc=$rc)" \
			"nothing was transferred and the push stamp is unchanged; $stage was left in place" ;;
	esac

	# The staging container has exited, so the volume is free again for the
	# whole (potentially long) transfer below.
	local src="$stage/sstate/" pass_rc=0

	# Two passes, payload first. bitbake decides an sstate object is
	# available by finding its .siginfo, so a consumer listing the mirror
	# mid-push must never see one whose object has not landed yet.
	#
	# --ignore-existing is the point of the whole transport: published
	# objects become immutable and the first writer wins, so two pushers
	# racing on one hash-derived path need no lock (they are pushing
	# identical bytes anyway), and a re-offered object costs a directory
	# listing rather than a re-upload. NEVER --inplace: rsync's default
	# temp-file-then-rename is what makes each object appear atomically,
	# the same same-directory-rename pattern sstate.bbclass itself uses.
	run rsync -rlt --ignore-existing --exclude='lost+found' --exclude='*.siginfo' "$src" "$dest" || pass_rc=$?
	[ "$pass_rc" -eq 0 ] || die "rsync failed on the payload pass (rc=$pass_rc)" \
		"nothing was stamped, so the next '$SCRIPT_CMD sstate push' retries the same objects; check ssh access to $dest"

	pass_rc=0
	run rsync -rlt --ignore-existing --exclude='lost+found' --include='*/' --include='*.siginfo' --exclude='*' "$src" "$dest" || pass_rc=$?
	[ "$pass_rc" -eq 0 ] || die "rsync failed on the siginfo pass (rc=$pass_rc)" \
		"the objects themselves landed; re-run '$SCRIPT_CMD sstate push' once $dest is reachable again"

	if [ "$DRY_RUN" -eq 1 ]; then
		info "  (dry-run: nothing was transferred and the push stamp is unchanged)"
		return 0
	fi
	push_stamp_write "$stamp" "$now"
	run rm -rf "${stage:?}"
	did "pushed '$MACKAS_VOL_SSTATE' -> $dest (stamp: $stamp)"
}

cmd_sstate() {
	local sub="" rest=() a want_help=0
	for a in "$@"; do
		case "$a" in
			--dry-run)     DRY_RUN=1 ;;
			-y|-f|--yes|--force)  ASSUME_YES=1 ;;
			-v|--verbose)  VERBOSE=1 ;;
			-h|--help)     want_help=1 ;;
			--version)     echo "$SCRIPT_NAME $SCRIPT_VERSION"; exit 0 ;;
			--config|--config=*|--project|--project=*|--set|--set=*) die_on_misplaced_global_flag "$a" sstate ;;
			*) if [ -z "$sub" ]; then sub="$a"; else rest+=("$a"); fi ;;
		esac
	done

	if [ "$want_help" -eq 1 ]; then
		sstate_usage
		return 0
	fi

	case "${sub:-help}" in
		prune)  sstate_prune ${rest+"${rest[@]}"} ;;
		push)   sstate_push ${rest+"${rest[@]}"} ;;
		help)   sstate_usage ;;
		*) die "unknown 'sstate' subcommand: $sub" \
			"$SCRIPT_CMD sstate --help  (prune, push)" ;;
	esac
}

monitor_usage() {
	cat <<EOF
${C_BLD}$SCRIPT_CMD monitor${C_RST} -- show live bitbake progress from a build
started with MACKAS_MONITOR=1.

${C_BLD}USAGE${C_RST}
  $SCRIPT_CMD monitor [--port N] [--once] [--notify] [--wait-for-start SECONDS]

Polls the in-container progress bridge and prints one line per update:
'[status] done/total  recipe:task'. This only polls an already-published
port -- it does not start a build. Enable the bridge for the build you
want to watch first, e.g.:

  $SCRIPT_CMD --set MACKAS_MONITOR=1 smoketest &
  $SCRIPT_CMD monitor

If you want a completion SIGNAL rather than a progress view -- for a script
or a Claude workflow that just needs to know when a build finished -- the
build's own exit code is the more reliable choice; see 'A DONE-SIGNAL
WITHOUT POLLING' below before reaching for this command.

${C_BLD}OPTIONS${C_RST}
  --port N              Poll this port instead of MACKAS_MONITOR_PORT.
  --once                Print a single snapshot and exit, instead of
                         following until the build reports success/failed.
                         Exit status distinguishes success (0), a build
                         that failed (1) and no bridge reachable at all
                         (2) -- usable as a scripted probe.
  --notify              Also post a native macOS notification on exactly
                         three transitions -- build started, succeeded,
                         failed -- never per task. MACKAS_MONITOR_NOTIFY=1
                         turns it on without the flag. Uses
                         terminal-notifier when it is installed, else
                         osascript.
  --wait-for-start SECONDS
                         Tolerate the bridge not being up yet for up to
                         SECONDS, instead of failing on the very first
                         poll (the default: 0, today's behavior). Makes it
                         possible to launch 'monitor' at the same moment
                         as the build it watches -- kas's own
                         checkout/patch/container-start plus reaching
                         bitbake can take anywhere from seconds to
                         minutes. Only covers the FIRST connection: once
                         the bridge has answered even once, a later
                         failure is still reported immediately -- a bridge
                         that goes away mid-build is a real problem, not a
                         startup race.

MACKAS_MONITOR_POLL_INTERVAL sets the poll interval in seconds (default 2);
there is no flag for it, since it is a display-only knob, not a setting
'mackas set' persists.

${C_BLD}A DONE-SIGNAL WITHOUT POLLING${C_RST}
'monitor' (without --once) already blocks until the build finishes and
returns a distinct exit code (0 success, 1 the build failed, 2 no bridge
reachable) -- backgrounding it is a real, non-polling way to be told when
a build ends. But it only ever sees ONE container's bitbake: it cannot
tell you a multi-rung 'smoketest' ladder or a hand-typed multi-machine
batch is fully done, only that the container it happened to be watching
ended, and it cannot see a failure that happens before bitbake ever
starts (a bad kas config, a container that never comes up).

For that reason, THE BUILD'S OWN EXIT CODE IS THE MORE RELIABLE SIGNAL --
background the build itself, not this command:

  $SCRIPT_CMD smoketest -y > smoketest.log 2>&1 &
  wait \$!   # \$? is the ladder's real result, covering everything

  $SCRIPT_CMD monitor --once   # a cheap progress check meanwhile, if wanted

If you drive kas-container BY HAND instead of through 'smoketest'/'build',
two things matter for the exit code to stay trustworthy:

- Background it with '> log 2>&1 &' in a shell that has SOURCED env.sh,
  never by PIPING it ('kas-container ... | tail -3' runs the function in
  a subshell, so any exports it makes -- including the derived
  MACKAS_PROJECT_DIR/MACKAS_KAS_CONFIG -- vanish the moment the pipe
  closes, which can silently point a later command at the wrong project).
- 'nohup'/'env'/an absolute path/anything else that resolves
  'kas-container' via \$PATH instead of the sourced shell function still
  reaches the generated protection wrapper (the real volumes and CPU/
  memory limits apply, and the exit code is genuine) -- but it skips the
  shell function's own conveniences, the auto-appended tuning fragment
  and the MACKAS_PROJECT_DIR/MACKAS_KAS_CONFIG derivation. That trade is
  fine for getting a trustworthy background exit code specifically; it is
  not fine if the build also depends on either of those being derived for
  you -- export them yourself first in that case.

${C_BLD}WHEN THE PUBLISHED PORT RESETS${C_RST}
Apple's 'container' can accept the connection on a published port and then
reset it instead of answering -- the forward's bug, not the bridge's, which
answers that same request correctly on the container's own address. When
that happens the poll asks the runtime which running container publishes
this port, switches to that container's IP (saying so once), and carries
on. A working port is never delayed by any of this: nothing is asked of the
runtime unless a poll has already been reset.

${C_BLD}NOTIFICATION PERMISSIONS${C_RST}
If the terminal app has no Notification Center entry, osascript
notifications are dropped SILENTLY, with no error and no exit code to
check -- it looks identical to working. Granting it is a one-time trip
through System Settings > Notifications that no CLI can do for you.
Installing terminal-notifier (brew install terminal-notifier) sidesteps it
by carrying its own bundle identity, and is preferred automatically.

-y/--yes (or -f/--force) and -v/--verbose are accepted here for consistency
with every other command, but have no effect: monitor never mutates
anything or asks for confirmation. --dry-run prints the mackas-monitor
invocation it would run instead of polling.
EOF
}

cmd_monitor() {
	local port="$MACKAS_MONITOR_PORT" once=0 want_help=0 wait_for_start=0
	local notify="${MACKAS_MONITOR_NOTIFY:-0}"
	while [ "$#" -gt 0 ]; do
		case "$1" in
			-h|--help|help) want_help=1; shift ;;
			--port)    port="${2:-}"
				[ -n "$port" ] || die "--port needs a value" "$SCRIPT_CMD monitor --help"
				shift 2 ;;
			--port=*)  port="${1#*=}"; shift ;;
			--once)    once=1; shift ;;
			--notify)  notify=1; shift ;;
			--wait-for-start) wait_for_start="${2:-}"
				[ -n "$wait_for_start" ] || die "--wait-for-start needs a value" "$SCRIPT_CMD monitor --help"
				shift 2 ;;
			--wait-for-start=*) wait_for_start="${1#*=}"; shift ;;
			--dry-run) DRY_RUN=1; shift ;;
			-y|-f|--yes|--force) ASSUME_YES=1; shift ;;
			-v|--verbose) VERBOSE=1; shift ;;
			--version) echo "$SCRIPT_NAME $SCRIPT_VERSION"; exit 0 ;;
			--config|--config=*|--project|--project=*|--set|--set=*) die_on_misplaced_global_flag "$1" monitor ;;
			-*) die "unknown option for 'monitor': $1" "$SCRIPT_CMD monitor --help" ;;
			*) die "unexpected argument for 'monitor': $1" "$SCRIPT_CMD monitor --help" ;;
		esac
	done

	if [ "$want_help" -eq 1 ]; then
		monitor_usage
		return 0
	fi

	local tool="$SCRIPT_DIR/tools/mackas-monitor"
	[ -f "$tool" ] || die "monitor tool missing at $tool" \
		"reinstall/re-clone mackas -- this should ship with every checkout"
	[ -x /usr/bin/python3 ] || die "no /usr/bin/python3 -- mackas-monitor needs macOS's own stock python3" \
		"xcode-select --install   # or open Terminal once to trigger the CLT prompt"

	if [ "$MACKAS_MONITOR" != "1" ]; then
		warn "MACKAS_MONITOR is not 1 in this shell/config -- a build started now will not publish a bridge for this to poll"
		printf '%s  start one with: MACKAS_MONITOR=1 %s smoketest &, or make it permanent with: %s set MACKAS_MONITOR 1%s\n' \
			"$C_BLU" "$SCRIPT_CMD" "$SCRIPT_CMD" "$C_RST" >&2
	fi

	local args=(--port "$port")
	[ "$once" -eq 1 ] && args+=(--once)
	[ "$notify" = "1" ] && args+=(--notify)
	[ "$wait_for_start" != "0" ] && args+=(--wait-for-start "$wait_for_start")
	# run(): prints the invocation and returns 0 under --dry-run instead of
	# actually polling, same as every other real command in this file.
	run /usr/bin/python3 "$tool" "${args[@]}"
}

show() { printf '  %-24s %s\n' "$1" "$2"; }

# One line per volume: name, what it backs, cap, and what it costs today.
# volume_real_cap NAME -- the real cap the container daemon reports for an
# existing volume NAME (same source `volume list` uses), or empty if it does
# not exist yet or the daemon query failed. The configured
# MACKAS_VOLUME_SIZE_* is only ever what a FUTURE `setup` would request --
# ensure_volume() never resizes an existing volume, so once one exists its
# real cap can permanently diverge from whatever the setting happens to say
# right now (e.g. `setup --tmpdir-size 1T`'s size flags are one-shot and are
# not written to the config file, so the very next invocation reports the
# factory default again). Shared by status_volume()'s per-volume display and
# cmd_status()'s Configuration section, so the two never disagree about the
# same volume.
volume_real_cap() {
	local name="$1"
	# Always returns 0: this only ever PRINTS a cap or prints nothing, it
	# never signals an error. A caller doing `real_cap="$(volume_real_cap ...)"`
	# is a bare, unguarded assignment -- under `set -e` that assignment's own
	# exit status aborts the whole script the instant it is nonzero, which is
	# exactly what "the volume does not exist yet" (the common case) would be
	# without this.
	volume_exists "$name" && volume_size "$name"
	return 0
}

# display_volume_setting NAME CONFIGURED -- what the Configuration section
# should print for a MACKAS_VOLUME_SIZE_* setting: the real cap when NAME
# already exists and differs from CONFIGURED (annotated, so it is clear this
# is not what the config file says), else CONFIGURED as-is.
display_volume_setting() {
	local name="$1" configured="$2" real
	real="$(volume_real_cap "$name")"
	if [ -n "$real" ] && [ "$(size_to_gb "$real")" != "$(size_to_gb "$configured")" ]; then
		printf '%s  (configured: %s -- see "ext4 volumes" below)\n' "$real" "$configured"
	else
		printf '%s\n' "$configured"
	fi
}

status_volume() {
	local name="$1" size="$2" role="$3" img used="" moved="" near_cap=0
	local real_cap="" cap_display="$size"
	img="$CONTAINER_VOLUMES_DIR/$name/volume.img"
	real_cap="$(volume_real_cap "$name")"
	[ -n "$real_cap" ] && cap_display="$real_cap"
	# du -h already reports actual disk BLOCKS allocated (sparse-aware on
	# APFS), not volume.img's logical/apparent size -- this is real usage,
	# not the cap, even when it reads the same as the cap. See the note
	# under "total cap" below for why "on disk" can still climb to the cap:
	# ext4 freeing space inside the guest does not, by itself, punch holes
	# in the host image.
	[ -e "$img" ] && used="$(du -h "$img" 2>/dev/null | awk '{print $1}')"
	if [ -n "$used" ]; then
		local used_gb cap_gb
		used_gb="$(size_to_gb "$used")"
		cap_gb="$(size_to_gb "$cap_display")"
		[ "$cap_gb" -gt 0 ] && [ "$((used_gb * 100 / cap_gb))" -ge 90 ] && near_cap=1
	fi
	# A per-volume symlink here means `volume move` (or `recover`) relocated it;
	# the symlink is the record, so read it straight back.
	[ -L "$CONTAINER_VOLUMES_DIR/$name" ] && moved="$(readlink "$CONTAINER_VOLUMES_DIR/$name")"
	if volume_exists "$name"; then
		printf '  %s[yes]%s %-22s %-22s cap %-5s %s\n' "$C_GRN" "$C_RST" \
			"$name" "$role" "$cap_display" "${used:+on disk: $used}"
	else
		printf '  %s[ no]%s %-22s %-22s cap %-5s (%s setup)\n' "$C_DIM" "$C_RST" \
			"$name" "$role" "$size" "$SCRIPT_NAME"
	fi
	if [ -n "$real_cap" ] && [ "$(size_to_gb "$real_cap")" != "$(size_to_gb "$size")" ]; then
		printf '        %sconfigured size is %s, but setup never resizes an existing volume%s\n' \
			"$C_YEL" "$size" "$C_RST"
	fi
	if [ -n "$moved" ]; then
		printf '        %smoved to: %s%s\n' "$C_BLU" "$moved" "$C_RST"
	fi
	if [ "$near_cap" -eq 1 ]; then
		printf '        %snear cap -- freed ext4 blocks do not shrink volume.img on their own;\n' "$C_YEL"
		printf '        reclaim it: %s volume fstrim %s%s\n' "$SCRIPT_NAME" "$name" "$C_RST"
	fi
}

# status_volume_dirty_bit NAME -- one line, only when volume_dirty_bit says
# NAME's volume.img has ext4 errors on record; silent otherwise (clean, not
# created yet, or the check itself unavailable). Host-side, no daemon --
# see check_volume_dirty_bit's matching comment in check_state().
status_volume_dirty_bit() {
	local name="$1" dbout dbrc=0 detail
	dbout="$(volume_dirty_bit "$name")" || dbrc=$?
	[ "$dbrc" -eq 1 ] || return 0
	detail="${dbout#*"$name/volume.img"}"
	printf '        %sext4 errors recorded on disk%s -- fix: %s volume fsck %s%s\n' \
		"$C_RED" "$detail" "$SCRIPT_NAME" "$name" "$C_RST"
}

status_usage() {
	cat <<EOF
${C_BLD}$SCRIPT_CMD status${C_RST} -- show what is configured and what exists on disk.

${C_BLD}USAGE${C_RST}
  $SCRIPT_CMD status

Read-only, like check, but reports state rather than grading it: every
resolved setting and where it came from, derived paths, whether env.sh/
kas-container/the project checkout/gitconfig exist, the container runtime's
own state, the three ext4 volumes (cap vs. real on-disk cost, and a reclaim
hint when one is near its cap), free disk space, and recent logs/artifacts.

Options: --dry-run, -y/--yes (or -f/--force) and -v/--verbose work here too,
though status reads only and never prompts, so none of them change anything.
EOF
}

# status_project_volume_note -- the #77 "precedence-and-warn" note: when a
# project is selected and an explicit volume-name setting (MACKAS_VOLUME_NAME
# and/or the M1 MACKAS_VOLUME_DL_NAME/_SSTATE_NAME overrides) disagrees with
# what the selector would have derived on its own, say so.
#
# Deliberately a plain VALUE comparison -- the three resolved MACKAS_VOL_*
# names against the mackas-<name>-* triple the selector alone would produce
# -- rather than re-deriving from setting_is_explicit()/config_pinned_setting.
# The two always agree by construction: derive_volume_names() already applies
# that exact default whenever nothing pinned MACKAS_VOLUME_NAME, so a
# disagreement here can ONLY mean something above the defaults rung -- config
# file, environment, or --set -- set an explicit value. Comparing values
# needs no provenance flag at all, so it cannot be fooled by the same
# factory-default-collision gap config_pinned_setting() exists to work around
# (see its own comment) -- it is simply never exposed to that question here.
#
# "Once" is per invocation: mackas is a short-lived process with no state
# file to remember having already said something, so this prints at most
# once, and only from `status` (#77 requires status; a note on every command
# would be noise on every build).
#
# Deliberately informational, never phrased as an error or a suggestion to
# change anything: migration path B of #72 (explicit MACKAS_VOLUME_NAME=
# oe-build, no data moves) is a fully supported, deliberate end state, and a
# user who chose it on purpose must not read this as having done something
# wrong.
status_project_volume_note() {
	[ -n "$PROJECT_SELECTED" ] || return 0
	local d_tmp d_dl d_sstate
	d_tmp="mackas-$PROJECT_SELECTED-tmp"
	d_dl="mackas-$PROJECT_SELECTED-dl"
	d_sstate="mackas-$PROJECT_SELECTED-sstate"
	if [ "$MACKAS_VOL_TMP" = "$d_tmp" ] && [ "$MACKAS_VOL_DL" = "$d_dl" ] \
	   && [ "$MACKAS_VOL_SSTATE" = "$d_sstate" ]; then
		return 0
	fi
	info ""
	info "  note: an explicit volume name is set for '$PROJECT_SELECTED', and it is"
	info "  being honoured -- this is not an error; keeping a different stem (e.g."
	info "  oe-build-*, with no data move) is a fully supported choice."
	[ "$MACKAS_VOL_TMP" = "$d_tmp" ] \
		|| info "    tmp     set: $MACKAS_VOL_TMP   (--project $PROJECT_SELECTED would derive: $d_tmp)"
	[ "$MACKAS_VOL_DL" = "$d_dl" ] \
		|| info "    dl      set: $MACKAS_VOL_DL   (--project $PROJECT_SELECTED would derive: $d_dl)"
	[ "$MACKAS_VOL_SSTATE" = "$d_sstate" ] \
		|| info "    sstate  set: $MACKAS_VOL_SSTATE   (--project $PROJECT_SELECTED would derive: $d_sstate)"
}

cmd_status() {
	hdr "Configuration"
	show "config file"        "${CONFIG_FILE_USED:-<none: built-in defaults>}"
	# Only when one was selected: the selector is not a setting (it chooses
	# the file, it is not read out of one), so the loop below never shows it.
	if [ -n "$PROJECT_SELECTED" ]; then
		show "project selected"   "$PROJECT_SELECTED"
		status_project_volume_note
	fi
	local n
	for n in $SETTING_NAMES; do
		# The three volume sizes: show the REAL cap once a volume already
		# exists (ensure_volume() never resizes one), not the configured
		# value alone -- otherwise this section and "ext4 volumes" below
		# disagree about the same volume, which is exactly the confusing
		# state a live report surfaced (Configuration said 120G, "ext4
		# volumes" said cap 1T, for the same MACKAS_VOLUME_SIZE_TMP).
		case "$n" in
			MACKAS_VOLUME_SIZE_TMP)
				show "$n" "$(display_volume_setting "$MACKAS_VOL_TMP" "$MACKAS_VOLUME_SIZE_TMP")" ;;
			MACKAS_VOLUME_SIZE_DL)
				show "$n" "$(display_volume_setting "$MACKAS_VOL_DL" "$MACKAS_VOLUME_SIZE_DL")" ;;
			MACKAS_VOLUME_SIZE_SSTATE)
				show "$n" "$(display_volume_setting "$MACKAS_VOL_SSTATE" "$MACKAS_VOLUME_SIZE_SSTATE")" ;;
			*)
				eval "show \"\$n\" \"\${$n}\"" ;;
		esac
	done

	# status never dies on a missing root -- it is the command you run to find
	# out that it is missing -- but it must not let a blank line be the only
	# clue either.
	if [ -z "$MACKAS_ROOT" ]; then
		hdr "MACKAS_ROOT is not set"
		info "  Commands fall back to the current directory (with a warning). There is"
		info "  no baked-in default because OE needs a case-sensitive filesystem and a"
		info "  stock Mac's home is case-insensitive APFS; the derived paths below stay"
		info "  empty until you set it. For a real build point it at a proper volume:"
		root_hint | sed 's/^/  /'
	fi

	hdr "Derived paths"
	show "MACKAS_BASE (in use)"   "$MACKAS_BASE"
	show "kas work dir"       "$MACKAS_WORK"
	show "project checkout"   "$MACKAS_PROJECT"
	show "kas files"          "$KAS_FILES_ARG"
	show "env.sh"             "$MACKAS_ENV_SH"
	show "shim"               "$SHIM_DIR/docker"

	hdr "Present?"
	local p
	for p in "$MACKAS_ROOT" "$MACKAS_SHORT_LINK" "$MACKAS_ENV_SH" "$KAS_CONTAINER_BIN" \
	         "$KAS_CONTAINER_REAL" "$SHIM_DIR/docker" "$MACKAS_PROJECT" \
	         "$MACKAS_KAS_FRAGMENT_SRC" "$MACKAS_KAS_FRAGMENT_REPO"; do
		if [ -e "$p" ]; then
			printf '  %s[yes]%s %s\n' "$C_GRN" "$C_RST" "$p"
		else
			printf '  %s[ no]%s %s\n' "$C_DIM" "$C_RST" "$p"
		fi
	done

	hdr "Runtime"
	if container_running; then
		show "container system" "running"
	else
		show "container system" "NOT running  (container system start)"
	fi
	if image_present "$KAS_IMAGE"; then show "image" "$KAS_IMAGE present"
	else show "image" "$KAS_IMAGE NOT pulled  ($SCRIPT_CMD setup)"; fi
	# Not `$(resolved_docker || echo '<none>')`: resolved_docker ends in
	# `|| true`, so it always exits 0 and that fallback could never fire --
	# a missing docker printed an empty line instead. The emptiness of the
	# output is the signal, not the exit status.
	local docker_path
	docker_path="$(resolved_docker)"
	show "docker resolves to"  "${docker_path:-<none>}"

	# Only when one is configured: on a properly case-sensitive root there is
	# no image and a permanent "workspace image: none" line would be noise.
	# "attached?" is the whole point of the section -- it is the one piece of
	# state here that a reboot silently changes, and "it worked yesterday" is
	# almost always this.
	if [ -n "${MACKAS_WORKSPACE_IMAGE:-}" ]; then
		hdr "Workspace image (work/)"
		show "image" "$MACKAS_WORKSPACE_IMAGE"
		if [ ! -f "$MACKAS_WORKSPACE_IMAGE" ]; then
			show "attached" "NO -- the image file itself is missing ($SCRIPT_CMD check explains)"
		else
			# du -h reports actual disk blocks allocated (sparse-aware on APFS),
			# the same idiom status_volume() uses for the ext4 volumes -- real
			# usage, not the image's logical/configured size.
			local wsize
			wsize="$(du -h "$MACKAS_WORKSPACE_IMAGE" 2>/dev/null | awk '{print $1}')"
			[ -n "$wsize" ] && show "on disk" "$wsize"
			local wst
			set +e; workspace_is_attached; wst=$?; set -e
			case "$wst" in
				0) show "attached" "yes: $MACKAS_ROOT/work -> $(readlink "$MACKAS_ROOT/work" 2>/dev/null)" ;;
				2) show "attached" "NO -- a DIFFERENT filesystem is mounted at $MACKAS_ROOT/work" ;;
				*) show "attached" "no  (a reboot unmounts it; '$SCRIPT_CMD setup' or any build reattaches)" ;;
			esac
		fi
		info ""
		info "  work/ holds the layer checkouts. They are git repos with real remotes,"
		info "  so 'git push' is the backup story -- the image is one file with none."
		workspace_unpushed_work_line
	fi

	hdr "ext4 volumes"
	# status_volume()'s [yes]/[ no] and the legacy-volume line both ask the
	# daemon (volume_exists -> 'container volume ls'), which returns nothing
	# when it's not running -- every volume used to print [ no] for state
	# that is actually fine, just unreachable (issue #33; see "Runtime"
	# above for the one line that already says so).
	if ! container_running; then
		info "  container system is not running -- volume existence cannot be checked"
		info "  this way; everything below is UNKNOWN, not necessarily absent"
	else
		status_volume "$MACKAS_VOL_TMP"    "$MACKAS_VOLUME_SIZE_TMP"    "/build      TMPDIR"
		status_volume "$MACKAS_VOL_DL"     "$MACKAS_VOLUME_SIZE_DL"     "/downloads  DL_DIR"
		status_volume "$MACKAS_VOL_SSTATE" "$MACKAS_VOLUME_SIZE_SSTATE" "/sstate     SSTATE_DIR"
		if volume_exists "$MACKAS_VOL_LEGACY"; then
			printf '  %s[old]%s %-22s unused leftover of the single-volume scheme\n' \
				"$C_YEL" "$C_RST" "$MACKAS_VOL_LEGACY"
			printf '        %sremove with: container volume delete %s%s\n' \
				"$C_BLU" "$(printf '%q' "$MACKAS_VOL_LEGACY")" "$C_RST"
		fi
	fi
	# Host-side, no daemon needed (see status_volume_dirty_bit's own
	# comment) -- runs regardless of container_running above.
	status_volume_dirty_bit "$MACKAS_VOL_TMP"
	status_volume_dirty_bit "$MACKAS_VOL_DL"
	status_volume_dirty_bit "$MACKAS_VOL_SSTATE"
	show "total cap" "$(status_total_cap_gb) GiB (sparse: costs only what is used)"
	info ""
	info "  \"on disk\" is REAL usage (du, sparse-aware), never the cap. It only"
	info "  drops after an explicit fstrim hole-punches freed ext4 blocks back out"
	info "  of the host image -- ext4 freeing space inside the guest does not do"
	info "  that by itself. '$SCRIPT_CMD volume fstrim <name>|all' reclaims it."
	info ""
	info "  Their contents are NOT visible on the host -- they are ext4 images. To"
	info "  look inside: $SCRIPT_CMD shell"

	hdr "Effective kas --runtime-args"
	printf '  %s\n' "$(kas_runtime_args)"

	if [ -d "$MACKAS_ROOT" ]; then
		hdr "Disk"
		show "free on target" "$(free_gb_for "$MACKAS_ROOT") GiB"
		show "MACKAS_ROOT size"   "$(du -sh "$MACKAS_ROOT" 2>/dev/null | awk '{print $1}')"
	fi

	if [ -d "$MACKAS_LOGS" ]; then
		hdr "Recent logs"
		# shellcheck disable=SC2012  # our own log filenames, all well-behaved
		ls -t "$MACKAS_LOGS" 2>/dev/null | head -5 | sed 's/^/  /'
	fi

	if [ -n "$MACKAS_BASE" ]; then
		hdr "Artifacts"
		local artdir="$MACKAS_BASE/artifacts"
		if [ -d "$artdir" ]; then
			show "buildstats dest" "$artdir"
			# shellcheck disable=SC2012  # our own dir names, all well-behaved
			ls -1 "$artdir" 2>/dev/null | head -5 | sed 's/^/    /'
		else
			show "buildstats dest" "$artdir (empty; run '$SCRIPT_CMD retrieve buildstats')"
		fi
		info ""
		info "  The volumes' tmp/{buildstats,log,deploy} are not visible on the host."
		info "  Copy them out with: $SCRIPT_CMD retrieve buildstats [logs] [deploy]"
	fi
}

clean_usage() {
	cat <<EOF
${C_BLD}$SCRIPT_CMD clean${C_RST} -- drop the TMPDIR volume (recreated empty), or one
narrower target at a time. Never touches \$MACKAS_ROOT or the short symlink --
for that, see '$SCRIPT_CMD destroy'.

${C_BLD}USAGE${C_RST}
  $SCRIPT_CMD clean [TARGET...]

Bare '$SCRIPT_CMD clean' (no target) deletes and recreates the WHOLE TMPDIR
volume ('$MACKAS_VOL_TMP') and clears \$MACKAS_LOGS. That drops everything
under TOPDIR, not just tmp/: deploy, buildhistory (if the project inherits
it), conf/ and cache/ all go too. DL_DIR and SSTATE_DIR are never touched --
having them in separate volumes is exactly why this works. Only prompts once
(no typed confirmation word, unlike '$SCRIPT_CMD destroy').

${C_BLD}TARGETS${C_RST} (optional, repeatable, order does not matter)
  tmp+deploy   Clear TMPDIR and DEPLOY_DIR in place, WITHOUT deleting or
               recreating the TMPDIR volume -- keeps buildhistory and conf/,
               which bare '$SCRIPT_CMD clean' drops. TMPDIR and DEPLOY_DIR are
               always cleared TOGETHER: bitbake's stamps (under TMPDIR) record
               which tasks already wrote DEPLOY_DIR, so clearing either one
               alone leaves the other inconsistent with it -- there is no
               'deploy only' or 'tmp only' target. SSTATE_DIR survives, so
               the next build refills both cheaply -- but largely by
               RESTORING the same cached artifacts, not recompiling; to force
               a genuinely fresh rebuild of something, use '$SCRIPT_CMD shell'
               and e.g. 'bitbake -f -c deploy <recipe>'. Slower than bare
               clean (an in-place rm, not a volume swap), so it also fstrims
               TMPDIR afterward to reclaim the freed host disk that an
               in-place rm alone would not (MACKAS_FSTRIM_AUTO=0 skips this).
  downloads    Delete and recreate the DL_DIR volume ('$MACKAS_VOL_DL').
               Independent of tmp/deploy/sstate -- fetched sources have no
               stamp relationship to them. Cheap to refill if an HTTP/NFS
               mirror is configured; otherwise everything is re-fetched over
               the network.
  sstate       Delete and recreate the SSTATE_DIR volume ('$MACKAS_VOL_SSTATE')
               -- a full wipe. For age-based partial cleanup instead, see
               '$SCRIPT_CMD sstate prune --older-than N[d]'.

Options: --dry-run, -y/--yes (or -f/--force) and -v/--verbose work here too;
put them before or after 'clean', e.g. '$SCRIPT_CMD --dry-run clean downloads'.

${C_BLD}PATH RESOLUTION (tmp+deploy)${C_RST}
  tmp+deploy resolves the real TMPDIR/DEPLOY_DIR from bitbake instead of
  assuming the OE-core default layout -- a distro conf may set DEPLOY_DIR to
  any path, e.g. a sibling of tmp/ rather than inside it. That resolution
  needs \$MACKAS_PROJECT_DIR and \$MACKAS_KAS_CONFIG set -- in the config
  file, or exported in this shell:
    export MACKAS_PROJECT_DIR=<checkout under work/>
    export MACKAS_KAS_CONFIG=<its kas files>
  If bitbake-getvar still fails with those set, tmp+deploy REFUSES rather
  than guessing a path it is about to rm -rf (see '$SCRIPT_CMD status'/
  'check') -- deliberate: a guessed path can only be right by luck or a
  silent no-op reported as success. downloads/sstate are unaffected --
  whole-volume operations, no bitbake variable resolution involved. A
  sourced env.sh can derive both automatically from a hand-typed
  'kas-container build/shell <files>', but only for that one shell
  session, never across a piped invocation.

${C_BLD}ONE-VM RULE${C_RST}
  Only one VM may access an ext4 image at a time. Each target refuses while a
  running build (smoketest/shell) still holds the volume it needs -- stop it
  first.
EOF
}

runtime_args_usage() {
	cat <<EOF
${C_BLD}$SCRIPT_CMD runtime-args${C_RST} -- plumbing. Prints the \`--runtime-args\` string
a build right now would use (CPU/memory limits, the three ext4 volume
mounts, mirror mounts if enabled, the live-progress-bridge args if
MACKAS_MONITOR=1) and nothing else.

${C_BLD}USAGE${C_RST}
  $SCRIPT_CMD runtime-args [--require-volumes-free] [--expect-work DIR]

Not something you normally run directly: the generated \`kas-container\`
wrapper calls this itself, once per invocation, so a setting that
affects the build (MACKAS_MONITOR, a volume-name override, ...) takes
effect on a hand-typed \`kas-container build/shell <files>\` the same way it
already does for '$SCRIPT_CMD smoketest'/'shell' -- not just after the next
'$SCRIPT_CMD setup'. Exists so that fact has one implementation instead of
being copied into the generated wrapper.

${C_BLD}--expect-work DIR${C_RST} refuses when the config in effect resolves a
different work directory than DIR. The wrapper passes the MACKAS_WORK it
was generated with: volumes are recomputed live while work dir, image and
gitconfig stay frozen in it, so a config naming another root would mount
another project's ext4 volumes under this project's sources. Comparing
identities rather than freezing the config path keeps an ambient
\$MACKAS_CONF usable whenever it agrees, and refuses only when it does not.

${C_BLD}--require-volumes-free${C_RST} applies the one-VM rule first and prints nothing
if it fails: refuse, naming the volume, when a running container already
holds one of the three ext4 volumes this string attaches. The wrapper
passes it on every call, so a hand-typed \`kas-container build\` while a
build is running is refused exactly as '$SCRIPT_CMD shell' would be.

Options: --dry-run, -y/--yes (or -f/--force) and -v/--verbose are accepted
but change nothing here -- there is nothing to confirm and nothing dry-run
would print differently.
EOF
}

destroy_usage() {
	cat <<EOF
${C_BLD}$SCRIPT_CMD destroy${C_RST} -- remove all four volumes (the three active ones
plus a rarely-present legacy one), \$MACKAS_ROOT and the short symlink.

${C_BLD}USAGE${C_RST}
  $SCRIPT_CMD destroy

The widest-blast-radius command mackas has: every ext4 volume, the project
checkout, logs and artifacts under \$MACKAS_ROOT, and the \$MACKAS_SHORT_LINK
symlink, all gone. Refuses to remove \$MACKAS_ROOT if any volume survives
deletion (e.g. still in use), so a partial failure never silently drops the
checkout while leaving orphaned volumes behind.

For a narrower reset, see '$SCRIPT_CMD clean' (the whole TMPDIR volume),
'$SCRIPT_CMD clean tmp+deploy|downloads|sstate' (one thing at a time), or
'$SCRIPT_CMD volume destroy --all' (every volume, but not \$MACKAS_ROOT).

Requires typing the word DESTROY to confirm, unless -y/--yes/-f/--force is
given (required for non-interactive use). --dry-run and -v/--verbose also
work here.
EOF
}

# cmd_runtime_args -- print kas_runtime_args()'s current value, stdout only,
# nothing else. The generated kas-container wrapper shells out to this per
# call (see write_kas_wrapper) instead of freezing the string at 'setup' time,
# so a setting kas_runtime_args() reads (MACKAS_MONITOR, MACKAS_USE_NFS_MIRRORS,
# a volume-name override) reaches a hand-typed kas-container call the same way
# it already reaches run_kas() -- one implementation, not two copies that can
# drift (see issue #25: the frozen copy is exactly how MACKAS_MONITOR=1
# silently never took effect for a hand-typed build).
#
# --require-volumes-free adds run_kas()'s one-VM guard to that same call
# (issue #96). It lives HERE, rather than being reimplemented in POSIX sh
# inside the generated wrapper, for the reason above -- one implementation of
# volume_in_use() -- and it rides on the runtime-args call rather than a
# second subprocess so the names checked are, by construction, exactly the
# names that call is about to hand kas-container. Ordering matches run_kas():
# the wrapper starts the container runtime before it gets here, because
# volume_in_use() short-circuits to "not in use" with the daemon down.
cmd_runtime_args() {
	local want_help=0 require_free=0 expect_work=""
	while [ "$#" -gt 0 ]; do
		case "$1" in
			-h|--help|help) want_help=1; shift ;;
			--require-volumes-free) require_free=1; shift ;;
			--expect-work) expect_work="${2:-}"; [ -n "$expect_work" ] || die "--expect-work needs a DIR"; shift 2 ;;
			--expect-work=*) expect_work="${1#*=}"; [ -n "$expect_work" ] || die "--expect-work needs a DIR"; shift ;;
			--dry-run) DRY_RUN=1; shift ;;
			-y|-f|--yes|--force) ASSUME_YES=1; shift ;;
			-v|--verbose) VERBOSE=1; shift ;;
			--version) echo "$SCRIPT_NAME $SCRIPT_VERSION"; exit 0 ;;
			--config|--config=*|--project|--project=*|--set|--set=*) die_on_misplaced_global_flag "$1" runtime-args ;;
			-*) die "unknown option for 'runtime-args': $1" "$SCRIPT_CMD runtime-args --help" ;;
			*) die "unexpected argument for 'runtime-args': $1" "$SCRIPT_CMD runtime-args --help" ;;
		esac
	done

	if [ "$want_help" -eq 1 ]; then
		runtime_args_usage
		return 0
	fi

	# The generated wrapper passes the MACKAS_WORK it was built with. Volumes
	# are recomputed live (so `mackas set` takes effect without regenerating
	# the wrapper) while work dir, image and gitconfig stay frozen in it -- so
	# a config that resolves a DIFFERENT root would hand this build another
	# project's ext4 volumes while its sources and gitconfig stay put. Compare
	# identities rather than freezing the config path into the wrapper: an
	# ambient $MACKAS_CONF keeps working whenever it is consistent, and is
	# refused only when it actually disagrees.
	if [ -n "$expect_work" ] && [ "$expect_work" != "$MACKAS_WORK" ]; then
		die "this wrapper was generated for a different configuration" \
			"$(wrapper_identity_hint "$expect_work")"
	fi

	# Before printing, never after: a caller that refuses on a held volume must
	# get nothing on stdout to accidentally use.
	if [ "$require_free" -eq 1 ]; then
		require_volumes_free "kas-container ..."
	fi

	printf '%s\n' "$(kas_runtime_args)"
}

cmd_destroy() {
	require_mackas_root
	local what="EVERYTHING: all three ext4 volumes ($MACKAS_VOL_TMP, $MACKAS_VOL_DL,
  $MACKAS_VOL_SSTATE -- so downloads and sstate too), $MACKAS_ROOT (the project
  checkout and logs), and the $MACKAS_SHORT_LINK symlink"

	printf '\n%s%s WARNING %s\n' "$C_RED$C_BLD" "===" "===$C_RST"
	printf '%sThis will PERMANENTLY DELETE %s%s\n\n' "$C_RED" "$what" "$C_RST"

	# du fails if MACKAS_ROOT is already gone; pipefail would make the bare
	# assignment abort the whole script under set -e.
	local sz=""
	sz="$(du -sh "$MACKAS_ROOT" 2>/dev/null | awk '{print $1}' || true)"
	if [ -n "$sz" ]; then
		printf '%s%s currently holds %s.%s\n\n' "$C_RED" "$MACKAS_ROOT" "$sz" "$C_RST"
	fi
	if [ "$DRY_RUN" -eq 1 ]; then
		warn "--dry-run: skipping the DESTROY confirmation; nothing will be removed."
	elif [ "$ASSUME_YES" -ne 1 ]; then
		if [ ! -t 0 ]; then
			die "destroy needs a terminal or --yes" "$SCRIPT_CMD destroy --yes"
		fi
		printf '%sType the word DESTROY to confirm: %s' "$C_BLD" "$C_RST"
		local reply=""
		read -r reply || true
		[ "$reply" = "DESTROY" ] || { info "Aborted. Nothing was removed."; return 1; }
	fi

	# Delete every volume FIRST and tally the survivors, BEFORE touching the
	# symlink or rm -rf-ing anything. Order is the whole fix: with
	# MACKAS_RELOCATE_VOLUMES=1 the volumes' LIVE backing images sit inside
	# $MACKAS_ROOT/container-volumes, so removing the symlink and then
	# rm -rf $MACKAS_ROOT while a volume refused to delete would erase that
	# volume's image out from under a possibly-running VM -- and take any
	# unrelated foreign volumes with it. So a survivor aborts here, before
	# any of that runs.
	local v survivors=0
	for v in "$MACKAS_VOL_TMP" "$MACKAS_VOL_DL" "$MACKAS_VOL_SSTATE" "$MACKAS_VOL_LEGACY"; do
		delete_volume "$v" || survivors=$((survivors + 1))
	done
	if [ "$survivors" -ne 0 ]; then
		err "$survivors volume(s) could NOT be removed (see the warnings above)"
		die "destroy did not finish: some volumes survive -- refusing to remove $MACKAS_ROOT" \
			"container volume ls   -- then stop whatever is using them and re-run"
	fi

	# All our volumes are gone. If setup relocated the container volumes dir
	# onto the SSD, its REAL directory is $MACKAS_ROOT/container-volumes and
	# may STILL hold FOREIGN volumes that setup_relocate_volumes rsync'd in
	# from the internal disk. Move whatever remains back to the internal disk
	# before removing the symlink or $MACKAS_ROOT -- rm -rf must never take a
	# volume we did not create. This is the exact inverse of setup's move.
	if [ -L "$CONTAINER_VOLUMES_DIR" ]; then
		local reloc leftover=0
		reloc="$(readlink "$CONTAINER_VOLUMES_DIR")"
		if [ -d "$reloc" ]; then
			# shellcheck disable=SC2012  # counting entries; names irrelevant
			leftover="$(ls -A "$reloc" 2>/dev/null | wc -l | tr -d ' ')"
		fi
		run rm -f "$CONTAINER_VOLUMES_DIR"
		if [ "$leftover" -gt 0 ]; then
			run mv "$reloc" "$CONTAINER_VOLUMES_DIR"
			did "moved $leftover foreign volume(s) back to $CONTAINER_VOLUMES_DIR"
		else
			run mkdir -p "$CONTAINER_VOLUMES_DIR"
			did "restored $CONTAINER_VOLUMES_DIR to a real directory"
		fi
	fi
	if [ -L "$MACKAS_SHORT_LINK" ]; then
		run rm -f "$MACKAS_SHORT_LINK"
	fi
	# Delete through the REAL path, never through the symlink.
	if [ -d "$MACKAS_ROOT" ]; then
		run rm -rf "$MACKAS_ROOT"
		did "destroyed $MACKAS_ROOT"
	else
		did "$MACKAS_ROOT was already gone"
	fi
}

# clean_tmpdir_volume -- bare 'mackas clean' (no target): delete and recreate
# the WHOLE TMPDIR volume. Unchanged from before targeted cleans existed --
# see cmd_clean for how a target list routes elsewhere instead.
clean_tmpdir_volume() {
	local what="the TMPDIR volume '$MACKAS_VOL_TMP' (recreated empty) and $MACKAS_LOGS
  (the '$MACKAS_VOL_DL' and '$MACKAS_VOL_SSTATE' cache volumes and the project
  checkout are KEPT -- having them in separate volumes is exactly why this works)"

	printf '\n%s%s WARNING %s\n' "$C_RED$C_BLD" "===" "===$C_RST"
	printf '%sThis will PERMANENTLY DELETE %s%s\n\n' "$C_RED" "$what" "$C_RST"

	confirm "Proceed?" || { info "Aborted. Nothing was removed."; return 1; }

	# TMPDIR is a whole volume, so cleaning it is delete + recreate rather
	# than rm -rf: it is faster, it cannot leave a half-deleted tree behind,
	# and it hands back the sparse image's disk space in one go. The dl and
	# sstate volumes are never touched here -- that is the entire reason
	# they are separate volumes.
	#
	# Bail out rather than fall through to ensure_volume if the delete
	# failed: ensure_volume would find the volume still present, skip
	# creating it, and `clean` would report a cleaned TMPDIR over the old
	# contents, still there.
	if volume_exists "$MACKAS_VOL_TMP"; then
		delete_volume "$MACKAS_VOL_TMP" || \
			die "cannot clean TMPDIR: volume '$MACKAS_VOL_TMP' could not be removed" \
				"stop anything still using it (mackas volume list) and re-run '$SCRIPT_CMD clean'"
	fi
	ensure_volume "$MACKAS_VOL_TMP" "$MACKAS_VOLUME_SIZE_TMP" "TMPDIR -> /build"
	if [ -d "$MACKAS_LOGS" ]; then
		run rm -rf "$MACKAS_LOGS"; run mkdir -p "$MACKAS_LOGS"
	fi
	did "cleaned TMPDIR; '$MACKAS_VOL_DL' and '$MACKAS_VOL_SSTATE' kept"
}

# die_unresolved_guest_var VAR -- clean_tmp_deploy() is about to rm -rf a path
# resolved by bitbake-getvar, so a failed resolution is hard-failed here
# rather than handled with this codebase's usual confirm()-gated automated
# fix: there is nothing safe to offer instead. 'clean' has no file list of its
# own to derive MACKAS_PROJECT_DIR/MACKAS_KAS_CONFIG from the way the
# kas-container wrapper's _mackas_derive_project does, and a guessed path
# feeding an in-place rm -rf can only be right by luck or a silent no-op
# reported as success -- exactly the incident this replaces (see
# clean_tmp_deploy's own comment above the two bitbake_getvar calls).
die_unresolved_guest_var() {
	local var="$1" hint
	if [ -z "$MACKAS_PROJECT_DIR" ]; then
		hint="no project is configured -- export MACKAS_PROJECT_DIR=<checkout under work/> and export MACKAS_KAS_CONFIG=<its kas files>"
	else
		hint="the bitbake-getvar query itself failed; see the warning above -- $SCRIPT_CMD status"
	fi
	die "$var could not be resolved via bitbake-getvar; clean tmp+deploy will not guess a path it is about to rm -rf" "$hint"
}

# refuse_unsafe_guest_path PATH LABEL -- die unless PATH is strictly under
# /build with no '..' component. Guards clean_tmp_deploy()'s in-place `rm -rf`
# against a bitbake-getvar answer this throwaway container cannot safely act
# on: only /build (the TMPDIR volume) is mounted there, so a PATH outside it
# would either no-op against the container's own rootfs or, if it happened to
# exist there for some other reason, delete the wrong thing. LABEL is the
# variable name, purely for the message.
refuse_unsafe_guest_path() {
	local path="$1" label="$2"
	case "$path" in
		/build/?*)
			case "$path" in
				*..*) ;;
				*) return 0 ;;
			esac
			;;
	esac
	die "$label resolved to '${path:-<empty>}', which is not safely under /build -- refusing to rm it" \
		"only /build (the TMPDIR volume) is mounted here; inspect the real value with '$SCRIPT_CMD shell'"
}

# clean_tmp_deploy -- clear TMPDIR and DEPLOY_DIR in place, inside the live
# oe-build-tmp volume, WITHOUT deleting or recreating the volume itself (so
# /build/buildhistory and /build/conf, which bare 'clean' drops along with
# everything else under TOPDIR, survive here).
#
# The two are cleared TOGETHER, unconditionally, with no way to ask for just
# one: bitbake's stamps live under TMPDIR and record which tasks already
# wrote DEPLOY_DIR. Dropping TMPDIR alone would leave DEPLOY_DIR holding
# output from a task graph that no longer exists, with nothing to say those
# images are now stale; dropping DEPLOY_DIR alone leaves the stamps claiming
# those tasks already ran, so the next build silently will not regenerate it
# without being forced. Either half alone is the inconsistent state, not a
# narrower version of this target.
#
# No mkdir+chown after the rm, unlike a fresh 'container volume create': only
# the two resolved subdirectories are removed, never /build itself, so /build
# keeps the ownership ensure_volume() already gave it and bitbake's own next
# mkdir under it (running as that same uid) is correctly owned without help
# -- see check_buildstats_accumulation() for the same reasoning applied to one
# buildstats subdirectory.
clean_tmp_deploy() {
	# One-VM rule: bitbake_getvar() goes through kas_shell_ro(), which attaches
	# ALL THREE volumes via kas_runtime_args() -- not just TMPDIR -- so all
	# three must be checked, same as cmd_exec/kas_project_subcommand_preflight.
	require_volumes_free "$SCRIPT_CMD clean tmp+deploy"
	if ! volume_exists "$MACKAS_VOL_TMP"; then
		info "Nothing to clean -- '$MACKAS_VOL_TMP' does not exist yet ($SCRIPT_CMD setup)"
		return 0
	fi

	local tmpdir deploydir
	tmpdir="$(bitbake_getvar TMPDIR)" || die_unresolved_guest_var TMPDIR
	deploydir="$(bitbake_getvar DEPLOY_DIR)" || die_unresolved_guest_var DEPLOY_DIR
	refuse_unsafe_guest_path "$tmpdir" TMPDIR
	refuse_unsafe_guest_path "$deploydir" DEPLOY_DIR

	# Always runs for real, dry-run or not -- a read-only probe, same
	# reasoning as sstate_prune's scan: "nothing to clean" needs the REAL
	# state, not --dry-run's assumed yes. One container run reports BOTH
	# paths' existence as stdout tokens (sstate_prune's scan idiom) rather
	# than an OR'd exit status, so a lone survivor can be reported honestly
	# below instead of folded into a blanket "cleared both". The trailing
	# `exit 0` keeps a genuinely-absent path (a false `[ -d ] && echo`) from
	# making the whole probe look like it failed.
	local present have_tmpdir have_deploydir
	present="$(container run --rm -u 0:0 -v "$MACKAS_VOL_TMP:/build" "$KAS_IMAGE" \
		sh -c "[ -d $(printf '%q' "$tmpdir") ] && echo TMPDIR; [ -d $(printf '%q' "$deploydir") ] && echo DEPLOY_DIR; exit 0" 2>/dev/null)" || present=""
	if printf '%s\n' "$present" | grep -qxF TMPDIR; then have_tmpdir="yes"; else have_tmpdir="no"; fi
	if printf '%s\n' "$present" | grep -qxF DEPLOY_DIR; then have_deploydir="yes"; else have_deploydir="no"; fi

	if [ "$have_tmpdir" = "no" ] && [ "$have_deploydir" = "no" ]; then
		info "Nothing to clean -- neither $tmpdir nor $deploydir exists yet (has a build run? $SCRIPT_CMD smoketest)"
		return 0
	fi

	confirm "Clear TMPDIR ($tmpdir) and DEPLOY_DIR ($deploydir) in '$MACKAS_VOL_TMP'? They are always cleared together." \
		|| { info "Declined -- nothing cleaned."; return 1; }

	run container run --rm -u 0:0 -v "$MACKAS_VOL_TMP:/build" "$KAS_IMAGE" \
		sh -c "rm -rf $(printf '%q' "$tmpdir") $(printf '%q' "$deploydir")"

	# Report per-path, not a blanket "cleared both": an rm -rf against a path
	# that never existed is a silent no-op, and an earlier version of this
	# message claimed success for a DEPLOY_DIR it never touched (the incident
	# github.com/koenkooi/mackas/issues/30 tracks).
	if [ "$have_tmpdir" = "yes" ] && [ "$have_deploydir" = "yes" ]; then
		did "cleared TMPDIR ($tmpdir) and DEPLOY_DIR ($deploydir) in '$MACKAS_VOL_TMP' -- buildhistory and conf/ untouched"
	elif [ "$have_tmpdir" = "yes" ]; then
		did "cleared TMPDIR ($tmpdir) in '$MACKAS_VOL_TMP'; DEPLOY_DIR ($deploydir) did not exist -- buildhistory and conf/ untouched"
	else
		did "cleared DEPLOY_DIR ($deploydir) in '$MACKAS_VOL_TMP'; TMPDIR ($tmpdir) did not exist -- buildhistory and conf/ untouched"
	fi
	info "  the stamps went with TMPDIR, so the next build re-runs the whole task"
	info "  graph -- SSTATE_DIR survives, so that is mostly cheap sstate restores"
	info "  of the same cached artifacts. For a genuinely fresh rebuild of"
	info "  something, use '$SCRIPT_CMD shell' and e.g. 'bitbake -f -c deploy <recipe>'."

	# Unlike bare 'clean' (a fresh volume.img, already minimal), this rm was
	# IN PLACE -- the freed ext4 blocks stay allocated on the host image until
	# something discards them (see "Reclaiming disk" in docs/storage.md), so
	# this target is exactly the case that needs it. MACKAS_FSTRIM_AUTO is the
	# same knob run_kas() already uses around a build. Best-effort, like
	# run_kas()'s own auto-fstrim: a non-hole-punching host filesystem makes
	# fstrim warn and return nonzero, and `|| true` keeps that from turning an
	# already-successful clean into a failure (from_all=1 likewise downgrades
	# a vanished/busy volume to a warn-and-skip).
	if [ "${MACKAS_FSTRIM_AUTO:-1}" = "1" ]; then
		volume_fstrim_one "$MACKAS_VOL_TMP" 1 || true
	fi
}

# clean_volume_target NAME SIZE ROLE -- delete and recreate ONE whole cache
# volume (DL_DIR or SSTATE_DIR), the same delete+ensure_volume shape bare
# 'clean' already uses for TMPDIR. Unlike clean_tmp_deploy, these two ARE
# independent of each other and of tmp+deploy: fetched sources and sstate
# objects carry no stamp relationship to bitbake's task graph, so either can
# be wiped alone without leaving the other inconsistent.
clean_volume_target() {
	local name="$1" size="$2" role="$3" img used=""
	if volume_in_use "$name"; then
		die "volume '$name' is attached to a running container" \
			"only ONE VM may touch an ext4 image at a time; stop the build first (mackas volume list), then re-run '$SCRIPT_CMD clean'"
	fi
	if ! volume_exists "$name"; then
		info "Nothing to clean -- '$name' does not exist yet ($SCRIPT_CMD setup)"
		return 0
	fi
	img="$CONTAINER_VOLUMES_DIR/$name/volume.img"
	used="$(volume_img_kb "$img")"
	confirm "Delete and recreate '$name' ($role)${used:+, currently $(fmt_kb "$used")}?" \
		|| { info "Declined -- nothing cleaned."; return 1; }
	delete_volume "$name" || die "cannot clean '$name': it could not be removed" \
		"stop anything still using it (mackas volume list) and re-run"
	ensure_volume "$name" "$size" "$role"
	did "cleaned '$name' ($role)"
}

# cmd_clean [TARGET...] -- no target: today's whole-TMPDIR-volume clean,
# unchanged. One or more of tmp+deploy/downloads/sstate: only that narrower
# slice, each independently confirmed. See clean_usage for what each does.
cmd_clean() {
	local targets=() want_help=0
	while [ $# -gt 0 ]; do
		case "$1" in
			--dry-run)     DRY_RUN=1; shift ;;
			-y|-f|--yes|--force)  ASSUME_YES=1; shift ;;
			-v|--verbose)  VERBOSE=1; shift ;;
			-h|--help)     want_help=1; shift ;;
			help)          want_help=1; shift ;;
			--version)     echo "$SCRIPT_NAME $SCRIPT_VERSION"; exit 0 ;;
			--config|--config=*|--project|--project=*|--set|--set=*) die_on_misplaced_global_flag "$1" clean ;;
			tmp+deploy|downloads|sstate) targets+=("$1"); shift ;;
			-*) die "unknown option for 'clean': $1" "$SCRIPT_CMD clean --help" ;;
			*) die "unknown target for 'clean': $1" \
				"$SCRIPT_CMD clean --help  (targets: tmp+deploy downloads sstate)" ;;
		esac
	done

	if [ "$want_help" -eq 1 ]; then
		clean_usage
		return 0
	fi

	require_mackas_root

	if [ "${#targets[@]}" -eq 0 ]; then
		clean_tmpdir_volume
		return $?
	fi

	local t rc=0
	for t in "${targets[@]}"; do
		case "$t" in
			tmp+deploy)
				clean_tmp_deploy || rc=1 ;;
			downloads)
				if [ "$MACKAS_USE_HTTP_MIRRORS" = "1" ] || [ "$MACKAS_USE_NFS_MIRRORS" = "1" ]; then
					info "  a mirror is configured, so re-fetching is cheap"
				else
					info "  no mirror configured -- everything will be re-fetched over the network"
				fi
				clean_volume_target "$MACKAS_VOL_DL" "$MACKAS_VOLUME_SIZE_DL" "DL_DIR -> /downloads" || rc=1 ;;
			sstate)
				info "  for age-based partial cleanup instead, see '$SCRIPT_CMD sstate prune --older-than N[d]'"
				clean_volume_target "$MACKAS_VOL_SSTATE" "$MACKAS_VOLUME_SIZE_SSTATE" "SSTATE_DIR -> /sstate" || rc=1 ;;
		esac
	done
	return "$rc"
}

# ---------------------------------------------------------------------------
# volume -- manage the ext4 container volumes: list, fstrim (reclaim), duplicate
# and destroy an arbitrary one. These operate on `container` volumes directly
# (under CONTAINER_VOLUMES_DIR), so they do not need MACKAS_ROOT -- the volume
# names are derived from MACKAS_VOLUME_NAME, which has a default.
# ---------------------------------------------------------------------------

# KiB -> human. `du` on APFS reports allocated blocks, i.e. what a sparse image
# actually costs, so this formats the SAME quantity for before/after/reclaimed
# and they stay internally consistent (a plain `du -h` uses the locale decimal
# separator -- "2,3M" here -- which we deliberately avoid for the numbers we
# compute on).
fmt_kb() {
	local kb="$1"
	[ "$kb" -lt 0 ] && kb=0
	# LC_ALL=C so the decimal separator is always '.', not the locale's ','
	# (awk honours LC_NUMERIC), keeping the output predictable and testable.
	if [ "$kb" -ge 1048576 ]; then
		LC_ALL=C awk -v k="$kb" 'BEGIN { printf "%.1fG", k / 1048576 }'
	elif [ "$kb" -ge 1024 ]; then
		LC_ALL=C awk -v k="$kb" 'BEGIN { printf "%.1fM", k / 1024 }'
	else
		printf '%dK' "$kb"
	fi
}

# du of a volume's backing image, in KiB (blocks actually used). Empty if the
# image is absent (e.g. a volume that exists but was never written to). A `du`
# that fails on an EXISTING image (a dangling relocation symlink, a permission
# hiccup) must also degrade to empty, not abort: this runs inside `used_kb="$(
# volume_img_kb ...)"` under `set -e`+pipefail, so a failing pipeline here would
# otherwise kill `volume list` mid-listing. `|| true` keeps the listing going;
# the caller renders empty as "-".
volume_img_kb() {
	local img="$1"
	[ -e "$img" ] || return 0
	du -k "$img" 2>/dev/null | awk '{print $1; exit}' || true
}

# The configured (declared) size of a volume, read from `container volume
# inspect`'s JSON -- the "size" field under configuration.options, e.g. "800M".
# Parsed with sed, not jq (stdlib only). "sizeInBytes" cannot be mismatched:
# the pattern requires the closing quote right after `size`, which only the
# options."size" line has.
volume_size() {
	container volume inspect "$1" 2>/dev/null \
		| sed -n 's/.*"size"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
		| head -1
}

# Mark a volume name: which of the three mackas volumes it is (or the legacy
# single-volume leftover), for `volume list`.
volume_role() {
	case "$1" in
		"$MACKAS_VOL_TMP")    printf 'mackas/tmp' ;;
		"$MACKAS_VOL_DL")     printf 'mackas/dl' ;;
		"$MACKAS_VOL_SSTATE") printf 'mackas/sstate' ;;
		"$MACKAS_VOL_LEGACY") printf 'old' ;;
		*)                    printf '-' ;;
	esac
}

# volume list -- every container volume, with its configured cap, what its
# volume.img actually costs on disk today, and whether a running VM holds it.
# The on-disk column is the whole motivation for `fstrim`: sparse ext4 images
# only ratchet up, so this is where you SEE one that has grown far past what it
# still holds.
volume_list() {
	[ "$#" -eq 0 ] || die "'volume list' takes no arguments" "$SCRIPT_CMD volume list"

	hdr "Container volumes"
	printf '  %-24s %-14s %-8s %-10s %s\n' "NAME" "ROLE" "CAP" "ON DISK" "IN USE"

	# Read-only: never force-starts the daemon (unlike the volume subcommands
	# that mutate a volume, which call require_runtime_for_volumes). With the
	# daemon down, `container volume ls` returns nothing useful -- the same
	# blind spot cmd_status's own "ext4 volumes" section already works around
	# (issue #33) -- so say so plainly instead of printing "(no volumes)",
	# which reads as "none exist" rather than "cannot tell right now".
	if ! container_running; then
		info "  container system is not running -- volume existence cannot be checked"
		info "  this way; everything below is UNKNOWN, not necessarily absent"
		return 0
	fi

	# One `container volume ls`. Its OPTIONS column carries `size=<cap>`; pull
	# the name (field 1) and that cap out in one pass, tab-separated so a value
	# can never be confused for a column boundary.
	local rows
	rows="$(container volume ls 2>/dev/null | awk '
		NR > 1 {
			name = $1
			cap = ""
			for (i = 2; i <= NF; i++) if ($i ~ /^size=/) cap = substr($i, 6)
			print name "\t" cap
		}')"

	if [ -z "$rows" ]; then
		info "  (no volumes)"
		return 0
	fi

	local name cap img used_kb used inuse moved realdir leftover lk
	while IFS="$(printf '\t')" read -r name cap; do
		[ -n "$name" ] || continue
		img="$CONTAINER_VOLUMES_DIR/$name/volume.img"
		used_kb="$(volume_img_kb "$img")"
		if [ -n "$used_kb" ]; then used="$(fmt_kb "$used_kb")"; else used="-"; fi
		if volume_in_use "$name"; then inuse="yes"; else inuse="no"; fi
		printf '  %-24s %-14s %-8s %-10s %s\n' \
			"$name" "$(volume_role "$name")" "${cap:--}" "$used" "$inuse"
		# A per-volume symlink at the runtime path means `volume move` relocated
		# it; the ON DISK figure was measured THROUGH that symlink, so note where
		# the image actually lives (matching `status`'s "moved to:").
		if [ -L "$CONTAINER_VOLUMES_DIR/$name" ]; then
			moved="$(readlink "$CONTAINER_VOLUMES_DIR/$name")"
			printf '  %s-> moved to: %s%s\n' "$C_DIM" "$moved" "$C_RST"
		fi
		# 'volume fsck' keeps the pre-repair image as the user's only undo and
		# never removes it itself. It is APFS block-shared with the live image,
		# so it costs little at first and grows as the two diverge -- and it is
		# invisible in the ON DISK column above, which is du of volume.img alone.
		realdir="$(volume_real_dir "$name")"
		for leftover in "$realdir"/volume.img.mackas-corrupt-*; do
			[ -f "$leftover" ] || continue
			lk="$(volume_img_kb "$leftover")"
			printf '  %s-> pre-fsck image kept: %s (%s) -- rm -f it when satisfied%s\n' \
				"$C_DIM" "$leftover" "$(fmt_kb "${lk:-0}")" "$C_RST"
		done
	done <<EOF
$rows
EOF

	info ""
	info "  ON DISK is what volume.img costs right now -- a sparse ext4 image only"
	info "  grows; deleting files inside the guest never shrinks it. Reclaim the"
	info "  freed space with: $SCRIPT_CMD volume fstrim <name>   (or 'all')"
}

# fstrim ONE volume. Returns non-zero on a real failure; when called from
# 'all' a missing/busy volume is skipped (warned) rather than fatal.
volume_fstrim_one() {
	local name="$1" from_all="${2:-0}"

	require_runtime_for_volumes

	if ! volume_exists "$name"; then
		if [ "$from_all" -eq 1 ]; then
			warn "  volume '$name' does not exist; skipping"
			return 0
		fi
		die "volume '$name' does not exist" "$SCRIPT_CMD volume list"
	fi

	# One-VM rule: an ext4 image mounted by two VMs at once corrupts. Refuse to
	# attach a volume a running build still holds rather than race it.
	if volume_in_use "$name"; then
		if [ "$from_all" -eq 1 ]; then
			warn "  volume '$name' is attached to a running container; skipping (one-VM rule)"
			return 0
		fi
		die "volume '$name' is attached to a running container" \
			"only ONE VM may touch an ext4 image at a time; stop the build first (mackas volume list), then re-run '$SCRIPT_CMD volume fstrim $name'"
	fi

	local img="$CONTAINER_VOLUMES_DIR/$name/volume.img"
	local before_kb
	before_kb="$(volume_img_kb "$img")"

	info "${C_BLD}mackas volume fstrim $name${C_RST}"
	info "  on disk before: $(fmt_kb "${before_kb:-0}")"

	# The recipe, measured on this machine (an 800M image with 600M deleted
	# inside fell to 202M in 0.01s):
	#
	#   container run --rm -u 0:0 --cap-add CAP_SYS_ADMIN -v NAME:/mnt IMAGE fstrim -v /mnt
	#
	# Apple's own tooling never issues discards, but the hypervisor's
	# virtio-blk backend DOES implement DISCARD -> host hole-punch (the guest's
	# discard_max_bytes is non-zero). fstrim inside the guest is what triggers
	# it. BOTH flags are required and neither alone works:
	#   -u 0:0            the kas image's default user is uid 30000 and gets
	#                     EPERM on the FITRIM ioctl.
	#   --cap-add CAP_SYS_ADMIN   root without the cap still gets EPERM; the cap
	#                     is dropped across the privilege-dropping exec otherwise.
	# util-linux fstrim already ships in the kas image (no apk needed).
	#
	# NOT `hdiutil compact`: it returns "Function not implemented" on these raw
	# ext4 images, so we do not attempt it.
	if [ "$DRY_RUN" -eq 1 ]; then
		run container run --rm -u 0:0 --cap-add CAP_SYS_ADMIN -v "$name:/mnt" "$KAS_IMAGE" fstrim -v /mnt
		info "  (dry-run: nothing was reclaimed)"
		return 0
	fi

	vrb "+ $(quote_cmd container run --rm -u 0:0 --cap-add CAP_SYS_ADMIN -v "$name:/mnt" "$KAS_IMAGE" fstrim -v /mnt)"
	# `|| st=$?` so a non-zero fstrim does not abort under `set -e` -- we handle
	# the failure ourselves below (a device with discard_max_bytes=0 errors here).
	local out st=0
	out="$(container run --rm -u 0:0 --cap-add CAP_SYS_ADMIN -v "$name:/mnt" "$KAS_IMAGE" fstrim -v /mnt 2>&1)" || st=$?
	# $out is captured through $(...), not streamed to a real TTY, so
	# container's own boot-progress reporting ("[3/6] Fetching kernel [0s]")
	# lands as 7-8 separate newline-terminated lines instead of one
	# in-place-updating line -- and by the time we get here the run has
	# already finished, so none of them carry information any more. Drop
	# them; only fstrim's own output (if any) is worth the "  fstrim: " noise.
	local filtered
	filtered="$(printf '%s\n' "$out" | grep -vE '^\[[0-9]+/[0-9]+\]' || true)"
	[ -n "$filtered" ] && printf '%s\n' "$filtered" | sed 's/^/  fstrim: /'

	if [ "$st" -ne 0 ]; then
		# Some backing filesystems report discard_max_bytes=0 and fstrim
		# errors on the FITRIM ioctl. Say so rather than claim a reclaim that
		# never happened. Measured live: this is not a stale-volume or
		# mackas-side problem -- a completely fresh volume fails identically
		# -- it is whatever filesystem MACKAS_ROOT (and so
		# CONTAINER_VOLUMES_DIR, symlinked under it) actually sits on. APFS
		# supports the sparse-file hole-punch DISCARD needs; ExFAT does not.
		warn "  fstrim did not succeed on '$name' -- this device may not support"
		warn "  discard (discard_max_bytes=0); nothing was reclaimed."
		warn "  This tracks the filesystem $MACKAS_ROOT is on, not a stale volume --"
		warn "  a brand new volume fails the same way on a non-hole-punching host"
		warn "  filesystem (e.g. ExFAT). See docs/storage.md's fstrim section."
		return 1
	fi

	# Report reclaimed space by RE-MEASURING du of volume.img, before -> after.
	# We deliberately do NOT trust fstrim's own "N bytes trimmed" line: that is
	# the guest's free space, not host reclaim, and APFS block sharing (clones)
	# would make any computed figure a lie. The host `du` delta is the truth.
	local after_kb reclaimed_kb
	after_kb="$(volume_img_kb "$img")"
	reclaimed_kb=$(( ${before_kb:-0} - ${after_kb:-0} ))
	[ "$reclaimed_kb" -lt 0 ] && reclaimed_kb=0

	did "fstrim '$name': $(fmt_kb "${before_kb:-0}") -> $(fmt_kb "${after_kb:-0}") ${C_BLD}(reclaimed $(fmt_kb "$reclaimed_kb"))${C_RST}"
	if [ "$reclaimed_kb" -eq 0 ]; then
		info "  Nothing to reclaim -- the image was already compact."
	fi
	return 0
}

# volume fstrim <name> | all -- reclaim host disk from sparse ext4 image(s).
# "all" is the primary, documented form of this command's object -- 'volume
# fstrim' already reads as verb+object, so a second object value is more
# consistent than a flag. --all/-a are ALSO accepted, as synonyms for 'all',
# purely for consistency with 'volume destroy --all' -- not because the
# verb+object reasoning above was wrong.
volume_fstrim() {
	# fstrim ATTACHES each volume (via volume_fstrim_one), so it is a mutating
	# command and needs a root like the rest. Without one, `all` would expand
	# to the default volume names (oe-build-{tmp,dl,sstate}) and attach the real
	# volumes of whatever install happens to share those names -- the one thing
	# the root gate exists to stop. `volume list`, which only reads, does NOT
	# require a root.
	require_mackas_root
	local do_all=0 names=() a
	for a in "$@"; do
		case "$a" in
			all|-a|--all) do_all=1 ;;
			-*) die "unknown option for 'volume fstrim': $a" \
				"$SCRIPT_CMD volume fstrim <name> | all | --all" ;;
			*) names+=("$a") ;;
		esac
	done

	if [ "$do_all" -eq 1 ]; then
		[ "${#names[@]}" -eq 0 ] || die "'volume fstrim all' takes no volume name" \
			"$SCRIPT_CMD volume fstrim all"
		names=("$MACKAS_VOL_TMP" "$MACKAS_VOL_DL" "$MACKAS_VOL_SSTATE")
	fi

	[ "${#names[@]}" -ge 1 ] || die "'volume fstrim' needs a volume name (or 'all'/--all)" \
		"$SCRIPT_CMD volume fstrim <name> | all | --all"

	local n rc=0
	for n in "${names[@]}"; do
		volume_fstrim_one "$n" "$do_all" || rc=1
	done
	return "$rc"
}

# volume duplicate <source> <duplicate> -- clone a volume cheaply via APFS
# clonefile. Measured at 0.003s: `cp -c` is copy-on-write, so the clone SHARES
# physical blocks with its source and costs almost nothing until one side is
# written. <duplicate> is a NAME YOU CHOOSE for the new volume, not an
# existing one.
volume_duplicate() {
	local src="${1:-}" dst="${2:-}"
	[ -n "$src" ] && [ -n "$dst" ] || die "'volume duplicate' needs <source> and <duplicate>" \
		"$SCRIPT_CMD volume duplicate <source> <duplicate>"
	[ "$#" -le 2 ] || die "'volume duplicate' takes exactly <source> <duplicate>" \
		"$SCRIPT_CMD volume duplicate <source> <duplicate>"
	[ "$src" != "$dst" ] || die "source and duplicate name must differ" \
		"$SCRIPT_CMD volume duplicate <source> <duplicate>"

	require_runtime_for_volumes

	volume_exists "$src" || die "source volume '$src' does not exist" "$SCRIPT_CMD volume list"
	if volume_exists "$dst"; then
		die "destination volume '$dst' already exists" \
			"pick a new name, or remove it: $SCRIPT_CMD volume destroy $dst"
	fi

	# One-VM guard on the SOURCE too. The engine guards `rm` against a running
	# container but does NOT guard read access, and cloning a live image
	# (mid-write, dirty journal) yields an inconsistent copy.
	if volume_in_use "$src"; then
		die "source volume '$src' is attached to a running container" \
			"only ONE VM may touch an ext4 image at a time; stop the build first (mackas volume list), then re-run"
	fi

	local size
	size="$(volume_size "$src")"
	[ -n "$size" ] || die "could not read the size of '$src' from 'container volume inspect'" \
		"container volume inspect $src"

	local src_img="$CONTAINER_VOLUMES_DIR/$src/volume.img"
	local dst_img="$CONTAINER_VOLUMES_DIR/$dst/volume.img"

	info "${C_BLD}mackas volume duplicate $src -> $dst${C_RST}"
	info "  size: $size (matched from the source)"

	refuse_if_stale_entity "$dst" || die "destination volume '$dst' already exists" \
		"pick a new name, or remove it: $SCRIPT_CMD volume destroy $dst"

	# 1. Create dst at the SAME size. This writes a valid entity.json we must
	#    NOT edit -- only its volume.img gets swapped underneath it.
	run container volume create -s "$size" "$dst"
	# 2. Drop the fresh (empty) image `create` just made.
	run rm -f "$dst_img"
	# 3. clonefile the source image into its place. `cp -c` asks for a CoW
	#    clone. TRAP: `cp -c` ACROSS APFS volumes silently falls back to a full
	#    byte copy (exit 0, no warning) -- both images live under
	#    CONTAINER_VOLUMES_DIR, so they are same-volume in normal use, but if
	#    that dir is ever relocated onto a different filesystem the "clone"
	#    would quietly become a full copy.
	run cp -c "$src_img" "$dst_img"

	did "duplicated '$src' -> '$dst' (size $size)"
	info "  The clone SHARES physical blocks with '$src' (APFS copy-on-write), so"
	info "  it costs almost nothing on disk until one of the two is written to."
	return 0
}

# volume destroy <name> | --all -- remove ONE arbitrary volume, or (--all/-a)
# every mackas-managed volume: the three active ones plus the legacy
# pre-split leftover, if present. Distinct from the top-level `destroy`,
# which ALSO removes MACKAS_ROOT and the short symlink -- this only ever
# touches volumes. Single-name mode is the counterpart to `duplicate`: remove
# a clone, or a stray zztest-* volume, without touching anything else.
volume_destroy() {
	local name="" do_all=0 a
	for a in "$@"; do
		case "$a" in
			# 'all' is accepted bare too, matching volume_fstrim()'s own
			# 'all|-a|--all' precedent -- the two --all-capable subcommands
			# read the same way, not just the flag-spelled one.
			all|-a|--all) do_all=1 ;;
			-*) die "unknown option for 'volume destroy': $a" \
				"$SCRIPT_CMD volume destroy <name> | all | --all" ;;
			*)
				[ -z "$name" ] || die "'volume destroy' removes one volume at a time" \
					"$SCRIPT_CMD volume destroy <name>"
				name="$a"
				;;
		esac
	done

	require_runtime_for_volumes

	if [ "$do_all" -eq 1 ]; then
		[ -z "$name" ] || die "'volume destroy --all' takes no volume name" \
			"$SCRIPT_CMD volume destroy --all"
		# Same reasoning as volume_fstrim()'s root gate: --all expands to
		# names DERIVED from MACKAS_VOLUME_NAME, so an unset MACKAS_ROOT could
		# otherwise mean deleting whatever install happens to share those
		# default names. Destroying is a stronger reason for this gate than
		# fstrim's own attach-only risk, not a weaker one.
		require_mackas_root
		volume_destroy_all
		return $?
	fi

	[ -n "$name" ] || die "'volume destroy' needs a volume name" "$SCRIPT_CMD volume destroy <name>"

	volume_exists "$name" || die "volume '$name' does not exist" "$SCRIPT_CMD volume list"

	if volume_in_use "$name"; then
		die "volume '$name' is attached to a running container" \
			"only ONE VM may touch an ext4 image at a time; stop the build first (mackas volume list), then re-run"
	fi

	local img="$CONTAINER_VOLUMES_DIR/$name/volume.img" before_kb
	before_kb="$(volume_img_kb "$img")"

	confirm "Delete volume '$name'${before_kb:+ (on disk: $(fmt_kb "$before_kb"))}? This cannot be undone." \
		|| { info "Aborted. Nothing was removed."; return 1; }

	delete_volume "$name" || die "could not delete volume '$name'" \
		"stop whatever is using it (mackas volume list) and re-run"
	return 0
}

# volume destroy --all's worker. Unlike the single-name path above, a volume
# that does not exist is normal here (not every install has all four), not an
# error -- and a busy one is skipped with a warning, mirroring
# volume_fstrim_one()'s from_all shape, rather than aborting the whole run.
volume_destroy_all() {
	local names=("$MACKAS_VOL_TMP" "$MACKAS_VOL_DL" "$MACKAS_VOL_SSTATE" "$MACKAS_VOL_LEGACY")
	local n present=() total_kb=0 kb img

	for n in "${names[@]}"; do
		volume_exists "$n" || continue
		present+=("$n")
		img="$CONTAINER_VOLUMES_DIR/$n/volume.img"
		kb="$(volume_img_kb "$img")"
		total_kb=$((total_kb + ${kb:-0}))
	done

	if [ "${#present[@]}" -eq 0 ]; then
		info "no mackas volumes exist -- nothing to destroy"
		return 0
	fi

	confirm "Delete ${#present[@]} volume(s) (${present[*]}) -- $(fmt_kb "$total_kb") total? This cannot be undone." \
		|| { info "Aborted. Nothing was removed."; return 1; }

	local rc=0 removed=()
	for n in "${present[@]}"; do
		if volume_in_use "$n"; then
			warn "  volume '$n' is attached to a running container; skipping (one-VM rule)"
			rc=1
			continue
		fi
		if delete_volume "$n"; then
			removed+=("$n")
		else
			rc=1
		fi
	done

	[ "${#removed[@]}" -eq 0 ] || did "removed ${#removed[@]} volume(s): ${removed[*]}"
	return "$rc"
}

# The real on-disk directory that backs a volume. Normally this is just
# $CONTAINER_VOLUMES_DIR/<name>, but `volume move` (and `recover`) leave a
# SYMLINK there pointing at the image's new home on a roomier disk -- Apple's
# runtime follows it (VERIFIED: it mounts a symlinked volume dir as ext4 with
# data intact). readlink gives the stored absolute target; a plain dir gives
# itself. This is the persistence mechanism: the symlink IS the record of where
# a volume lives, so there is no second state file to drift out of sync.
volume_real_dir() {
	local name="$1"
	local link="$CONTAINER_VOLUMES_DIR/$name"
	if [ -L "$link" ]; then
		readlink "$link"
	else
		printf '%s' "$link"
	fi
}

# True (0) when a volume's runtime location does NOT resolve to a real
# volume.img: a dangling symlink left by a hand-move, or a missing dir/image.
# False (1) when it is healthy. This is what `recover` detects.
volume_broken() {
	local name="$1" real
	real="$(volume_real_dir "$name")"
	[ -f "$real/volume.img" ] && return 1
	return 0
}

# Move a volume's on-disk tree $1 -> $2. cross=1 when the two are on different
# filesystems. Same-fs is a plain `mv` -- an atomic rename. Cross-fs cannot
# rename, and macOS `mv` across filesystems copies a sparse image WITHOUT its
# holes: it writes the image's full logical size in zeros, ballooning a
# 120G-cap TMPDIR to 120G on the destination (needs >= cap free, slow, lands
# un-sparse). So clone it instead: `cp -cR` asks clonefile(2) for a
# copy-on-write clone and, where that is impossible (a different filesystem),
# falls back to a plain copy that STILL preserves holes. The source is removed
# only AFTER the copy returns success, so a crash mid-copy leaves it intact --
# nothing is lost (the copy is not atomic, but the source is the safety net).
volume_transfer() {
	local src="$1" dst="$2" cross="$3"
	if [ "$cross" -eq 1 ]; then
		run cp -cR "$src" "$dst" && run rm -rf "$src"
	else
		run mv "$src" "$dst"
	fi
}

# volume move <name> <dir> -- relocate ONE volume's on-disk image tree to
# <dir>/<name> and leave a symlink at the runtime location so the engine still
# finds it. Apple `container` 1.1.0 has no per-volume storage-root knob, and its
# whole-dir MACKAS_RELOCATE_VOLUMES symlink moves ALL volumes together; this
# moves just one -- e.g. a big TMPDIR onto a disk with more room.
volume_move() {
	local name="${1:-}" dest_dir="${2:-}"
	[ -n "$name" ] && [ -n "$dest_dir" ] || die "'volume move' needs <name> and <dir>" \
		"$SCRIPT_CMD volume move <name> <dir>"
	[ "$#" -le 2 ] || die "'volume move' takes exactly <name> <dir>" \
		"$SCRIPT_CMD volume move <name> <dir>"

	require_runtime_for_volumes

	volume_exists "$name" || die "volume '$name' does not exist" "$SCRIPT_CMD volume list"

	# One-VM rule: never relocate an image a running VM still holds. Moving the
	# backing dir of a mounted ext4 image is exactly the double-life the rule
	# forbids.
	if volume_in_use "$name"; then
		die "volume '$name' is attached to a running container" \
			"only ONE VM may touch an ext4 image at a time; stop the build first (mackas volume list), then re-run '$SCRIPT_CMD volume move $name <dir>'"
	fi

	# Absolutise a relative <dir> against $PWD -- a relative destination for a
	# persistent symlink target would be surprising (and, once stored, wrong from
	# any other working directory).
	case "$dest_dir" in
		/*) ;;
		*)  dest_dir="$PWD/$dest_dir" ;;
	esac

	local link="$CONTAINER_VOLUMES_DIR/$name"
	local real_src dest
	real_src="$(volume_real_dir "$name")"   # follows a prior move's symlink
	dest="$dest_dir/$name"

	if [ "$real_src" = "$dest" ]; then
		die "volume '$name' is already located at '$dest'" "nothing to do"
	fi

	# Refuse to move a volume into its own subtree (mv would fail, or worse).
	case "$dest/" in
		"$real_src"/*) die "cannot move '$name' into its own subtree ('$dest' is under '$real_src')" \
			"choose a directory outside '$real_src'" ;;
	esac

	# Moving a relocated volume BACK home: <dir> is the runtime volumes dir, so
	# $dest is the runtime path itself, currently a symlink left by an earlier
	# move-away. This is the inverse of a move -- put the tree back and drop the
	# symlink so the engine sees a plain directory again. (When the volume was
	# never moved, $real_src == $dest and we already died "already located", so
	# reaching here with $dest == $link means $link is that symlink.)
	local moving_home=0
	[ "$dest" = "$link" ] && [ -L "$link" ] && moving_home=1

	# Refuse a destination that already exists, UNLESS it is an empty directory
	# we can reuse (mv into an existing dir would nest, not replace). The
	# move-home symlink at $link is expected, not a collision -- skip the check.
	if [ "$moving_home" -eq 0 ] && { [ -e "$dest" ] || [ -L "$dest" ]; }; then
		if [ -d "$dest" ] && [ ! -L "$dest" ] && [ -z "$(ls -A "$dest" 2>/dev/null)" ]; then
			run rmdir "$dest"
		else
			die "destination '$dest' already exists and is not an empty directory" \
				"pick a different directory, or remove '$dest' first"
		fi
	fi

	info "${C_BLD}mackas volume move $name -> $dest${C_RST}"

	# Same-fs vs cross-fs decides HOW the tree moves. A cross-filesystem move
	# cannot rename and, done with `mv`, would balloon the sparse image to its
	# full logical size (see volume_transfer); cross-fs we clone with holes
	# preserved instead. Either way the copy is not atomic, but the source
	# stays intact until it finishes, so nothing is lost.
	local src_mp dest_mp cross_fs=0
	src_mp="$(volume_mount_point "$real_src")"
	dest_mp="$(volume_mount_point "$dest_dir")"
	if [ "$src_mp" != "$dest_mp" ]; then
		cross_fs=1
		info "  '$dest_dir' is on a different filesystem ($dest_mp) than the image"
		info "  ($src_mp): copying with holes preserved (a CoW clone where the"
		info "  filesystem allows, else a plain sparse copy), then removing the source."
	fi

	run mkdir -p "$dest_dir"

	# The transfer-then-symlink window is crash-sensitive: on a FIRST move the
	# runtime dir is about to move away, and until the replacement symlink lands
	# nothing at $link resolves AND `container volume ls` no longer lists it
	# (entity.json moved with the dir). A Ctrl-C in that gap (the INT trap exits
	# immediately) would strand the volume where a no-arg `recover` scan can't
	# see it. Block INT/TERM across the window and restore the trap after.
	trap '' INT TERM
	if [ "$moving_home" -eq 1 ]; then
		# Drop the relocation symlink, then bring the tree back to the runtime
		# path. Same-fs/cross-fs handling is identical to a normal move.
		run rm -f "$link"
		volume_transfer "$real_src" "$dest" "$cross_fs"
	else
		# Move the tree to its new home: same-fs an atomic rename, cross-fs a
		# holes-preserving copy whose source is removed only after it succeeds.
		volume_transfer "$real_src" "$dest" "$cross_fs"
		# Plant the symlink atomically: create it under a temp name, then mv it
		# into place. Renaming a symlink is atomic, so $link is only ever the OLD
		# state or the NEW one, never absent -- and the mv also replaces a
		# re-move's dangling symlink outright, so no separate `rm -f` is needed.
		run ln -s "$dest" "$link.tmp.$$" && run mv -f "$link.tmp.$$" "$link"
	fi
	trap on_interrupt INT TERM

	if [ "$moving_home" -eq 1 ]; then
		did "moved '$name' back home to '$dest'"
		info "  $link is a plain directory again (no relocation symlink)."
	else
		did "moved '$name' to '$dest'"
		info "  $link -> $dest"
		info "  '$SCRIPT_CMD status' now reports this location; it survives reboots and"
		info "  a re-'$SCRIPT_CMD setup' preserves the symlink."
	fi
	return 0
}

# volume resize <name> <size> -- GROW a volume's ext4 filesystem in place.
#
# A volume's size is fixed at creation: ensure_volume() never resizes one, and
# Apple container v1.1.0 has no grow command, so until now the only route was
# destroy-and-recreate, which costs the whole cache. That is a real cost --
# a TMPDIR that turns out too small mid-build, or an sstate volume that
# outgrew a cap chosen months ago.
#
# The mechanism, derived from what the daemon actually stores on disk:
#
#   $CONTAINER_VOLUMES_DIR/<name>/
#     entity.json   {..."sizeInBytes":53687091200,..."options":{"size":"50G"}}
#     volume.img    a SPARSE file whose apparent size == sizeInBytes
#
# so growing is: extend the sparse image (free -- no blocks are allocated
# until written), tell the daemon its new size, then grow the ext4 filesystem
# inside it to fill the space. All three have to happen, in that order:
# truncating alone leaves the daemon attaching the old size; editing
# entity.json alone leaves the image too small to back it; and doing both
# without resize2fs leaves a bigger block device with the same-sized
# filesystem on it, which is exactly nothing.
#
# The daemon caches its volume index at startup (see refuse_if_stale_entity),
# so entity.json edited underneath it is not seen until 'container system
# restart' -- which is why that restart is part of the recipe rather than an
# optimisation. resize2fs then runs against the MOUNTED filesystem: ext4
# supports online growth, and mounting is the only way a plain
# 'container run -v name:/mnt' gives us the block device at all.
#
# SHRINKING IS NOT IMPLEMENTED, and not merely unfinished: resize2fs refuses
# to shrink a mounted filesystem, and nothing here can attach a volume
# *without* mounting it -- the loop-device route needs --privileged, which
# Apple container does not have (see TODO.md's non-goals). A shrink would have
# to be copy-and-destroy through a temp volume, which is a different feature.
# Refuse clearly rather than half-do it.
# WHY THERE IS NO IN-PLACE GROW, AND WHY THERE CANNOT BE ONE
#
# Extending the sparse image and rewriting entity.json works: the daemon does
# re-read an edited entity.json across a restart, and presents the larger
# block device. Growing the ext4 filesystem inside it does not, and the
# blocker is structural rather than a missing tool:
#
#   resize2fs: kernel does not support online resize with sparse_super2
#
# `container volume create` formats its volumes with the sparse_super2
# feature (`dumpe2fs -h` on a fresh volume lists it), and the guest kernel
# (6.18.15) has no online-resize support for a filesystem carrying it. An
# OFFLINE resize2fs would not care -- but that needs the filesystem
# unmounted, and a container volume can only ever be attached mounted. The
# loop-device route needs --privileged, which Apple container does not have.
#
# So all three of image, daemon record and filesystem cannot be made to move
# together, and a half-grown volume (bigger device, same-sized filesystem) is
# exactly the silent no-op worth avoiding. Copying into a correctly-sized new
# volume is the whole mechanism. It needs no resize2fs, no hand-edited
# entity.json and no daemon restart, so it also avoids every assumption the
# in-place route rested on.
#
# This would become possible if Apple stopped setting sparse_super2, or the
# guest kernel gained support for it. Re-test with `dumpe2fs -h` on a fresh
# volume before believing otherwise.

# Grow by COPYING into a fresh volume, for when no resize2fs is available.
#
# Uses only operations already proven to work, and notably needs neither of
# the two things the in-place path depends on: no hand-edited entity.json (the
# daemon makes a correct one itself for a new volume) and no resize2fs.
#
# Apple container has no volume rename, so keeping NAME costs two copies:
# NAME -> temp, destroy NAME, recreate NAME at the new size, temp -> NAME.
# The old volume is never destroyed until its copy has been verified to exist,
# so an interrupted run leaves data in the temp volume rather than nowhere.
volume_resize_by_copy() {
	local name="$1" want="$2"
	local tmpvol="${name}-mackas-resizing"

	volume_exists "$tmpvol" && die "leftover volume '$tmpvol' from an interrupted resize" \
		"inspect it, then remove it with '$SCRIPT_CMD volume destroy $tmpvol' before retrying"

	# A volume that was RELOCATED with 'volume move' lives behind a per-volume
	# symlink, and 'container volume create' always creates in the default
	# location. Destroying and recreating would therefore silently drag the
	# volume back off the disk it was deliberately put on -- someone who put
	# TMPDIR on a fast NVMe would quietly get it back on the slow one. Record
	# where it really lives and put every new volume there BEFORE copying into
	# it, so the copies land on the right drive too (and so the space they need
	# is demanded of that drive, not of MACKAS_ROOT's).
	local relocated_parent=""
	if [ -L "$CONTAINER_VOLUMES_DIR/$name" ]; then
		relocated_parent="$(dirname "$(volume_real_dir "$name")")"
		info "  '$name' lives on another drive; the replacement will be put back there:"
		info "    $relocated_parent"
	fi

	info "  Copying into a new $want volume (no resize2fs needed)."
	info "  This is a real copy, twice -- it needs about twice the used space while it runs."

	# 1. A new volume at the target size, made by the daemon itself.
	run container volume create -s "$want" "$tmpvol" \
		|| die "could not create the temporary volume '$tmpvol'" "check free space and 'container volume ls'"
	# Move it while it is still EMPTY -- near-free, and it means the copy below
	# writes straight to the destination drive instead of via MACKAS_ROOT's.
	if [ -n "$relocated_parent" ]; then
		volume_move "$tmpvol" "$relocated_parent" >/dev/null \
			|| die "could not place the temporary volume on $relocated_parent" \
				"'$name' is untouched; free space on that drive, or move it somewhere roomier first"
	fi

	# 2. Copy everything across, preserving ownership/permissions/times. tar
	#    rather than cp -a: it is the portable way to move a whole tree between
	#    two mounts with hardlinks and sparse files intact.
	if ! run container run --rm -u 0:0 -v "$name:/from" -v "$tmpvol:/to" "$KAS_IMAGE" \
		sh -c 'cd /from && tar -cf - . | (cd /to && tar -xf -)'; then
		delete_volume "$tmpvol" || true
		die "copying '$name' into the new volume failed" "nothing was destroyed; '$name' is untouched"
	fi

	# 3. Only now is it safe to drop the original.
	delete_volume "$name" || die "could not remove the old volume '$name'" \
		"your data is safe in '$tmpvol'; remove '$name' by hand, then rename by re-running the copy"

	# A daemon-level delete removes the per-volume SYMLINK, not what it pointed
	# at, so a relocated volume leaves its whole image directory behind on the
	# other drive -- which then blocks volume_move below with "destination
	# already exists and is not an empty directory". Clear it, but only the
	# exact path recorded above, and only now: the contents were verified copied
	# into $tmpvol in step 2, so this is deleting a second copy, not the data.
	if [ -n "$relocated_parent" ] && [ -d "$relocated_parent/$name" ]; then
		run rm -rf "${relocated_parent:?}/${name:?}"
	fi

	# 4. Recreate under the original name, and copy back.
	run container volume create -s "$want" "$name" \
		|| die "could not recreate '$name'" "your data is in '$tmpvol' -- do not delete it"
	# Put it back on its own drive, again while empty.
	if [ -n "$relocated_parent" ]; then
		volume_move "$name" "$relocated_parent" >/dev/null \
			|| die "recreated '$name' but could not put it back on $relocated_parent" \
				"your data is in '$tmpvol' -- do not delete it"
	fi
	if ! run container run --rm -u 0:0 -v "$tmpvol:/from" -v "$name:/to" "$KAS_IMAGE" \
		sh -c 'cd /from && tar -cf - . | (cd /to && tar -xf -)'; then
		die "copying back into '$name' failed" "your data is still in '$tmpvol' -- do not delete it"
	fi

	delete_volume "$tmpvol" || warn "      could not remove the temporary volume '$tmpvol'; remove it by hand"
	did "grew '$name' to $want by copying (contents preserved)"
	return 0
}

volume_resize() {
	# Mutating, and it attaches the volume -- same root gate as fstrim, and for
	# the same reason: without a root, a bare name would resolve against
	# whatever install happens to share it.
	require_mackas_root
	require_runtime_for_volumes
	local name="${1:-}" want="${2:-}"
	[ -n "$name" ] && [ -n "$want" ] || die "'volume resize' needs <name> and <size>" \
		"$SCRIPT_CMD volume resize <name> <size>   # e.g. $SCRIPT_CMD volume resize $MACKAS_VOL_TMP 1T"
	[ "$#" -le 2 ] || die "'volume resize' takes exactly <name> <size>" \
		"$SCRIPT_CMD volume resize <name> <size>"

	local new_bytes; new_bytes="$(size_to_bytes "$want")"
	[ "$new_bytes" -gt 0 ] || die "'$want' is not a size" \
		"use a number with T/G/M, e.g. 1T, 500G, 800M (a bare number means GiB)"

	volume_exists "$name" || die "volume '$name' does not exist" "$SCRIPT_CMD volume list"

	# One-VM rule: this attaches the volume to run resize2fs, and an ext4 image
	# mounted by two VMs at once corrupts. Growing one underneath a running
	# build would be a spectacular way to prove it.
	if volume_in_use "$name"; then
		die "volume '$name' is attached to a running container" \
			"only ONE VM may touch an ext4 image at a time; stop the build first ('$SCRIPT_CMD volume list'), then re-run"
	fi

	# volume_real_dir, not the runtime path: a volume moved onto another drive
	# lives behind a symlink, and both the image and the free space that
	# matters are over there, not on MACKAS_ROOT.
	local dir img ent cur_bytes
	dir="$(volume_real_dir "$name")"
	img="$dir/volume.img"
	ent="$dir/entity.json"
	[ -f "$img" ] || die "no volume.img at $img" "$SCRIPT_CMD volume recover $name"
	[ -f "$ent" ] || die "no entity.json at $ent -- this does not look like a container volume" \
		"$SCRIPT_CMD volume list"
	cur_bytes="$(sed -n 's/.*"sizeInBytes":\([0-9][0-9]*\).*/\1/p' "$ent" | head -1)"
	[ -n "$cur_bytes" ] && [ "$cur_bytes" -gt 0 ] || \
		die "could not read the current size out of $ent" \
			"inspect it by hand; mackas will not guess at a size it cannot read"

	info "${C_BLD}mackas volume resize $name${C_RST}"
	info "  now      : $(fmt_kb $((cur_bytes / 1024)))"
	info "  requested: $(fmt_kb $((new_bytes / 1024)))"
	info "  image    : $img"

	if [ "$new_bytes" -eq "$cur_bytes" ]; then
		info "  already that size; nothing to do"
		return 0
	fi

	if [ "$new_bytes" -lt "$cur_bytes" ]; then
		die "shrinking is not supported" \
			"resize2fs cannot shrink a mounted filesystem, and a volume can only be attached mounted -- to get a smaller volume, create a new one and copy into it ('$SCRIPT_CMD volume duplicate' then '$SCRIPT_CMD volume destroy'), or see TODO.md item 26"
	fi

	# Free space is the real constraint, and it is subtler than it looks: the
	# image is sparse, so truncating it costs nothing TODAY, but every byte the
	# build later writes into the grown filesystem has to come from this drive.
	# Reporting the shortfall up front is the whole point -- a cap the drive
	# can never honour just moves the failure into a build, which is where it
	# is most expensive.
	local grow_gb free_gb
	grow_gb=$(( (new_bytes - cur_bytes + 1073741823) / 1073741824 ))
	free_gb="$(free_gb_for "$dir")"
	info "  growth   : ${grow_gb} GiB, free on that drive: ${free_gb} GiB"
	if [ "$free_gb" -lt "$grow_gb" ]; then
		warn "      That drive cannot currently back the full growth."
		warn "      The image is sparse, so this succeeds now and fails LATER,"
		warn "      mid-build, when the space is actually asked for."
	fi

	confirm "  Grow '$name' to $want?" || { info "  Left unchanged."; return 1; }

	# Copying is the whole mechanism -- see the comment above
	# volume_resize_by_copy for why an in-place grow is not possible on Apple
	# container's volumes.
	volume_resize_by_copy "$name" "$want"
	return "$?"
}

# Which image 'volume fsck' runs e2fsck from. Empty MACKAS_FSCK_IMAGE (the
# default) falls back to $KAS_IMAGE -- same shape the removed
# MACKAS_RESIZE_IMAGE used (f50c9ee), and resolved lazily for the same
# reason: KAS_IMAGE is itself a setting that may be overridden after
# set_defaults() ran.
fsck_image() { printf '%s' "${MACKAS_FSCK_IMAGE:-$KAS_IMAGE}"; }

# host_e2fsck_bin -- print the path to a working host-side e2fsck, or print
# nothing and return 1 if none is available. e2fsck operates on volume.img
# as a plain file: it does not need a mount, a loop device, or the kernel to
# understand ext4 at all (verified live: Homebrew's e2fsprogs, a macOS
# binary, read AND repaired a real corrupted volume.img this way, results
# byte-identical to the container+loop-device path) -- so when this is
# available, volume_fsck_one() skips the throwaway container and the
# apt-get entirely: no boot, no network dependency, no MACKAS_FSCK_IMAGE
# needed.
#
# Detected by FUNCTION, not provenance: `command -v e2fsck` (any PATH
# source -- MacPorts, a manual build, a non-default `brew --prefix`) is
# tried first and wins if present. Only if that fails, and only if `brew`
# itself is on PATH, does this fall back to asking brew where e2fsprogs
# actually lives (`brew --prefix e2fsprogs`, never a hardcoded
# /opt/homebrew|/usr/local guess) -- e2fsprogs is keg-only (macOS ships
# similarly-named tools), so it is never first on $PATH even when
# installed via brew.
#
# Test seam (undocumented, cf. MACKAS_CONTAINER_BIN/MACKAS_OVERHEAD_BIN):
# MACKAS_FSCK_HOST_E2FSCK_BIN unset means "detect normally"; set but empty
# forces "not available" (so a hermetic test can exercise the container
# fallback deterministically, regardless of what happens to be installed
# on the machine actually running the suite); set non-empty is used
# verbatim, no detection at all.
host_e2fsck_bin() {
	if [ -n "${MACKAS_FSCK_HOST_E2FSCK_BIN+x}" ]; then
		[ -n "$MACKAS_FSCK_HOST_E2FSCK_BIN" ] || return 1
		printf '%s' "$MACKAS_FSCK_HOST_E2FSCK_BIN"
		return 0
	fi
	local bin
	bin="$(command -v e2fsck 2>/dev/null)" || bin=""
	if [ -n "$bin" ]; then
		printf '%s' "$bin"
		return 0
	fi
	if command -v brew >/dev/null 2>&1; then
		local prefix=""
		prefix="$(brew --prefix e2fsprogs 2>/dev/null)" || prefix=""
		if [ -n "$prefix" ] && [ -x "$prefix/sbin/e2fsck" ]; then
			printf '%s' "$prefix/sbin/e2fsck"
			return 0
		fi
	fi
	return 1
}

# fsck_host_run MODE IMG -- the host-side fast path: run the SAME e2fsck
# sequence fsck_guest_script() runs in the container, directly against IMG
# on the host, no losetup/CAP_SYS_ADMIN/apt-get needed. Emits the identical
# "MACKAS-FSCK: ..." marker lines volume_fsck_one()'s classification step
# already parses, so this is a drop-in alternative output source, not a
# second parsing path. e2fsck's own (verbose) output is left to flow to
# this function's stdout unfiltered, interleaved with the markers -- same
# shape the container path's captured output has.
fsck_host_run() {
	local mode="$1" img="$2" e2fsck st=0
	e2fsck="$(host_e2fsck_bin)" || { echo "MACKAS-FSCK: error no host e2fsck available"; return 12; }
	echo "MACKAS-FSCK: host e2fsck ($e2fsck)"
	st=0; "$e2fsck" -f -n "$img" || st=$?
	if [ "$st" -eq 0 ]; then echo "MACKAS-FSCK: clean"; return 0; fi
	echo "MACKAS-FSCK: dirty $st"
	if [ "$mode" = check ]; then return 10; fi
	st=0; "$e2fsck" -f -y "$img" || st=$?
	echo "MACKAS-FSCK: repair-exit $st"
	if [ "$st" -ge 8 ]; then echo "MACKAS-FSCK: unrepairable"; return 11; fi
	st=0; "$e2fsck" -f -n "$img" || st=$?
	if [ "$st" -ne 0 ]; then echo "MACKAS-FSCK: unrepairable"; return 11; fi
	echo "MACKAS-FSCK: repaired"
	return 0
}

# Print the POSIX-sh script that runs INSIDE the throwaway fsck container --
# the FALLBACK path, used only when host_e2fsck_bin() finds nothing
# (fsck_host_run() above is the fast path and needs no container at all).
# MODE is "check" (--check-only) or "repair". One definition, used by both
# the real 'container run' and the --dry-run print, so the two can never
# drift -- and so a test can grep the whole thing for the invariants it
# encodes.
#
# MODE is baked into the emitted TEXT (an early 'exit 10' right after the
# assess pass, in check mode) rather than passed as a guest env var: 'container
# run -e' is not used anywhere else in this file and is unverified against
# Apple container 1.1.0.
fsck_guest_script() {
	local mode="$1"
	cat <<'EOS'
set -e
img=/vol/volume.img
# e2fsprogs only if this image does not already have it. The pinned kas
# image (ghcr.io/siemens/kas/kas:5.5) has NO e2fsprogs at all -- no e2fsck,
# fsck.ext4, dumpe2fs or debugfs, only a generic /usr/sbin/fsck dispatcher
# with nothing to dispatch to (verified live). It IS Debian 13 trixie with a
# working apt, and a build already needs network, so installing into the
# throwaway container is the cheapest route. MACKAS_FSCK_IMAGE is the escape
# hatch for anyone who wants it prebuilt or is offline.
if ! command -v e2fsck >/dev/null 2>&1; then
  echo "MACKAS-FSCK: installing e2fsprogs"
  apt-get update -qq  >/dev/null 2>&1 || { echo "MACKAS-FSCK: error apt-get update failed"; exit 12; }
  apt-get install -y -qq e2fsprogs >/dev/null 2>&1 || { echo "MACKAS-FSCK: error could not install e2fsprogs"; exit 12; }
fi
command -v e2fsck >/dev/null 2>&1 || { echo "MACKAS-FSCK: error no e2fsck in this image"; exit 12; }
# Loop-attach the CLONE. This is the whole point of the command: a loop
# device carries a genuinely UNMOUNTED ext4 filesystem, which is what
# e2fsck needs for a real repair. A named-volume mount (-v NAME:/path) can
# never give us that -- Apple's runtime auto-mounts it as ext4 first.
# Only the explicit /dev/loop0 form was verified live; --find is tried
# first but must never be the only path.
dev="$(losetup --find --show "$img" 2>/dev/null || true)"
if [ -z "$dev" ]; then
  losetup /dev/loop0 "$img" 2>/dev/null || { echo "MACKAS-FSCK: error could not attach a loop device"; exit 12; }
  dev=/dev/loop0
fi
# Detach on EVERY exit path, and sync first so e2fsck's metadata writes are
# on the virtiofs-backed file before the VM goes away.
trap 'sync; losetup -d "$dev" >/dev/null 2>&1 || true' EXIT
echo "MACKAS-FSCK: device $dev"
# Assess. -f forces a check even when the superblock claims clean; -n
# answers no to everything, so nothing is written. NOTE: -n cannot replay a
# dirty journal, so after a crash this pass OVER-reports. That is why a
# non-zero here is only ever read as "needs the repair pass", never as a
# verdict, and why exit 0 is the only trusted answer.
st=0; e2fsck -f -n "$dev" || st=$?
if [ "$st" -eq 0 ]; then echo "MACKAS-FSCK: clean"; exit 0; fi
echo "MACKAS-FSCK: dirty $st"
EOS
	[ "$mode" = check ] && printf 'exit 10\n'
	cat <<'EOS'
# Repair the CLONE. -y answers yes to everything; the journal is replayed
# first, which is exactly what -n could not do.
st=0; e2fsck -f -y "$dev" || st=$?
echo "MACKAS-FSCK: repair-exit $st"
# e2fsck exit bits: 1 errors corrected, 2 corrected+reboot, 4 uncorrected,
# 8 operational error, 16 usage, 32 aborted. >=8 means it could not even do
# the job, which is categorically different from "found and fixed things".
if [ "$st" -ge 8 ]; then echo "MACKAS-FSCK: unrepairable"; exit 11; fi
# Verify: an INDEPENDENT second forced pass must come back completely clean.
# This is the rehearsal the promotion decision rests on.
st=0; e2fsck -f -n "$dev" || st=$?
if [ "$st" -ne 0 ]; then echo "MACKAS-FSCK: unrepairable"; exit 11; fi
echo "MACKAS-FSCK: repaired"
exit 0
EOS
}

# fsck ONE volume: check, and on confirmation repair, ext4 corruption in its
# backing image. Returns non-zero on a real failure; when called from 'all'
# a missing/busy/leftover-blocked volume is warned and skipped rather than
# fatal -- same shape as volume_fstrim_one().
#
# SAFETY: e2fsck NEVER runs against the real volume.img, in ANY mode,
# including --check-only. The only bind mount the fsck container ever gets
# is $work (a scratch APFS clone, created and verified BEFORE the container
# exists) -- the original image is not reachable from inside the guest at
# all, so no command it runs, correct or buggy, can touch it. This is
# structural (the container invocation never names $dir or $img), not just
# an ordering guarantee -- but the ordering holds too: nothing under
# "STEP H" runs until the clone at $work/volume.img has been created AND
# had its size verified equal to the original's.
volume_fsck_one() {
	local name="$1" from_all="${2:-0}" check_only="${3:-0}"

	require_runtime_for_volumes

	# STEP A -- guards, before anything at all is created on disk.
	if ! volume_exists "$name"; then
		if [ "$from_all" -eq 1 ]; then
			warn "  volume '$name' does not exist; skipping"
			return 0
		fi
		die "volume '$name' does not exist" "$SCRIPT_CMD volume list"
	fi

	# One-VM rule, checked BEFORE the clone: cloning an image a live VM is
	# mid-writing yields an inconsistent copy (same reasoning
	# volume_duplicate() states for its own guard on the SOURCE), and
	# promoting a repair made from an inconsistent copy would be
	# catastrophic. This must never run after STEP G.
	if volume_in_use "$name"; then
		if [ "$from_all" -eq 1 ]; then
			warn "  volume '$name' is attached to a running container; skipping (one-VM rule)"
			return 0
		fi
		die "volume '$name' is attached to a running container" \
			"only ONE VM may touch an ext4 image at a time; stop the build first (mackas volume list), then re-run '$SCRIPT_CMD volume fsck $name'"
	fi

	# STEP B -- locate the REAL image. volume_real_dir(), never
	# $CONTAINER_VOLUMES_DIR/$name directly, so a volume relocated by
	# 'volume move' is handled and the clone lands on the drive the image
	# actually lives on (same reasoning volume_resize() states for its own
	# dir/img/ent block).
	local dir img
	dir="$(volume_real_dir "$name")"
	img="$dir/volume.img"
	if [ ! -f "$img" ]; then
		if [ "$from_all" -eq 1 ]; then
			warn "  '$name' has no volume.img at $dir; skipping"
			return 0
		fi
		die "no volume.img at $img" "$SCRIPT_CMD volume recover $name"
	fi
	[ -f "$dir/entity.json" ] || die "no entity.json at $dir -- this does not look like a container volume" \
		"$SCRIPT_CMD volume list"

	# STEP C -- refuse a leftover scratch dir from an interrupted run,
	# matching volume_resize_by_copy()'s leftover-tmpvol refusal.
	local w
	for w in "$dir"/.mackas-fsck-*; do
		[ -d "$w" ] || continue
		if [ "$from_all" -eq 1 ]; then
			warn "  '$name' has a leftover scratch copy at $w; skipping"
			return 0
		fi
		die "leftover scratch copy from an interrupted '$SCRIPT_CMD volume fsck': $w" \
			"it holds a full copy of '$name' -- inspect it, then remove it (rm -rf $(quote_cmd "$w")) before retrying"
	done

	local mode
	if [ "$check_only" -eq 1 ]; then mode=check; else mode=repair; fi

	# Decide ONCE, up front: the host fast path (no container, no network)
	# when a working e2fsck is available there, else the existing
	# container path. Resolved before the plan is printed so the plan, the
	# confirm() prompt and the --dry-run preview all agree on which one
	# will actually run.
	local host_bin=""
	host_bin="$(host_e2fsck_bin)" || host_bin=""

	# STEP D -- report the plan, and budget. Free space matters because the
	# clone is CoW-shared at first but every metadata block e2fsck rewrites
	# diverges it from the source.
	local stamp work keep img_kb
	stamp="$(date +%Y%m%d-%H%M%S)"
	work="$dir/.mackas-fsck-$stamp"
	keep="$dir/volume.img.mackas-corrupt-$stamp"
	img_kb="$(volume_img_kb "$img")"
	info "${C_BLD}mackas volume fsck $name${C_RST}"
	info "  image  : $img"
	info "  on disk: $(fmt_kb "${img_kb:-0}")"
	info "  scratch: $work/volume.img (APFS clone -- near-free until e2fsck writes)"
	if [ -n "$host_bin" ]; then
		info "  e2fsck : $host_bin (host, no container needed)"
	else
		info "  e2fsck : throwaway container ($(fsck_image)) -- installs e2fsprogs on demand"
	fi
	local free_gb; free_gb="$(free_gb_for "$dir")"
	[ "$free_gb" -ge 2 ] || warn "      only ${free_gb} GiB free on that drive; e2fsck's rewritten metadata diverges the clone from its source and needs room."
	# For the throwaway TMPDIR volume, say the cheaper answer out loud.
	[ "$name" = "$MACKAS_VOL_TMP" ] && info "  ('$name' is the throwaway TMPDIR volume -- '$SCRIPT_CMD clean' recreates it fresh, which is usually cheaper than repairing it.)"

	# STEP E -- --dry-run, its own early branch, exactly the shape
	# volume_fstrim_one() uses. It must not even create the scratch dir.
	if [ "$DRY_RUN" -eq 1 ]; then
		run mkdir -p "$work"
		run cp -c "$img" "$work/volume.img"
		if [ -n "$host_bin" ]; then
			run "$host_bin" -f -n "$work/volume.img"
		else
			run container run --rm -u 0:0 --cap-add CAP_SYS_ADMIN -v "$work:/vol" "$(fsck_image)" sh -c "$(fsck_guest_script "$mode")"
		fi
		run ln "$img" "$keep"
		run mv -f "$work/volume.img" "$img"
		info "  (dry-run: nothing was cloned, checked or repaired)"
		return 0
	fi

	# STEP F used to be a confirm() gate here ("Clone and run e2fsck against
	# the COPY?"), asked before any check had even run. That question came
	# too early to be answerable -- '$name' itself is never touched by the
	# clone-and-check below, so there was no real risk on the other side of
	# "yes", and no way for the user to judge it (nothing had been found
	# yet). STEP D already printed the full plan (image, size, scratch path,
	# which e2fsck path will run); proceed straight into it rather than
	# stopping to ask a question nothing above has earned yet. The one place
	# this command asks anything is GATE 2 below, once a real repair exists
	# and there is an actual decision (and actual information) to weigh.

	# STEP G -- THE BACKUP. Unconditional, host-side, before any container
	# exists. Same dir means same filesystem, so 'cp -c' is a genuine APFS
	# clonefile and not the silent full-copy fallback volume_duplicate()'s
	# comment warns about; it also makes the later promotion an atomic
	# same-fs rename.
	run mkdir -p "$work"
	run cp -c "$img" "$work/volume.img" || { run rm -rf "${work:?}"; die "could not clone $img" "check free space on $(volume_mount_point "$dir")"; }

	# stat, not a bare existence test: it doubles as the "did the clone
	# really appear" check and gives us the byte count STEP J compares
	# against. `|| statrc=$?` attached to the SAME statement (not a separate
	# `rc=$?` line) so a failing stat cannot trip `set -e` before the die()
	# below runs -- same idiom sstate_prune's report="$(...)" || rc=$? uses,
	# and the file's own stat -f '%u' ... || return 1 (line 807-808).
	local orig_sz="" clone_sz="" statrc=0
	orig_sz="$(stat -f '%z' "$img" 2>/dev/null)" || statrc=$?
	if [ "$statrc" -ne 0 ] || [ -z "$orig_sz" ]; then
		run rm -rf "${work:?}"
		die "could not stat $img" "nothing was changed; check permissions on $dir"
	fi
	statrc=0
	clone_sz="$(stat -f '%z' "$work/volume.img" 2>/dev/null)" || statrc=$?
	if [ "$statrc" -ne 0 ] || [ -z "$clone_sz" ]; then
		run rm -rf "${work:?}"
		die "the clone of $img did not appear at $work/volume.img" "check free space and permissions on $dir"
	fi
	if [ "$orig_sz" != "$clone_sz" ]; then
		run rm -rf "${work:?}"
		die "the clone is $clone_sz bytes but $img is $orig_sz -- refusing to check a copy that is not the image" \
			"report this; nothing was changed"
	fi

	# STEP H -- run e2fsck against the CLONE. The host fast path
	# (fsck_host_run(), resolved above) when available: e2fsck operates on
	# $work/volume.img as a plain file, no mount or loop device needed, so
	# there is nothing container-shaped to set up at all. Otherwise, THE
	# CONTAINER: -v "$work:/vol" is a plain HOST DIRECTORY bind mount (an
	# ordinary virtiofs share, exactly like retrieve's -v "$dest:/out"), NOT
	# a named-volume mount, so Apple's auto-mount-as-ext4 special case never
	# fires and e2fsck really does get an unmounted filesystem inside the
	# guest. Either way $img (the real volume.img) is never named or
	# reachable -- only the clone is -- so STEP I's classification is
	# identical regardless of which path ran.
	local out st=0
	if [ -n "$host_bin" ]; then
		vrb "+ $(quote_cmd "$host_bin" -f -n/-y "$work/volume.img")"
		out="$(fsck_host_run "$mode" "$work/volume.img" 2>&1)" || st=$?
	else
		# -u 0:0 and --cap-add CAP_SYS_ADMIN are both required and neither
		# alone suffices, the same pair volume_fstrim_one() documents.
		vrb "+ $(quote_cmd container run --rm -u 0:0 --cap-add CAP_SYS_ADMIN -v "$work:/vol" "$(fsck_image)" sh -c "$(fsck_guest_script "$mode")")"
		out="$(container run --rm -u 0:0 --cap-add CAP_SYS_ADMIN -v "$work:/vol" "$(fsck_image)" sh -c "$(fsck_guest_script "$mode")" 2>&1)" || st=$?
	fi

	# Same boot-progress filter volume_fstrim_one() uses: captured through
	# $(...) rather than a TTY, container emits 7-8 "[3/6] Fetching kernel
	# [0s]" lines that carry no information by the time we read them.
	local filtered
	filtered="$(printf '%s\n' "$out" | grep -vE '^\[[0-9]+/[0-9]+\]' || true)"
	[ -n "$filtered" ] && printf '%s\n' "$filtered" | sed 's/^/  e2fsck: /'

	# STEP I -- classify off the MARKER LINES (primary; $st is corroboration
	# only, since whether Apple container faithfully propagates a guest
	# exit status is unverified). Same output-parsing shape sstate_prune()
	# already uses.
	if printf '%s\n' "$out" | grep -qF 'MACKAS-FSCK: clean'; then
		run rm -rf "${work:?}"
		did "'$name' is clean -- no repair needed"
		return 0
	fi
	if printf '%s\n' "$out" | grep -qF 'MACKAS-FSCK: error'; then
		run rm -rf "${work:?}"
		err "could not check '$name' -- e2fsck never ran (see above)."
		info "  '$name' was not touched. Try MACKAS_FSCK_IMAGE=<image with e2fsprogs> if this is a network problem."
		return 1
	fi
	if [ "$check_only" -eq 1 ]; then
		run rm -rf "${work:?}"
		warn "  '$name' is NOT clean. Note that a read-only pass cannot replay a dirty"
		warn "  journal, so after a crash it over-reports -- re-run without --check-only"
		warn "  to have the repair pass replay it first and say what is really wrong."
		return 1
	fi
	if printf '%s\n' "$out" | grep -qF 'MACKAS-FSCK: unrepairable'; then
		err "e2fsck could not bring a copy of '$name' to a clean state."
		info "  '$name' itself was NOT modified. The attempted repair is at:"
		info "    $work/volume.img"
		info "  Remove it when you are done with it: rm -rf $(quote_cmd "$work")"
		return 1
	fi
	if ! printf '%s\n' "$out" | grep -qF 'MACKAS-FSCK: repaired'; then
		run rm -rf "${work:?}"
		err "e2fsck produced no result mackas understands (rc=$st) -- '$name' was not touched"
		return 1
	fi

	# STEP J -- size re-check, then GATE 2. e2fsck never changes an image's
	# size; a difference means something other than a repair happened, so
	# refuse rather than promote. Same statrc idiom as STEP G.
	statrc=0
	clone_sz="$(stat -f '%z' "$work/volume.img" 2>/dev/null)" || statrc=$?
	if [ "$statrc" -ne 0 ] || [ -z "$clone_sz" ]; then
		die "could not stat the repaired copy at $work/volume.img" "'$name' was not touched; inspect $work by hand"
	fi
	if [ "$orig_sz" != "$clone_sz" ]; then
		die "the repaired copy is $clone_sz bytes but '$name' is $orig_sz -- refusing to promote it" \
			"'$name' was not touched; the copy is at $work/volume.img"
	fi
	confirm "  Promote the repaired copy to be '$name's volume.img? (the current image is kept alongside it)" \
		|| { info "  Left unchanged. The repaired copy is at $work/volume.img (rm -rf it when done)."; return 1; }

	# STEP K -- PROMOTION. The ONLY step that touches the real image, and it
	# is reached only after the rehearsal above verified clean. 'ln' first
	# (instant, shares every block), so volume.img is never absent for even
	# an instant; then an atomic same-fs rename replaces it. INT/TERM
	# blocked across the window, the identical guard volume_move() puts
	# around its own transfer.
	trap '' INT TERM
	run ln "$img" "$keep"
	run mv -f "$work/volume.img" "$img"
	trap on_interrupt INT TERM
	run rmdir "$work"

	did "repaired '$name'"
	info "  The pre-repair image is kept (APFS-shared, so it costs little today):"
	info "    $keep"
	info "  mackas never removes it. Once you are satisfied the volume is good:"
	info "    rm -f $(quote_cmd "$keep")"
	info "  '$SCRIPT_CMD volume list' reports it until you do."
	info "  ext4 repair may have moved unrecoverable directory entries into"
	info "  lost+found rather than restoring them in place -- normal after a crash."
	info "  For tmp: '$SCRIPT_CMD clean' rebuilds it. For sstate: bitbake re-fetches."
	return 0
}

# volume fsck <name> | all -- check, and offer to repair, ext4 corruption in
# a volume's backing image. 'all' is the primary, documented form of this
# command's object; --all/-a are accepted synonyms, exactly as for
# 'volume fstrim'/'volume destroy'.
volume_fsck() {
	# Mutating and it runs a container against volume images, so it needs a
	# root for the same reason volume_fstrim() states: without one, 'all'
	# would expand to the default volume names and operate on whatever
	# install happens to share them.
	require_mackas_root
	local do_all=0 check_only=0 names=() a
	for a in "$@"; do
		case "$a" in
			all|-a|--all)     do_all=1 ;;
			-n|--check-only)  check_only=1 ;;
			-*) die "unknown option for 'volume fsck': $a" \
				"$SCRIPT_CMD volume fsck <name> | all | --all [--check-only]" ;;
			*)  names+=("$a") ;;
		esac
	done

	if [ "$do_all" -eq 1 ]; then
		[ "${#names[@]}" -eq 0 ] || die "'volume fsck all' takes no volume name" \
			"$SCRIPT_CMD volume fsck all"
		names=("$MACKAS_VOL_TMP" "$MACKAS_VOL_DL" "$MACKAS_VOL_SSTATE")
	fi

	[ "${#names[@]}" -ge 1 ] || die "'volume fsck' needs a volume name (or 'all'/--all)" \
		"$SCRIPT_CMD volume fsck <name> | all | --all"

	local n rc=0
	for n in "${names[@]}"; do
		volume_fsck_one "$n" "$do_all" "$check_only" || rc=1
	done
	return "$rc"
}

# Ask Spotlight where a volume.img with the right shape lives. Prints one
# candidate directory per line (the dir that CONTAINS volume.img). Test seam:
# MACKAS_MDFIND overrides the mdfind binary, exactly like MACKAS_CONTAINER_BIN.
volume_spotlight_find() {
	local name="$1" mdfind="${MACKAS_MDFIND:-mdfind}" img dir
	# A genuine container volume is <something>/<name>/volume.img with an
	# entity.json sibling. Query by filename, then filter -- kMDItemFSName is the
	# indexed attribute; the structural checks are ours, not Spotlight's.
	"$mdfind" "kMDItemFSName == 'volume.img'" 2>/dev/null | while IFS= read -r img; do
		[ -f "$img" ] || continue
		dir="$(dirname "$img")"
		[ "$(basename "$dir")" = "$name" ] || continue
		[ -f "$dir/entity.json" ] || continue
		printf '%s\n' "$dir"
	done
}

# Orphaned volume images: a volume.img on some drive that no volume claims.
#
# These are created by destroying a RELOCATED volume. `container volume delete`
# removes what the daemon knows about -- for a moved volume that is the
# per-volume SYMLINK, not the image it points at -- so the image survives on
# the other drive with nothing left referring to it. A "destroyed" 300 GB
# TMPDIR goes on costing 300 GB, and the only clue is free space that never
# came back. delete_volume now warns and offers to remove it at the moment it
# happens; this finds the ones destroyed before that existed, or removed by
# some other route.
#
# Spotlight is the only way to find them: without the symlink there is no
# record of which drives were ever used, so there is nowhere else to look.
# Same query and structural filtering as volume_spotlight_find, but matching
# ANY directory name rather than one volume's, and then discarding every
# directory that IS a live volume or the runtime's own location.
#
# Prints one "<dir>" per orphan. Silent when Spotlight is unavailable or the
# index is off -- an empty answer here must never read as "nothing is wrong",
# which is why the caller reports the difference.
find_orphaned_volume_images() {
	local mdfind="${MACKAS_MDFIND:-mdfind}" img dir base real
	local known; known="$(container volume ls 2>/dev/null | awk 'NR>1 {print $1}')"
	"$mdfind" "kMDItemFSName == 'volume.img'" 2>/dev/null | while IFS= read -r img; do
		[ -f "$img" ] || continue
		dir="$(dirname "$img")"
		[ -f "$dir/entity.json" ] || continue
		base="$(basename "$dir")"
		# Still a live volume? Then it is not an orphan, wherever it lives.
		printf '%s\n' "$known" | grep -qxF "$base" && continue
		# The runtime's own directory for that name -- if the image is there,
		# or a symlink still points at it, something still refers to it.
		real="$(volume_real_dir "$base")"
		[ "$real" = "$dir" ] && continue
		printf '%s\n' "$dir"
	done
}

# volume recover [<name>] -- when a volume.img has been moved by hand, the
# runtime location ($CONTAINER_VOLUMES_DIR/<name>) no longer resolves to it.
# Detect that, locate the image with Spotlight, and offer to re-point the
# symlink. Nothing changes without confirmation.
volume_recover() {
	local only="${1:-}"
	[ "$#" -le 1 ] || die "'volume recover' takes at most one <name>" \
		"$SCRIPT_CMD volume recover [<name>]"

	# The set to examine: an explicit name, else the mackas volumes.
	local candidates
	if [ -n "$only" ]; then
		candidates="$only"
	else
		candidates="$MACKAS_VOL_TMP $MACKAS_VOL_DL $MACKAS_VOL_SSTATE $MACKAS_VOL_LEGACY"
	fi

	local name link any=0 fixed=0
	for name in $candidates; do
		link="$CONTAINER_VOLUMES_DIR/$name"

		# Healthy: resolves to a real volume.img. Skip -- but if the user named
		# it explicitly, say so rather than stay silent.
		if ! volume_broken "$name"; then
			[ -n "$only" ] && info "volume '$name' is healthy ($(volume_real_dir "$name")/volume.img)"
			continue
		fi

		# Broken. When scanning (no explicit name), only treat it as broken if
		# there is EVIDENCE the volume should exist -- a dangling symlink left by
		# a hand-move, or the runtime still listing it -- so a volume that was
		# simply never created is not reported as a problem. But an interrupted
		# FIRST move strands a volume with NEITHER (the runtime dir is entirely
		# gone and entity.json moved away with it), so before concluding "never
		# created", ask Spotlight: if it finds a matching image, the volume is
		# stranded and worth recovering; if not, stay silent.
		if [ -z "$only" ] && [ ! -L "$link" ] && ! volume_exists "$name"; then
			[ -n "$(volume_spotlight_find "$name")" ] || continue
		fi

		any=1
		err "volume '$name' does not resolve to a volume.img (looked at $link)"

		# Ask Spotlight where it went. Exclude the current broken location.
		local matches match count=0 chosen=""
		matches="$(volume_spotlight_find "$name" | grep -vxF "$(volume_real_dir "$name")" || true)"
		if [ -n "$matches" ]; then
			count="$(printf '%s\n' "$matches" | grep -c .)"
		fi

		if [ "$count" -eq 0 ]; then
			# Spotlight found nothing. Is the likely disk even indexed?
			local disk="$MACKAS_ROOT"
			if command -v mdutil >/dev/null 2>&1 && \
			   mdutil -s "$disk" 2>/dev/null | grep -qi "disabled"; then
				warn "  Spotlight indexing is off for $disk, so it cannot search there."
				info "  Re-point by hand once you know the path:"
				info "    ln -s <the-dir-holding-volume.img> $(printf '%q' "$link")"
			else
				warn "  Spotlight found no volume.img named '$name' anywhere it indexes."
				info "  If you moved it to an unindexed disk, re-point by hand:"
				info "    ln -s <the-dir-holding-volume.img> $(printf '%q' "$link")"
			fi
			continue
		fi

		if [ "$count" -gt 1 ]; then
			warn "  Spotlight found $count candidates; refusing to guess. Re-point the right one:"
			printf '%s\n' "$matches" | while IFS= read -r match; do
				info "    ln -s $(printf '%q' "$match") $(printf '%q' "$link")"
			done
			continue
		fi

		chosen="$matches"
		info "  found it at: $chosen"
		if confirm "  re-point '$name' there?"; then
			run rm -f "$link"
			run ln -s "$chosen" "$link"
			if [ "$DRY_RUN" -eq 1 ]; then
				# Under --dry-run the rm/ln above only PRINTED, so the volume
				# is of course still broken -- verifying here would print a
				# false failure over a perfectly good target. Skip it.
				info "  (dry-run: would re-point '$name' to $chosen; nothing changed)"
			elif volume_broken "$name"; then
				err "  re-pointed, but '$name' still does not resolve -- check $chosen"
			else
				did "recovered '$name' -> $chosen"
				fixed=$((fixed + 1))
			fi
		else
			info "  left '$name' as-is."
		fi
	done

	if [ "$any" -eq 0 ]; then
		info "Nothing to recover -- every volume resolves to its image."
	else
		info "Recovered $fixed volume(s)."
	fi

	# The workspace image (item 19 phase 3) is not an ext4 volume -- no
	# runtime symlink, so it has no place in the loop above -- but a scan
	# with no explicit <name> is the same "something's broken, help me fix
	# it" moment, so it belongs in the same command. Skipped when <name> was
	# given: that scopes this run to one NAMED ext4 volume specifically.
	[ -n "$only" ] || workspace_image_recover
	return 0
}

# workspace_image_recover -- item 19 phase 3. When the workspace image FILE
# itself goes missing (moved by hand, drive gone, deleted), MACKAS_WORKSPACE_IMAGE
# is the record -- unlike an ext4 volume there is no runtime symlink to
# re-point. Mirrors volume_recover()'s UX (Spotlight-located, confirm-gated,
# refuse-to-guess-on-multiple-hits, the mdutil -s indexing-off diagnosis) but
# the fix is different: move the FOUND image back to the recorded path
# (volume_transfer()'s holes-preserving copy, same care 'volume move' takes),
# rather than update a symlink. Printing the found path for the user to
# adopt by hand (mackas set MACKAS_WORKSPACE_IMAGE <found>) is the fallback
# when moving is declined -- never silently touched without confirmation.
workspace_image_recover() {
	[ -n "${MACKAS_WORKSPACE_IMAGE:-}" ] || return 0
	[ -f "$MACKAS_WORKSPACE_IMAGE" ] && return 0

	err "workspace image is recorded as $MACKAS_WORKSPACE_IMAGE, but no such file exists"

	local mdfind="${MACKAS_MDFIND:-mdfind}" base f matches="" count=0 chosen
	base="$(basename "$MACKAS_WORKSPACE_IMAGE")"
	while IFS= read -r f; do
		[ -f "$f" ] || continue
		matches="${matches:+$matches
}$f"
	done < <("$mdfind" "kMDItemFSName == '$base'" 2>/dev/null)
	[ -n "$matches" ] && count="$(printf '%s\n' "$matches" | grep -c .)"

	if [ "$count" -eq 0 ]; then
		local disk; disk="$(dirname "$MACKAS_WORKSPACE_IMAGE")"
		if command -v mdutil >/dev/null 2>&1 && mdutil -s "$disk" 2>/dev/null | grep -qi "disabled"; then
			warn "  Spotlight indexing is off for $disk, so it cannot search there."
		else
			warn "  Spotlight found no file named '$base' anywhere it indexes."
		fi
		info "  Move it back by hand once you know the path, or:"
		info "    $SCRIPT_CMD unset MACKAS_WORKSPACE_IMAGE   # if you no longer use one"
		return 0
	fi

	if [ "$count" -gt 1 ]; then
		warn "  Spotlight found $count candidates named '$base'; refusing to guess:"
		printf '%s\n' "$matches" | while IFS= read -r f; do info "    $f"; done
		info "  Move the right one back by hand, or adopt one with '$SCRIPT_CMD set MACKAS_WORKSPACE_IMAGE <path>'."
		return 0
	fi

	chosen="$matches"
	info "  found it at: $chosen"
	if confirm "  move it back to $MACKAS_WORKSPACE_IMAGE?"; then
		local src_mp dest_mp cross_fs=0
		src_mp="$(volume_mount_point "$(dirname "$chosen")")"
		dest_mp="$(volume_mount_point "$(dirname "$MACKAS_WORKSPACE_IMAGE")")"
		[ "$src_mp" != "$dest_mp" ] && cross_fs=1
		run mkdir -p "$(dirname "$MACKAS_WORKSPACE_IMAGE")"
		volume_transfer "$chosen" "$MACKAS_WORKSPACE_IMAGE" "$cross_fs"
		if [ "$DRY_RUN" -eq 1 ]; then
			info "  (dry-run: would move $chosen -> $MACKAS_WORKSPACE_IMAGE; nothing changed)"
		elif [ -f "$MACKAS_WORKSPACE_IMAGE" ]; then
			did "recovered workspace image -> $MACKAS_WORKSPACE_IMAGE"
		else
			err "  moved, but $MACKAS_WORKSPACE_IMAGE still does not exist -- check $chosen"
		fi
	else
		info "  left it at $chosen -- adopt it instead with:"
		info "    $SCRIPT_CMD set MACKAS_WORKSPACE_IMAGE $chosen"
	fi
}

volume_usage() {
	cat <<EOF
${C_BLD}$SCRIPT_CMD volume${C_RST} -- manage the ext4 container volumes.

${C_BLD}USAGE${C_RST}
  $SCRIPT_CMD volume list
  $SCRIPT_CMD volume fstrim <name> | all | --all
  $SCRIPT_CMD volume duplicate <source> <duplicate>
  $SCRIPT_CMD volume destroy <name> | all | --all
  $SCRIPT_CMD volume move <name> <dir>
  $SCRIPT_CMD volume resize <name> <size>
  $SCRIPT_CMD volume fsck <name> | all | --all [--check-only]
  $SCRIPT_CMD volume recover [<name>]

${C_BLD}SUBCOMMANDS${C_RST}
  list (ls)            Every volume: role, configured cap, actual on-disk cost
                       of its volume.img, and whether a running VM holds it.
  fstrim <name>        Reclaim host disk from a sparse ext4 image. Deleting
  (trim)               files inside the guest never shrinks volume.img; fstrim
                       inside the guest issues the discards that hole-punch it
                       on the host. 'all' (or --all/-a) does the three active
                       mackas volumes, skipping any that are in use.
  duplicate <source> <duplicate>  Clone a volume via APFS copy-on-write
  (dup, clone)         (near-free; the clone shares blocks with its source
                       until written). <duplicate> is a name you choose.
  destroy <name>       Remove ONE volume, or ('all'/--all/-a) every mackas-managed
  (delete, rm)         volume: the three active ones plus the legacy
                       pre-split leftover, if present -- skipping any that are
                       missing or in use rather than aborting. Unlike the
                       top-level '$SCRIPT_NAME destroy' (which ALSO removes
                       $MACKAS_ROOT and the symlink), this only ever touches
                       volumes.
  move <name> <dir>    Relocate one volume's on-disk image to <dir>/<name> and
  (relocate)           leave a symlink behind so the engine still finds it --
                       e.g. put a big TMPDIR on a roomier disk. Refuses an
                       in-use volume (one-VM rule). '$SCRIPT_CMD status' then
                       reports the new location.
  resize <name> <size> GROW a volume, keeping its contents, by copying it into
  (grow)               a new one of the requested size. Sizes are the usual
                       1T/500G/800M. There is no in-place grow: container
                       volumes are formatted with sparse_super2, which the
                       guest kernel cannot resize online, and offline resizing
                       needs the filesystem unmounted -- which a volume never
                       is. Copying is therefore a real copy, twice, and
                       transiently needs about double the used space; a
                       relocated volume is put back on its own drive. Refuses
                       an in-use volume (one-VM rule) and reports the growth
                       against free space on the drive the image really lives
                       on. SHRINKING IS REFUSED: the same copy would work, but
                       silently discarding data that no longer fits is not
                       something mackas will do for you.
  fsck <name>          Check, and offer to REPAIR, ext4 corruption in a
                       volume's backing image -- the '[Errno 117] Structure
                       needs cleaning' a host crash mid-write leaves behind.
                       Works on a CLONE: mackas copies volume.img first
                       (APFS copy-on-write, near-free), runs e2fsck against
                       the copy inside a throwaway container, and only
                       offers to promote the result once a second, clean
                       verification pass has confirmed the repair. '<name>'
                       itself is never written until you say yes to that,
                       and the pre-repair image is kept alongside it
                       afterwards -- mackas never deletes it, not even with
                       -y. --check-only (-n) stops after the check. 'all'
                       (or --all/-a) does the three mackas volumes,
                       skipping any that are in use. A repair can move
                       unrecoverable directory entries into lost+found
                       rather than restoring them in place; that is normal
                       fsck behaviour after a crash, not a mackas bug.
                       Needs e2fsprogs, which the kas image does not ship
                       -- it is installed into the throwaway container
                       (needs network); set MACKAS_FSCK_IMAGE to an image
                       that already has it to skip that.
  recover [<name>]     When you have moved a volume.img by hand and the runtime
                       can no longer find it, locate it with Spotlight and
                       offer to re-point the symlink. With no name, checks all
                       the mackas volumes, AND the workspace image (if one is
                       configured but its file has gone missing) -- offering
                       to move it back to its recorded path instead, since it
                       has no symlink to re-point. Never changes anything
                       unprompted.

  Parenthesized names are accepted aliases -- 'ls'/'rm' etc. match Apple
  container's own vocabulary (this is a volume manager sitting right next to
  'container volume ls'); the rest are contractions.

Options: --dry-run, -y/--yes (or -f/--force) and -v/--verbose work here too;
before or after the subcommand, e.g. '$SCRIPT_CMD --dry-run volume fstrim oe-build-tmp'
or '$SCRIPT_CMD volume fstrim oe-build-tmp --dry-run' both work.

${C_BLD}ONE-VM RULE${C_RST}
  Only one VM may access an ext4 image at a time. fstrim, duplicate, destroy
  and fsck all refuse a volume a running container holds -- for duplicate,
  that guard is on the SOURCE, since a clone of a live (mid-write) image is
  inconsistent. In --all/-a mode (fstrim, destroy or fsck), a busy volume is
  skipped with a warning instead of aborting the whole run; naming a volume
  explicitly still refuses.
EOF
}

cmd_volume() {
	local sub="" rest=() a want_help=0
	for a in "$@"; do
		case "$a" in
			--dry-run)     DRY_RUN=1 ;;
			-y|-f|--yes|--force)  ASSUME_YES=1 ;;
			-v|--verbose)  VERBOSE=1 ;;
			# -h/--help anywhere means help, whether it comes before the
			# subcommand ('volume --help') or after it ('volume fstrim --help').
			# The old form only mapped a LEADING -h/--help and let a trailing one
			# fall through to the subcommand's arg parser, which died "unknown
			# option".
			-h|--help)     want_help=1 ;;
			--version)     echo "$SCRIPT_NAME $SCRIPT_VERSION"; exit 0 ;;
			--config|--config=*|--project|--project=*|--set|--set=*) die_on_misplaced_global_flag "$a" volume ;;
			*) if [ -z "$sub" ]; then sub="$a"; else rest+=("$a"); fi ;;
		esac
	done

	if [ "$want_help" -eq 1 ]; then
		volume_usage
		return 0
	fi

	case "${sub:-help}" in
		list|ls)               volume_list ${rest+"${rest[@]}"} ;;
		fstrim|trim)           volume_fstrim ${rest+"${rest[@]}"} ;;
		duplicate|dup|clone)   volume_duplicate ${rest+"${rest[@]}"} ;;
		destroy|delete|rm)     volume_destroy ${rest+"${rest[@]}"} ;;
		move|relocate)         volume_move ${rest+"${rest[@]}"} ;;
		resize|grow)           volume_resize ${rest+"${rest[@]}"} ;;
		fsck)                  volume_fsck ${rest+"${rest[@]}"} ;;
		recover)               volume_recover ${rest+"${rest[@]}"} ;;
		help)                  volume_usage ;;
		*) die "unknown 'volume' subcommand: $sub" \
			"$SCRIPT_CMD volume --help  (list | fstrim | duplicate | destroy | move | resize | fsck | recover)" ;;
	esac
}

# ---------------------------------------------------------------------------
# Usage
# ---------------------------------------------------------------------------
usage() {
	local project_line
	if [ -n "$MACKAS_PROJECT_URL" ]; then
		project_line="Project: $MACKAS_PROJECT_DIR (branch $MACKAS_PROJECT_BRANCH)."
	else
		project_line="No project configured yet -- 'setup' still works, just skips the checkout step."
	fi
	cat <<EOF
${C_BLD}$SCRIPT_NAME${C_RST} v$SCRIPT_VERSION -- run kas-container OpenEmbedded builds on Apple's
'container' runtime. $project_line Set MACKAS_PROJECT_* to build your own
layers -- qualcomm-linux/meta-ai is a worked example, see mackas.conf.example.

${C_BLD}USAGE${C_RST}
  $SCRIPT_NAME [OPTIONS] [COMMAND]

${C_BLD}COMMANDS${C_RST}
  check      Preflight only. Changes nothing. ${C_BLD}This is the default.${C_RST}
  setup      Do the full setup. Idempotent -- safe to re-run after a crash.
  adopt      Bring a MACKAS_ROOT set up by another Mac back to a working
             build here. '$SCRIPT_CMD adopt --help'.
  project    Pin a project workspace under THIS root -- 'project add NAME'.
             The in-root sibling of 'adopt'. '$SCRIPT_CMD project --help'.
  smoketest  Run the validation ladder: parse-only, then MACKAS_SMOKETEST_TARGETS.
  status     Show what is configured and what exists on disk.
  shell      Drop into a kas shell for the project's kas config.
  exec       Run a one-off read-only command against the checkout, with
             kas's repo-mutating setup steps always skipped.
             '$SCRIPT_CMD exec --help'.
  retrieve   Copy build outputs (buildstats/logs/deploy/buildhistory/sbom)
             out of the ext4 TMPDIR volume, where macOS cannot see them.
             '$SCRIPT_CMD retrieve --help'.
  buildstats Work with buildstats already retrieved (currently: analyze).
             '$SCRIPT_CMD buildstats --help'.
  buildhistory  Work with a buildhistory tree already retrieved: analyze
             what changed between two builds. '$SCRIPT_CMD buildhistory --help'.
  sstate     Prune sstate objects bitbake hasn't reused in a while, or push
             new ones to a mirror. '$SCRIPT_CMD sstate --help'.
  monitor    Show live bitbake progress from a build started with
             MACKAS_MONITOR=1. '$SCRIPT_CMD monitor --help'.
  clean      Drop the TMPDIR volume; keep the downloads/sstate volumes and the
             checkout. Or one target at a time (tmp+deploy/downloads/sstate);
             '$SCRIPT_CMD clean --help'.
  destroy    Remove all four volumes (the three active ones plus a
             rarely-present legacy one), $MACKAS_ROOT and the short symlink.
             Makes you type DESTROY.
  volume     Manage the ext4 volumes: list, fstrim (reclaim disk), duplicate,
             destroy one, move one to another disk, resize one, fsck a
             corrupted one, recover a hand-moved one.
             '$SCRIPT_CMD volume --help'.
  set        Persist one setting in the config file. '$SCRIPT_CMD set --help'.
  get        Print one setting's currently resolved value. '$SCRIPT_CMD get --help'.
  unset      Remove one persisted setting. '$SCRIPT_CMD unset --help'.
  projects   List the pinned per-project configs --project selects between.
             '$SCRIPT_CMD projects --help'.
  runtime-args  Plumbing: prints the effective --runtime-args string. The
             env.sh wrapper calls this itself; you don't normally need to.
  lock       Pin every declared repo to its exact current commit
             (\`kas lock\`, writes into the checkout). '$SCRIPT_CMD lock --help'.
  dump       Save the fully-resolved kas config next to the logs
             (\`kas dump --resolve-*\`). '$SCRIPT_CMD dump --help'.
  help       This message, or '$SCRIPT_CMD help COMMAND' for one command's own.

${C_BLD}OPTIONS${C_RST}
  --config FILE   Use this config file instead of searching.
  --project NAME  Use the pinned project NAME's config instead of searching:
                  ~/.config/mackas/projects/NAME.conf. Mutually exclusive
                  with --config/\$MACKAS_CONF. '$SCRIPT_CMD projects' lists them.
  --set NAME=VAL  Override one setting for THIS command only; beats config
                  file and environment. Repeatable. For a PERSISTENT
                  override, use '$SCRIPT_CMD set NAME VALUE' instead.
                  '$SCRIPT_CMD status' lists the valid names.
  --dry-run       Print every mutating command; change nothing.
  -y, --yes       Assume yes; never prompt (required for non-interactive destroy).
                  -f/--force is an accepted synonym, for anyone used to
                  'docker system prune -f'.
  -v, --verbose   Echo commands as they run.
  -h, --help      This message.

${C_BLD}CONFIGURATION${C_RST}
  Precedence, lowest to highest:
    built-in defaults  ->  config file  ->  environment  ->  command-line flags

  Which file, first match wins:
    --config FILE  /  \$MACKAS_CONF            (a path, named outright)
    --project NAME /  \$MACKAS_PROJECT_SELECT  (~/.config/mackas/projects/)
    ~/.config/mackas/config
    ~/.mackas.conf

  Naming a path and selecting a project are mutually exclusive -- they are two
  answers to the same question, so mackas refuses rather than ranks them, and
  says which command drops the one you did not mean. The selector picks WHICH
  file is sourced; it is not a fifth precedence rung. An empty value is refused
  either way: --config= behaves like --config \"\", --project= like --project \"\".

  '$SCRIPT_CMD --project NAME setup' pins NAME into the generated kas-container
  wrapper, so a hand-typed 'kas-container ...' recomputes --runtime-args
  against that project's config too, not the default search path.

  It is sourced as shell, so it is only looked for in places that are yours:
  a searched file, and a --project one, are refused unless you (or root) own
  the file and its directory and neither is writable by group or other. A
  --config path is exempt: mackas derives every other candidate itself, and a
  derived path in a guessable place is an ambush, while a typed one is a
  request. ./mackas.conf is NOT searched -- name it out loud with
  --config ./mackas.conf.

  Every setting is also an environment variable of the same name, and can be
  overridden with --set NAME=VALUE. See mackas.conf.example for the full
  annotated list.

${C_BLD}EXAMPLES${C_RST}
  # See whether this Mac can do it at all -- touches nothing.
  $SCRIPT_CMD check

  # See exactly what setup would do, without doing it.
  $SCRIPT_CMD --dry-run setup

  # Set it up, answering yes to the sudo prompts.
  $SCRIPT_CMD setup

  # Use the shell afterwards.
  source $MACKAS_ENV_SH
  $SCRIPT_CMD smoketest

  # Give the build more RAM, just this once.
  MACKAS_MEMORY=48g $SCRIPT_CMD setup
  $SCRIPT_CMD --set MACKAS_MEMORY=48g setup

  # Reuse a mirror host's sstate + downloads caches as read-only mirrors,
  # over HTTP. Needs mackas-mirrord running there; see mirror-server/.
  MACKAS_USE_HTTP_MIRRORS=1 $SCRIPT_CMD check

  # The same, over NFS instead (needs sudo to mount, and is unproven).
  MACKAS_USE_NFS_MIRRORS=1 $SCRIPT_CMD check

  # Build somewhere else entirely.
  $SCRIPT_CMD --config ~/other.conf setup

  # Or, for a project already pinned by 'adopt':
  $SCRIPT_CMD projects
  $SCRIPT_CMD --project meta-ai status
  export MACKAS_PROJECT_SELECT=meta-ai   # for a whole shell

  # Start over.
  $SCRIPT_CMD destroy
EOF
}

# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------
parse_set() {
	local kv="$1" name
	[ -n "$kv" ] || die "--set needs NAME=VALUE" "$SCRIPT_CMD --help"
	case "$kv" in
		*=*) ;;
		*) die "--set expects NAME=VALUE, got: $kv" "$SCRIPT_CMD --help" ;;
	esac
	name="${kv%%=*}"
	if ! is_setting_name "$name"; then
		die "--set: unknown setting '$name'" \
			"$SCRIPT_CMD status  (lists every valid setting name)"
	fi
	CLI_OVERRIDES+=("$kv")
}

main() {
	setup_colors

	local cmd="" config_flag="" project_flag="" want_help=0
	# Flags may appear before or after the subcommand. want_help is tracked
	# SEPARATELY from cmd (rather than cmd="help" as a sentinel) so that
	# 'mackas setup --help'/'mackas setup help'/'mackas help setup' all still
	# know which command's OWN usage to show, instead of -h/--help/'help'
	# clobbering which command was named.
	while [ $# -gt 0 ]; do
		case "$1" in
			--config) config_flag="${2:-}"; [ -n "$config_flag" ] || die "--config needs a FILE"; shift 2 ;;
			# Same arity check as the space-separated form: --config= silently
			# falling through to $MACKAS_CONF or the search path made an
			# explicit-but-empty override resolve to a DIFFERENT file.
			--config=*) config_flag="${1#*=}"; [ -n "$config_flag" ] || die "--config needs a FILE"; shift ;;
			# Only the flag's arity is checked here. The NAME itself is
			# validated in load_config, the one place that turns it into a
			# path, so nothing can ever reach that path unchecked -- and so
			# --help stays typeable from anywhere, exactly as it is with an
			# unreadable --config.
			--project) project_flag="${2:-}"; [ -n "$project_flag" ] || die "--project needs a NAME" "$SCRIPT_CMD projects"; shift 2 ;;
			# Checked here too: an empty value would otherwise fall through to
			# the search path (or to an exported $MACKAS_PROJECT_SELECT), so
			# '--project=' would silently select something other than what was
			# asked for while '--project ""' dies.
			--project=*) project_flag="${1#*=}"; [ -n "$project_flag" ] || die "--project needs a NAME" "$SCRIPT_CMD projects"; shift ;;
			--set) parse_set "${2:-}"; shift 2 ;;
			--set=*) parse_set "${1#*=}"; shift ;;
			--dry-run) DRY_RUN=1; shift ;;
			-y|-f|--yes|--force) ASSUME_YES=1; shift ;;
			-v|--verbose) VERBOSE=1; shift ;;
			-h|--help) want_help=1; shift ;;
			help) want_help=1; shift ;;
			--version) echo "$SCRIPT_NAME $SCRIPT_VERSION"; exit 0 ;;
			-*) die "unknown option: $1" "$SCRIPT_CMD --help" ;;
			volume)
				# `volume` owns everything after it (its subcommand and that
				# subcommand's own args/flags), so capture the tail verbatim and
				# stop parsing -- cmd_volume does the rest. Global flags still
				# work BEFORE it (mackas --dry-run volume ...) and cmd_volume
				# also honours --dry-run/-y/-v placed after it.
				#
				# 'mackas help volume [...]' arrives here with want_help
				# already 1 -- reuse cmd_volume's own -h/--help handling
				# instead of a separate help path to drift out of sync with.
				[ -n "$cmd" ] && die "more than one command given: '$cmd' and '$1'" "$SCRIPT_CMD --help"
				cmd="volume"; shift
				if [ "$want_help" -eq 1 ]; then VOLUME_ARGS=("$@" "--help"); else VOLUME_ARGS=("$@"); fi
				break ;;
			retrieve)
				# Same shape as `volume`: retrieve owns everything after it (its
				# objects and --dest), captured verbatim for cmd_retrieve.
				[ -n "$cmd" ] && die "more than one command given: '$cmd' and '$1'" "$SCRIPT_CMD --help"
				cmd="retrieve"; shift
				if [ "$want_help" -eq 1 ]; then RETRIEVE_ARGS=("$@" "--help"); else RETRIEVE_ARGS=("$@"); fi
				break ;;
			buildstats)
				# Same shape again: buildstats owns everything after it (its
				# subcommand, e.g. 'analyze', and that subcommand's own args).
				[ -n "$cmd" ] && die "more than one command given: '$cmd' and '$1'" "$SCRIPT_CMD --help"
				cmd="buildstats"; shift
				if [ "$want_help" -eq 1 ]; then BUILDSTATS_ARGS=("$@" "--help"); else BUILDSTATS_ARGS=("$@"); fi
				break ;;
			buildhistory)
				# Same shape again: buildhistory owns everything after it (its
				# subcommand, e.g. 'analyze', and that subcommand's own args).
				[ -n "$cmd" ] && die "more than one command given: '$cmd' and '$1'" "$SCRIPT_CMD --help"
				cmd="buildhistory"; shift
				if [ "$want_help" -eq 1 ]; then BUILDHISTORY_ARGS=("$@" "--help"); else BUILDHISTORY_ARGS=("$@"); fi
				break ;;
			sstate)
				# Same shape again: sstate owns everything after it (its
				# subcommand, e.g. 'prune', and that subcommand's own args).
				[ -n "$cmd" ] && die "more than one command given: '$cmd' and '$1'" "$SCRIPT_CMD --help"
				cmd="sstate"; shift
				if [ "$want_help" -eq 1 ]; then SSTATE_ARGS=("$@" "--help"); else SSTATE_ARGS=("$@"); fi
				break ;;
			clean)
				# Same shape again: clean owns everything after it (its
				# optional target list -- tmp+deploy/downloads/sstate --
				# captured verbatim for cmd_clean). 'destroy' stays in the
				# bare branch below: it takes no targets of its own.
				[ -n "$cmd" ] && die "more than one command given: '$cmd' and '$1'" "$SCRIPT_CMD --help"
				cmd="clean"; shift
				if [ "$want_help" -eq 1 ]; then CLEAN_ARGS=("$@" "--help"); else CLEAN_ARGS=("$@"); fi
				break ;;
			exec)
				# Same shape again, with one deliberate difference: the
				# arbitrary user COMMAND that follows must never be mistaken
				# for a mackas flag, so a leading 'help'/-h/--help (from
				# 'mackas help exec CMD...' or 'mackas -h exec CMD...') is
				# PREPENDED, not appended like every other tail-capturer above
				# -- appending would land "--help" at the END of the array,
				# where cmd_exec's own parser (which stops recognizing ITS
				# flags at the first word of CMD) would hand it to the user's
				# command as an argument instead of treating it as a help
				# request.
				[ -n "$cmd" ] && die "more than one command given: '$cmd' and '$1'" "$SCRIPT_CMD --help"
				cmd="exec"; shift
				if [ "$want_help" -eq 1 ]; then EXEC_ARGS=("--help" "$@"); else EXEC_ARGS=("$@"); fi
				break ;;
			monitor)
				# Same shape again: monitor owns everything after it
				# (--port/--once), captured verbatim for cmd_monitor.
				[ -n "$cmd" ] && die "more than one command given: '$cmd' and '$1'" "$SCRIPT_CMD --help"
				cmd="monitor"; shift
				if [ "$want_help" -eq 1 ]; then MONITOR_ARGS=("$@" "--help"); else MONITOR_ARGS=("$@"); fi
				break ;;
			set)
				# Same shape again: set owns everything after it (NAME and
				# VALUE), captured verbatim for cmd_set. Persists to the config
				# file -- see set_usage -- unlike the ephemeral --set flag.
				[ -n "$cmd" ] && die "more than one command given: '$cmd' and '$1'" "$SCRIPT_CMD --help"
				cmd="set"; shift
				if [ "$want_help" -eq 1 ]; then SET_ARGS=("$@" "--help"); else SET_ARGS=("$@"); fi
				break ;;
			get)
				[ -n "$cmd" ] && die "more than one command given: '$cmd' and '$1'" "$SCRIPT_CMD --help"
				cmd="get"; shift
				if [ "$want_help" -eq 1 ]; then GET_ARGS=("$@" "--help"); else GET_ARGS=("$@"); fi
				break ;;
			unset)
				[ -n "$cmd" ] && die "more than one command given: '$cmd' and '$1'" "$SCRIPT_CMD --help"
				cmd="unset"; shift
				if [ "$want_help" -eq 1 ]; then UNSET_ARGS=("$@" "--help"); else UNSET_ARGS=("$@"); fi
				break ;;
			setup)
				# Same shape as `volume`: setup owns everything after it (an
				# optional positional root path and its own --tmpdir-size/
				# --sstate-size/--downloads-size flags), captured verbatim for
				# cmd_setup.
				[ -n "$cmd" ] && die "more than one command given: '$cmd' and '$1'" "$SCRIPT_CMD --help"
				cmd="setup"; shift
				if [ "$want_help" -eq 1 ]; then SETUP_ARGS=("$@" "--help"); else SETUP_ARGS=("$@"); fi
				break ;;
			adopt)
				# Same shape again: adopt owns everything after it (its
				# positional path and --project-dir/--config), captured
				# verbatim for cmd_adopt.
				[ -n "$cmd" ] && die "more than one command given: '$cmd' and '$1'" "$SCRIPT_CMD --help"
				cmd="adopt"; shift
				if [ "$want_help" -eq 1 ]; then ADOPT_ARGS=("$@" "--help"); else ADOPT_ARGS=("$@"); fi
				break ;;
			project)
				# Same shape again: project owns everything after it (its
				# verb, 'add', and that verb's own args), captured verbatim
				# for cmd_project. Exact-string case matching means this can
				# never collide with the existing, plural, read-only
				# 'projects' command below.
				[ -n "$cmd" ] && die "more than one command given: '$cmd' and '$1'" "$SCRIPT_CMD --help"
				cmd="project"; shift
				if [ "$want_help" -eq 1 ]; then PROJECT_ARGS=("$@" "--help"); else PROJECT_ARGS=("$@"); fi
				break ;;
			runtime-args)
				# Same shape again: runtime-args owns everything after it
				# (--require-volumes-free), captured verbatim for
				# cmd_runtime_args.
				[ -n "$cmd" ] && die "more than one command given: '$cmd' and '$1'" "$SCRIPT_CMD --help"
				cmd="runtime-args"; shift
				if [ "$want_help" -eq 1 ]; then RUNTIME_ARGS_ARGS=("$@" "--help"); else RUNTIME_ARGS_ARGS=("$@"); fi
				break ;;
			check|smoketest|status|shell|destroy|lock|dump|projects)
				[ -n "$cmd" ] && die "more than one command given: '$cmd' and '$1'" "$SCRIPT_CMD --help"
				cmd="$1"; shift ;;
			*) die "unknown command: $1" "$SCRIPT_CMD --help  (commands: check setup adopt project smoketest status shell exec retrieve buildstats sstate monitor clean destroy volume set get unset projects runtime-args lock dump help)" ;;
		esac
	done

	SCRIPT_SUBCOMMAND="${cmd:-check}"

	snapshot_env
	set_defaults
	snapshot_defaults

	# Showing help -- whether bare 'help'/'-h' or 'X --help'/'X help'/'help X'
	# for any command X -- never loads the config file. Its text mentions a
	# few settings, so it still needs the defaults, the environment and --set
	# -- but none of those execute anything, whereas the config file is
	# SOURCED AS SHELL. Running a stranger's shell code to print a usage
	# message is a trade with nothing on the win side, so any --help path
	# skips load_config entirely and stays safe to type in any directory.
	if [ "$want_help" -ne 1 ]; then
		case "${cmd:-check}" in
			# See load_config's comment: only these three may target a
			# --config/$MACKAS_CONF path, or a --project name, that does not
			# exist yet.
			set|get|unset) load_config "$config_flag" 1 "$project_flag" ;;
			*)              load_config "$config_flag" 0 "$project_flag" ;;
		esac
		mark_explicit_from_config
	fi
	restore_env
	apply_cli_overrides
	validate_settings
	derive_paths

	# A bare 'help'/'-h' (no command named at all) shows the general usage.
	# volume/retrieve/buildstats/sstate/monitor/runtime-args/set/get/unset handle their OWN --help
	# internally (via the "--help" appended to their *_ARGS above), so they
	# are dispatched normally either way, below.
	if [ "$want_help" -eq 1 ] && [ -z "$cmd" ]; then
		usage
		return 0
	fi

	case "${cmd:-check}" in
		check)     if [ "$want_help" -eq 1 ]; then check_usage;     else cmd_check;     fi ;;
		setup)     if [ "$want_help" -eq 1 ]; then setup_usage;     else cmd_setup ${SETUP_ARGS+"${SETUP_ARGS[@]}"}; fi ;;
		adopt)      cmd_adopt ${ADOPT_ARGS+"${ADOPT_ARGS[@]}"} ;;
		project)    cmd_project ${PROJECT_ARGS+"${PROJECT_ARGS[@]}"} ;;
		smoketest) if [ "$want_help" -eq 1 ]; then smoketest_usage; else cmd_smoketest; fi ;;
		status)    if [ "$want_help" -eq 1 ]; then status_usage;    else cmd_status;    fi ;;
		shell)     if [ "$want_help" -eq 1 ]; then shell_usage;     else cmd_shell;     fi ;;
		destroy)   if [ "$want_help" -eq 1 ]; then destroy_usage;   else cmd_destroy;   fi ;;
		runtime-args) cmd_runtime_args ${RUNTIME_ARGS_ARGS+"${RUNTIME_ARGS_ARGS[@]}"} ;;
		lock)      if [ "$want_help" -eq 1 ]; then lock_usage;      else cmd_lock;      fi ;;
		dump)      if [ "$want_help" -eq 1 ]; then dump_usage;      else cmd_dump;      fi ;;
		projects)  if [ "$want_help" -eq 1 ]; then projects_usage;  else cmd_projects;  fi ;;
		clean)      cmd_clean ${CLEAN_ARGS+"${CLEAN_ARGS[@]}"} ;;
		exec)       cmd_exec ${EXEC_ARGS+"${EXEC_ARGS[@]}"} ;;
		volume)     cmd_volume ${VOLUME_ARGS+"${VOLUME_ARGS[@]}"} ;;
		retrieve)   cmd_retrieve ${RETRIEVE_ARGS+"${RETRIEVE_ARGS[@]}"} ;;
		buildstats) cmd_buildstats ${BUILDSTATS_ARGS+"${BUILDSTATS_ARGS[@]}"} ;;
		buildhistory) cmd_buildhistory ${BUILDHISTORY_ARGS+"${BUILDHISTORY_ARGS[@]}"} ;;
		sstate)     cmd_sstate ${SSTATE_ARGS+"${SSTATE_ARGS[@]}"} ;;
		monitor)    cmd_monitor ${MONITOR_ARGS+"${MONITOR_ARGS[@]}"} ;;
		set)        cmd_set ${SET_ARGS+"${SET_ARGS[@]}"} ;;
		get)        cmd_get ${GET_ARGS+"${GET_ARGS[@]}"} ;;
		unset)      cmd_unset ${UNSET_ARGS+"${UNSET_ARGS[@]}"} ;;
	esac
}

# Running main is skipped when MACKAS_LIB_ONLY=1, which lets the test suite
# source this file to unit-test the pure helper functions in isolation. It
# has no effect on normal use.
if [ "${MACKAS_LIB_ONLY:-0}" != "1" ]; then
	main "$@"
fi
