			--config|--config=*|--set|--set=*) die_on_misplaced_global_flag "$1" monitor ;;
			-*) die "unknown option for 'monitor': $1" "$SCRIPT_CMD monitor --help" ;;
			*) die "unexpected argument for 'monitor': $1" "$SCRIPT_CMD monitor --help" ;;
		esac
	done

	if [ "$want_help" -eq 1 ]; then
		monitor_usage
		return 0
	fi

	local tool="$SCRIPT_DIR/tools/mackas-monitor"
	if [ ! -f "$tool" ] || [ ! -x /usr/bin/python3 ]; then
		warn "monitor tool not found at $tool; skipping"
		return 1
	fi

	local args=(--port "$port")
	[ "$once" -eq 1 ] && args+=(--once)
	/usr/bin/python3 "$tool" "${args[@]}"
}

show() { printf '  %-24s %s\n' "$1" "$2"; }

# One line per volume: name, what it backs, cap, and what it costs today.
status_volume() {
	local name="$1" size="$2" role="$3" img used="" moved="" near_cap=0
	img="$CONTAINER_VOLUMES_DIR/$name/volume.img"
	# du -h already reports actual disk BLOCKS allocated (sparse-aware on
	# APFS), not volume.img's logical/apparent size -- this is real usage,
	# not the cap, even when it reads the same as the cap. See the note
	# under "total cap" below for why "on disk" can still climb to the cap:
	# ext4 freeing space inside the guest does not, by itself, punch holes
	# in the host image.
	[ -e "$img" ] && used="$(du -h "$img" 2>/dev/null | awk '{print $1}')"
	if [ -n "$used" ]; then
		local used_gb cap_gb
		used_gb="$(size_to_gb "$used")"
		cap_gb="$(size_to_gb "$size")"
		[ "$cap_gb" -gt 0 ] && [ "$((used_gb * 100 / cap_gb))" -ge 90 ] && near_cap=1
	fi
	# A per-volume symlink here means `volume move` (or `recover`) relocated it;
	# the symlink is the record, so read it straight back.
	[ -L "$CONTAINER_VOLUMES_DIR/$name" ] && moved="$(readlink "$CONTAINER_VOLUMES_DIR/$name")"
	if volume_exists "$name"; then
		printf '  %s[yes]%s %-22s %-22s cap %-5s %s\n' "$C_GRN" "$C_RST" \
			"$name" "$role" "$size" "${used:+on disk: $used}"
	else
		printf '  %s[ no]%s %-22s %-22s cap %-5s (%s setup)\n' "$C_DIM" "$C_RST" \
			"$name" "$role" "$size" "$SCRIPT_NAME"
	fi
	if [ -n "$moved" ]; then
		printf '        %smoved to: %s%s\n' "$C_BLU" "$moved" "$C_RST"
	fi
	if [ "$near_cap" -eq 1 ]; then
		printf '        %snear cap -- freed ext4 blocks do not shrink volume.img on their own;\n' "$C_YEL"
		printf '        reclaim it: %s volume fstrim %s%s\n' "$SCRIPT_NAME" "$name" "$C_RST"
	fi
}

status_usage() {
	cat <<EOF
${C_BLD}$SCRIPT_CMD status${C_RST} -- show what is configured and what exists on disk.

${C_BLD}USAGE${C_RST}
  $SCRIPT_CMD status

Read-only, like check, but reports state rather than grading it: every
resolved setting and where it came from, derived paths, whether env.sh/
kas-container/the project checkout/gitconfig exist, the container runtime's
own state, the three ext4 volumes (cap vs. real on-disk cost, and a reclaim
hint when one is near its cap), free disk space, and recent logs/artifacts.

Options: --dry-run, -y/--yes (or -f/--force) and -v/--verbose work here too,
though status reads only and never prompts, so none of them change anything.
EOF
}

cmd_status() {
	hdr "Configuration"
	show "config file"        "${CONFIG_FILE_USED:-<none: built-in defaults>}"
	local n
	for n in $SETTING_NAMES; do
		eval "show \"\$n\" \"\${$n}\""
	done

	# status never dies on a missing root -- it is the command you run to find
	# out that it is missing -- but it must not let a blank line be the only
	# clue either.
	if [ -z "$MACKAS_ROOT" ]; then
		hdr "MACKAS_ROOT is not set"
		info "  Commands fall back to the current directory (with a warning). There is"
		info "  no baked-in default because OE needs a case-sensitive filesystem and a"
		info "  stock Mac's home is case-insensitive APFS; the derived paths below stay"
		info "  empty until you set it. For a real build point it at a proper volume:"
		root_hint | sed 's/^/  /'
	fi

	hdr "Derived paths"
	show "MACKAS_BASE (in use)"   "$MACKAS_BASE"
	show "kas work dir"       "$MACKAS_WORK"
	show "project checkout"   "$MACKAS_PROJECT"
	show "kas files"          "$KAS_FILES_ARG"
	show "env.sh"             "$MACKAS_ENV_SH"
	show "shim"               "$SHIM_DIR/docker"

	hdr "Present?"
	local p
	for p in "$MACKAS_ROOT" "$MACKAS_SHORT_LINK" "$MACKAS_ENV_SH" "$KAS_CONTAINER_BIN" \
	         "$SHIM_DIR/docker" "$MACKAS_PROJECT" "$MACKAS_KAS_FRAGMENT_SRC" "$MACKAS_KAS_FRAGMENT_REPO"; do
		if [ -e "$p" ]; then
			printf '  %s[yes]%s %s\n' "$C_GRN" "$C_RST" "$p"
		else
			printf '  %s[ no]%s %s\n' "$C_DIM" "$C_RST" "$p"
		fi
	done

	hdr "Runtime"
	if container_running; then
		show "container system" "running"
	else
		show "container system" "NOT running  (container system start)"
	fi
	if image_present "$KAS_IMAGE"; then show "image" "$KAS_IMAGE present"
	else show "image" "$KAS_IMAGE NOT pulled  ($SCRIPT_CMD setup)"; fi
	# Not `$(resolved_docker || echo '<none>')`: resolved_docker ends in
	# `|| true`, so it always exits 0 and that fallback could never fire --
	# a missing docker printed an empty line instead. The emptiness of the
	# output is the signal, not the exit status.
	local docker_path
	docker_path="$(resolved_docker)"
	show "docker resolves to"  "${docker_path:-<none>}"

	hdr "ext4 volumes"
	status_volume "$MACKAS_VOL_TMP"    "$MACKAS_VOLUME_SIZE_TMP"    "/build      TMPDIR"
	status_volume "$MACKAS_VOL_DL"     "$MACKAS_VOLUME_SIZE_DL"     "/downloads  DL_DIR"
	status_volume "$MACKAS_VOL_SSTATE" "$MACKAS_VOLUME_SIZE_SSTATE" "/sstate     SSTATE_DIR"
	if volume_exists "$MACKAS_VOL_LEGACY"; then
		printf '  %s[old]%s %-22s unused leftover of the single-volume scheme\n' \
			"$C_YEL" "$C_RST" "$MACKAS_VOL_LEGACY"
		printf '        %sremove with: container volume delete %s%s\n' \
			"$C_BLU" "$(printf '%q' "$MACKAS_VOL_LEGACY")" "$C_RST"
	fi
	show "total cap" "$(total_volume_gb) GiB (sparse: costs only what is used)"
	info ""
	info "  \"on disk\" is REAL usage (du, sparse-aware), never the cap. It only"
	info "  drops after an explicit fstrim hole-punches freed ext4 blocks back out"
	info "  of the host image -- ext4 freeing space inside the guest does not do"
	info "  that by itself. '$SCRIPT_CMD volume fstrim <name>|all' reclaims it."
	info ""
	info "  Their contents are NOT visible on the host -- they are ext4 images. To"
	info "  look inside: $SCRIPT_CMD shell"

	hdr "Effective kas --runtime-args"
	printf '  %s\n' "$(kas_runtime_args)"

	if [ -d "$MACKAS_ROOT" ]; then
		hdr "Disk"
		show "free on target" "$(free_gb_for "$MACKAS_ROOT") GiB"
		show "MACKAS_ROOT size"   "$(du -sh "$MACKAS_ROOT" 2>/dev/null | awk '{print $1}')"
	fi

	if [ -d "$MACKAS_LOGS" ]; then
		hdr "Recent logs"
		# shellcheck disable=SC2012  # our own log filenames, all well-behaved
		ls -t "$MACKAS_LOGS" 2>/dev/null | head -5 | sed 's/^/  /'
	fi

	if [ -n "$MACKAS_BASE" ]; then
		hdr "Artifacts"
		local artdir="$MACKAS_BASE/artifacts"
		if [ -d "$artdir" ]; then
			show "buildstats dest" "$artdir"
			# shellcheck disable=SC2012  # our own dir names, all well-behaved
			ls -1 "$artdir" 2>/dev/null | head -5 | sed 's/^/    /'
		else
			show "buildstats dest" "$artdir (empty; run '$SCRIPT_CMD retrieve buildstats')"
		fi
		info ""
		info "  The volumes' tmp/{buildstats,log,deploy} are not visible on the host."
		info "  Copy them out with: $SCRIPT_CMD retrieve buildstats [logs] [deploy]"
	fi
}

clean_usage() {
	cat <<EOF
${C_BLD}$SCRIPT_CMD clean${C_RST} -- drop the TMPDIR volume (recreated empty). Keeps the
downloads/sstate volumes and the project checkout.

${C_BLD}USAGE${C_RST}
  $SCRIPT_CMD clean

Deletes and recreates only the TMPDIR volume, so the next build starts with a
clean \${TMPDIR} but reuses everything already fetched/cached in DL_DIR and
SSTATE_DIR -- having them in separate volumes is exactly why this works.
Unlike '$SCRIPT_CMD destroy', this never touches \$MACKAS_ROOT or the short
symlink, and only prompts once (no typed confirmation word).

Options: --dry-run, -y/--yes (or -f/--force) and -v/--verbose work here too.
EOF
}

destroy_usage() {
	cat <<EOF
${C_BLD}$SCRIPT_CMD destroy${C_RST} -- remove all four volumes (the three active ones
plus a rarely-present legacy one), \$MACKAS_ROOT and the short symlink.

${C_BLD}USAGE${C_RST}
  $SCRIPT_CMD destroy

The widest-blast-radius command mackas has: every ext4 volume, the project
checkout, logs and artifacts under \$MACKAS_ROOT, and the \$MACKAS_SHORT_LINK
symlink, all gone. Refuses to remove \$MACKAS_ROOT if any volume survives
deletion (e.g. still in use), so a partial failure never silently drops the
checkout while leaving orphaned volumes behind.

For a narrower reset, see '$SCRIPT_CMD clean' (TMPDIR only) or
'$SCRIPT_CMD volume destroy --all' (every volume, but not \$MACKAS_ROOT).

Requires typing the word DESTROY to confirm, unless -y/--yes/-f/--force is
given (required for non-interactive use). --dry-run and -v/--verbose also
work here.
EOF
}

cmd_clean() {
	require_mackas_root
	local destroy="$1"
	local what

	if [ "$destroy" = "1" ]; then
		what="EVERYTHING: all three ext4 volumes ($MACKAS_VOL_TMP, $MACKAS_VOL_DL,
  $MACKAS_VOL_SSTATE -- so downloads and sstate too), $MACKAS_ROOT (the project
  checkout and logs), and the $MACKAS_SHORT_LINK symlink"
	else
		what="the TMPDIR volume '$MACKAS_VOL_TMP' (recreated empty) and $MACKAS_LOGS
  (the '$MACKAS_VOL_DL' and '$MACKAS_VOL_SSTATE' cache volumes and the project
  checkout are KEPT -- having them in separate volumes is exactly why this works)"
	fi

	printf '\n%s%s WARNING %s\n' "$C_RED$C_BLD" "===" "===$C_RST"
	printf '%sThis will PERMANENTLY DELETE %s%s\n\n' "$C_RED" "$what" "$C_RST"

	if [ "$destroy" = "1" ]; then
		# du fails if MACKAS_ROOT is already gone; pipefail would make the bare
		# assignment abort the whole script under set -e.
		local sz=""
		sz="$(du -sh "$MACKAS_ROOT" 2>/dev/null | awk '{print $1}' || true)"
		if [ -n "$sz" ]; then
			printf '%s%s currently holds %s.%s\n\n' "$C_RED" "$MACKAS_ROOT" "$sz" "$C_RST"
		fi
		if [ "$DRY_RUN" -eq 1 ]; then
			warn "--dry-run: skipping the DESTROY confirmation; nothing will be removed."
		elif [ "$ASSUME_YES" -ne 1 ]; then
			if [ ! -t 0 ]; then
				die "destroy needs a terminal or --yes" "$SCRIPT_CMD destroy --yes"
			fi
			printf '%sType the word DESTROY to confirm: %s' "$C_BLD" "$C_RST"
			local reply=""
			read -r reply || true
			[ "$reply" = "DESTROY" ] || { info "Aborted. Nothing was removed."; return 1; }
		fi
	else
		confirm "Proceed?" || { info "Aborted. Nothing was removed."; return 1; }
	fi

	if [ "$destroy" = "1" ]; then
		# Delete every volume FIRST and tally the survivors, BEFORE touching the
		# symlink or rm -rf-ing anything. Order is the whole fix: with
		# MACKAS_RELOCATE_VOLUMES=1 the volumes' LIVE backing images sit inside
		# $MACKAS_ROOT/container-volumes, so removing the symlink and then
		# rm -rf $MACKAS_ROOT while a volume refused to delete would erase that
		# volume's image out from under a possibly-running VM -- and take any
		# unrelated foreign volumes with it. So a survivor aborts here, before
		# any of that runs.
		local v survivors=0
		for v in "$MACKAS_VOL_TMP" "$MACKAS_VOL_DL" "$MACKAS_VOL_SSTATE" "$MACKAS_VOL_LEGACY"; do
			delete_volume "$v" || survivors=$((survivors + 1))
		done
		if [ "$survivors" -ne 0 ]; then
			err "$survivors volume(s) could NOT be removed (see the warnings above)"
			die "destroy did not finish: some volumes survive -- refusing to remove $MACKAS_ROOT" \
				"container volume ls   -- then stop whatever is using them and re-run"
		fi

		# All our volumes are gone. If setup relocated the container volumes dir
		# onto the SSD, its REAL directory is $MACKAS_ROOT/container-volumes and
		# may STILL hold FOREIGN volumes that setup_relocate_volumes rsync'd in
		# from the internal disk. Move whatever remains back to the internal disk
		# before removing the symlink or $MACKAS_ROOT -- rm -rf must never take a
		# volume we did not create. This is the exact inverse of setup's move.
		if [ -L "$CONTAINER_VOLUMES_DIR" ]; then
			local reloc leftover=0
			reloc="$(readlink "$CONTAINER_VOLUMES_DIR")"
			if [ -d "$reloc" ]; then
				# shellcheck disable=SC2012  # counting entries; names irrelevant
				leftover="$(ls -A "$reloc" 2>/dev/null | wc -l | tr -d ' ')"
			fi
			run rm -f "$CONTAINER_VOLUMES_DIR"
			if [ "$leftover" -gt 0 ]; then
				run mv "$reloc" "$CONTAINER_VOLUMES_DIR"
				did "moved $leftover foreign volume(s) back to $CONTAINER_VOLUMES_DIR"
			else
				run mkdir -p "$CONTAINER_VOLUMES_DIR"
				did "restored $CONTAINER_VOLUMES_DIR to a real directory"
			fi
		fi
		if [ -L "$MACKAS_SHORT_LINK" ]; then
			run rm -f "$MACKAS_SHORT_LINK"
		fi
		# Delete through the REAL path, never through the symlink.
		if [ -d "$MACKAS_ROOT" ]; then
			run rm -rf "$MACKAS_ROOT"
			did "destroyed $MACKAS_ROOT"
		else
			did "$MACKAS_ROOT was already gone"
		fi
	else
		# TMPDIR is a whole volume, so cleaning it is delete + recreate rather
		# than rm -rf: it is faster, it cannot leave a half-deleted tree behind,
		# and it hands back the sparse image's disk space in one go. The dl and
		# sstate volumes are never touched here -- that is the entire reason
		# they are separate volumes.
		#
		# Bail out rather than fall through to ensure_volume if the delete
		# failed: ensure_volume would find the volume still present, skip
		# creating it, and `clean` would report a cleaned TMPDIR over the old
		# contents, still there.
		if volume_exists "$MACKAS_VOL_TMP"; then
			delete_volume "$MACKAS_VOL_TMP" || \
				die "cannot clean TMPDIR: volume '$MACKAS_VOL_TMP' could not be removed" \
					"stop anything still using it (mackas volume list) and re-run '$SCRIPT_CMD clean'"
		fi
		ensure_volume "$MACKAS_VOL_TMP" "$MACKAS_VOLUME_SIZE_TMP" "TMPDIR -> /build"
		if [ -d "$MACKAS_LOGS" ]; then
			run rm -rf "$MACKAS_LOGS"; run mkdir -p "$MACKAS_LOGS"
		fi
		did "cleaned TMPDIR; '$MACKAS_VOL_DL' and '$MACKAS_VOL_SSTATE' kept"
	fi
}

# ---------------------------------------------------------------------------
# volume -- manage the ext4 container volumes: list, fstrim (reclaim), duplicate
# and destroy an arbitrary one. These operate on `container` volumes directly
# (under CONTAINER_VOLUMES_DIR), so they do not need MACKAS_ROOT -- the volume
# names are derived from MACKAS_VOLUME_NAME, which has a default.
# ---------------------------------------------------------------------------

# KiB -> human. `du` on APFS reports allocated blocks, i.e. what a sparse image
# actually costs, so this formats the SAME quantity for before/after/reclaimed
# and they stay internally consistent (a plain `du -h` uses the locale decimal
# separator -- "2,3M" here -- which we deliberately avoid for the numbers we
# compute on).
fmt_kb() {
	local kb="$1"
	[ "$kb" -lt 0 ] && kb=0
	# LC_ALL=C so the decimal separator is always '.', not the locale's ','
	# (awk honours LC_NUMERIC), keeping the output predictable and testable.
	if [ "$kb" -ge 1048576 ]; then
		LC_ALL=C awk -v k="$kb" 'BEGIN { printf "%.1fG", k / 1048576 }'
	elif [ "$kb" -ge 1024 ]; then
		LC_ALL=C awk -v k="$kb" 'BEGIN { printf "%.1fM", k / 1024 }'
	else
		printf '%dK' "$kb"
	fi
}

# du of a volume's backing image, in KiB (blocks actually used). Empty if the
# image is absent (e.g. a volume that exists but was never written to). A `du`
# that fails on an EXISTING image (a dangling relocation symlink, a permission
# hiccup) must also degrade to empty, not abort: this runs inside `used_kb="$(
# volume_img_kb ...)"` under `set -e`+pipefail, so a failing pipeline here would
# otherwise kill `volume list` mid-listing. `|| true` keeps the listing going;
# the caller renders empty as "-".
volume_img_kb() {
	local img="$1"
	[ -e "$img" ] || return 0
	du -k "$img" 2>/dev/null | awk '{print $1; exit}' || true
}

# The configured (declared) size of a volume, read from `container volume
# inspect`'s JSON -- the "size" field under configuration.options, e.g. "800M".
# Parsed with sed, not jq (stdlib only). "sizeInBytes" cannot be mismatched:
# the pattern requires the closing quote right after `size`, which only the
# options."size" line has.
volume_size() {
	container volume inspect "$1" 2>/dev/null \
		| sed -n 's/.*"size"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
		| head -1
}

# Mark a volume name: which of the three mackas volumes it is (or the legacy
# single-volume leftover), for `volume list`.
volume_role() {
	case "$1" in
		"$MACKAS_VOL_TMP")    printf 'mackas/tmp' ;;
		"$MACKAS_VOL_DL")     printf 'mackas/dl' ;;
		"$MACKAS_VOL_SSTATE") printf 'mackas/sstate' ;;
		"$MACKAS_VOL_LEGACY") printf 'old' ;;
		*)                    printf '-' ;;
	esac
}

# volume list -- every container volume, with its configured cap, what its
# volume.img actually costs on disk today, and whether a running VM holds it.
# The on-disk column is the whole motivation for `fstrim`: sparse ext4 images
# only ratchet up, so this is where you SEE one that has grown far past what it
# still holds.
volume_list() {
	[ "$#" -eq 0 ] || die "'volume list' takes no arguments" "$SCRIPT_CMD volume list"

	hdr "Container volumes"
	printf '  %-24s %-14s %-8s %-10s %s\n' "NAME" "ROLE" "CAP" "ON DISK" "IN USE"

	# One `container volume ls`. Its OPTIONS column carries `size=<cap>`; pull
	# the name (field 1) and that cap out in one pass, tab-separated so a value
	# can never be confused for a column boundary.
	local rows
	rows="$(container volume ls 2>/dev/null | awk '
		NR > 1 {
			name = $1
			cap = ""
			for (i = 2; i <= NF; i++) if ($i ~ /^size=/) cap = substr($i, 6)
			print name "\t" cap
		}')"

	if [ -z "$rows" ]; then
		info "  (no volumes)"
		return 0
	fi

	local name cap img used_kb used inuse moved
	while IFS="$(printf '\t')" read -r name cap; do
		[ -n "$name" ] || continue
		img="$CONTAINER_VOLUMES_DIR/$name/volume.img"
		used_kb="$(volume_img_kb "$img")"
		if [ -n "$used_kb" ]; then used="$(fmt_kb "$used_kb")"; else used="-"; fi
		if volume_in_use "$name"; then inuse="yes"; else inuse="no"; fi
		printf '  %-24s %-14s %-8s %-10s %s\n' \
			"$name" "$(volume_role "$name")" "${cap:--}" "$used" "$inuse"
		# A per-volume symlink at the runtime path means `volume move` relocated
		# it; the ON DISK figure was measured THROUGH that symlink, so note where
		# the image actually lives (matching `status`'s "moved to:").
		if [ -L "$CONTAINER_VOLUMES_DIR/$name" ]; then
			moved="$(readlink "$CONTAINER_VOLUMES_DIR/$name")"
			printf '  %s-> moved to: %s%s\n' "$C_DIM" "$moved" "$C_RST"
		fi
	done <<EOF
$rows
EOF

	info ""
	info "  ON DISK is what volume.img costs right now -- a sparse ext4 image only"
	info "  grows; deleting files inside the guest never shrinks it. Reclaim the"
	info "  freed space with: $SCRIPT_CMD volume fstrim <name>   (or 'all')"
}

# fstrim ONE volume. Returns non-zero on a real failure; when called from
# 'all' a missing/busy volume is skipped (warned) rather than fatal.
volume_fstrim_one() {
	local name="$1" from_all="${2:-0}"

	if ! volume_exists "$name"; then
		if [ "$from_all" -eq 1 ]; then
			warn "  volume '$name' does not exist; skipping"
			return 0
		fi
		die "volume '$name' does not exist" "$SCRIPT_CMD volume list"
	fi

	# One-VM rule: an ext4 image mounted by two VMs at once corrupts. Refuse to
	# attach a volume a running build still holds rather than race it.
	if volume_in_use "$name"; then
		if [ "$from_all" -eq 1 ]; then
			warn "  volume '$name' is attached to a running container; skipping (one-VM rule)"
			return 0
		fi
		die "volume '$name' is attached to a running container" \
			"only ONE VM may touch an ext4 image at a time; stop the build first (mackas volume list), then re-run '$SCRIPT_CMD volume fstrim $name'"
	fi

	local img="$CONTAINER_VOLUMES_DIR/$name/volume.img"
	local before_kb
	before_kb="$(volume_img_kb "$img")"

	info "${C_BLD}mackas volume fstrim $name${C_RST}"
	info "  on disk before: $(fmt_kb "${before_kb:-0}")"

	# The recipe, measured on this machine (an 800M image with 600M deleted
	# inside fell to 202M in 0.01s):
	#
	#   container run --rm -u 0:0 --cap-add CAP_SYS_ADMIN -v NAME:/mnt IMAGE fstrim -v /mnt
	#
	# Apple's own tooling never issues discards, but the hypervisor's
	# virtio-blk backend DOES implement DISCARD -> host hole-punch (the guest's
	# discard_max_bytes is non-zero). fstrim inside the guest is what triggers
	# it. BOTH flags are required and neither alone works:
	#   -u 0:0            the kas image's default user is uid 30000 and gets
	#                     EPERM on the FITRIM ioctl.
	#   --cap-add CAP_SYS_ADMIN   root without the cap still gets EPERM; the cap
	#                     is dropped across the privilege-dropping exec otherwise.
	# util-linux fstrim already ships in the kas image (no apk needed).
	#
	# NOT `hdiutil compact`: it returns "Function not implemented" on these raw
	# ext4 images, so we do not attempt it.
	if [ "$DRY_RUN" -eq 1 ]; then
		run container run --rm -u 0:0 --cap-add CAP_SYS_ADMIN -v "$name:/mnt" "$KAS_IMAGE" fstrim -v /mnt
		info "  (dry-run: nothing was reclaimed)"
		return 0
	fi

	vrb "+ $(quote_cmd container run --rm -u 0:0 --cap-add CAP_SYS_ADMIN -v "$name:/mnt" "$KAS_IMAGE" fstrim -v /mnt)"
	# `|| st=$?` so a non-zero fstrim does not abort under `set -e` -- we handle
	# the failure ourselves below (a device with discard_max_bytes=0 errors here).
	local out st=0
	out="$(container run --rm -u 0:0 --cap-add CAP_SYS_ADMIN -v "$name:/mnt" "$KAS_IMAGE" fstrim -v /mnt 2>&1)" || st=$?
	[ -n "$out" ] && printf '%s\n' "$out" | sed 's/^/  fstrim: /'

	if [ "$st" -ne 0 ]; then
		# Some backing filesystems report discard_max_bytes=0 and fstrim
		# errors on the FITRIM ioctl. Say so rather than claim a reclaim that
		# never happened. Measured live: this is not a stale-volume or
		# mackas-side problem -- a completely fresh volume fails identically
		# -- it is whatever filesystem MACKAS_ROOT (and so
		# CONTAINER_VOLUMES_DIR, symlinked under it) actually sits on. APFS
		# supports the sparse-file hole-punch DISCARD needs; ExFAT does not.
		warn "  fstrim did not succeed on '$name' -- this device may not support"
		warn "  discard (discard_max_bytes=0); nothing was reclaimed."
		warn "  This tracks the filesystem $MACKAS_ROOT is on, not a stale volume --"
		warn "  a brand new volume fails the same way on a non-hole-punching host"
		warn "  filesystem (e.g. ExFAT). See docs/storage.md's fstrim section."
		return 1
	fi

	# Report reclaimed space by RE-MEASURING du of volume.img, before -> after.
	# We deliberately do NOT trust fstrim's own "N bytes trimmed" line: that is
	# the guest's free space, not host reclaim, and APFS block sharing (clones)
	# would make any computed figure a lie. The host `du` delta is the truth.
	local after_kb reclaimed_kb
	after_kb="$(volume_img_kb "$img")"
	reclaimed_kb=$(( ${before_kb:-0} - ${after_kb:-0} ))
	[ "$reclaimed_kb" -lt 0 ] && reclaimed_kb=0

	did "fstrim '$name': $(fmt_kb "${before_kb:-0}") -> $(fmt_kb "${after_kb:-0}") (reclaimed $(fmt_kb "$reclaimed_kb"))"
	if [ "$reclaimed_kb" -eq 0 ]; then
		info "  Nothing to reclaim -- the image was already compact."
	fi
	return 0
}

# volume fstrim <name> | all -- reclaim host disk from sparse ext4 image(s).
# "all" is the primary, documented form of this command's object -- 'volume
# fstrim' already reads as verb+object, so a second object value is more
# consistent than a flag. --all/-a are ALSO accepted, as synonyms for 'all',
# purely for consistency with 'volume destroy --all' -- not because the
# verb+object reasoning above was wrong.
volume_fstrim() {
	# fstrim ATTACHES each volume (via volume_fstrim_one), so it is a mutating
	# command and needs a root like the rest. Without one, `all` would expand
	# to the default volume names (oe-build-{tmp,dl,sstate}) and attach the real
	# volumes of whatever install happens to share those names -- the one thing
	# the root gate exists to stop. `volume list`, which only reads, does NOT
	# require a root.
	require_mackas_root
	local do_all=0 names=() a
	for a in "$@"; do
		case "$a" in
			all|-a|--all) do_all=1 ;;
			-*) die "unknown option for 'volume fstrim': $a" \
				"$SCRIPT_CMD volume fstrim <name> | all | --all" ;;
			*) names+=("$a") ;;
		esac
	done

	if [ "$do_all" -eq 1 ]; then
		[ "${#names[@]}" -eq 0 ] || die "'volume fstrim all' takes no volume name" \
			"$SCRIPT_CMD volume fstrim all"
		names=("$MACKAS_VOL_TMP" "$MACKAS_VOL_DL" "$MACKAS_VOL_SSTATE")
	fi

	[ "${#names[@]}" -ge 1 ] || die "'volume fstrim' needs a volume name (or 'all'/--all)" \
		"$SCRIPT_CMD volume fstrim <name> | all | --all"

	local n rc=0
	for n in "${names[@]}"; do
		volume_fstrim_one "$n" "$do_all" || rc=1
	done
	return "$rc"
}

# volume duplicate <source> <duplicate> -- clone a volume cheaply via APFS
# clonefile. Measured at 0.003s: `cp -c` is copy-on-write, so the clone SHARES
# physical blocks with its source and costs almost nothing until one side is
# written. <duplicate> is a NAME YOU CHOOSE for the new volume, not an
# existing one.
volume_duplicate() {
	local src="${1:-}" dst="${2:-}"
	[ -n "$src" ] && [ -n "$dst" ] || die "'volume duplicate' needs <source> and <duplicate>" \
		"$SCRIPT_CMD volume duplicate <source> <duplicate>"
	[ "$#" -le 2 ] || die "'volume duplicate' takes exactly <source> <duplicate>" \
		"$SCRIPT_CMD volume duplicate <source> <duplicate>"
	[ "$src" != "$dst" ] || die "source and duplicate name must differ" \
		"$SCRIPT_CMD volume duplicate <source> <duplicate>"

	volume_exists "$src" || die "source volume '$src' does not exist" "$SCRIPT_CMD volume list"
	if volume_exists "$dst"; then
		die "destination volume '$dst' already exists" \
			"pick a new name, or remove it: $SCRIPT_CMD volume destroy $dst"
	fi

	# One-VM guard on the SOURCE too. The engine guards `rm` against a running
	# container but does NOT guard read access, and cloning a live image
	# (mid-write, dirty journal) yields an inconsistent copy.
	if volume_in_use "$src"; then
		die "source volume '$src' is attached to a running container" \
			"only ONE VM may touch an ext4 image at a time; stop the build first (mackas volume list), then re-run"
	fi

	local size
	size="$(volume_size "$src")"
	[ -n "$size" ] || die "could not read the size of '$src' from 'container volume inspect'" \
		"container volume inspect $src"

	local src_img="$CONTAINER_VOLUMES_DIR/$src/volume.img"
	local dst_img="$CONTAINER_VOLUMES_DIR/$dst/volume.img"

	info "${C_BLD}mackas volume duplicate $src -> $dst${C_RST}"
	info "  size: $size (matched from the source)"

	refuse_if_stale_entity "$dst" || die "destination volume '$dst' already exists" \
		"pick a new name, or remove it: $SCRIPT_CMD volume destroy $dst"

	# 1. Create dst at the SAME size. This writes a valid entity.json we must
	#    NOT edit -- only its volume.img gets swapped underneath it.
	run container volume create -s "$size" "$dst"
	# 2. Drop the fresh (empty) image `create` just made.
	run rm -f "$dst_img"
	# 3. clonefile the source image into its place. `cp -c` asks for a CoW
	#    clone. TRAP: `cp -c` ACROSS APFS volumes silently falls back to a full
	#    byte copy (exit 0, no warning) -- both images live under
	#    CONTAINER_VOLUMES_DIR, so they are same-volume in normal use, but if
	#    that dir is ever relocated onto a different filesystem the "clone"
	#    would quietly become a full copy.
	run cp -c "$src_img" "$dst_img"

	did "duplicated '$src' -> '$dst' (size $size)"
	info "  The clone SHARES physical blocks with '$src' (APFS copy-on-write), so"
	info "  it costs almost nothing on disk until one of the two is written to."
	return 0
}

# volume destroy <name> | --all -- remove ONE arbitrary volume, or (--all/-a)
# every mackas-managed volume: the three active ones plus the legacy
# pre-split leftover, if present. Distinct from the top-level `destroy`,
# which ALSO removes MACKAS_ROOT and the short symlink -- this only ever
# touches volumes. Single-name mode is the counterpart to `duplicate`: remove
# a clone, or a stray zztest-* volume, without touching anything else.
volume_destroy() {
	local name="" do_all=0 a
	for a in "$@"; do
		case "$a" in
			# 'all' is accepted bare too, matching volume_fstrim()'s own
			# 'all|-a|--all' precedent -- the two --all-capable subcommands
			# read the same way, not just the flag-spelled one.
			all|-a|--all) do_all=1 ;;
			-*) die "unknown option for 'volume destroy': $a" \
				"$SCRIPT_CMD volume destroy <name> | all | --all" ;;
			*)
				[ -z "$name" ] || die "'volume destroy' removes one volume at a time" \
					"$SCRIPT_CMD volume destroy <name>"
				name="$a"
				;;
		esac
	done

	if [ "$do_all" -eq 1 ]; then
		[ -z "$name" ] || die "'volume destroy --all' takes no volume name" \
			"$SCRIPT_CMD volume destroy --all"
		# Same reasoning as volume_fstrim()'s root gate: --all expands to
		# names DERIVED from MACKAS_VOLUME_NAME, so an unset MACKAS_ROOT could
		# otherwise mean deleting whatever install happens to share those
		# default names. Destroying is a stronger reason for this gate than
		# fstrim's own attach-only risk, not a weaker one.
		require_mackas_root
		volume_destroy_all
		return $?
	fi

	[ -n "$name" ] || die "'volume destroy' needs a volume name" "$SCRIPT_CMD volume destroy <name>"

	volume_exists "$name" || die "volume '$name' does not exist" "$SCRIPT_CMD volume list"

	if volume_in_use "$name"; then
		die "volume '$name' is attached to a running container" \
			"only ONE VM may touch an ext4 image at a time; stop the build first (mackas volume list), then re-run"
	fi

	local img="$CONTAINER_VOLUMES_DIR/$name/volume.img" before_kb
	before_kb="$(volume_img_kb "$img")"

	confirm "Delete volume '$name'${before_kb:+ (on disk: $(fmt_kb "$before_kb"))}? This cannot be undone." \
		|| { info "Aborted. Nothing was removed."; return 1; }

	delete_volume "$name" || die "could not delete volume '$name'" \
		"stop whatever is using it (mackas volume list) and re-run"
	return 0
}

# volume destroy --all's worker. Unlike the single-name path above, a volume
# that does not exist is normal here (not every install has all four), not an
# error -- and a busy one is skipped with a warning, mirroring
# volume_fstrim_one()'s from_all shape, rather than aborting the whole run.
volume_destroy_all() {
	local names=("$MACKAS_VOL_TMP" "$MACKAS_VOL_DL" "$MACKAS_VOL_SSTATE" "$MACKAS_VOL_LEGACY")
	local n present=() total_kb=0 kb img

	for n in "${names[@]}"; do
		volume_exists "$n" || continue
		present+=("$n")
		img="$CONTAINER_VOLUMES_DIR/$n/volume.img"
		kb="$(volume_img_kb "$img")"
		total_kb=$((total_kb + ${kb:-0}))
	done

	if [ "${#present[@]}" -eq 0 ]; then
		info "no mackas volumes exist -- nothing to destroy"
		return 0
	fi

	confirm "Delete ${#present[@]} volume(s) (${present[*]}) -- $(fmt_kb "$total_kb") total? This cannot be undone." \
		|| { info "Aborted. Nothing was removed."; return 1; }

	local rc=0 removed=()
	for n in "${present[@]}"; do
		if volume_in_use "$n"; then
			warn "  volume '$n' is attached to a running container; skipping (one-VM rule)"
			rc=1
			continue
		fi
		if delete_volume "$n"; then
			removed+=("$n")
		else
			rc=1
		fi
	done

	[ "${#removed[@]}" -eq 0 ] || did "removed ${#removed[@]} volume(s): ${removed[*]}"
	return "$rc"
}

# The real on-disk directory that backs a volume. Normally this is just
# $CONTAINER_VOLUMES_DIR/<name>, but `volume move` (and `recover`) leave a
# SYMLINK there pointing at the image's new home on a roomier disk -- Apple's
# runtime follows it (VERIFIED: it mounts a symlinked volume dir as ext4 with
# data intact). readlink gives the stored absolute target; a plain dir gives
# itself. This is the persistence mechanism: the symlink IS the record of where
# a volume lives, so there is no second state file to drift out of sync.
volume_real_dir() {
	local name="$1"
	local link="$CONTAINER_VOLUMES_DIR/$name"
	if [ -L "$link" ]; then
		readlink "$link"
	else
		printf '%s' "$link"
	fi
}

# True (0) when a volume's runtime location does NOT resolve to a real
# volume.img: a dangling symlink left by a hand-move, or a missing dir/image.
# False (1) when it is healthy. This is what `recover` detects.
volume_broken() {
	local name="$1" real
	real="$(volume_real_dir "$name")"
	[ -f "$real/volume.img" ] && return 1
	return 0
}

# Move a volume's on-disk tree $1 -> $2. cross=1 when the two are on different
# filesystems. Same-fs is a plain `mv` -- an atomic rename. Cross-fs cannot
# rename, and macOS `mv` across filesystems copies a sparse image WITHOUT its
# holes: it writes the image's full logical size in zeros, ballooning a
# 120G-cap TMPDIR to 120G on the destination (needs >= cap free, slow, lands
# un-sparse). So clone it instead: `cp -cR` asks clonefile(2) for a
# copy-on-write clone and, where that is impossible (a different filesystem),
# falls back to a plain copy that STILL preserves holes. The source is removed
# only AFTER the copy returns success, so a crash mid-copy leaves it intact --
# nothing is lost (the copy is not atomic, but the source is the safety net).
volume_transfer() {
	local src="$1" dst="$2" cross="$3"
	if [ "$cross" -eq 1 ]; then
		run cp -cR "$src" "$dst" && run rm -rf "$src"
	else
		run mv "$src" "$dst"
	fi
}

# volume move <name> <dir> -- relocate ONE volume's on-disk image tree to
# <dir>/<name> and leave a symlink at the runtime location so the engine still
# finds it. Apple `container` 1.1.0 has no per-volume storage-root knob, and its
# whole-dir MACKAS_RELOCATE_VOLUMES symlink moves ALL volumes together; this
# moves just one -- e.g. a big TMPDIR onto a disk with more room.
volume_move() {
	local name="${1:-}" dest_dir="${2:-}"
	[ -n "$name" ] && [ -n "$dest_dir" ] || die "'volume move' needs <name> and <dir>" \
		"$SCRIPT_CMD volume move <name> <dir>"
	[ "$#" -le 2 ] || die "'volume move' takes exactly <name> <dir>" \
		"$SCRIPT_CMD volume move <name> <dir>"

	volume_exists "$name" || die "volume '$name' does not exist" "$SCRIPT_CMD volume list"

	# One-VM rule: never relocate an image a running VM still holds. Moving the
	# backing dir of a mounted ext4 image is exactly the double-life the rule
	# forbids.
	if volume_in_use "$name"; then
		die "volume '$name' is attached to a running container" \
			"only ONE VM may touch an ext4 image at a time; stop the build first (mackas volume list), then re-run '$SCRIPT_CMD volume move $name <dir>'"
	fi

	# Absolutise a relative <dir> against $PWD -- a relative destination for a
	# persistent symlink target would be surprising (and, once stored, wrong from
	# any other working directory).
	case "$dest_dir" in
		/*) ;;
		*)  dest_dir="$PWD/$dest_dir" ;;
	esac

	local link="$CONTAINER_VOLUMES_DIR/$name"
	local real_src dest
	real_src="$(volume_real_dir "$name")"   # follows a prior move's symlink
	dest="$dest_dir/$name"

	if [ "$real_src" = "$dest" ]; then
		die "volume '$name' is already located at '$dest'" "nothing to do"
	fi

	# Refuse to move a volume into its own subtree (mv would fail, or worse).
	case "$dest/" in
		"$real_src"/*) die "cannot move '$name' into its own subtree ('$dest' is under '$real_src')" \
			"choose a directory outside '$real_src'" ;;
	esac

	# Moving a relocated volume BACK home: <dir> is the runtime volumes dir, so
	# $dest is the runtime path itself, currently a symlink left by an earlier
	# move-away. This is the inverse of a move -- put the tree back and drop the
	# symlink so the engine sees a plain directory again. (When the volume was
	# never moved, $real_src == $dest and we already died "already located", so
	# reaching here with $dest == $link means $link is that symlink.)
	local moving_home=0
	[ "$dest" = "$link" ] && [ -L "$link" ] && moving_home=1

	# Refuse a destination that already exists, UNLESS it is an empty directory
	# we can reuse (mv into an existing dir would nest, not replace). The
	# move-home symlink at $link is expected, not a collision -- skip the check.
	if [ "$moving_home" -eq 0 ] && { [ -e "$dest" ] || [ -L "$dest" ]; }; then
		if [ -d "$dest" ] && [ ! -L "$dest" ] && [ -z "$(ls -A "$dest" 2>/dev/null)" ]; then
			run rmdir "$dest"
		else
			die "destination '$dest' already exists and is not an empty directory" \
				"pick a different directory, or remove '$dest' first"
		fi
	fi

	info "${C_BLD}mackas volume move $name -> $dest${C_RST}"

	# Same-fs vs cross-fs decides HOW the tree moves. A cross-filesystem move
	# cannot rename and, done with `mv`, would balloon the sparse image to its
	# full logical size (see volume_transfer); cross-fs we clone with holes
	# preserved instead. Either way the copy is not atomic, but the source
	# stays intact until it finishes, so nothing is lost.
	local src_mp dest_mp cross_fs=0
	src_mp="$(volume_mount_point "$real_src")"
	dest_mp="$(volume_mount_point "$dest_dir")"
	if [ "$src_mp" != "$dest_mp" ]; then
		cross_fs=1
		info "  '$dest_dir' is on a different filesystem ($dest_mp) than the image"
		info "  ($src_mp): copying with holes preserved (a CoW clone where the"
		info "  filesystem allows, else a plain sparse copy), then removing the source."
	fi

	run mkdir -p "$dest_dir"

	# The transfer-then-symlink window is crash-sensitive: on a FIRST move the
	# runtime dir is about to move away, and until the replacement symlink lands
	# nothing at $link resolves AND `container volume ls` no longer lists it
	# (entity.json moved with the dir). A Ctrl-C in that gap (the INT trap exits
	# immediately) would strand the volume where a no-arg `recover` scan can't
	# see it. Block INT/TERM across the window and restore the trap after.
	trap '' INT TERM
	if [ "$moving_home" -eq 1 ]; then
		# Drop the relocation symlink, then bring the tree back to the runtime
		# path. Same-fs/cross-fs handling is identical to a normal move.
		run rm -f "$link"
		volume_transfer "$real_src" "$dest" "$cross_fs"
	else
		# Move the tree to its new home: same-fs an atomic rename, cross-fs a
		# holes-preserving copy whose source is removed only after it succeeds.
		volume_transfer "$real_src" "$dest" "$cross_fs"
		# Plant the symlink atomically: create it under a temp name, then mv it
		# into place. Renaming a symlink is atomic, so $link is only ever the OLD
		# state or the NEW one, never absent -- and the mv also replaces a
		# re-move's dangling symlink outright, so no separate `rm -f` is needed.
		run ln -s "$dest" "$link.tmp.$$" && run mv -f "$link.tmp.$$" "$link"
	fi
	trap on_interrupt INT TERM

	if [ "$moving_home" -eq 1 ]; then
		did "moved '$name' back home to '$dest'"
		info "  $link is a plain directory again (no relocation symlink)."
	else
		did "moved '$name' to '$dest'"
		info "  $link -> $dest"
		info "  '$SCRIPT_CMD status' now reports this location; it survives reboots and"
		info "  a re-'$SCRIPT_CMD setup' preserves the symlink."
	fi
	return 0
}

# Ask Spotlight where a volume.img with the right shape lives. Prints one
# candidate directory per line (the dir that CONTAINS volume.img). Test seam:
# MACKAS_MDFIND overrides the mdfind binary, exactly like MACKAS_CONTAINER_BIN.
volume_spotlight_find() {
	local name="$1" mdfind="${MACKAS_MDFIND:-mdfind}" img dir
	# A genuine container volume is <something>/<name>/volume.img with an
	# entity.json sibling. Query by filename, then filter -- kMDItemFSName is the
	# indexed attribute; the structural checks are ours, not Spotlight's.
	"$mdfind" "kMDItemFSName == 'volume.img'" 2>/dev/null | while IFS= read -r img; do
		[ -f "$img" ] || continue
		dir="$(dirname "$img")"
		[ "$(basename "$dir")" = "$name" ] || continue
		[ -f "$dir/entity.json" ] || continue
		printf '%s\n' "$dir"
	done
}

# volume recover [<name>] -- when a volume.img has been moved by hand, the
# runtime location ($CONTAINER_VOLUMES_DIR/<name>) no longer resolves to it.
# Detect that, locate the image with Spotlight, and offer to re-point the
# symlink. Nothing changes without confirmation.
volume_recover() {
	local only="${1:-}"
	[ "$#" -le 1 ] || die "'volume recover' takes at most one <name>" \
		"$SCRIPT_CMD volume recover [<name>]"

	# The set to examine: an explicit name, else the mackas volumes.
	local candidates
	if [ -n "$only" ]; then
		candidates="$only"
	else
		candidates="$MACKAS_VOL_TMP $MACKAS_VOL_DL $MACKAS_VOL_SSTATE $MACKAS_VOL_LEGACY"
	fi

	local name link any=0 fixed=0
	for name in $candidates; do
		link="$CONTAINER_VOLUMES_DIR/$name"

		# Healthy: resolves to a real volume.img. Skip -- but if the user named
		# it explicitly, say so rather than stay silent.
		if ! volume_broken "$name"; then
			[ -n "$only" ] && info "volume '$name' is healthy ($(volume_real_dir "$name")/volume.img)"
			continue
		fi

		# Broken. When scanning (no explicit name), only treat it as broken if
		# there is EVIDENCE the volume should exist -- a dangling symlink left by
		# a hand-move, or the runtime still listing it -- so a volume that was
		# simply never created is not reported as a problem. But an interrupted
		# FIRST move strands a volume with NEITHER (the runtime dir is entirely
		# gone and entity.json moved away with it), so before concluding "never
		# created", ask Spotlight: if it finds a matching image, the volume is
		# stranded and worth recovering; if not, stay silent.
		if [ -z "$only" ] && [ ! -L "$link" ] && ! volume_exists "$name"; then
			[ -n "$(volume_spotlight_find "$name")" ] || continue
		fi

		any=1
		err "volume '$name' does not resolve to a volume.img (looked at $link)"

		# Ask Spotlight where it went. Exclude the current broken location.
		local matches match count=0 chosen=""
		matches="$(volume_spotlight_find "$name" | grep -vxF "$(volume_real_dir "$name")" || true)"
		if [ -n "$matches" ]; then
			count="$(printf '%s\n' "$matches" | grep -c .)"
		fi

		if [ "$count" -eq 0 ]; then
			# Spotlight found nothing. Is the likely disk even indexed?
			local disk="$MACKAS_ROOT"
			if command -v mdutil >/dev/null 2>&1 && \
			   mdutil -s "$disk" 2>/dev/null | grep -qi "disabled"; then
				warn "  Spotlight indexing is off for $disk, so it cannot search there."
				info "  Re-point by hand once you know the path:"
				info "    ln -s <the-dir-holding-volume.img> $(printf '%q' "$link")"
			else
				warn "  Spotlight found no volume.img named '$name' anywhere it indexes."
				info "  If you moved it to an unindexed disk, re-point by hand:"
				info "    ln -s <the-dir-holding-volume.img> $(printf '%q' "$link")"
			fi
			continue
		fi

		if [ "$count" -gt 1 ]; then
			warn "  Spotlight found $count candidates; refusing to guess. Re-point the right one:"
			printf '%s\n' "$matches" | while IFS= read -r match; do
				info "    ln -s $(printf '%q' "$match") $(printf '%q' "$link")"
			done
			continue
		fi

		chosen="$matches"
		info "  found it at: $chosen"
		if confirm "  re-point '$name' there?"; then
			run rm -f "$link"
			run ln -s "$chosen" "$link"
			if [ "$DRY_RUN" -eq 1 ]; then
				# Under --dry-run the rm/ln above only PRINTED, so the volume
				# is of course still broken -- verifying here would print a
				# false failure over a perfectly good target. Skip it.
				info "  (dry-run: would re-point '$name' to $chosen; nothing changed)"
			elif volume_broken "$name"; then
				err "  re-pointed, but '$name' still does not resolve -- check $chosen"
			else
				did "recovered '$name' -> $chosen"
				fixed=$((fixed + 1))
			fi
		else
			info "  left '$name' as-is."
		fi
	done

	if [ "$any" -eq 0 ]; then
		info "Nothing to recover -- every volume resolves to its image."
	else
		info "Recovered $fixed volume(s)."
	fi
	return 0
}

volume_usage() {
	cat <<EOF
${C_BLD}$SCRIPT_CMD volume${C_RST} -- manage the ext4 container volumes.

${C_BLD}USAGE${C_RST}
  $SCRIPT_CMD volume list
  $SCRIPT_CMD volume fstrim <name> | all | --all
  $SCRIPT_CMD volume duplicate <source> <duplicate>
  $SCRIPT_CMD volume destroy <name> | all | --all
  $SCRIPT_CMD volume move <name> <dir>
  $SCRIPT_CMD volume recover [<name>]

${C_BLD}SUBCOMMANDS${C_RST}
  list (ls)            Every volume: role, configured cap, actual on-disk cost
                       of its volume.img, and whether a running VM holds it.
  fstrim <name>        Reclaim host disk from a sparse ext4 image. Deleting
  (trim)               files inside the guest never shrinks volume.img; fstrim
                       inside the guest issues the discards that hole-punch it
                       on the host. 'all' (or --all/-a) does the three active
                       mackas volumes, skipping any that are in use.
  duplicate <source> <duplicate>  Clone a volume via APFS copy-on-write
  (dup, clone)         (near-free; the clone shares blocks with its source
                       until written). <duplicate> is a name you choose.
  destroy <name>       Remove ONE volume, or ('all'/--all/-a) every mackas-managed
  (delete, rm)         volume: the three active ones plus the legacy
                       pre-split leftover, if present -- skipping any that are
                       missing or in use rather than aborting. Unlike the
                       top-level '$SCRIPT_NAME destroy' (which ALSO removes
                       $MACKAS_ROOT and the symlink), this only ever touches
                       volumes.
  move <name> <dir>    Relocate one volume's on-disk image to <dir>/<name> and
  (relocate)           leave a symlink behind so the engine still finds it --
                       e.g. put a big TMPDIR on a roomier disk. Refuses an
                       in-use volume (one-VM rule). '$SCRIPT_CMD status' then
                       reports the new location.
  recover [<name>]     When you have moved a volume.img by hand and the runtime
                       can no longer find it, locate it with Spotlight and
                       offer to re-point the symlink. With no name, checks all
                       the mackas volumes. Never changes anything unprompted.

  Parenthesized names are accepted aliases -- 'ls'/'rm' etc. match Apple
  container's own vocabulary (this is a volume manager sitting right next to
  'container volume ls'); the rest are contractions.

Options: --dry-run, -y/--yes (or -f/--force) and -v/--verbose work here too;
before or after the subcommand, e.g. '$SCRIPT_CMD --dry-run volume fstrim oe-build-tmp'
or '$SCRIPT_CMD volume fstrim oe-build-tmp --dry-run' both work.

${C_BLD}ONE-VM RULE${C_RST}
  Only one VM may access an ext4 image at a time. fstrim, duplicate and destroy
  all refuse a volume a running container holds -- for duplicate, that guard is
  on the SOURCE, since a clone of a live (mid-write) image is inconsistent. In
  --all/-a mode (fstrim or destroy), a busy volume is skipped with a warning
  instead of aborting the whole run; naming a volume explicitly still refuses.
EOF
}

cmd_volume() {
	local sub="" rest=() a want_help=0
	for a in "$@"; do
		case "$a" in
			--dry-run)     DRY_RUN=1 ;;
			-y|-f|--yes|--force)  ASSUME_YES=1 ;;
			-v|--verbose)  VERBOSE=1 ;;
			# -h/--help anywhere means help, whether it comes before the
			# subcommand ('volume --help') or after it ('volume fstrim --help').
			# The old form only mapped a LEADING -h/--help and let a trailing one
			# fall through to the subcommand's arg parser, which died "unknown
			# option".
			-h|--help)     want_help=1 ;;
			--version)     echo "$SCRIPT_NAME $SCRIPT_VERSION"; exit 0 ;;
			--config|--config=*|--set|--set=*) die_on_misplaced_global_flag "$a" volume ;;
			*) if [ -z "$sub" ]; then sub="$a"; else rest+=("$a"); fi ;;
		esac
	done

	if [ "$want_help" -eq 1 ]; then
		volume_usage
		return 0
	fi

	case "${sub:-help}" in
		list|ls)               volume_list ${rest+"${rest[@]}"} ;;
		fstrim|trim)           volume_fstrim ${rest+"${rest[@]}"} ;;
		duplicate|dup|clone)   volume_duplicate ${rest+"${rest[@]}"} ;;
		destroy|delete|rm)     volume_destroy ${rest+"${rest[@]}"} ;;
		move|relocate)         volume_move ${rest+"${rest[@]}"} ;;
		recover)               volume_recover ${rest+"${rest[@]}"} ;;
		help)                  volume_usage ;;
		*) die "unknown 'volume' subcommand: $sub" \
			"$SCRIPT_CMD volume --help  (list | fstrim | duplicate | destroy | move | recover)" ;;
	esac
}

# ---------------------------------------------------------------------------
# Usage
# ---------------------------------------------------------------------------
usage() {
	local project_line
	if [ -n "$MACKAS_PROJECT_URL" ]; then
		project_line="Project: $MACKAS_PROJECT_DIR (branch $MACKAS_PROJECT_BRANCH)."
	else
		project_line="No project configured yet -- 'setup' still works, just skips the checkout step."
	fi
	cat <<EOF
${C_BLD}$SCRIPT_NAME${C_RST} v$SCRIPT_VERSION -- run kas-container OpenEmbedded builds on Apple's
'container' runtime. $project_line Set MACKAS_PROJECT_* to build your own
layers -- qualcomm-linux/meta-ai is a worked example, see mackas.conf.example.

${C_BLD}USAGE${C_RST}
  $SCRIPT_NAME [OPTIONS] [COMMAND]

${C_BLD}COMMANDS${C_RST}
  check      Preflight only. Changes nothing. ${C_BLD}This is the default.${C_RST}
  setup      Do the full setup. Idempotent -- safe to re-run after a crash.
  smoketest  Run the validation ladder: parse-only, then MACKAS_SMOKETEST_TARGETS.
  status     Show what is configured and what exists on disk.
  shell      Drop into a kas shell for the project's kas config.
  retrieve   Copy build outputs (buildstats/logs/deploy) out of the ext4
             TMPDIR volume, where macOS cannot see them. '$SCRIPT_CMD retrieve --help'.
  buildstats Work with buildstats already retrieved (currently: analyze).
             '$SCRIPT_CMD buildstats --help'.
  sstate     Prune sstate objects bitbake hasn't reused in a while.
             '$SCRIPT_CMD sstate --help'.
  monitor    Show live bitbake progress from a build started with
             MACKAS_MONITOR=1. '$SCRIPT_CMD monitor --help'.
  clean      Drop the TMPDIR volume; keep the downloads/sstate volumes and the checkout.
  destroy    Remove all three volumes, $MACKAS_ROOT and the short symlink.
             Makes you type DESTROY.
  volume     Manage the ext4 volumes: list, fstrim (reclaim disk), duplicate,
             destroy one, move one to another disk, recover a hand-moved one.
             '$SCRIPT_CMD volume --help'.
  set        Persist one setting in the config file. '$SCRIPT_CMD set --help'.
  get        Print one setting's currently resolved value. '$SCRIPT_CMD get --help'.
  unset      Remove one persisted setting. '$SCRIPT_CMD unset --help'.
  help       This message, or '$SCRIPT_CMD help COMMAND' for one command's own.

${C_BLD}OPTIONS${C_RST}
  --config FILE   Use this config file instead of searching.
  --set NAME=VAL  Override one setting for THIS command only; beats config
                  file and environment. Repeatable. For a PERSISTENT
                  override, use '$SCRIPT_CMD set NAME VALUE' instead.
                  '$SCRIPT_CMD status' lists the valid names.
  --dry-run       Print every mutating command; change nothing.
  -y, --yes       Assume yes; never prompt (required for non-interactive destroy).
                  -f/--force is an accepted synonym, for anyone used to
                  'docker system prune -f'.
  -v, --verbose   Echo commands as they run.
  -h, --help      This message.

${C_BLD}CONFIGURATION${C_RST}
  Precedence, lowest to highest:
    built-in defaults  ->  config file  ->  environment  ->  command-line flags

  Config file, first match wins:
    \$MACKAS_CONF
    ~/.config/mackas/config
    ~/.mackas.conf

  It is sourced as shell, so it is only looked for in places that are yours:
  a searched file is skipped unless you (or root) own it and its directory,
  and neither is writable by group or other. ./mackas.conf is NOT searched --
  name a per-project config out loud with --config ./mackas.conf.

  Every setting is also an environment variable of the same name, and can be
  overridden with --set NAME=VALUE. See mackas.conf.example for the full
  annotated list.

${C_BLD}EXAMPLES${C_RST}
  # See whether this Mac can do it at all -- touches nothing.
  $SCRIPT_CMD check

  # See exactly what setup would do, without doing it.
  $SCRIPT_CMD --dry-run setup

  # Set it up, answering yes to the sudo prompts.
  $SCRIPT_CMD setup

  # Use the shell afterwards.
  source $MACKAS_ENV_SH
  $SCRIPT_CMD smoketest

  # Give the build more RAM, just this once.
  MACKAS_MEMORY=48g $SCRIPT_CMD setup
  $SCRIPT_CMD --set MACKAS_MEMORY=48g setup

  # Reuse a mirror host's sstate + downloads caches as read-only mirrors,
  # over HTTP. Needs mackas-mirrord running there; see mirror-server/.
  MACKAS_USE_HTTP_MIRRORS=1 $SCRIPT_CMD check

  # The same, over NFS instead (needs sudo to mount, and is unproven).
  MACKAS_USE_NFS_MIRRORS=1 $SCRIPT_CMD check

  # Build somewhere else entirely.
  $SCRIPT_CMD --config ~/other.conf setup

  # Start over.
  $SCRIPT_CMD destroy
EOF
}

# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------
parse_set() {
	local kv="$1" name
	[ -n "$kv" ] || die "--set needs NAME=VALUE" "$SCRIPT_CMD --help"
	case "$kv" in
		*=*) ;;
		*) die "--set expects NAME=VALUE, got: $kv" "$SCRIPT_CMD --help" ;;
	esac
	name="${kv%%=*}"
	if ! is_setting_name "$name"; then
		die "--set: unknown setting '$name'" \
			"$SCRIPT_CMD status  (lists every valid setting name)"
	fi
	CLI_OVERRIDES+=("$kv")
}

main() {
	setup_colors

	local cmd="" config_flag="" want_help=0
	# Flags may appear before or after the subcommand. want_help is tracked
	# SEPARATELY from cmd (rather than cmd="help" as a sentinel) so that
	# 'mackas setup --help'/'mackas setup help'/'mackas help setup' all still
	# know which command's OWN usage to show, instead of -h/--help/'help'
	# clobbering which command was named.
	while [ $# -gt 0 ]; do
		case "$1" in
			--config) config_flag="${2:-}"; [ -n "$config_flag" ] || die "--config needs a FILE"; shift 2 ;;
			--config=*) config_flag="${1#*=}"; shift ;;
			--set) parse_set "${2:-}"; shift 2 ;;
			--set=*) parse_set "${1#*=}"; shift ;;
			--dry-run) DRY_RUN=1; shift ;;
			-y|-f|--yes|--force) ASSUME_YES=1; shift ;;
			-v|--verbose) VERBOSE=1; shift ;;
			-h|--help) want_help=1; shift ;;
			help) want_help=1; shift ;;
			--version) echo "$SCRIPT_NAME $SCRIPT_VERSION"; exit 0 ;;
			-*) die "unknown option: $1" "$SCRIPT_CMD --help" ;;
			volume)
				# `volume` owns everything after it (its subcommand and that
				# subcommand's own args/flags), so capture the tail verbatim and
				# stop parsing -- cmd_volume does the rest. Global flags still
				# work BEFORE it (mackas --dry-run volume ...) and cmd_volume
				# also honours --dry-run/-y/-v placed after it.
				#
				# 'mackas help volume [...]' arrives here with want_help
				# already 1 -- reuse cmd_volume's own -h/--help handling
				# instead of a separate help path to drift out of sync with.
				[ -n "$cmd" ] && die "more than one command given: '$cmd' and '$1'" "$SCRIPT_CMD --help"
				cmd="volume"; shift
				if [ "$want_help" -eq 1 ]; then VOLUME_ARGS=("$@" "--help"); else VOLUME_ARGS=("$@"); fi
				break ;;
			retrieve)
				# Same shape as `volume`: retrieve owns everything after it (its
				# objects and --dest), captured verbatim for cmd_retrieve.
				[ -n "$cmd" ] && die "more than one command given: '$cmd' and '$1'" "$SCRIPT_CMD --help"
				cmd="retrieve"; shift
				if [ "$want_help" -eq 1 ]; then RETRIEVE_ARGS=("$@" "--help"); else RETRIEVE_ARGS=("$@"); fi
				break ;;
			buildstats)
				# Same shape again: buildstats owns everything after it (its
				# subcommand, e.g. 'analyze', and that subcommand's own args).
				[ -n "$cmd" ] && die "more than one command given: '$cmd' and '$1'" "$SCRIPT_CMD --help"
				cmd="buildstats"; shift
				if [ "$want_help" -eq 1 ]; then BUILDSTATS_ARGS=("$@" "--help"); else BUILDSTATS_ARGS=("$@"); fi
				break ;;
			sstate)
				# Same shape again: sstate owns everything after it (its
				# subcommand, e.g. 'prune', and that subcommand's own args).
				[ -n "$cmd" ] && die "more than one command given: '$cmd' and '$1'" "$SCRIPT_CMD --help"
				cmd="sstate"; shift
				if [ "$want_help" -eq 1 ]; then SSTATE_ARGS=("$@" "--help"); else SSTATE_ARGS=("$@"); fi
				break ;;
			monitor)
				# Same shape again: monitor owns everything after it
				# (--port/--once), captured verbatim for cmd_monitor.
				[ -n "$cmd" ] && die "more than one command given: '$cmd' and '$1'" "$SCRIPT_CMD --help"
				cmd="monitor"; shift
				if [ "$want_help" -eq 1 ]; then MONITOR_ARGS=("$@" "--help"); else MONITOR_ARGS=("$@"); fi
				break ;;
			set)
				# Same shape again: set owns everything after it (NAME and
				# VALUE), captured verbatim for cmd_set. Persists to the config
				# file -- see set_usage -- unlike the ephemeral --set flag.
				[ -n "$cmd" ] && die "more than one command given: '$cmd' and '$1'" "$SCRIPT_CMD --help"
				cmd="set"; shift
				if [ "$want_help" -eq 1 ]; then SET_ARGS=("$@" "--help"); else SET_ARGS=("$@"); fi
				break ;;
			get)
				[ -n "$cmd" ] && die "more than one command given: '$cmd' and '$1'" "$SCRIPT_CMD --help"
				cmd="get"; shift
				if [ "$want_help" -eq 1 ]; then GET_ARGS=("$@" "--help"); else GET_ARGS=("$@"); fi
				break ;;
			unset)
				[ -n "$cmd" ] && die "more than one command given: '$cmd' and '$1'" "$SCRIPT_CMD --help"
				cmd="unset"; shift
				if [ "$want_help" -eq 1 ]; then UNSET_ARGS=("$@" "--help"); else UNSET_ARGS=("$@"); fi
				break ;;
			setup)
				# Same shape as `volume`: setup owns everything after it (an
				# optional positional root path and its own --tmpdir-size/
				# --sstate-size/--downloads-size flags), captured verbatim for
				# cmd_setup.
				[ -n "$cmd" ] && die "more than one command given: '$cmd' and '$1'" "$SCRIPT_CMD --help"
				cmd="setup"; shift
				if [ "$want_help" -eq 1 ]; then SETUP_ARGS=("$@" "--help"); else SETUP_ARGS=("$@"); fi
				break ;;
			adopt)
				# Same shape again: adopt owns everything after it (its
				# positional path and --project-dir/--config), captured
				# verbatim for cmd_adopt.
				[ -n "$cmd" ] && die "more than one command given: '$cmd' and '$1'" "$SCRIPT_CMD --help"
				cmd="adopt"; shift
				if [ "$want_help" -eq 1 ]; then ADOPT_ARGS=("$@" "--help"); else ADOPT_ARGS=("$@"); fi
				break ;;
			check|smoketest|status|shell|clean|destroy)
				[ -n "$cmd" ] && die "more than one command given: '$cmd' and '$1'" "$SCRIPT_CMD --help"
				cmd="$1"; shift ;;
			*) die "unknown command: $1" "$SCRIPT_CMD --help  (commands: check setup adopt smoketest status shell retrieve buildstats sstate monitor clean destroy volume set get unset help)" ;;
		esac
	done

	snapshot_env
	set_defaults
	snapshot_defaults

	# Showing help -- whether bare 'help'/'-h' or 'X --help'/'X help'/'help X'
	# for any command X -- never loads the config file. Its text mentions a
	# few settings, so it still needs the defaults, the environment and --set
	# -- but none of those execute anything, whereas the config file is
	# SOURCED AS SHELL. Running a stranger's shell code to print a usage
	# message is a trade with nothing on the win side, so any --help path
	# skips load_config entirely and stays safe to type in any directory.
	if [ "$want_help" -ne 1 ]; then
		case "${cmd:-check}" in
			# See load_config's comment: only these three may target a
			# --config/MACKAS_CONF path that does not exist yet.
			set|get|unset) load_config "$config_flag" 1 ;;
			*)              load_config "$config_flag" ;;
		esac
		mark_explicit_from_config
	fi
	restore_env
	apply_cli_overrides
	validate_settings
	derive_paths

	# A bare 'help'/'-h' (no command named at all) shows the general usage.
	# volume/retrieve/buildstats/sstate/monitor/set/get/unset handle their OWN --help
	# internally (via the "--help" appended to their *_ARGS above), so they
	# are dispatched normally either way, below.
	if [ "$want_help" -eq 1 ] && [ -z "$cmd" ]; then
		usage
		return 0
	fi

	case "${cmd:-check}" in
		check)     if [ "$want_help" -eq 1 ]; then check_usage;     else cmd_check;     fi ;;
		setup)     if [ "$want_help" -eq 1 ]; then setup_usage;     else cmd_setup ${SETUP_ARGS+"${SETUP_ARGS[@]}"}; fi ;;
		adopt)      cmd_adopt ${ADOPT_ARGS+"${ADOPT_ARGS[@]}"} ;;
		smoketest) if [ "$want_help" -eq 1 ]; then smoketest_usage; else cmd_smoketest; fi ;;
		status)    if [ "$want_help" -eq 1 ]; then status_usage;    else cmd_status;    fi ;;
		shell)     if [ "$want_help" -eq 1 ]; then shell_usage;     else cmd_shell;     fi ;;
		clean)     if [ "$want_help" -eq 1 ]; then clean_usage;     else cmd_clean 0;   fi ;;
		destroy)   if [ "$want_help" -eq 1 ]; then destroy_usage;   else cmd_clean 1;   fi ;;
		volume)     cmd_volume ${VOLUME_ARGS+"${VOLUME_ARGS[@]}"} ;;
		retrieve)   cmd_retrieve ${RETRIEVE_ARGS+"${RETRIEVE_ARGS[@]}"} ;;
		buildstats) cmd_buildstats ${BUILDSTATS_ARGS+"${BUILDSTATS_ARGS[@]}"} ;;
		sstate)     cmd_sstate ${SSTATE_ARGS+"${SSTATE_ARGS[@]}"} ;;
		monitor)    cmd_monitor ${MONITOR_ARGS+"${MONITOR_ARGS[@]}"} ;;
		set)        cmd_set ${SET_ARGS+"${SET_ARGS[@]}"} ;;
		get)        cmd_get ${GET_ARGS+"${GET_ARGS[@]}"} ;;
		unset)      cmd_unset ${UNSET_ARGS+"${UNSET_ARGS[@]}"} ;;
	esac
}

# Running main is skipped when MACKAS_LIB_ONLY=1, which lets the test suite
# source this file to unit-test the pure helper functions in isolation. It
# has no effect on normal use.
if [ "${MACKAS_LIB_ONLY:-0}" != "1" ]; then
	main "$@"
fi
