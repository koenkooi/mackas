def parse_kv_file(path: str) -> Dict[str, str]:
    """Parse a KEY=VALUE config file.

    Note this is NOT sourced as shell (mackas.conf is; this is not). A Python
    daemon that exec'd its config file would turn "can write the config" into
    "can run code as the daemon user", and the config may live somewhere more
    widely writable than the binary.
    """
    out: Dict[str, str] = {}
    try:
        with open(path, "r", encoding="utf-8") as fh:
            for lineno, raw in enumerate(fh, 1):
                line = raw.strip()
                if not line or line.startswith("#"):
                    continue
                if "=" not in line:
                    raise ConfigError("%s:%d: not KEY=VALUE" % (path, lineno))
                key, value = line.split("=", 1)
                key = key.strip()
                value = value.strip()
                if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
                    value = value[1:-1]
                out[key] = value
    except OSError as exc:
        raise ConfigError("cannot read config file %s: %s" % (path, exc))
    return out


def _as_bool(value: str, what: str) -> bool:
    v = value.strip().lower()
    if v in ("1", "true", "yes", "on"):
        return True
    if v in ("0", "false", "no", "off"):
        return False
    raise ConfigError("%s: not a boolean: %r" % (what, value))


def parse_root_spec(spec: str) -> Tuple[str, str]:
    """Parse NAME=PATH (or a bare PATH, which is served at the URL root)."""
    if "=" in spec:
        name, path = spec.split("=", 1)
        name = name.strip().strip("/")
        if not name:
            raise ConfigError("root name is empty in %r" % spec)
        if "/" in name:
            raise ConfigError("root name may not contain '/': %r" % name)
        if not re.match(r"^[A-Za-z0-9._-]+$", name):
            raise ConfigError("root name must be [A-Za-z0-9._-]+: %r" % name)
    else:
        name, path = "", spec
    path = path.strip()
    if not path:
        raise ConfigError("root path is empty in %r" % spec)
    return name, path


def validate_roots(specs: Sequence[str]) -> Dict[str, str]:
    roots: Dict[str, str] = {}
    for spec in specs:
        name, path = parse_root_spec(spec)
        real = os.path.realpath(path)
        if not os.path.isdir(real):
            raise ConfigError("root is not a directory: %s" % path)
        if not os.access(real, os.R_OK | os.X_OK):
            raise ConfigError("root is not readable: %s" % path)
        if name in roots:
            raise ConfigError("duplicate root name: %r" % name)
        if "" in roots or (name == "" and roots):
            raise ConfigError(
                "an unnamed root serves the whole URL space and cannot be "
                "combined with named roots")
        roots[name] = real
    return roots


# ---------------------------------------------------------------------------
# The HTTP handler
# ---------------------------------------------------------------------------


class MirrorHandler(BaseHTTPRequestHandler):
    """Read-only file serving with authentication, and nothing else.

    Deliberately built on BaseHTTPRequestHandler rather than
    SimpleHTTPRequestHandler: we want request parsing, not translate_path(),
    not list_directory(), not send_head().
    """

    # HTTP/1.1 for keep-alive: bitbake issues a long stream of sstate probes
    # against this server and a fresh TCP (and TLS) handshake per probe is
    # most of the cost of a miss. Every response below sets Content-Length,
    # which is what makes keep-alive safe.
    protocol_version = "HTTP/1.1"

    # Do not advertise "BaseHTTP/0.6 Python/3.13.5". A version banner is free
    # reconnaissance: it tells an attacker exactly which CVEs to try. This is
    # not security by obscurity as a *control*, it is declining to help.
    server_version = PROGRAM
    sys_version = ""

    config: Config
    limiter: RateLimiter

    # -- plumbing ----------------------------------------------------------

    def version_string(self) -> str:
        return PROGRAM

    def address_string(self) -> str:
        # BaseHTTPRequestHandler's version reverse-resolves the client IP for
        # logging. That is a DNS round trip per request, on the request path,
        # against a name the client's own PTR record controls. No.
        return self.client_address[0]

    def log_message(self, fmt: str, *args) -> None:
        # Route BaseHTTPRequestHandler's internal chatter (parse errors and
        # the like) through logging, sanitized. Our own access log is emitted
        # by _respond(), which knows the byte count.
        log.debug("%s %s", self.address_string(),
                  sanitize_for_log(fmt % args))

    def log_error(self, fmt: str, *args) -> None:
        log.warning("%s %s", self.address_string(),
                    sanitize_for_log(fmt % args))

    def log_access(self, status: int, nbytes: int) -> None:
        if self.config.quiet:
            return
        log.info('%s "%s %s" %d %d',
                 self.address_string(),
                 sanitize_for_log(getattr(self, "command", "-") or "-", 16),
                 sanitize_for_log(getattr(self, "path", "-") or "-"),
                 status, nbytes)

    def parse_request(self) -> bool:
        """Belt-and-braces limits on top of the ones enforced during the read.

        The real memory bound is set by http.client._MAXLINE/_MAXHEADERS at
        import (see the comment on MAX_HEADER_LINE) -- a header block that
        blows those never gets here, it dies inside parse_headers() and
        http.server turns it into a 431. What is left for us is the aggregate
        limit, which no per-line cap can express: 64 lines of 8 KiB each are
        individually legal and collectively absurd.
        """
        if not super().parse_request():
            return False
        if len(self.requestline) > MAX_REQUEST_LINE:
            self.fail(http.HTTPStatus.REQUEST_URI_TOO_LONG)
            return False
        if len(self.headers) > MAX_HEADERS:
            self.fail(http.HTTPStatus.REQUEST_HEADER_FIELDS_TOO_LARGE)
            return False
        total = sum(len(k) + len(v) for k, v in self.headers.items())
        if total > MAX_HEADER_BYTES:
            self.fail(http.HTTPStatus.REQUEST_HEADER_FIELDS_TOO_LARGE)
            return False
        return True

    def handle_one_request(self) -> None:
        """Never let an exception reach the client as a traceback."""
        try:
            super().handle_one_request()
        except (socket.timeout, TimeoutError):
            # Slowloris and friends, or just a client that wandered off.
            log.debug("%s timed out", self.address_string())
            self.close_connection = True
        except (ConnectionResetError, BrokenPipeError):
            self.close_connection = True
        except Exception:
            # An unexpected bug in our own code. The client gets a bare 500
            # with no detail; the traceback goes to our log, where it belongs.
            log.exception("%s unhandled error", self.address_string())
            try:
                self.fail(http.HTTPStatus.INTERNAL_SERVER_ERROR)
            except Exception:
                pass
            self.close_connection = True

    # -- responses ---------------------------------------------------------

    def send_error(self, code, message=None, explain=None) -> None:
        """Replace BaseHTTPRequestHandler's error pages entirely.

        The stock send_error() interpolates `message` and `explain` into an
        HTML body. Historically that was a reflected-XSS hole in http.server
        (the request path landed in the page), and it still echoes strings we
        may not have vetted. We never echo anything: a fixed body per status
        code, and the detail goes to the log.
        """
        try:
            status = http.HTTPStatus(int(code))
            phrase = status.phrase
        except ValueError:
            phrase = "Error"
        self.fail(int(code), phrase=phrase)

    def fail(self, code, phrase: Optional[str] = None,
             headers: Optional[Sequence[Tuple[str, str]]] = None,
             reason: Optional[str] = None) -> None:
        """Send a generic error. `reason` is logged, never sent."""
        try:
            status = http.HTTPStatus(int(code))
            code_int = int(status)
            phrase = phrase or status.phrase
        except ValueError:
            code_int = int(code)
            phrase = phrase or "Error"
        if reason:
            log.info("%s refused: %s", self.address_string(),
                     sanitize_for_log(reason))
        # A fixed, input-free body. No user data, so no XSS, no reflection,
        # no oracle.
        body = ("%d %s\n" % (code_int, phrase)).encode("ascii", "replace")
        self.send_response_only(code_int, phrase)
        self.send_header("Server", PROGRAM)
        self.send_header("Date", self.date_time_string())
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("X-Content-Type-Options", "nosniff")
        for key, value in (headers or ()):
            self.send_header(key, value)
        if code_int >= 400:
            self.send_header("Connection", "close")
            self.close_connection = True
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)
        self.log_access(code_int, len(body) if self.command != "HEAD" else 0)

    # -- access control ----------------------------------------------------

    def client_ip(self) -> Optional[ipaddress._BaseAddress]:
        raw = self.client_address[0]
        try:
            addr = ipaddress.ip_address(raw)
        except ValueError:
            return None
        # A v4-mapped v6 address (::ffff:192.0.2.68) must be compared against
        # v4 CIDRs as v4, or a dual-stack listener silently ignores the
        # allowlist.
        if isinstance(addr, ipaddress.IPv6Address) and addr.ipv4_mapped:
            addr = addr.ipv4_mapped
        return addr

    def ip_allowed(self) -> bool:
        """IP allowlist check. Complementary to auth, not a substitute.

        Deliberately no X-Forwarded-For support: this server is meant to be
        reached directly, and honouring a client-supplied header as identity
        would let anyone claim any address. If it is ever put behind a proxy,
        that must be an explicit, separate decision.
        """
        if not self.config.allow_nets:
            return True
        addr = self.client_ip()
        if addr is None:
            return False
        return any(addr in net for net in self.config.allow_nets)

    def authenticated(self) -> bool:
        store = self.config.creds
        if not store:
            return True
        header = self.headers.get("Authorization", "")
        if not header:
            return False
        try:
            scheme, _, payload = header.partition(" ")
            if scheme.lower() != "basic":
                return False
            decoded = base64.b64decode(payload.strip(), validate=True)
            username, sep, password = decoded.decode("utf-8").partition(":")
            if not sep:
                return False
        except (binascii.Error, ValueError, UnicodeDecodeError):
            return False
        return self.check_password(store, username, password)

    def check_password(self, store: "CredentialStore", username: str,
                       password: str) -> bool:
        """Verify a password, but never let a stranger choose our CPU bill.

        A cache hit costs a dict lookup, so bitbake's thousands of identical
        sstate probes pay for one PBKDF2 between them. Only a genuinely new
        user:password pair reaches the KDF, and that is what the budget covers:
        DEFAULT_KDF_RATE derivations per second per IP, with a burst that no
        real client can exhaust (a real client has ONE password, so it misses
        the cache once per TTL) and an attacker exhausts immediately.

        Over budget is a plain 401, deliberately: the same answer a wrong
        password gets. Answering 429 here would tell an attacker they had found
        the interesting endpoint, and would let them distinguish "throttled"
        from "wrong" -- the throttle is not a secret worth leaking. The event
        is logged, so an operator can see it happening.

        Note this is the only rate limit that is on by default (DEFAULT_RATE is
        0.0, i.e. the general request limiter is off). That asymmetry is
        intentional: a general limit would break bitbake's request pattern,
        this one cannot, because bitbake does not brute-force passwords.
        """
        cached = store.cached_result(username, password)
        if cached is not None:
            return cached
        if not self.kdf_limiter.allow(self.client_address[0]):
            log.warning("%s exceeded the password-hashing budget; refusing "
                        "without hashing", self.address_string())
            return False
        return store.check(username, password)

    def check_access(self) -> bool:
        """Rate limit, then allowlist, then auth -- all before any FS access.

        Order matters. Every check here is cheaper than a stat() on an NFS
        mount, and more importantly none of them may be *skippable* by a path
        that reaches the filesystem first. An unauthenticated client must not
        be able to learn whether a file exists, which is exactly what
        checking auth after a stat would tell it (via response timing, if not
        the status code).
        """
        if not self.limiter.allow(self.client_address[0]):
            self.fail(http.HTTPStatus.TOO_MANY_REQUESTS,
                      headers=[("Retry-After", "1")],
                      reason="rate limit")
            return False
        if not self.ip_allowed():
            self.fail(http.HTTPStatus.FORBIDDEN, reason="ip not in allowlist")
            return False
        if not self.authenticated():
            self.fail(
                http.HTTPStatus.UNAUTHORIZED,
                headers=[("WWW-Authenticate",
                          'Basic realm="%s", charset="UTF-8"'
                          % self.config.realm)],
                reason="authentication failed")
            return False
        return True

    # -- request bodies ----------------------------------------------------

    def consume_request_body(self) -> bool:
        """Read and discard any request body. False if we already responded.

        THE BUG THIS FIXES -- CL.0 request smuggling

        This server has no method that takes a body, so nothing ever called
        rfile.read(). A GET with `Content-Length: 6` and a body was answered
        normally, keep-alive stayed on, and the six unread bytes sat in the
        socket buffer -- where the next loop of handle_one_request() parsed
        them as a brand-new request line. One request in, two responses out.
        That is a request-smuggling primitive: anything in front of us (a
        proxy, a load balancer) counts one request where we count two, and an
        attacker chooses what the second one says. do_OPTIONS was the worst of
        them -- 204, no body read, connection kept alive.

        The rule is now: nothing reaches a response until the body is off the
        socket, or the connection is closed. Called after check_access(), so an
        unauthenticated client is still refused before we read anything --
        every failure path routes through fail(), which sets close_connection
        on any status >= 400, so a smuggled body dies with the connection.
        """
        if self.headers.get("Transfer-Encoding", "").strip():
            # Chunked, or something exotic. No method here takes a body, so
            # there is nothing to be gained by implementing dechunking -- and a
            # dechunker we do not need is a parser differential we do not want.
            # Refuse and close; the framing is now unknowable, so the socket is
            # not reusable.
            self.fail(http.HTTPStatus.BAD_REQUEST,
                      reason="body with Transfer-Encoding on a bodyless method")
            return False

        values = self.headers.get_all("Content-Length") or []
        if not values:
            return True
        # Two Content-Lengths is a smuggling attempt by construction: it exists
        # only to make us and a proxy disagree about where the body ends.
        if len(set(v.strip() for v in values)) > 1:
            self.fail(http.HTTPStatus.BAD_REQUEST,
                      reason="conflicting Content-Length headers")
            return False
        try:
            length = int(values[0].strip())
        except ValueError:
            self.fail(http.HTTPStatus.BAD_REQUEST,
                      reason="malformed Content-Length")
            return False
        if length < 0:
            self.fail(http.HTTPStatus.BAD_REQUEST,
                      reason="negative Content-Length")
            return False
        if length == 0:
            return True
        if length > MAX_REQUEST_BODY:
            # We will not read megabytes to be polite about a body that should
            # not exist. 413 and close: the unread remainder goes with it.
            self.fail(http.HTTPStatus.REQUEST_ENTITY_TOO_LARGE,
                      reason="body of %d bytes on a bodyless method" % length)
            return False

        remaining = length
        while remaining > 0:
            chunk = self.rfile.read(min(remaining, 16384))
            if not chunk:
                # Client promised more than it sent. Framing is broken; the
                # connection cannot be reused safely.
                self.close_connection = True
                return False
            remaining -= len(chunk)
        return True

    # -- methods -----------------------------------------------------------

    ALLOWED_METHODS = "GET, HEAD, OPTIONS"

    def do_GET(self) -> None:
        self.handle_download(body=True)

    def do_HEAD(self) -> None:
        self.handle_download(body=False)

    def do_OPTIONS(self) -> None:
        if not self.check_access():
            return
        if not self.consume_request_body():
            return
        self.send_response_only(http.HTTPStatus.NO_CONTENT)
        self.send_header("Server", PROGRAM)
        self.send_header("Date", self.date_time_string())
        self.send_header("Allow", self.ALLOWED_METHODS)
        self.send_header("Content-Length", "0")
        self.end_headers()
        self.log_access(204, 0)

    def _reject_method(self) -> None:
        # Every mutating method lands here. No CLIENT REQUEST can cause a
        # write -- there is no code that opens a request body as a file, or
        # turns a request path into an open(..., "wb")/unlink() argument --
        # so 405 is a statement of fact about what a client can trigger, not
        # a policy knob. (With --cache-dir, the daemon does have one
        # internal write path now: see the "Local file cache" section
        # above. It is reached only from serve_file(), only after the
        # requested object has already been resolved and opened read-only
        # through the same path-containment logic every response goes
        # through, and it never accepts a client-supplied filename. That is
        # a different claim from "no request can write", and this comment
        # is about the latter.)
        # Access control runs first so that an unauthenticated prober cannot
        # even learn which methods exist.
        #
        # No body drain here, and none needed: a POST/PUT body is left unread,
        # but fail() answers 405 and sets close_connection, so the socket dies
        # with the unread bytes still in it. Nothing can be smuggled onto a
        # connection that is not reused. (This is load-bearing -- if fail()
        # ever stops closing on 4xx, this method needs consume_request_body().)
        if not self.check_access():
            return
        self.fail(http.HTTPStatus.METHOD_NOT_ALLOWED,
                  headers=[("Allow", self.ALLOWED_METHODS)],
                  reason="method %s" % sanitize_for_log(self.command or "?", 16))

    do_POST = _reject_method
    do_PUT = _reject_method
    do_DELETE = _reject_method
    do_PATCH = _reject_method
    do_PROPFIND = _reject_method
    do_PROPPATCH = _reject_method
    do_MKCOL = _reject_method
    do_COPY = _reject_method
    do_MOVE = _reject_method
    do_LOCK = _reject_method
    do_UNLOCK = _reject_method
    do_TRACE = _reject_method
    do_CONNECT = _reject_method

    # -- the actual download ----------------------------------------------

    def pick_root(self, url_path: str) -> Tuple[str, str]:
        """Split '/sstate/xx/foo.tgz' into (root_real, '/xx/foo.tgz')."""
        roots = self.config.roots
        if "" in roots:
            return roots[""], url_path
        trimmed = url_path.lstrip("/")
        name, sep, rest = trimmed.partition("/")
        if name not in roots:
            raise PathRejected("unknown root %r" % name)
        return roots[name], "/" + (rest if sep else "")

    def handle_download(self, body: bool) -> None:
        if not self.check_access():
            return
        if not self.consume_request_body():
            return

        try:
            url_path = unquote(split_url_path(self.path), errors="strict")
        except (ValueError, UnicodeDecodeError):
            self.fail(http.HTTPStatus.BAD_REQUEST, reason="undecodable path")
            return

        try:
            root_real, rel = self.pick_root(url_path)
            target = resolve_under_root(root_real, rel,
                                        self.config.allow_symlinks)
        except PathRejected as exc:
            # 404, not 403: a hostile path and a missing file are reported
            # identically so that probing cannot map what exists or where the
            # roots are. The real reason goes to the log.
            self.fail(http.HTTPStatus.NOT_FOUND,
                      reason="rejected path %s (%s)"
                             % (sanitize_for_log(url_path), exc))
            return

        self.serve_file(target, root_real, body)

    def serve_file(self, target: str, root_real: str, body: bool) -> None:
        """Open and send one regular file.

        The open is the last line of defence and it does its own checking
        rather than trusting the checks above:

          * open_under_root() walks from a descriptor on the root, one
            component at a time, O_NOFOLLOW on each. It never re-opens
            `target` as a string, so there is no window in which an attacker
            can swap an intermediate directory for a symlink and be followed
            through it. Containment is structural, not checked-then-hoped.
          * fstat on the opened descriptor, not stat on the path, so what we
            check is exactly what we send.
          * S_ISREG: no directories, no devices, no FIFOs. Opening a FIFO on
            an NFS export would hang this thread forever, which is a
            denial-of-service handed to anyone who can write to the export.

        If --cache-dir is configured, a cache lookup happens FIRST, before
        any of the above touches the (possibly slow) source root at all --
        see CacheManager.open_cached(). Hit-count bookkeeping and promotion
        happen only AFTER the source open below confirms a regular file
        exists, deliberately: the dominant request here is the sstate MISS
        (bitbake probing an object that does not exist), and that path must
        stay exactly as cheap with caching as without it.
        """
        cache = self.config.cache
        if cache is not None:
            cfd = cache.open_cached(target)
            if cfd is not None:
                try:
                    cst = os.fstat(cfd)
                    self.send_regular_file(cfd, cst, target, body)
                finally:
                    os.close(cfd)
                return

        fd = None
        try:
            try:
                fd = open_under_root(root_real, target)
            except PathRejected as exc:
                self.fail(http.HTTPStatus.NOT_FOUND, reason=str(exc))
                return
            except OSError as exc:
                # The dominant request pattern here is the sstate MISS: bitbake
                # probes for thousands of objects that do not exist, and this
                # is that path -- open, ENOENT, 404. No stat, no listdir, no
                # body.
                #
                # It used to say "as cheap as the filesystem allows", and the
                # dir_fd walk made that not quite true any more: a miss now
                # costs one open per component (typically three: root, the
                # hash-prefix directory, the leaf) instead of one. That is the
                # price of containment, it is bounded by the path depth, and it
                # is small next to the realpath() the check already does -- both
                # are O(components) round trips on NFS. ELOOP/ENOTDIR arriving
                # here is the interesting case: it means a component was a
                # symlink at open time, i.e. either a genuine race or an
                # attacker, and either way the answer is 404.
                if exc.errno in (errno.ENOENT, errno.ENOTDIR, errno.ELOOP,
                                 errno.ENAMETOOLONG):
                    self.fail(http.HTTPStatus.NOT_FOUND)
                elif exc.errno in (errno.EACCES, errno.EPERM):
                    self.fail(http.HTTPStatus.FORBIDDEN,
                              reason="permission denied on target")
                else:
                    log.warning("open failed: %s", sanitize_for_log(str(exc)))
                    self.fail(http.HTTPStatus.INTERNAL_SERVER_ERROR)
                return
            except ValueError:
                self.fail(http.HTTPStatus.NOT_FOUND, reason="invalid target")
                return

            st = os.fstat(fd)

            if stat.S_ISDIR(st.st_mode):
                self.serve_directory(fd, body)
                return

            if not stat.S_ISREG(st.st_mode):
                self.fail(http.HTTPStatus.NOT_FOUND,
                          reason="not a regular file")
                return

            # Only now -- confirmed regular, existing file -- does caching
            # get involved. See the docstring above for why counting here,
            # not before the open, is what keeps the sstate-MISS path free.
            if cache is not None:
                count = cache.record_hit(target)
                if count >= cache.min_hits:
                    cache.maybe_promote(root_real, target)

            # Clear O_NONBLOCK now that we know it is a regular file; regular
            # files ignore it for reads anyway, but leave nothing surprising
            # for the reader below.
            if hasattr(os, "O_NONBLOCK"):
                import fcntl
                fl = fcntl.fcntl(fd, fcntl.F_GETFL)
                fcntl.fcntl(fd, fcntl.F_SETFL, fl & ~os.O_NONBLOCK)

            self.send_regular_file(fd, st, target, body)
        finally:
            if fd is not None:
                try:
                    os.close(fd)
                except OSError:
                    pass

    def serve_directory(self, fd: int, body: bool) -> None:
        """Directory listings are OFF unless explicitly enabled.

        A listing of an sstate cache is a map of every package and every hash
        the mirror host has ever built -- product names, versions, internal
        branch names. bitbake never needs it: it constructs exact object URLs
        from its own hashes. So the default is 404, indistinguishable from a
        missing file.

        Takes the descriptor serve_file already opened, not a path: listing by
        name would re-introduce exactly the string-reopen bug open_under_root()
        exists to kill. os.listdir() and os.stat() both accept a dir_fd.
        """
        if not self.config.listing:
            self.fail(http.HTTPStatus.NOT_FOUND, reason="listing disabled")
            return
        try:
            names = sorted(os.listdir(fd))
        except OSError:
            self.fail(http.HTTPStatus.NOT_FOUND, reason="listdir failed")
            return
        # Plain text, not HTML: nothing to escape means nothing to escape
        # wrongly. wget and curl read it fine and bitbake does not read it at
        # all.
        lines = []
        for name in names:
            try:
                is_dir = stat.S_ISDIR(os.stat(name, dir_fd=fd).st_mode)
            except OSError:
                is_dir = False
            lines.append(name + ("/" if is_dir else ""))
        payload = ("\n".join(lines) + "\n").encode("utf-8", "replace")
        self.send_response_only(http.HTTPStatus.OK)
        self.send_header("Server", PROGRAM)
        self.send_header("Date", self.date_time_string())
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Content-Length", str(len(payload)))
        self.send_header("X-Content-Type-Options", "nosniff")
        self.end_headers()
        if body:
            self.wfile.write(payload)
        self.log_access(200, len(payload) if body else 0)

    def send_regular_file(self, fd: int, st: os.stat_result, target: str,
                          body: bool) -> None:
        size = st.st_size
        mtime = st.st_mtime
        last_modified = self.date_time_string(int(mtime))

        # If-Modified-Since. bitbake/wget send it when re-checking a mirror,
        # and answering 304 saves the whole transfer. BaseHTTPRequestHandler
        # gives us nothing here (that logic lives in SimpleHTTPRequestHandler,
        # which we do not inherit), so it is implemented explicitly.
        ims = self.headers.get("If-Modified-Since")
        if ims and not self.headers.get("If-None-Match"):
            try:
                import email.utils
                parsed = email.utils.parsedate_to_datetime(ims)
                if parsed is not None:
                    if parsed.tzinfo is None:
                        ims_ts = time.mktime(parsed.timetuple())
                    else:
                        ims_ts = parsed.timestamp()
                    if int(mtime) <= int(ims_ts):
                        self.send_response_only(http.HTTPStatus.NOT_MODIFIED)
                        self.send_header("Server", PROGRAM)
                        self.send_header("Date", self.date_time_string())
                        self.send_header("Last-Modified", last_modified)
                        self.send_header("Content-Length", "0")
                        self.end_headers()
                        self.log_access(304, 0)
                        return
            except (TypeError, ValueError, OverflowError, IndexError):
                pass  # Unparseable date: ignore it and send the file.

        # Range. SimpleHTTPRequestHandler does NOT implement Range at all --
        # it ignores the header and sends 200 with the whole body, which is
        # correct-but-useless for a resumed wget. We implement single-range
        # requests (the only form wget sends) because a resumed 200 MB
        # download over a flaky link is a real cost here. Multi-range is not
        # implemented; per RFC 7233 a server may ignore a Range it does not
        # understand and answer 200, which is what happens below.
        start, end = 0, size - 1
        partial = False
        range_header = self.headers.get("Range")
        if range_header and size > 0:
            parsed_range = parse_byte_range(range_header, size)
            if parsed_range == "unsatisfiable":
                self.fail(http.HTTPStatus.REQUESTED_RANGE_NOT_SATISFIABLE,
                          headers=[("Content-Range", "bytes */%d" % size)],
                          reason="unsatisfiable range")
                return
            if parsed_range is not None:
                start, end = parsed_range
                partial = True

        length = end - start + 1 if size > 0 else 0

        status = (http.HTTPStatus.PARTIAL_CONTENT if partial
                  else http.HTTPStatus.OK)
        self.send_response_only(status)
        self.send_header("Server", PROGRAM)
        self.send_header("Date", self.date_time_string())
        # One content type for everything. Sniffing the extension to decide
        # between application/octet-stream and text/html is how a stored file
        # becomes stored XSS; every object here is an opaque blob to bitbake,
        # so we say so and add nosniff to stop the browser second-guessing us.
        self.send_header("Content-Type", "application/octet-stream")
        self.send_header("Content-Length", str(length))
        self.send_header("Last-Modified", last_modified)
        self.send_header("Accept-Ranges", "bytes")
        self.send_header("X-Content-Type-Options", "nosniff")
        if partial:
            self.send_header("Content-Range",
                             "bytes %d-%d/%d" % (start, end, size))
        self.end_headers()

        if not body:
            self.log_access(int(status), 0)
            return

        sent = 0
        try:
            if start:
                os.lseek(fd, start, os.SEEK_SET)
            remaining = length
            while remaining > 0:
                chunk = os.read(fd, min(65536, remaining))
                if not chunk:
                    break  # File shrank under us; Content-Length now lies, so
                    # close the connection rather than desync the stream.
                self.wfile.write(chunk)
                remaining -= len(chunk)
                sent += len(chunk)
            if remaining > 0:
                self.close_connection = True
        except (BrokenPipeError, ConnectionResetError):
            self.close_connection = True
        self.log_access(int(status), sent)


def parse_byte_range(header: str, size: int):
    """Parse a single-range 'Range: bytes=a-b' header.

    Returns (start, end) inclusive, None if the header should be ignored, or
    the string 'unsatisfiable' for a 416. Anything malformed is ignored rather
    than rejected, per RFC 7233 section 3.1.
    """
    header = header.strip()
    if not header.lower().startswith("bytes="):
        return None
    spec = header[6:].strip()
    if "," in spec:
        return None  # multi-range: not implemented, ignore and send 200
    first, sep, last = spec.partition("-")
    if not sep:
        return None
    first, last = first.strip(), last.strip()
    try:
        if not first:
            # Suffix range: "bytes=-500" == the last 500 bytes.
            if not last:
                return None
            nbytes = int(last)
            if nbytes <= 0:
                return "unsatisfiable"
            start = max(0, size - nbytes)
            return (start, size - 1)
        start = int(first)
        if start < 0:
            return None
        if start >= size:
            return "unsatisfiable"
        if not last:
            return (start, size - 1)
        end = int(last)
        if end < start:
            return None
        return (start, min(end, size - 1))
    except ValueError:
        return None


