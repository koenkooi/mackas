class ConfigError(Exception):
    """Bad configuration. Always fatal; never reported to a client."""


class Config:
    def __init__(self) -> None:
        self.roots: Dict[str, str] = {}
        self.bind = DEFAULT_BIND
        self.port = DEFAULT_PORT
        self.allow_nets: List[ipaddress._BaseNetwork] = []
        self.creds = CredentialStore([])
        self.realm = "mackas mirror"
        self.tls_cert: Optional[str] = None
        self.tls_key: Optional[str] = None
        self.listing = False
        self.allow_symlinks = True
        self.timeout = DEFAULT_TIMEOUT
        self.max_connections = DEFAULT_MAX_CONNECTIONS
        self.rate = DEFAULT_RATE
        self.burst = DEFAULT_BURST
        self.cache_dir: Optional[str] = None
        self.cache_min_hits = DEFAULT_CACHE_MIN_HITS
        self.cache_max_size_mb = DEFAULT_CACHE_MAX_SIZE_MB
        self.cache: Optional[CacheManager] = None
        self.user: Optional[str] = None
        self.group: Optional[str] = None
