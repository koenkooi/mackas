class Credential:
    """One username plus a salted PBKDF2 hash of its password.

    The password is never stored, never passed on argv (argv is world-readable
    via ps(1) on Linux), and never logged. The on-disk record is:

        username:pbkdf2_sha256:ITERATIONS:SALT_B64:HASH_B64

    Generate one with `mackas-mirrord --hash-password`.
    """

    __slots__ = ("username", "algo", "iterations", "salt", "digest")

    def __init__(self, username: str, algo: str, iterations: int,
                 salt: bytes, digest: bytes) -> None:
        self.username = username
        self.algo = algo
        self.iterations = iterations
        self.salt = salt
        self.digest = digest

    @classmethod
    def parse(cls, line: str) -> "Credential":
        parts = line.strip().split(":")
        if len(parts) != 5:
            raise ValueError(
                "credential must have 5 colon-separated fields "
                "(username:algo:iterations:salt:hash)")
        username, algo, iters, salt_b64, hash_b64 = parts
        if not username:
            raise ValueError("credential has an empty username")
        if algo != "pbkdf2_" + PBKDF2_ALGO:
            raise ValueError("unsupported credential algorithm: %r" % algo)
        try:
            iterations = int(iters)
        except ValueError:
            raise ValueError("credential iteration count is not a number")
        if iterations < 1000:
            raise ValueError("credential iteration count is implausibly low")
        try:
            salt = base64.b64decode(salt_b64, validate=True)
            digest = base64.b64decode(hash_b64, validate=True)
        except (binascii.Error, ValueError):
            raise ValueError("credential salt/hash is not valid base64")
        if not salt or not digest:
            raise ValueError("credential salt/hash is empty")
        return cls(username, algo, iterations, salt, digest)

    def derive(self, password: str) -> bytes:
        return hashlib.pbkdf2_hmac(
            PBKDF2_ALGO, password.encode("utf-8"), self.salt,
            self.iterations, dklen=len(self.digest))

    def verify(self, password: str) -> bool:
        """Constant-time password check.

        `==` on the derived digests would leak, through its early exit, how
        many leading bytes matched -- enough to reconstruct the digest one
        byte at a time over many requests. hmac.compare_digest does not
        short-circuit.
        """
        return hmac.compare_digest(self.derive(password), self.digest)

    def __str__(self) -> str:
        return "%s:%s:%d:%s:%s" % (
            self.username, self.algo, self.iterations,
            base64.b64encode(self.salt).decode("ascii"),
            base64.b64encode(self.digest).decode("ascii"))


def make_credential(username: str, password: str) -> Credential:
    salt = os.urandom(SALT_BYTES)
    digest = hashlib.pbkdf2_hmac(
        PBKDF2_ALGO, password.encode("utf-8"), salt, PBKDF2_ITERATIONS)
    return Credential(username, "pbkdf2_" + PBKDF2_ALGO,
                      PBKDF2_ITERATIONS, salt, digest)


class CredentialStore:
    """The set of accepted credentials, and the Basic-auth check itself.

    THE AMPLIFIER THIS GUARDS AGAINST

    Every request carrying an Authorization header used to cost a full
    200k-iteration PBKDF2 -- 0.03-0.1s depending on hardware -- before we knew
    anything about the client. That is an unauthenticated attacker spending one
    cheap HTTP request to buy 0.1s of our CPU: ~34 req/s pegs a core, and
    DEFAULT_RATE was 0.0, so nothing was in the way. The KDF being slow is the
    point of a KDF; being slow *on demand, for anyone* is the bug.

    The fix is a verification cache, and it has to come first, because it is
    what makes rate-limiting the KDF safe. bitbake is a legitimate flood: it
    fires thousands of sstate probes, all with the identical Authorization
    header. Rate-limiting KDF invocations alone would start 401ing a real
    build. With the cache, that flood costs exactly ONE derivation and every
    subsequent probe is a dict lookup -- so a per-IP budget on actual
    derivations (see MirrorHandler.check_password) only ever bites a client
    trying *distinct* passwords, which is precisely the attacker and never
    bitbake.

    What is cached is a keyed hash, not the password: the key is HMAC-SHA256 of
    user:pass under a per-process random secret, so the table is useless to
    anyone who reads our memory later and cannot be precomputed. Entries expire
    (TTL) and the table is bounded, so it cannot be grown into a memory attack.
    Both hits and misses are cached -- a flood of one wrong password is as
    cheap to refuse as a right one is to accept.

    Timing, honestly: a cache hit is fast and a miss is slow, so an attacker
    can tell "this exact user:password pair was tried in the last few minutes"
    apart from a fresh one. That leaks nothing about whether a username exists
    or a password is right -- the unknown-username decoy above still equalises
    that -- and it is a good trade for removing the amplifier.
    """

    _CACHE_MAX = 1024
    _CACHE_TTL = 300.0

    def __init__(self, creds: Sequence[Credential]) -> None:
        self._by_user = {c.username: c for c in creds}
        self._cache = {}
        self._cache_lock = threading.Lock()
        self._cache_secret = os.urandom(32)
        # A decoy used when the username is unknown, so that a wrong username
        # costs the same wall-clock time as a wrong password. Without this,
        # response latency is a username oracle.
        #
        # The decoy's cost must be COPIED FROM A REAL CREDENTIAL, not from our
        # own defaults. It used to hardcode PBKDF2_ITERATIONS and dklen=32, so
        # a cred file written with different parameters -- an older file, a
        # hand-tuned one, a future default -- made the decoy cheaper or dearer
        # than the real thing, and the timing oracle this exists to close
        # reopened. Deriving the shape from a loaded credential means the decoy
        # tracks whatever is actually in the file.
        template = creds[0] if creds else None
        if template is not None:
            self._decoy = Credential(
                "", template.algo, template.iterations,
                b"\x00" * len(template.salt), b"\x00" * len(template.digest))
        else:
            self._decoy = Credential(
                "", "pbkdf2_" + PBKDF2_ALGO, PBKDF2_ITERATIONS,
                b"\x00" * SALT_BYTES, b"\x00" * 32)
        # Honest limit: with a mixed-parameter cred file the decoy can only
        # match one of them, so users whose records differ from creds[0] stay
        # distinguishable from each other by timing. Matching every record is
        # not possible with one decoy, and a file with per-user PBKDF2 costs is
        # not a thing this tool creates -- make_credential() writes one shape.

    def __bool__(self) -> bool:
        return bool(self._by_user)

    def __len__(self) -> int:
        return len(self._by_user)

    def _cache_key(self, username: str, password: str) -> bytes:
        # Length-prefixed so that ("ab", "c") and ("a", "bc") cannot collide
        # into the same key and let one credential authenticate as another.
        blob = ("%d:%s:%s" % (len(username), username, password))
        return hmac.new(self._cache_secret, blob.encode("utf-8"),
                        "sha256").digest()

    def cached_result(self, username: str, password: str) -> Optional[bool]:
        """A previously computed verdict for this exact pair, or None."""
        key = self._cache_key(username, password)
        now = time.monotonic()
        with self._cache_lock:
            entry = self._cache.get(key)
            if entry is None:
                return None
            result, expires = entry
            if expires <= now:
                self._cache.pop(key, None)
                return None
            return result

    def _remember(self, username: str, password: str, result: bool) -> None:
        key = self._cache_key(username, password)
        now = time.monotonic()
        with self._cache_lock:
            if len(self._cache) >= self._CACHE_MAX:
                for stale, (_, expires) in list(self._cache.items()):
                    if expires <= now:
                        del self._cache[stale]
                if len(self._cache) >= self._CACHE_MAX:
                    # Still full of live entries: this is a flood of distinct
                    # passwords, i.e. an attack, not a working set. Drop the
                    # lot rather than grow without bound. The KDF budget is
                    # what actually rate-limits them; this just bounds memory.
                    self._cache.clear()
            self._cache[key] = (result, now + self._CACHE_TTL)

    def check(self, username: str, password: str) -> bool:
        """Verify a credential, paying the full KDF cost. Caller must budget it.

        Do NOT call this on every request -- call MirrorHandler.check_password,
        which consults the cache and the per-IP KDF budget first.
        """
        cred = self._by_user.get(username)
        if cred is None:
            self._decoy.verify(password)  # burn the same time, then fail
            result = False
        else:
            result = cred.verify(password)
        self._remember(username, password, result)
        return result


def load_credentials(text: str, source: str) -> List[Credential]:
    creds = []
    for lineno, raw in enumerate(text.splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        try:
            creds.append(Credential.parse(line))
        except ValueError as exc:
            raise ConfigError("%s:%d: %s" % (source, lineno, exc))
    return creds


# ---------------------------------------------------------------------------
# Path resolution -- the security-critical core
# ---------------------------------------------------------------------------


class PathRejected(Exception):
    """The request path is malformed or hostile. Never serve it."""


def split_url_path(raw: str) -> str:
    """Take the path component of a request target and decode it exactly once.

    Decoding once is deliberate and sufficient. A client sending `%252e%252e`
    gets one decode to the literal seven characters `%2e%2e`, which is a
    filename, not a traversal -- decoding twice is the bug that makes
    double-encoding attacks work, so we do not.

    The leading-'//' collapse is not cosmetic. urlsplit('//sstate/x') reads
    'sstate' as a NETLOC, not a path segment, and returns path='/x' -- so the
    root prefix would silently vanish and '/x' would be resolved against
    whichever root came first. Today that is unreachable, because
    parse_request() collapses a leading '//' before we ever see it, which means
    our safety here rests on an undocumented implementation detail of a
    function we do not control. That is a fine thing to have noticed and a
    terrible thing to depend on: it can change in a point release, and the
    failure mode is silent. So we normalize it ourselves and stop caring what
    parse_request does.
    """
    if raw.startswith("//"):
        raw = "/" + raw.lstrip("/")
    return urlsplit(raw).path


def resolve_under_root(root_real: str, url_path: str,
                       allow_symlinks: bool = True) -> str:
    """Map a URL path to a real file inside `root_real`, or refuse.

    This is the function that stands between a public port and the rest of the
    filesystem. It defends against, in order:

      * Absolute paths and drive-letter tricks -- the path must start with '/'
        and is treated as relative to the root regardless.
      * NUL bytes -- os.* raises ValueError on embedded NUL, but some layers
        historically truncated at it, so `/etc/passwd\\0.txt` could pass an
        extension check and open something else. Rejected outright.
      * Control characters -- no legitimate cache object has one, and they
        exist in a request only to confuse a downstream parser or a log.
      * Backslashes -- not a separator on POSIX, but they are on other
        platforms and in some client libraries' idea of normalization. There
        is no legitimate '\\' in a bitbake sstate path; refusing is free.
      * '..' segments, encoded or not -- after the single unquote above,
        `..`, `%2e%2e`, `..%2f` and `%2e%2e%2f` are all just `..`, and are
        rejected as segments rather than normalized away. Normalizing is
        where traversal bugs live; refusing is unambiguous.
      * Symlink escape -- the root is an NFS mount whose *contents we do not
        control*. Anyone who can write to the export can drop in a symlink to
        /etc/shadow and read it through us. os.path.realpath resolves every
        component, so the containment check below sees the true target.
      * Prefix confusion -- containment is checked with os.path.commonpath,
        NOT str.startswith. '/root-evil/x'.startswith('/root') is True, and
        that single line is a complete filesystem escape. commonpath compares
        path *components*, so commonpath(['/root', '/root-evil']) == '/'.

    Returns the resolved absolute real path. Raises PathRejected otherwise.

    WHAT THIS FUNCTION IS AND IS NOT

    Everything above is a *check*, and every check is a snapshot: it describes
    the filesystem as it was at realpath() time. The root is an NFS export
    whose contents we do not control, so anyone who can write to it can change
    the shape of the tree immediately after we look. This function therefore
    decides only "is this request plausible" -- it is a cheap first gate that
    rejects the overwhelming majority of hostile paths without touching an
    open().

    It is NOT the containment mechanism, and its answer must never be re-opened
    by string. Containment is enforced by open_under_root() below, which walks
    the result component by component from a descriptor on the root. See the
    comment there for why the obvious "realpath then open(path, O_NOFOLLOW)"
    is not enough.
    """
    if "\0" in url_path:
        raise PathRejected("NUL byte in path")
    if any(ord(ch) < 0x20 or ord(ch) == 0x7f for ch in url_path):
        raise PathRejected("control character in path")
    if "\\" in url_path:
        raise PathRejected("backslash in path")

    if not url_path.startswith("/"):
        raise PathRejected("path is not absolute")

    segments = []
    for seg in url_path.split("/"):
        if seg in ("", "."):
            continue
        if seg == "..":
            raise PathRejected("'..' segment in path")
        if "\0" in seg:
            raise PathRejected("NUL byte in segment")
        segments.append(seg)

    candidate = os.path.join(root_real, *segments) if segments else root_real

    try:
        resolved = os.path.realpath(candidate)
    except (OSError, ValueError) as exc:
        raise PathRejected("cannot resolve path: %s" % exc)

    # Containment. Both paths are absolute and already realpath'd, so
    # commonpath is comparing canonical component lists.
    try:
        common = os.path.commonpath([root_real, resolved])
    except ValueError as exc:
        # Raised for mixed absolute/relative or (on Windows) mixed drives.
        raise PathRejected("cannot compare path to root: %s" % exc)
    if common != root_real:
        raise PathRejected("resolved path escapes the root")

    if not allow_symlinks:
        # Strict mode: refuse if any component under the root is a symlink,
        # even one that stays inside. Cheap because the depth is small.
        rel = os.path.relpath(resolved, root_real)
        if rel != ".":
            walk = root_real
            for seg in rel.split(os.sep):
                walk = os.path.join(walk, seg)
                try:
                    if stat.S_ISLNK(os.lstat(walk).st_mode):
                        raise PathRejected("symlink in path (strict mode)")
                except OSError:
                    break  # nonexistent -> the open below will 404
        # A path that realpath changed at all means a symlink was traversed
        # somewhere; catch the case the walk above cannot see.
        if os.path.realpath(candidate) != os.path.abspath(candidate):
            raise PathRejected("symlink in path (strict mode)")

    return resolved


# Flags, resolved once. getattr() because the O_* names are POSIX-only and we
# would rather degrade loudly than crash at import on an exotic platform.
_O_NOFOLLOW = getattr(os, "O_NOFOLLOW", 0)
_O_DIRECTORY = getattr(os, "O_DIRECTORY", 0)
_O_NONBLOCK = getattr(os, "O_NONBLOCK", 0)


def open_under_root(root_real: str, resolved: str) -> int:
    """Open `resolved` by descending from `root_real` one component at a time.

    WHY THIS EXISTS -- the bug this replaces

    The previous code realpath'd the path and then re-opened the *string* with
    O_NOFOLLOW, on the theory that "realpath's output contains no symlinks by
    construction, so O_NOFOLLOW can only fire if the path changed under us".
    That reasoning is wrong, and only ever described the LAST component.
    O_NOFOLLOW governs the final component and nothing else: every directory
    in the middle is resolved by the kernel, following symlinks, exactly as
    normal. So an attacker with write access to the export could swap an
    intermediate directory -- root/sub -- for a symlink to /etc in the window
    between our realpath() and our open(), and the open would cheerfully walk
    through it. The checks all passed; they just described a tree that no
    longer existed. On NFS the window is wide: realpath costs a network round
    trip per component.

    HOW THIS FIXES IT

    We never hand a multi-component path to the kernel again. We open the root
    directory once, then for each component call
    os.open(seg, O_NOFOLLOW|O_DIRECTORY, dir_fd=parent), closing each parent as
    we descend. Every step is relative to a descriptor we already hold, so
    there is no name for the kernel to re-resolve and nothing for an attacker
    to swap: a descriptor keeps pointing at the inode it was opened on even if
    the directory entry that produced it is renamed or replaced a microsecond
    later. O_NOFOLLOW on *every* component means a symlink appearing anywhere
    in the chain is refused (ELOOP) rather than followed. Containment stops
    being a property we check and hope holds, and becomes a property of how the
    descriptors were obtained.

    The one open-by-string is the root itself. That is deliberate and safe: the
    root is operator-supplied, realpath'd at config time, and its parent
    directories are the mount path, which is outside the threat model -- the
    attacker controls the *contents* of the export, not the path to it.

    WHY NOT openat2(RESOLVE_BENEATH)

    It does exactly this in one syscall, but it is Linux 5.6+ only and has no
    stdlib binding. This walk is pure stdlib and behaves identically on the
    Linux mirror host and on macOS, where the tests run.

    WHAT THIS MEANS FOR SYMLINKS (--no-symlinks semantics are unchanged)

    Note we walk the components of the *realpath output*, not of the URL. That
    is what keeps legitimate symlinks working, and DL_DIR is full of them:

      * An intra-root symlink leaf -- downloads/foo.tar.gz -> ../git2/foo --
        was already resolved by realpath, so the components we walk are the
        real ones and the file is served. Correct: the reviewer's rule is that
        an intra-root symlink is legitimate.
      * An escaping symlink was already refused by the commonpath check, so we
        never get here.
      * A symlink that appears in the chain *after* resolve_under_root looked
        is precisely the attack, and O_NOFOLLOW refuses it. That is the
        default, and it is not the same thing as "refuse all symlinks": a
        symlink resolved before the check is followed, a symlink that appears
        after it is not.

    So the default still serves symlinked cache objects, and --no-symlinks
    still means the stricter "no symlink anywhere under the root", enforced by
    resolve_under_root above. Neither option's meaning changed; only the
    mechanism that enforces the default did.

    Returns an open descriptor the caller owns. Raises OSError (ENOENT, ELOOP,
    ENOTDIR ... -- mapped to a status by the caller) or PathRejected.
    """
    dir_flags = os.O_RDONLY | _O_NOFOLLOW | _O_DIRECTORY
    # O_NONBLOCK on the leaf so that opening a FIFO an attacker planted in the
    # export cannot hang this thread forever.
    leaf_flags = os.O_RDONLY | _O_NOFOLLOW | _O_NONBLOCK

    rel = os.path.relpath(resolved, root_real)
    segments = [] if rel == os.curdir else rel.split(os.sep)
    # relpath on two realpath'd, commonpath-contained absolutes cannot produce
    # these. Belt and braces: if it ever did, we would be walking upwards.
    for seg in segments:
        if seg in ("", os.curdir, os.pardir):
            raise PathRejected("non-canonical component after resolution")

    parent = os.open(root_real, dir_flags)
    try:
        for seg in segments[:-1]:
            child = os.open(seg, dir_flags, dir_fd=parent)
            os.close(parent)
            parent = child
        if not segments:
            # The request is for the root directory itself.
            return os.dup(parent)
        return os.open(segments[-1], leaf_flags, dir_fd=parent)
    finally:
        os.close(parent)


