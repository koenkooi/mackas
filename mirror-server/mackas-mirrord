def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog=PROGRAM,
        description="Read-only HTTP bridge from an NFS-mounted OpenEmbedded build "
                    "cache to bitbake's SSTATE_MIRRORS / SOURCE_MIRROR_URL.",
        epilog=EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter)

    p.add_argument("--version", action="version",
                   version="%s %s" % (PROGRAM, VERSION))
    p.add_argument("--config", metavar="FILE",
                   help="KEY=VALUE config file (not sourced as shell)")

    g = p.add_argument_group("what to serve")
    g.add_argument("--root", metavar="NAME=PATH", action="append", default=[],
                   help="serve PATH under /NAME/. Repeatable. A bare PATH "
                        "serves it at the URL root.")
    g.add_argument("--listing", action="store_true", default=None,
                   help="enable directory listings (OFF by default: a listing "
                        "of an sstate cache maps every package you build)")
    g.add_argument("--no-symlinks", action="store_true", default=None,
                   help="refuse ALL symlinks under the root, not just "
                        "escaping ones (escaping symlinks are always refused)")

    g = p.add_argument_group("local cache")
    g.add_argument("--cache-dir", metavar="DIR",
                   help="cache hot objects here after --cache-min-hits "
                        "requests/day and serve later requests from disk "
                        "instead of the (possibly slow) root. Must be "
                        "outside every --root. Default: unset, i.e. "
                        "caching OFF -- opt-in only.")
    g.add_argument("--cache-min-hits", metavar="N", type=int,
                   help="promote an object to the cache after this many "
                        "requests for it in one calendar day (default: "
                        "%d, i.e. 'more than %d')"
                        % (DEFAULT_CACHE_MIN_HITS, DEFAULT_CACHE_MIN_HITS - 1))
    g.add_argument("--cache-max-size-mb", metavar="N", type=int,
                   help="evict least-recently-used cached objects once the "
                        "cache exceeds this size, in MiB (default: %d). "
                        "The backstop for a single day -- daily rotation is "
                        "what actually keeps steady-state size down."
                        % DEFAULT_CACHE_MAX_SIZE_MB)

    g = p.add_argument_group("where to listen")
    g.add_argument("--bind", metavar="ADDR",
                   help="address to bind (default: %s)" % DEFAULT_BIND)
    g.add_argument("--port", metavar="N", type=int,
                   help="port (default: %d)" % DEFAULT_PORT)

    g = p.add_argument_group("access control")
    g.add_argument("--allow", metavar="CIDR", action="append", default=[],
                   help="allow only these IPs/CIDRs. Repeatable. Without "
                        "--cred-file this is the ONLY control -- acceptable "
                        "on a trusted LAN, and stated as such.")
    g.add_argument("--cred-file", metavar="FILE",
                   help="file of username:pbkdf2_sha256:iters:salt:hash lines "
                        "(see --hash-password)")
    g.add_argument("--realm", metavar="STR", help="Basic-auth realm")
    g.add_argument("--hash-password", action="store_true",
                   help="prompt for a username and password, print a "
                        "credential line, and exit")

    g = p.add_argument_group("tls")
    g.add_argument("--tls-cert", metavar="FILE", help="PEM certificate chain")
    g.add_argument("--tls-key", metavar="FILE", help="PEM private key")

    g = p.add_argument_group("hardening")
    g.add_argument("--user", metavar="NAME",
                   help="drop to this user if started as root (required when "
                        "running as root)")
    g.add_argument("--group", metavar="NAME", help="drop to this group")
    g.add_argument("--allow-root", action="store_true", default=None,
                   help="permit running as root with no --user (loudly "
                        "discouraged)")
    g.add_argument("--timeout", metavar="SEC", type=float,
                   help="per-connection socket timeout, blunts slowloris "
                        "(default: %g)" % DEFAULT_TIMEOUT)
    g.add_argument("--max-connections", metavar="N", type=int,
                   help="hard cap on concurrent connections (default: %d)"
                        % DEFAULT_MAX_CONNECTIONS)
    g.add_argument("--rate", metavar="RPS", type=float,
                   help="per-IP requests/second, 0 disables (default: %g)"
                        % DEFAULT_RATE)
    g.add_argument("--burst", metavar="N", type=int,
                   help="per-IP burst allowance (default: %d)" % DEFAULT_BURST)

    g = p.add_argument_group("other")
    g.add_argument("--check", "--dry-run", dest="check", action="store_true",
                   help="validate the configuration, report it, and exit "
                        "without binding the port")
    g.add_argument("--quiet", action="store_true", default=None,
                   help="suppress the per-request access log")
    g.add_argument("--debug", action="store_true", help="verbose logging")
    return p


def env_get(name: str) -> Optional[str]:
    return os.environ.get(ENV_PREFIX + name)


def resolve_config(args: argparse.Namespace) -> Config:
    """Apply precedence: defaults -> config file -> env -> CLI flags."""
    cfg = Config()

    filecfg: Dict[str, str] = {}
    config_path = args.config or env_get("CONFIG")
    if config_path:
        filecfg = parse_kv_file(config_path)

    def pick(key: str, cli_value, default=None):
        if cli_value is not None and cli_value != [] and cli_value is not False:
            return cli_value
        env_value = env_get(key)
        if env_value is not None:
            return env_value
        if key in filecfg:
            return filecfg[key]
        if ENV_PREFIX + key in filecfg:
            return filecfg[ENV_PREFIX + key]
        return default

    root_specs: List[str] = list(args.root)
    if not root_specs:
        raw = pick("ROOTS", None)
        if raw:
            root_specs = [s for s in raw.split(",") if s.strip()]
    if not root_specs:
        raise ConfigError("no --root given; there is nothing to serve")
    cfg.roots = validate_roots(root_specs)

    cfg.bind = str(pick("BIND", args.bind, DEFAULT_BIND))
    port = pick("PORT", args.port, DEFAULT_PORT)
    try:
        cfg.port = int(port)
    except (TypeError, ValueError):
        raise ConfigError("port is not a number: %r" % port)
    if not (1 <= cfg.port <= 65535):
        raise ConfigError("port out of range: %d" % cfg.port)

    allow_specs: List[str] = list(args.allow)
    if not allow_specs:
        raw = pick("ALLOW", None)
        if raw:
            allow_specs = [s for s in re.split(r"[,\s]+", raw) if s]
    for spec in allow_specs:
        try:
            # strict=False so that "192.0.2.5/24" is accepted as the /24 it
            # obviously means, rather than erroring on host bits.
            cfg.allow_nets.append(ipaddress.ip_network(spec, strict=False))
        except ValueError as exc:
            raise ConfigError("bad --allow %r: %s" % (spec, exc))

    cred_text = None
    cred_source = "<none>"
    cred_file = pick("CRED_FILE", args.cred_file)
    inline = env_get("CRED")
    if cred_file:
        try:
            st = os.stat(cred_file)
        except OSError as exc:
            raise ConfigError("cannot stat credential file: %s" % exc)
        if st.st_mode & (stat.S_IRWXG | stat.S_IRWXO):
            # A credential file readable by other local users is a credential
            # everyone has. Refuse rather than warn: a warning in a systemd
            # journal is a warning nobody reads.
            raise ConfigError(
                "credential file %s is group/world accessible (mode %o); "
                "chmod 600 it" % (cred_file, st.st_mode & 0o777))
        try:
            with open(cred_file, "r", encoding="utf-8") as fh:
                cred_text = fh.read()
        except OSError as exc:
            raise ConfigError("cannot read credential file: %s" % exc)
        cred_source = cred_file
    elif inline:
        # An env var is visible in /proc/PID/environ to the owning user and
        # root only -- unlike argv, which /proc/PID/cmdline shows to everyone.
        # Still second-best to a file; documented as such.
        cred_text = inline
        cred_source = "$%sCRED" % ENV_PREFIX
    if cred_text is not None:
        creds = load_credentials(cred_text, cred_source)
        if not creds:
            raise ConfigError("%s contains no credentials" % cred_source)
        cfg.creds = CredentialStore(creds)

    cfg.realm = str(pick("REALM", args.realm, "mackas mirror"))
    cfg.tls_cert = pick("TLS_CERT", args.tls_cert)
    cfg.tls_key = pick("TLS_KEY", args.tls_key)
    if bool(cfg.tls_cert) != bool(cfg.tls_key):
        raise ConfigError("--tls-cert and --tls-key must be given together")

    listing = pick("LISTING", args.listing, False)
    cfg.listing = listing if isinstance(listing, bool) else _as_bool(listing, "LISTING")
    nosym = pick("NO_SYMLINKS", args.no_symlinks, False)
    nosym = nosym if isinstance(nosym, bool) else _as_bool(nosym, "NO_SYMLINKS")
    cfg.allow_symlinks = not nosym

    timeout = pick("TIMEOUT", args.timeout, DEFAULT_TIMEOUT)
    cfg.timeout = float(timeout)
    if cfg.timeout <= 0:
        raise ConfigError("timeout must be positive")
    maxconn = pick("MAX_CONNECTIONS", args.max_connections,
                   DEFAULT_MAX_CONNECTIONS)
    cfg.max_connections = int(maxconn)
    if cfg.max_connections < 1:
        raise ConfigError("max-connections must be >= 1")
    cfg.rate = float(pick("RATE", args.rate, DEFAULT_RATE))
    cfg.burst = int(pick("BURST", args.burst, DEFAULT_BURST))
    if cfg.burst < 1:
        raise ConfigError("burst must be >= 1")

    cache_dir = pick("CACHE_DIR", args.cache_dir)
    cfg.cache_dir = str(cache_dir) if cache_dir else None
    min_hits = pick("CACHE_MIN_HITS", args.cache_min_hits,
                    DEFAULT_CACHE_MIN_HITS)
    try:
        cfg.cache_min_hits = int(min_hits)
    except (TypeError, ValueError):
        raise ConfigError("cache-min-hits is not a number: %r" % min_hits)
    if cfg.cache_min_hits < 1:
        raise ConfigError("cache-min-hits must be >= 1")
    max_mb = pick("CACHE_MAX_SIZE_MB", args.cache_max_size_mb,
                 DEFAULT_CACHE_MAX_SIZE_MB)
    try:
        cfg.cache_max_size_mb = int(max_mb)
    except (TypeError, ValueError):
        raise ConfigError("cache-max-size-mb is not a number: %r" % max_mb)
    if cfg.cache_max_size_mb < 1:
        raise ConfigError("cache-max-size-mb must be >= 1")
    if cfg.cache_dir:
        real = validate_cache_dir(cfg.cache_dir, cfg.roots)
        cfg.cache_dir = real
        cfg.cache = CacheManager(
            real, cfg.cache_min_hits, cfg.cache_max_size_mb * 1024 * 1024)

    cfg.user = pick("USER", args.user)
    cfg.group = pick("GROUP", args.group)
    quiet = pick("QUIET", args.quiet, False)
    cfg.quiet = quiet if isinstance(quiet, bool) else _as_bool(quiet, "QUIET")

    allow_root = pick("ALLOW_ROOT", args.allow_root, False)
    allow_root = (allow_root if isinstance(allow_root, bool)
                  else _as_bool(allow_root, "ALLOW_ROOT"))

    if os.getuid() == 0 and not cfg.user and not allow_root:
        raise ConfigError(
            "refusing to run as root without --user. This process reads an "
            "NFS mount and answers a public port; it needs no privilege at "
            "all beyond binding it. Pass --user nobody (or use the systemd "
            "unit, which does it for you), or --allow-root if you have "
            "genuinely thought about it.")

    if not cfg.allow_nets and not cfg.creds:
        log.warning(
            "no --allow and no --cred-file: this server is open to anyone "
            "who can reach %s:%d. That may be what you want on a trusted "
            "LAN; it is not what you want anywhere else.", cfg.bind, cfg.port)
    if cfg.creds and not cfg.tls_cert:
        log.warning(
            "Basic auth without TLS: the password crosses the network "
            "base64-encoded, which is not encryption. Fine behind a trusted "
            "LAN; use --tls-cert/--tls-key otherwise.")

    return cfg


def describe(cfg: Config) -> str:
    lines = ["%s %s configuration:" % (PROGRAM, VERSION)]
    for name, path in sorted(cfg.roots.items()):
        lines.append("  root        /%s -> %s" % (name, path))
    lines.append("  listen      %s:%d (%s)"
                 % (cfg.bind, cfg.port, "https" if cfg.tls_cert else "http"))
    lines.append("  allowlist   %s"
                 % (", ".join(str(n) for n in cfg.allow_nets) or "(none - all IPs)"))
    lines.append("  auth        %s"
                 % ("%d credential(s)" % len(cfg.creds) if cfg.creds
                    else "(none - anonymous)"))
    lines.append("  tls         %s" % (cfg.tls_cert or "off"))
    lines.append("  listings    %s" % ("on" if cfg.listing else "off"))
    lines.append("  symlinks    %s"
                 % ("inside root only" if cfg.allow_symlinks else "refused"))
    lines.append("  timeout     %gs" % cfg.timeout)
    lines.append("  max conns   %d" % cfg.max_connections)
    lines.append("  rate limit  %s"
                 % ("%g/s per IP, burst %d" % (cfg.rate, cfg.burst)
                    if cfg.rate > 0 else "off"))
    lines.append("  cache       %s"
                 % ("%s (>= %d hits/day, cap %d MiB)"
                    % (cfg.cache_dir, cfg.cache_min_hits,
                       cfg.cache_max_size_mb)
                    if cfg.cache_dir else "off"))
    lines.append("  privdrop    %s"
                 % ("%s:%s" % (cfg.user, cfg.group or "(primary)")
                    if cfg.user else "(not root / none)"))
    return "\n".join(lines)


def do_hash_password() -> int:
    """Interactive credential generator. The password never touches argv."""
    username = input("username: ").strip()
    if not username:
        print("empty username", file=sys.stderr)
        return 2
    if ":" in username:
        print("username may not contain ':'", file=sys.stderr)
        return 2
    password = getpass.getpass("password: ")
    again = getpass.getpass("password (again): ")
    if not hmac.compare_digest(password, again):
        print("passwords do not match", file=sys.stderr)
        return 2
    if len(password) < 12:
        print("warning: password is shorter than 12 characters",
              file=sys.stderr)
    print(make_credential(username, password))
    return 0


def setup_logging(debug: bool) -> None:
    for existing in list(log.handlers):
        log.removeHandler(existing)
    handler = logging.StreamHandler(sys.stdout)
    handler.setFormatter(logging.Formatter(
        fmt="%(asctime)s %(levelname)s %(message)s",
        datefmt="%Y-%m-%dT%H:%M:%S%z"))
    log.addHandler(handler)
    log.setLevel(logging.DEBUG if debug else logging.INFO)
    log.propagate = False


def serve(cfg: Config) -> int:
    limiter = RateLimiter(cfg.rate, cfg.burst)
    handler_cls = make_handler(cfg, limiter)

    family = socket.AF_INET
    try:
        if ipaddress.ip_address(cfg.bind).version == 6:
            family = socket.AF_INET6
    except ValueError:
        pass  # a hostname; let getaddrinfo sort it out as v4

    try:
        httpd = MirrorServer((cfg.bind, cfg.port), handler_cls,
                             cfg.max_connections, cfg.timeout, family)
    except OSError as exc:
        log.error("cannot bind %s:%d: %s", cfg.bind, cfg.port, exc)
        return 1

    if cfg.tls_cert and cfg.tls_key:
        # Hand the context to the server; it wraps each accepted connection in
        # that connection's own worker thread. The listener stays plain TCP on
        # purpose -- see MirrorServer.process_request_thread().
        httpd.ssl_context = build_ssl_context(cfg.tls_cert, cfg.tls_key)

    # Bind first, then drop: binding a port below 1024 needs root, and the
    # order here means we hold that privilege for microseconds rather than
    # for the process lifetime.
    drop_privileges(cfg.user, cfg.group)

    if os.getuid() == 0:
        log.warning("running as root. Nothing here needs root; use --user.")

    stopping = threading.Event()

    def on_signal(signum, _frame):
        if stopping.is_set():
            return
        stopping.set()
        log.info("caught %s; shutting down",
                 signal.Signals(signum).name)
        # shutdown() blocks until serve_forever returns, and cannot be called
        # from the thread running serve_forever -- hence the helper thread.
        threading.Thread(target=httpd.shutdown, daemon=True).start()

    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGINT, on_signal)

    log.info("%s %s serving %s on %s:%d%s", PROGRAM, VERSION,
             ", ".join("/" + n if n else "/" for n in sorted(cfg.roots)),
             cfg.bind, cfg.port, " (TLS)" if cfg.tls_cert else "")
    try:
        httpd.serve_forever(poll_interval=0.5)
    finally:
        httpd.server_close()
    log.info("stopped")
    return 0


def main(argv: Optional[Sequence[str]] = None) -> int:
    if sys.version_info < MIN_PYTHON:
        sys.stderr.write("%s needs Python %d.%d or newer (found %s)\n"
                         % (PROGRAM, MIN_PYTHON[0], MIN_PYTHON[1],
                            ".".join(str(n) for n in sys.version_info[:3])))
        return 2

    parser = build_parser()
    args = parser.parse_args(argv)
    setup_logging(args.debug)

    if args.hash_password:
        return do_hash_password()

    try:
        cfg = resolve_config(args)
    except ConfigError as exc:
        log.error("%s", exc)
        return 2

    if args.check:
        print(describe(cfg))
        print("\nconfiguration is valid; not binding the port (--check).")
        return 0

    # serve() raises ConfigError too, and not only in theory: a bad TLS
    # cert/key (build_ssl_context) and a failed privilege drop
    # (drop_privileges) both surface here, i.e. exactly the two things most
    # likely to be wrong on a first deployment. Without this the operator gets
    # a raw traceback with filesystem paths in it instead of one clean line
    # and exit 2. Same handler, same exit code, wherever it was raised.
    try:
        return serve(cfg)
    except ConfigError as exc:
        log.error("%s", exc)
        return 2


if __name__ == "__main__":
    sys.exit(main())
