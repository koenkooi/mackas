# ---------------------------------------------------------------------------
# retrieve -- copy build outputs out of the ext4 TMPDIR volume
# buildstats -- work with buildstats already retrieved
# ---------------------------------------------------------------------------
#
# tmp/buildstats, tmp/log and tmp/deploy live inside the oe-build-tmp ext4
# image and are invisible from macOS (that is the deliberate cost of real Linux
# filesystem semantics -- see the "Known limitations" section of the README).
# This copies them out with a throwaway container that bind-mounts a host
# directory as /out. The recipe is the one proven by hand:
#
#   container run --rm -u 0:0 -v oe-build-tmp:/build -v <dest>:/out \
#       ghcr.io/siemens/kas/kas:5.4 sh -c 'cp -r /build/tmp/buildstats /out/'
#
# -u 0:0 is required: the kas image's default user (uid 30000) cannot read the
# root-owned build tree cleanly, and it matches ensure_volume()'s reasoning. No
# chown inside -- Apple's virtiofs forces host-user ownership on the /out bind
# mount, so files land owned by the invoking user already and a `chown -R`
# there fails "Operation not permitted".

# fetch_tmp_subdir SUB DEST -- copy /build/tmp/SUB out of the TMPDIR volume into
# DEST/SUB. Returns non-zero (with a clear message) when SUB is absent -- e.g.
# no build has run, so there is no tmp/buildstats -- rather than letting a raw
# `cp` error surface. Idempotent: re-copying overwrites in place.
fetch_tmp_subdir() {
	local sub="$1" dest="$2" var="$3" guest

	# Distros can redefine where these actually land (e.g. Angstrom sets
	# DEPLOY_DIR to $TOPDIR/deploy, not OE-core's $TMPDIR/deploy default) --
	# ask bitbake itself rather than assume the OE-core default layout.
	guest="$(bitbake_getvar "$var")" || {
		guest="/build/tmp/$sub"
		warn "  could not resolve $var via bitbake-getvar; assuming the OE-core default ($guest)"
	}

	# Existence probe first, so "no build has run yet" is a clear message and
	# not an obscure cp failure. Under --dry-run run() prints and returns 0, so
	# the copy command below is still shown.
	if ! run container run --rm -u 0:0 -v "$MACKAS_VOL_TMP:/build" "$KAS_IMAGE" test -d "$guest"; then
		if [ "$sub" = "buildstats" ]; then
			warn "  no $guest in '$MACKAS_VOL_TMP' -- has a build run yet? ($SCRIPT_CMD smoketest)"
		else
			warn "  no $guest in '$MACKAS_VOL_TMP'; skipping $sub"
		fi
		return 1
	fi

	run mkdir -p "$dest"
	run container run --rm -u 0:0 \
		-v "$MACKAS_VOL_TMP:/build" -v "$dest:/out" "$KAS_IMAGE" \
		sh -c "mkdir -p '/out/$sub' && cp -r '$guest/.' '/out/$sub/'"
	did "retrieved $sub -> $dest/$sub"
	return 0
}

retrieve_usage() {
	cat <<EOF
${C_BLD}$SCRIPT_CMD retrieve${C_RST} -- copy build outputs out of the ext4 TMPDIR
volume, where macOS cannot see them, via a throwaway container.

${C_BLD}USAGE${C_RST}
  $SCRIPT_CMD retrieve <object> [<object>...] [--dest DIR]

${C_BLD}OBJECTS${C_RST} (at least one required, repeatable, order does not matter)
  buildstats           tmp/buildstats -- per-task timing (bitbake -m stats).
  logs                 tmp/log -- cooker.log and friends.
  deploy               tmp/deploy -- the images and ipks. Can be tens of GB.

${C_BLD}OPTIONS${C_RST}
  --dest DIR      Where to copy (default \$MACKAS_BASE/artifacts).

Options: --dry-run, -y/--yes (or -f/--force) and -v/--verbose work here too;
put them before or after 'retrieve', e.g. '$SCRIPT_CMD --dry-run retrieve buildstats'.

${C_BLD}ONE-VM RULE${C_RST}
  Only one VM may access an ext4 image at a time. retrieve refuses while a
  running build (smoketest/shell) still holds the TMPDIR volume -- stop it first.
EOF
}

# retrieve <object>... [--dest DIR] -- copy one or more tmp/ subdirs out of the
# TMPDIR volume. Each object maps 1:1 onto a guest dir under /build/tmp,
# except 'logs' (the CLI-facing plural) which fetches tmp/log (singular).
cmd_retrieve() {
	local dest="" objects=() want_help=0
	while [ $# -gt 0 ]; do
		case "$1" in
			--dry-run)     DRY_RUN=1; shift ;;
			-y|-f|--yes|--force)  ASSUME_YES=1; shift ;;
			-v|--verbose)  VERBOSE=1; shift ;;
			-h|--help)     want_help=1; shift ;;
			help)          want_help=1; shift ;;
			--version)     echo "$SCRIPT_NAME $SCRIPT_VERSION"; exit 0 ;;
			--config|--config=*|--set|--set=*) die_on_misplaced_global_flag "$1" retrieve ;;
			--dest)        dest="${2:-}"; [ -n "$dest" ] || die "--dest needs a DIR"; shift 2 ;;
			--dest=*)      dest="${1#*=}"; shift ;;
			buildstats|logs|deploy) objects+=("$1"); shift ;;
			-*) die "unknown option for 'retrieve': $1" "$SCRIPT_CMD retrieve --help" ;;
			*) die "unknown object for 'retrieve': $1" \
				"$SCRIPT_CMD retrieve --help  (objects: buildstats logs deploy)" ;;
		esac
	done

	if [ "$want_help" -eq 1 ]; then
		retrieve_usage
		return 0
	fi

	[ "${#objects[@]}" -ge 1 ] || die "'retrieve' needs at least one object" \
		"$SCRIPT_CMD retrieve <buildstats|logs|deploy> [<object>...] [--dest DIR]"

	require_mackas_root

	dest="${dest:-$MACKAS_BASE/artifacts}"

	# dest becomes the host side of a -v "$dest:/out" bind mount, so it has two
	# constraints Apple container imposes. A ':' in the path breaks the mount
	# spec outright. And a RELATIVE path is read as a named-volume source, not a
	# host directory, so files would vanish into a fresh volume instead of
	# landing in ./out -- absolutise it against $PWD so --dest out means what it
	# reads like.
	case "$dest" in
		*:*) die "--dest must not contain ':' (it is a bind-mount path)" \
			"choose a destination without a colon" ;;
	esac
	case "$dest" in
		/*) ;;
		*)  dest="$PWD/$dest" ;;
	esac

	# One-VM rule: never attach the volume a build might still hold. Refuse
	# loudly rather than corrupt an ext4 image mounted by two VMs at once.
	if volume_in_use "$MACKAS_VOL_TMP"; then
		die "volume '$MACKAS_VOL_TMP' is attached to a running container" \
			"only ONE VM may touch an ext4 image at a time; stop the build first (mackas volume list), then re-run '$SCRIPT_CMD retrieve'"
	fi

	info "${C_BLD}mackas retrieve${C_RST}"
	info "  volume  : $MACKAS_VOL_TMP"
	info "  objects : ${objects[*]}"
	info "  dest    : $dest"
	info ""

	local it sub var fetched=0 got_buildstats=0
	for it in "${objects[@]}"; do
		sub="$it"
		var="DEPLOY_DIR"
		case "$it" in
			logs)       sub="log"; var="LOG_DIR" ;;
			buildstats) var="BUILDSTATS_BASE" ;;
		esac
		[ "$it" = "deploy" ] && warn "  deploy can be large (tens of GB); this may take a while and fill $dest"
		if fetch_tmp_subdir "$sub" "$dest" "$var"; then
			fetched=$((fetched + 1))
			[ "$it" = "buildstats" ] && got_buildstats=1
		fi
	done

	if [ "$fetched" -eq 0 ]; then
		warn "Nothing retrieved."
		return 1
	fi

	hdr "Retrieved to $dest"
	if [ "$got_buildstats" -eq 1 ]; then
		info "  Summarise with: $SCRIPT_CMD buildstats analyze $(printf '%q' "$dest/buildstats")"
	fi
	return 0
}

