class MirrorServer(ThreadingHTTPServer):
    """ThreadingHTTPServer with a hard cap on concurrent connections.

    ThreadingHTTPServer alone will happily spawn a thread per connection until
    the box dies -- 10k idle connections is 10k threads and ~80 GB of reserved
    stack. The semaphore turns that into a bounded queue: past the cap we
    close new connections immediately rather than degrade for everyone.

    daemon_threads=True so that a SIGTERM does not wait for a client that is
    halfway through a 200 MB download before exiting.
    """

    daemon_threads = True
    allow_reuse_address = True
    request_queue_size = 128

    # Set by serve() when TLS is configured. The LISTENING socket is never
    # wrapped -- see process_request_thread() for why that matters.
    ssl_context = None

    def __init__(self, addr, handler_cls, max_connections: int,
                 timeout: float, address_family=socket.AF_INET):
        self.address_family = address_family
        self._slots = threading.BoundedSemaphore(max_connections)
        self._conn_timeout = timeout
        super().__init__(addr, handler_cls)

    def get_request(self):
        """Accept a plain TCP connection and bound it in time immediately.

        The timeout has to be set HERE, not in the handler. StreamRequestHandler
        .setup() applies self.timeout, but setup() runs after the TLS handshake
        -- so a handshake that never completes was never covered by --timeout at
        all. Setting it on the raw socket at accept() time means the deadline is
        already armed when wrap_socket() starts talking.
        """
        sock, addr = self.socket.accept()
        sock.settimeout(self._conn_timeout)
        return sock, addr

    def process_request(self, request, client_address):
        if not self._slots.acquire(blocking=False):
            log.warning("connection cap reached; dropping %s",
                        sanitize_for_log(str(client_address[0])))
            self.shutdown_request(request)
            return
        try:
            super().process_request(request, client_address)
        except Exception:
            self._slots.release()
            raise

    def process_request_thread(self, request, client_address):
        """Do the TLS handshake HERE, in the worker thread. Never on the listener.

        THE BUG THIS REPLACES

        serve() used to do `httpd.socket = ctx.wrap_socket(httpd.socket,
        server_side=True)`, wrapping the *listening* socket. That turns
        SSLSocket.accept() into "accept, then run the whole TLS handshake
        inline" -- and accept() is called from serve_forever's single accept
        loop. One client that completes the TCP handshake and then sends zero
        bytes blocks that loop forever, and with it every other client on the
        server. Not slow: stopped. --timeout did not help (it is applied in
        StreamRequestHandler.setup(), which never ran), and the connection cap
        did not help either (it lives downstream of the block).

        WHY HERE AND NOT IN get_request()

        get_request() still runs on the accept thread, so wrapping there would
        move the handshake but not get it off the accept path -- the wedge would
        survive. Doing it in the worker thread buys two things:

          * The accept loop only ever does accept(), so it cannot be stalled by
            anything a client does or fails to do.
          * The handshake happens under the semaphore, already counted against
            --max-connections. A flood of clients that open TCP and go silent
            is bounded by the cap and by the accept-time timeout, and costs the
            same as any other slow client instead of being a server-wide
            off switch.
        """
        try:
            if self.ssl_context is not None:
                try:
                    request = self.ssl_context.wrap_socket(
                        request, server_side=True)
                except (ssl.SSLError, OSError) as exc:
                    # A failed handshake is routine: port scanners, a plain
                    # HTTP client hitting an HTTPS port, a timeout. Log at
                    # debug and drop the connection; never a traceback.
                    log.debug("TLS handshake failed from %s: %s",
                              sanitize_for_log(str(client_address[0])),
                              sanitize_for_log(str(exc)))
                    self.shutdown_request(request)
                    return
            super().process_request_thread(request, client_address)
        finally:
            self._slots.release()

    def handle_error(self, request, client_address):
        # The default prints a traceback to stderr with a banner. Log it
        # properly instead; the client has already been dealt with.
        log.debug("error handling request from %s",
                  sanitize_for_log(str(client_address)), exc_info=True)


# Slowloris: a client opens a connection and dribbles one header byte per
# minute, holding a thread forever. The counter is the socket timeout set on
# the handler below: any read that stalls longer raises socket.timeout,
# handle_one_request() catches it, and the thread goes back to the pool. 30s
# is generous for a LAN and still bounds the damage -- with a 64-connection
# cap an attacker holds the server for at most 30s per connection.
def make_handler(config: Config, limiter: RateLimiter):
    class Handler(MirrorHandler):
        pass

    Handler.config = config
    Handler.limiter = limiter
    # Separate from `limiter`, and always on. See check_password(): this budgets
    # PBKDF2 derivations, not requests, so it cannot throttle bitbake (which
    # reuses one Authorization header and therefore one cache entry) but does
    # cap what an unauthenticated stranger can make us compute.
    Handler.kdf_limiter = RateLimiter(DEFAULT_KDF_RATE, DEFAULT_KDF_BURST)
    Handler.timeout = config.timeout
    return Handler


def build_ssl_context(cert: str, key: str) -> ssl.SSLContext:
    """TLS context: 1.2 minimum, server-side, no client cert.

    Honest scope: this protects the Basic-auth password and the cache contents
    in transit. It does not authenticate the client -- that is what the
    password and the IP allowlist are for.

    TLS 1.2 is the floor because everything older (1.0/1.1) is deprecated and
    broken in ways with names (BEAST, POODLE, and the general fragility of
    RC4/3DES). PROTOCOL_TLS_SERVER already disables SSLv2/v3; the explicit
    minimum_version makes the intent legible and survives a distro that ships
    a permissive default.
    """
    ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    ctx.minimum_version = ssl.TLSVersion.TLSv1_2
    ctx.options |= ssl.OP_NO_COMPRESSION  # CRIME
    if hasattr(ssl, "OP_SINGLE_DH_USE"):
        ctx.options |= ssl.OP_SINGLE_DH_USE
    if hasattr(ssl, "OP_SINGLE_ECDH_USE"):
        ctx.options |= ssl.OP_SINGLE_ECDH_USE
    try:
        ctx.load_cert_chain(certfile=cert, keyfile=key)
    except (OSError, ssl.SSLError) as exc:
        raise ConfigError("cannot load TLS cert/key: %s" % exc)
    return ctx


def drop_privileges(user: Optional[str], group: Optional[str]) -> None:
    """Drop root to an unprivileged user, in the only correct order.

    ORDER MATTERS AND IS THE WHOLE POINT:

        setgroups() -> setgid() -> setuid()

    setuid() first is the classic bug: it drops the root privilege that
    setgid() and setgroups() require, so the subsequent calls fail (silently,
    if unchecked) and the process keeps root's group membership -- including
    the supplementary groups -- while looking unprivileged. Anything readable
    by group root remains readable.

    setgroups() must precede setgid() for the same reason: it needs
    CAP_SETGID, which setgid() to a non-root group gives away.

    We verify afterwards rather than trusting the calls, because a partial
    drop is worse than no drop: it looks safe in `ps` and is not.
    """
    if os.getuid() != 0:
        return
    if not user:
        return

    import grp
    import pwd

    try:
        pw = pwd.getpwnam(user)
    except KeyError:
        raise ConfigError("no such user: %s" % user)

    if group:
        try:
            gid = grp.getgrnam(group).gr_gid
        except KeyError:
            raise ConfigError("no such group: %s" % group)
    else:
        gid = pw.pw_gid

    if pw.pw_uid == 0:
        raise ConfigError("--user must not be root")

    try:
        os.setgroups([gid])
        os.setgid(gid)
        os.setuid(pw.pw_uid)
    except OSError as exc:
        raise ConfigError("privilege drop failed: %s" % exc)

    # Trust nothing: confirm we actually landed where we meant to, and that
    # the drop is irreversible (setuid, not seteuid).
    if os.getuid() != pw.pw_uid or os.geteuid() != pw.pw_uid:
        raise ConfigError("privilege drop did not take effect (uid)")
    if os.getgid() != gid or os.getegid() != gid:
        raise ConfigError("privilege drop did not take effect (gid)")
    try:
        os.setuid(0)
    except OSError:
        pass  # Good: we cannot get root back.
    else:
        raise ConfigError("privilege drop is reversible; refusing to run")

    log.info("dropped privileges to %s:%s (uid=%d gid=%d)",
             user, group or pw.pw_gid, pw.pw_uid, gid)


