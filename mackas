set -euo pipefail

SCRIPT_NAME="$(basename "$0")"
# How the user actually invoked us, for copy-pasteable command hints: "./mackas"
# from a checkout, "mackas" if on PATH, an absolute path if run that way.
# SCRIPT_NAME stays the bare program label ("mackas: error: ...").
SCRIPT_CMD="$0"
# The subcommand main() settled on, for hints that must name it back to the
# user from code shared by several: run_kas() serves both 'shell' and
# 'smoketest' and cannot tell them apart otherwise. Empty when this file is
# sourced as a library (MACKAS_LIB_ONLY=1), which never reaches those hints.
SCRIPT_SUBCOMMAND=""
SCRIPT_DIR="$(cd -- "$(dirname -- "$0")" && pwd)"
SCRIPT_VERSION="0.1.4"

# kas-container release we pin to, and its expected sha256.
KAS_CONTAINER_VERSION="5.5"
KAS_CONTAINER_URL="https://raw.githubusercontent.com/siemens/kas/${KAS_CONTAINER_VERSION}/kas-container"
KAS_CONTAINER_SHA256="7a8186f18d14ec6bec3f8d5188eba7a60f1ef4b5587af15917527588cc7d738a"

# The four kas 'shell' setup steps that mutate a repo checkout (checkout,
# patch application, writing local.conf/bblayers.conf) -- individually, and
# never -k; see the kflag assignment in kas_shell_ro() for why. One constant
# so kas_shell_ro()'s kflag, cmd_exec()'s dry-run print and exec_usage()'s
# --help text can never drift apart the way the old conditional '-k' logic did.
KAS_SKIP_REPO_STEPS="--skip setup_dir --skip finish_setup_repos --skip repos_checkout --skip repos_apply_patches"

# The KAS_CONTAINER_ENGINE value every direct kas-container invocation in this
# file forces, instead of relying on kas-container's own 'docker -v | grep
# ^Docker' probe (see env.sh's matching export for the same reasoning, kept
# separate since it is generated code, not a function body). One constant so
# kas_invoke_env(), kas_env_prefix() and write_kas_wrapper()'s generated
# wrapper can never disagree on it.
MACKAS_KAS_ENGINE="docker"

# The Apple `container` releases mackas is developed and tested against, and
# the macOS it needs.
#
# These are not decoration. mackas drives the `container` CLI by issuing exact
# subcommands, and that surface MOVES between releases -- proven the hard way:
# shipped mackas called `container system restart` in two places, and no such
# subcommand has ever existed (1.1.0 has start/stop/status/... only), so both
# call sites failed with "Unexpected argument 'restart'" every time they ran.
# A hermetic suite could not catch it, because the fake `container` accepts
# anything. Naming the tested range is how that class of drift gets noticed.
#
# MIN is a hard floor (below it, known-missing behaviour). TESTED is the
# newest release actually exercised here; above it mackas still runs and just
# says it is past what has been verified -- never a refusal, since blocking on
# an unknown-newer version would be worse than warning about it.
CONTAINER_MIN_VERSION="1.0.0"
CONTAINER_TESTED_VERSION="1.1.0"

# Apple `container` requires macOS 26 (Tahoe) or newer on Apple silicon.
MACOS_MIN_MAJOR=26

# The Homebrew bin dir prepended to the PATH of every child mackas launches
# (kas-container needs GNU realpath ahead of /usr/bin's BSD one), and baked
# into the env.sh and kas-container wrapper it generates.
#
# Test seam (undocumented, cf. MACKAS_CONTAINER_BIN/MACKAS_MDFIND): hardcoding
# it put a dev Mac's real `container` AHEAD of whatever the caller's own PATH
# resolved, inside the very children a hermetic test's stub exists to shadow.
# tests/helpers.bash points this at that stub instead.
#
# It reaches two generated files, so it is in SETTINGS_INTERPOLATED and is
# shq()-quoted by both writers -- a seam is still an input.
BREW_BIN="${MACKAS_BREW_BIN:-/opt/homebrew/bin}"

# Apple container's own volume storage root. There is no config knob for
# this in container 1.1.0, so relocation is done by symlinking the dir.
CONTAINER_VOLUMES_DIR="$HOME/Library/Application Support/com.apple.container/volumes"

# Marker file written at the ROOT of a workspace image's filesystem when
# mackas creates or (re)attaches one. It is what makes "work/ is a mount"
# mean "work/ is OUR mount": st_dev alone only says something is mounted
# there, and mounting anything else at work/ -- another sparse image, a USB
# stick, a leftover DMG that grabbed the name -- would otherwise read as
# "attached, carry on" and hand bitbake a filesystem nobody vetted. Its
# presence is checked, never its contents, so it stays a one-line file.
WORKSPACE_SENTINEL=".mackas-workspace"

# ---------------------------------------------------------------------------
# Settings. Every name here is: default -> config file -> env -> CLI flag.
# ---------------------------------------------------------------------------
SETTING_NAMES="
MACKAS_ROOT
MACKAS_SHORT_LINK
MACKAS_VOLUME_NAME
MACKAS_VOLUME_DL_NAME
MACKAS_VOLUME_SSTATE_NAME
MACKAS_VOLUME_SIZE_TMP
MACKAS_VOLUME_SIZE_DL
MACKAS_VOLUME_SIZE_SSTATE
MACKAS_RELOCATE_VOLUMES
KAS_IMAGE
MACKAS_CPUS
MACKAS_MEMORY
MACKAS_NFS_SERVER
MACKAS_NFS_EXPORT
MACKAS_USE_NFS_MIRRORS
MACKAS_NFS_MOUNT
MACKAS_SSTATE_MIRROR_PATH
MACKAS_DL_MIRROR_PATH
MACKAS_USE_HTTP_MIRRORS
MACKAS_HTTP_MIRROR_SSTATE
MACKAS_HTTP_MIRROR_DL
MACKAS_SSTATE_PUSH_DEST
MACKAS_SSTATE_PUSH_STAGE
MACKAS_PROJECT_URL
MACKAS_PROJECT_BRANCH
MACKAS_PROJECT_DIR
MACKAS_KAS_CONFIG
MACKAS_KAS_AUTO_FRAGMENT
MACKAS_KAS_AUTO_PROJECT
MACKAS_SMOKETEST_TARGETS
MACKAS_OVERHEAD
MACKAS_OVERHEAD_INTERVAL
MACKAS_FSTRIM_AUTO
MACKAS_FREE_SPACE_MARGIN_GB
MACKAS_REQUIRE_CASE_SENSITIVE
MACKAS_WORKSPACE_IMAGE
MACKAS_WORKSPACE_SIZE
MACKAS_MONITOR
MACKAS_MONITOR_PORT
MACKAS_MONITOR_NOTIFY
MACKAS_BUILDSTATS_ACCUMULATE
MACKAS_SOCKET_SWEEP
MACKAS_FSCK_IMAGE
"

# ---------------------------------------------------------------------------
# Output helpers
# ---------------------------------------------------------------------------
VERBOSE=0
DRY_RUN=0
ASSUME_YES=0


# Set by overhead_start()/overhead_stop() around a smoketest rung. Declared here so
# `set -u` is happy and on_interrupt() can reap the sampler on Ctrl-C.
OVERHEAD_PID=""
OVERHEAD_OUT=""

# The `volume`/`retrieve`/`buildstats`/`sstate`/`monitor`/`runtime-args`
# subcommands' tails (everything after the command word), captured verbatim by
# main()'s flag loop and handed to the matching cmd_*(). Declared empty here so
# `${FOO_ARGS+...}` is safe under `set -u` when that command never ran.
VOLUME_ARGS=()
RUNTIME_ARGS_ARGS=()
RETRIEVE_ARGS=()
BUILDSTATS_ARGS=()
BUILDHISTORY_ARGS=()
SSTATE_ARGS=()
MONITOR_ARGS=()
ADOPT_ARGS=()
PROJECT_ARGS=()
SET_ARGS=()
GET_ARGS=()
UNSET_ARGS=()
SETUP_ARGS=()
CLEAN_ARGS=()
EXEC_ARGS=()

setup_colors() {
	if [ -n "${NO_COLOR:-}" ] || [ ! -t 1 ] || [ "${TERM:-dumb}" = "dumb" ]; then
		C_RED=""; C_GRN=""; C_YEL=""; C_BLU=""; C_BLD=""; C_DIM=""; C_RST=""
	else
		C_RED="$(printf '\033[31m')"
		C_GRN="$(printf '\033[32m')"
		C_YEL="$(printf '\033[33m')"
		C_BLU="$(printf '\033[34m')"
		C_BLD="$(printf '\033[1m')"
		C_DIM="$(printf '\033[2m')"
		C_RST="$(printf '\033[0m')"
	fi
}

info()  { printf '%s\n' "$*"; }
warn()  { printf '%s%s%s\n' "$C_YEL" "$*" "$C_RST" >&2; }
err()   { printf '%s%s%s\n' "$C_RED" "$*" "$C_RST" >&2; }
vrb()   { [ "$VERBOSE" -eq 1 ] && printf '%s%s%s\n' "$C_DIM" "$*" "$C_RST" >&2 || true; }

die() {
	err "$SCRIPT_NAME: error: $1"
	if [ -n "${2:-}" ]; then
		printf '%s  next: %s%s\n' "$C_BLU" "$2" "$C_RST" >&2
	fi
	exit 1
}

hdr() {
	printf '\n%s%s%s\n' "$C_BLD" "$*" "$C_RST"
}

# Render $1 as a single-quoted shell word, for interpolation into a file this
# script GENERATES (env.sh). printf %q would also work, but %q leaves an
# ordinary path unquoted and reaches for $'...' when it does escape, and env.sh
# is sourced by whatever shell the user runs -- zsh on a stock Mac. A plain
# single-quoted string is understood identically by sh, bash and zsh, and is
# inert no matter what is inside it.
#
# The '\'' dance is the standard one: close the quote, emit an escaped quote,
# reopen. Values containing a newline never reach here (validate_settings
# refuses them), which is what makes the $(...) below lossless.
shq() {
	printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

# Render a command the way a user could paste it back into a shell.
quote_cmd() {
	local out="" a
	for a in "$@"; do
		# printf %q is available in bash 3.2.
		out="$out $(printf '%q' "$a")"
	done
	printf '%s' "${out# }"
}

# run CMD... — execute, or just print under --dry-run.
run() {
	if [ "$DRY_RUN" -eq 1 ]; then
		printf '%s+ %s%s\n' "$C_DIM" "$(quote_cmd "$@")" "$C_RST"
		return 0
	fi
	vrb "+ $(quote_cmd "$@")"
	"$@"
}

# run_sudo CMD... — same, but always shows the command first (even when
# not verbose) because the user is about to be asked for a password.
run_sudo() {
	printf '%s  sudo: %s%s\n' "$C_BLU" "$(quote_cmd sudo "$@")" "$C_RST"
	if [ "$DRY_RUN" -eq 1 ]; then
		printf '%s+ (dry-run, not executed)%s\n' "$C_DIM" "$C_RST"
		return 0
	fi
	sudo "$@"
}

confirm() {
	local prompt="$1" reply=""
	if [ "$DRY_RUN" -eq 1 ]; then
		# --dry-run must show every mutating command, so answer yes and let
		# run()/run_sudo() print rather than execute. Nothing can change.
		printf '%s%s [dry-run: assuming yes]%s\n' "$C_DIM" "$prompt" "$C_RST"
		return 0
	fi
	if [ "$ASSUME_YES" -eq 1 ]; then
		info "$prompt [auto-yes]"
		return 0
	fi
	if [ ! -t 0 ]; then
		warn "$prompt -- not a terminal and --yes not given; declining."
		return 1
	fi
	printf '%s%s [y/N] %s' "$C_BLD" "$prompt" "$C_RST"
	read -r reply || return 1
	case "$reply" in
		y|Y|yes|YES) return 0 ;;
		*) return 1 ;;
	esac
}

on_interrupt() {
	# Reap the overhead sampler first, if a smoketest rung had one running, so we
	# never orphan it. Best-effort; never let it get in the way of exiting.
	if [ -n "${OVERHEAD_PID:-}" ]; then
		kill -TERM "$OVERHEAD_PID" 2>/dev/null || true
	fi
	printf '\n'
	warn "Interrupted. Nothing is left half-written that a re-run won't fix:"
	warn "  '$SCRIPT_CMD setup' is idempotent -- just run it again."
	# `volume move` is the one mutation this does not fully cover: its
	# transfer-then-symlink window blocks INT/TERM itself (trap '' ...), so a
	# Ctrl-C there lands either before the move or after the symlink, never in
	# between. Outside that window nothing is half-written here either.
	exit 130
}
trap on_interrupt INT TERM

# ---------------------------------------------------------------------------
# Check accounting
# ---------------------------------------------------------------------------
N_PASS=0
N_WARN=0
N_FAIL=0

ck_pass() { N_PASS=$((N_PASS + 1)); printf '  %s[PASS]%s %s\n' "$C_GRN" "$C_RST" "$1"; }

ck_warn() {
	N_WARN=$((N_WARN + 1))
	printf '  %s[WARN]%s %s\n' "$C_YEL" "$C_RST" "$1"
	[ -n "${2:-}" ] && printf '         %sfix:%s %s\n' "$C_BLU" "$C_RST" "$2"
	return 0
}

ck_fail() {
	N_FAIL=$((N_FAIL + 1))
	printf '  %s[FAIL]%s %s\n' "$C_RED" "$C_RST" "$1"
	[ -n "${2:-}" ] && printf '         %sfix:%s %s\n' "$C_BLU" "$C_RST" "$2"
	return 0
}

ck_info() { printf '  %s[info]%s %s\n' "$C_DIM" "$C_RST" "$1"; }

# ---------------------------------------------------------------------------
# Configuration resolution
# ---------------------------------------------------------------------------

# Stash whatever the environment already set, so it can be re-applied on top
# of the config file (env beats config file).
snapshot_env() {
	local name
	for name in $SETTING_NAMES; do
		if eval "[ \"\${${name}+set}\" = set ]"; then
			eval "__ENV_${name}=\"\${${name}}\""
			eval "__ENV_${name}_SET=1"
		else
			eval "__ENV_${name}_SET=0"
		fi
	done
}

restore_env() {
	local name
	for name in $SETTING_NAMES; do
		if eval "[ \"\${__ENV_${name}_SET}\" = 1 ]"; then
			eval "${name}=\"\${__ENV_${name}}\""
			eval "__EXPLICIT_${name}=1"
		fi
	done
}

# snapshot_defaults/mark_explicit_from_config/setting_is_explicit -- track
# whether a setting's final value came from anything OTHER than
# set_defaults() (the config file, the environment via restore_env above, or
# --set via apply_cli_overrides below). Needed because several settings (the
# volume sizes) default to a non-empty value, so a plain "is it set" check
# cannot tell "explicitly configured to this value" from "just still reading
# as the factory default" apart -- 'setup's interactive prompting relies on
# the distinction to know which of its settings to actually prompt for.
#
# snapshot_defaults() must run right after set_defaults() (before
# load_config), so mark_explicit_from_config() has a factory baseline to
# compare load_config's result against.
snapshot_defaults() {
	local name
	for name in $SETTING_NAMES; do
		eval "__FACTORY_${name}=\"\${${name}}\""
	done
}

mark_explicit_from_config() {
	local name
	for name in $SETTING_NAMES; do
		eval "if [ \"\${${name}}\" != \"\${__FACTORY_${name}}\" ]; then __EXPLICIT_${name}=1; fi"
	done
}

setting_is_explicit() {
	eval "[ \"\${__EXPLICIT_$1:-0}\" = 1 ]"
}

# config_pinned_setting NAME -- true if NAME was actually assigned by
# whatever is currently loaded: the environment, --set, OR the config file
# CONFIG_FILE_USED names. Everything but the config-file leg is exactly
# setting_is_explicit(); the config-file leg exists because
# mark_explicit_from_config() cannot always be trusted for it.
#
# The gap: mark_explicit_from_config() only ever compares the FINAL VALUE
# against the factory default (__FACTORY_NAME, captured by snapshot_defaults()
# right after set_defaults()) -- it has no memory of whether a line was
# actually present in the sourced file. That is indistinguishable from
# "never touched" for any setting whose factory default is itself a
# non-empty string one might legitimately also choose on purpose.
# MACKAS_VOLUME_NAME is exactly that setting: its factory default is
# "oe-build" (set_defaults(), not empty like MACKAS_VOLUME_DL_NAME/
# _SSTATE_NAME), and a pinned project config that explicitly writes
# MACKAS_VOLUME_NAME="oe-build" -- migration path B of #72, "keep oe-build-*,
# no data moves" -- produces a value byte-identical to the untouched
# default. Trusting __EXPLICIT_MACKAS_VOLUME_NAME alone would read that
# deliberate choice as "unset" and silently override it.
#
# So when the flag alone says "no", fall back to grepping the actual
# sourced file for the line -- read-only, via config_grep_setting(), never
# a second `.`/source -- which answers "was this line present" directly
# instead of inferring it from a value comparison.
config_pinned_setting() {
	setting_is_explicit "$1" && return 0
	[ -n "$CONFIG_FILE_USED" ] || return 1
	config_grep_setting "$CONFIG_FILE_USED" "$1" >/dev/null
}

# --set NAME=VALUE overrides, collected during arg parsing and applied last so
# that command-line flags beat the environment (and everything else).
CLI_OVERRIDES=()

is_setting_name() {
	local needle="$1" n
	for n in $SETTING_NAMES; do
		[ "$n" = "$needle" ] && return 0
	done
	return 1
}

# die_on_misplaced_global_flag ARG CMD -- every verb-object command
# (volume/retrieve/buildstats/sstate/monitor/set/get/unset) owns everything after its own
# command word, captured verbatim by main() before cmd_CMD ever runs -- so
# --config/--project/--set typed AFTER the command word are silently never seen by the
# code that would act on them (main()'s own arg loop, and load_config/
# apply_cli_overrides, already ran). Falling through to a generic "unknown
# option" would leave that invisible; this redirects to the fix instead.
die_on_misplaced_global_flag() {
	case "$1" in
		--config|--config=*|--project|--project=*|--set|--set=*)
			die "'$1' must come BEFORE '$2', not after -- it is resolved before '$2' runs" \
				"$SCRIPT_CMD $1 ... $2 ..."
			;;
	esac
}

# Split on the FIRST '=' only, so values may contain '=' (as SSTATE_MIRRORS
# entries and paths do).
apply_cli_overrides() {
	local kv name value
	for kv in ${CLI_OVERRIDES+"${CLI_OVERRIDES[@]}"}; do
		name="${kv%%=*}"
		# shellcheck disable=SC2034  # consumed by the eval below, not directly
		value="${kv#*=}"
		# Assign via eval (the name is dynamic) but expand $value inside the
		# eval body rather than interpolating it, so values containing quotes,
		# spaces or $ are assigned literally and never re-evaluated.
		eval "${name}=\"\$value\""
		eval "__EXPLICIT_${name}=1"
	done
}

# Settings that get interpolated into something this script GENERATES -- the
# shell of env.sh, the /bin/sh of the kas-container wrapper, the YAML of the
# kas fragment -- or into an argv it builds from them: the host side of a
# `-v` bind mount, an rsync target. Registering a setting is a four-place
# edit (SETTING_NAMES, a default, this list, the docs); leaving it off here
# is what makes an unvalidated value reach one of those.
#
# BREW_BIN is the odd one out: not a name in SETTING_NAMES, but the value the
# MACKAS_BREW_BIN seam feeds into both generated shell files, so it belongs
# under the same check as everything else here. It is the DERIVED name, not
# MACKAS_BREW_BIN, because BREW_BIN is what is interpolated and is always set
# (a default) -- `set -u` would abort on the unset seam variable.
SETTINGS_INTERPOLATED="
BREW_BIN
MACKAS_ROOT
MACKAS_SHORT_LINK
MACKAS_VOLUME_NAME
MACKAS_VOLUME_DL_NAME
MACKAS_VOLUME_SSTATE_NAME
KAS_IMAGE
MACKAS_CPUS
MACKAS_MEMORY
MACKAS_NFS_MOUNT
MACKAS_SSTATE_MIRROR_PATH
MACKAS_DL_MIRROR_PATH
MACKAS_HTTP_MIRROR_SSTATE
MACKAS_HTTP_MIRROR_DL
MACKAS_SSTATE_PUSH_DEST
MACKAS_SSTATE_PUSH_STAGE
MACKAS_PROJECT_URL
MACKAS_PROJECT_BRANCH
MACKAS_PROJECT_DIR
MACKAS_KAS_CONFIG
"

# Refuse values that cannot be quoted out of trouble in BOTH of the files we
# generate. The generated shell is quoted with shq() and would survive any of
# these on its own, but the generated YAML has no such escape hatch -- a value
# lands inside a double-quoted scalar, where a literal '"' or a newline ends
# the scalar and everything after it is parsed as YAML.
#
# The list is deliberately short, and what is NOT on it matters as much as
# what is:
#
#   allowed: spaces, '$', "'". All three are legal in an APFS path and people
#     really do have them -- the shipped default MACKAS_ROOT has three spaces,
#     and /Users/o'brien is a name, not an attack. shq() renders every one of
#     them inert, and a YAML comment or double-quoted scalar does not care.
#   refused: '"', '`', and control characters (newline, tab, NUL...). These are
#     legal on APFS in principle and have never appeared in a real build path
#     in practice. Each is a way OUT of a generated file rather than a value
#     in it: a '"' ends the bitbake assignment the HTTP mirror URL sits inside,
#     and a newline ends the YAML line entirely, so what follows is parsed as
#     structure.
#
# This runs before derive_paths(), so the derived mirror paths inherit an
# already-checked MACKAS_ROOT and need no second pass.
validate_settings() {
	local n v where
	for n in $SETTINGS_INTERPOLATED; do
		eval "v=\"\${$n}\""
		# BREW_BIN is not settable by that name -- name the seam that feeds it,
		# so the fix points somewhere the reader can actually edit.
		where="$n in $(config_hint)"
		[ "$n" = "BREW_BIN" ] && where="MACKAS_BREW_BIN in the environment"
		case "$v" in
			*'"'*|*'`'*|*[[:cntrl:]]*)
				die "$n contains a double quote, a backtick or a control character" \
					"remove it from $where -- $SCRIPT_NAME cannot write such a value into the env.sh, kas-container wrapper and kas fragment it generates without corrupting them"
				;;
		esac
		# A literal backslash is legal on APFS but has never once shown up in a
		# real path -- what actually produces one is writing MACKAS_ROOT="/a\
		# path" in a config file: backslash-space is NOT special inside double
		# quotes, so the backslash survives as a literal character instead of
		# escaping the space, and everything downstream (mkdir, %q's display
		# under --dry-run/-v) then faithfully operates on that broken value,
		# which reads as "extra" escaping once %q re-escapes an already-literal
		# backslash. Catch it here with the actual fix, rather than silently
		# building against a path that is very likely wrong.
		case "$v" in
			*'\'*)
				die "$n contains a literal backslash: $v" \
					"this usually means backslash-escaped spaces got combined with quotes in $where -- backslash is not special inside double quotes, so it survives as a literal character instead of escaping the space. Use EITHER plain quotes (\"$n=/path with spaces\") OR backslash escapes with no surrounding quotes (\`$n=/path\\ with\\ spaces\`), not both."
				;;
		esac
	done

	# MACKAS_CPUS and MACKAS_MEMORY are word-split into kas-container's
	# --runtime-args string (see kas_runtime_args), so a SPACE in either injects
	# extra arguments: MACKAS_MEMORY='8g -v /Users:/host' would smuggle a bind
	# mount past every other check. A plain space is not a control character, so
	# the loop above lets it through; pin both to their expected shapes here, as
	# derive_paths() already does for the mirror paths.
	case "$MACKAS_CPUS" in
		''|*[!0-9]*)
			die "MACKAS_CPUS='$MACKAS_CPUS' is not a positive integer" \
				"set MACKAS_CPUS to a whole number of cores (no spaces) in $(config_hint)"
			;;
	esac
	case "$MACKAS_MEMORY" in
		''|[!0-9]*|*[!0-9gGmM]*)
			die "MACKAS_MEMORY='$MACKAS_MEMORY' is not a size like 8g, 512m or 16" \
				"set MACKAS_MEMORY to <digits> optionally followed by g or m (no spaces) in $(config_hint)"
			;;
	esac
	# MACKAS_MONITOR_PORT is also word-split into --runtime-args (as -p
	# PORT:PORT), same injection risk as MACKAS_CPUS/MACKAS_MEMORY above.
	case "$MACKAS_MONITOR_PORT" in
		''|*[!0-9]*)
			die "MACKAS_MONITOR_PORT='$MACKAS_MONITOR_PORT' is not a positive integer" \
				"set MACKAS_MONITOR_PORT to a whole port number (no spaces) in $(config_hint)"
			;;
	esac
	validate_volume_names
	# MACKAS_VOLUME_SIZE_* goes straight into `container volume create -s` and
	# the resize/budgeting math (size_to_gb/size_to_bytes) -- pin it to what
	# those actually parse so a typo or stray unit dies here with a clear
	# message instead of reaching the container CLI as-is.
	for n in MACKAS_VOLUME_SIZE_TMP MACKAS_VOLUME_SIZE_DL MACKAS_VOLUME_SIZE_SSTATE; do
		eval "v=\"\${$n}\""
		valid_size_shape "$v" || die "$n='$v' is not a size like 1T, 200G or 512M" \
			"set $n to digits optionally followed by t, g or m (or tb/gb/mb, tib/gib/mib) in $(config_hint)"
	done
}

# Every volume name lands unquoted in the --runtime-args string kas-container
# word-splits, as the -v source of a mount, so whitespace in one silently
# becomes two arguments and mounts something absurd. validate_settings() calls
# this for every command; setup_volumes() calls it again right before use,
# since bats exercises that function directly. The stem is also required to be
# non-empty; the two per-volume overrides mean "derive from the stem" when
# empty, so for those only whitespace is a problem.
validate_volume_names() {
	local n v
	case "$MACKAS_VOLUME_NAME" in
		*[[:space:]]*|"")
			die "MACKAS_VOLUME_NAME='$MACKAS_VOLUME_NAME' is empty or contains whitespace" \
				"set MACKAS_VOLUME_NAME to a non-empty, space-free name in $(config_hint)"
			;;
	esac
	for n in MACKAS_VOLUME_DL_NAME MACKAS_VOLUME_SSTATE_NAME; do
		eval "v=\"\${$n}\""
		case "$v" in
			*[[:space:]]*)
				die "$n='$v' contains whitespace" \
					"set $n to a space-free volume name in $(config_hint), or leave it empty to derive the name from MACKAS_VOLUME_NAME"
				;;
		esac
	done
}

host_mem_gb() {
	local bytes
	bytes="$(sysctl -n hw.memsize 2>/dev/null || echo 0)"
	echo $((bytes / 1024 / 1024 / 1024))
}

host_cores() {
	sysctl -n hw.physicalcpu 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 2
}

# How to make a volume that qualifies. Shared by require_mackas_root() and
# check_target_volume() so the two never drift apart. Printed multi-line, with
# every command a user is meant to run on its own line so it can be copied.
root_hint() {
	printf 'point MACKAS_ROOT (in %s) at a CASE-SENSITIVE volume with room for the caches.\n' "$(config_hint)"
	printf 'Make one — a case-sensitive APFS volume (pick <disk> from `diskutil list`):\n'
	printf '    diskutil apfs addVolume <disk> "Case-sensitive APFS" oe\n'
	printf 'or a case-sensitive sparse image:\n'
	printf '    hdiutil create -type SPARSE -fs "Case-sensitive APFS" -size 200g -volname oe ~/oe.sparseimage\n'
	printf '    hdiutil attach ~/oe.sparseimage\n'
}

# Every command except `help`, `status` and `check` needs a root to work in.
#
# `status` and `check` deliberately do NOT call this: both exist to tell you
# what is wrong with your configuration, and dying before printing that would
# make them useless in precisely the case you reached for them.
require_mackas_root() {
	[ -n "$MACKAS_ROOT" ] && return 0
	# No root configured: fall back to the current directory rather than refuse.
	# Say something TRUE about it -- actually probe case-sensitivity here instead
	# of assuming, since $PWD may well already be on a case-sensitive volume.
	MACKAS_ROOT="$PWD"
	local cs; set +e; dir_is_case_sensitive "$MACKAS_ROOT"; cs=$?; set -e
	{
		printf '%s%s: warning:%s MACKAS_ROOT is not set — using the current directory:\n' \
			"$C_RED" "$SCRIPT_NAME" "$C_RST"
		printf '    %s%s%s\n' "$C_BLD" "$MACKAS_ROOT" "$C_RST"
		case "$cs" in
		1)	# probed and it is case-INSENSITIVE: OE will genuinely break here
			printf '%s%s is on a CASE-INSENSITIVE filesystem — OpenEmbedded will fail here.%s\n' \
				"$C_RED" "$MACKAS_ROOT" "$C_RST"
			root_hint ;;
		0)	# probed and it IS case-sensitive: no alarm, just make it explicit
			printf '%sprobed it: case-sensitive, good. Set MACKAS_ROOT in %s to make this the deliberate choice.%s\n' \
				"$C_YEL" "$(config_hint)" "$C_RST" ;;
		*)	# could not probe (e.g. not writable yet): keep the honest caveat
			printf '%scould not verify it is case-sensitive; OpenEmbedded needs one, so a real build wants a proper root:%s\n' \
				"$C_YEL" "$C_RST"
			root_hint ;;
		esac
	} >&2
	# Re-derive every path now that MACKAS_ROOT is set (derive_paths already ran
	# once, with it empty).
	derive_paths
}

set_defaults() {
	local cores mem

	# Empty here; require_mackas_root() falls back to $PWD (with a warning) for
	# commands that need a root. There is no BAKED-IN default path on purpose:
	# OpenEmbedded needs a case-sensitive filesystem and a stock Mac has none
	# (the boot volume, and therefore $HOME, is case-INSENSITIVE APFS), and
	# guessing at /Volumes/<something> only works when the user already did the
	# setup. So the fallback is the current directory the user is standing in,
	# announced loudly, rather than a silent guess -- and require_mackas_root()
	# and check_target_volume() explain how to point it at a proper volume.
	MACKAS_ROOT=""

	# Why $HOME/oe and not /opt/oe:
	#   * /opt is drwxr-xr-x root:wheel, so /opt/oe needs sudo to create --
	#     and this script's design goal is "no sudo unless genuinely needed".
	#   * $HOME/oe is 13 chars vs /opt/oe's 7. Both are far under the ~104
	#     char AF_UNIX sockaddr_un limit for any realistic build path, and
	#     both kill the spaces-in-path problem, which is the bigger win.
	# Set MACKAS_SHORT_LINK=/opt/oe in the config if you want the extra 6 chars;
	# `setup` will offer the sudo mkdir for you.
	MACKAS_SHORT_LINK="$HOME/oe"

	# Stem for the three ext4 volumes: ${MACKAS_VOLUME_NAME}-{tmp,dl,sstate}.
	# kas-container word-splits --runtime-args, so the stem must not contain
	# whitespace; setup refuses one that does.
	MACKAS_VOLUME_NAME="oe-build"

	# Per-volume overrides of the stem, for downloads and sstate only. Empty
	# means derive from MACKAS_VOLUME_NAME, which is what every existing
	# install does. Naming one explicitly is what makes two mackas configs
	# able to point at the SAME cache volume -- possible, deliberately not a
	# default and not advice: an ext4 image takes exactly one VM at a time,
	# so a shared volume is a serialization point between whoever names it.
	# There is no equivalent for TMPDIR: two builds sharing one /build is
	# corruption, not contention.
	MACKAS_VOLUME_DL_NAME=""       # derived from MACKAS_VOLUME_NAME if empty
	MACKAS_VOLUME_SSTATE_NAME=""   # derived from MACKAS_VOLUME_NAME if empty

	# Three separately-sized volumes, not one. TMPDIR is the churny, throwaway
	# one -- `clean` drops it -- while downloads and sstate are the expensive
	# caches worth keeping across a TMPDIR wipe. They total 200G, which is the
	# budget the SSD (an active Time Machine destination) can spare. All three
	# are sparse: they cost ~1.2 MB each until used.
	MACKAS_VOLUME_SIZE_TMP="120G"
	MACKAS_VOLUME_SIZE_DL="40G"
	MACKAS_VOLUME_SIZE_SSTATE="40G"

	MACKAS_RELOCATE_VOLUMES=1

	KAS_IMAGE="ghcr.io/siemens/kas/kas:${KAS_CONTAINER_VERSION}"

	# Apple container defaults to cpus=4 / memory=1gb per container, which
	# is nowhere near enough for bitbake. Leave 2 cores for the host so the
	# Mac stays usable, and take two thirds of RAM (the OE guest is a VM;
	# overcommitting starves the host).
	cores="$(host_cores)"
	MACKAS_CPUS=$((cores - 2))
	[ "$MACKAS_CPUS" -lt 2 ] && MACKAS_CPUS=2

	mem="$(host_mem_gb)"
	MACKAS_MEMORY="$((mem * 2 / 3))g"
	[ "$mem" -lt 6 ] && MACKAS_MEMORY="4g"

	# A placeholder host, not a real one. Point these at your own mirror in the
	# config; there is no LAN default that would mean anything on someone else's
	# network. Mirrors are off by default, so this is only consulted once you
	# opt in.
	MACKAS_NFS_SERVER="linux-computer.local"
	MACKAS_NFS_EXPORT="/build"
	MACKAS_USE_NFS_MIRRORS=0
	MACKAS_NFS_MOUNT=""            # derived from MACKAS_ROOT if empty
	MACKAS_SSTATE_MIRROR_PATH=""   # derived from MACKAS_NFS_MOUNT if empty
	MACKAS_DL_MIRROR_PATH=""       # derived from MACKAS_NFS_MOUNT if empty

	# HTTP mirrors -- the recommended path (see README). These are URLs served
	# by mirror-server/mackas-mirrord on the mirror host, which re-serves its
	# NFS-mounted caches read-only. One process, one port, two path prefixes.
	# The host is a placeholder; port 8100 is the mirror server's own default.
	MACKAS_USE_HTTP_MIRRORS=0
	MACKAS_HTTP_MIRROR_SSTATE="http://linux-computer.local:8100/sstate"
	MACKAS_HTTP_MIRROR_DL="http://linux-computer.local:8100/downloads"

	# Where 'sstate push' publishes to, and where it stages first. Both empty
	# by default: push is explicit and does nothing until a destination is
	# named. The destination is an rsync/ssh target ('user@host:/srv/.../
	# sstate'), never an HTTP URL -- mackas-mirrord's read path is anonymous
	# and read-only on purpose, so the write path goes over ssh instead.
	# The staging directory is a real host path (it is the only place the
	# manifest verification can run), so it wants room for every NEW object
	# one push carries; empty means $MACKAS_BASE/sstate-push.
	MACKAS_SSTATE_PUSH_DEST=""
	MACKAS_SSTATE_PUSH_STAGE=""    # derived from MACKAS_BASE if empty

	# The project to build. Empty here on purpose -- there is no baked-in
	# default project. meta-ai (github.com/qualcomm-linux/meta-ai, branch
	# wrynose) is what has actually been tested end to end (bitbake bash, then
	# tensorflow-lite), and is shipped as the worked EXAMPLE in
	# mackas.conf.example, not silently checked out for anyone who never asked
	# for it. These ride the ordinary defaults->config->env->--set machinery
	# like any other setting, so pointing mackas at a layer set is purely a
	# config change. With none of this set, 'setup' still does its whole job
	# (volumes, kas-container, the shim, gitconfig) and just skips the project
	# checkout step -- see setup_project/setup_kas_fragment's callers.
	#
	#   _URL     git repo to clone
	#   _BRANCH  branch to check out
	#   _DIR     checkout name under work/ (also the cwd kas-container runs in)
	#   MACKAS_KAS_CONFIG  the kas files to compose, checkout-relative and
	#                      colon-separated, exactly as kas-container wants them.
	#                      macos-local.yml (generated) is appended after these.
	MACKAS_PROJECT_URL=""
	MACKAS_PROJECT_BRANCH=""
	MACKAS_PROJECT_DIR=""
	MACKAS_KAS_CONFIG=""

	# Whether the env.sh 'kas-container' wrapper (a bare, hand-typed
	# 'kas-container build/shell/... <files>' -- see setup_shim_and_env) also
	# appends the generated macos-local.yml fragment onto <files> itself, the
	# same way compose_kas_files() already does for every mackas subcommand
	# that drives kas. ON by default: the fragment carries parallelism,
	# BB_DISKMON_DIRS and BB_HASHSERVE_DB_DIR, and forgetting to compose it by
	# hand is a silent, easy-to-miss loss of exactly those (a live-reported
	# case: bitbake's own hash-equivalence warning at parse time, no other
	# symptom). Set to 0 to go back to composing it yourself, e.g. if your own
	# <files> list already ends with a differently-named fragment.
	MACKAS_KAS_AUTO_FRAGMENT=1

	# Whether the env.sh 'kas-container' wrapper also DERIVES
	# MACKAS_PROJECT_DIR/MACKAS_KAS_CONFIG from the file list it was just
	# given, and exports them into that shell. ON by default. The workflow
	# this exists for is real and was hit repeatedly: someone drives kas by
	# hand ('kas-container shell meta-angstrom/kas/angstrom.yml:...') and
	# never sets MACKAS_PROJECT_DIR, so bitbake_getvar -- and therefore
	# 'retrieve' and 'buildstats analyze' -- refuse outright, or silently fall
	# back to OE-core default paths a distro has redefined. The file list
	# already names the checkout, so there is nothing to ask the user for.
	#
	# Exported into the CURRENT shell only, never written to a config file
	# (same ephemeral philosophy as setup's own size flags), and never over an
	# already-set value -- env beats the config file in mackas's own
	# precedence, so a derived value is picked up by the next mackas command
	# in that shell with no further plumbing.
	MACKAS_KAS_AUTO_PROJECT=1


	# The smoketest ladder's build rungs, space-separated bitbake targets, run
	# in order after the universal parse-only rung. Empty by default: with no
	# targets configured, the ladder's one build rung passes no --target at
	# all, so kas/bitbake builds whatever default target the kas config itself
	# names. Set your own project's targets here to exercise more than that
	# default -- see mackas.conf.example for meta-ai's ladder as an example
	# override, and consider "bash" as a trivial fallback target for a kas
	# config with no sensible bare default.
	MACKAS_SMOKETEST_TARGETS=""

	# Host-side overhead sampling during `smoketest` builds. ON by default: it costs
	# one `ps` every MACKAS_OVERHEAD_INTERVAL seconds and nothing else, and it
	# is best-effort -- a sampler failure never fails the build. See
	# tools/mackas-overhead and docs/testing.md for what the number means and,
	# just as important, what it does not (a fully-cached rung does almost no VM
	# work, so its host figure is near zero -- correct, not a bug).
	MACKAS_OVERHEAD=1
	MACKAS_OVERHEAD_INTERVAL=5

	# Reclaim the sparse volume images around every kas run (before it starts
	# and after it ends), so they do not ratchet up build after build. On by
	# default; set to 0 to skip. fstrim is fast (~0.01s) and runs when nothing
	# holds the volumes, so it neither slows nor endangers the build. The same
	# knob gates the fstrim `clean tmp+deploy` runs after its in-place clear.
	MACKAS_FSTRIM_AUTO=1

	# OpenEmbedded needs a case-sensitive filesystem for the layer checkouts
	# (KAS_WORK_DIR is a host bind-mount; oe-core has files that differ only by
	# case). setup REFUSES a case-insensitive MACKAS_ROOT by default rather than
	# build a doomed tree. Set to 0 only if you know the case-sensitive parts
	# live elsewhere (e.g. a workspace image, below) or for tests.
	MACKAS_REQUIRE_CASE_SENSITIVE=1

	# Path of the case-sensitive APFS sparse image mounted at work/, or empty
	# for the normal case: no image, work/ is a plain directory on an already
	# case-sensitive volume. This is a RECORD, not a preference -- `setup`'s
	# offer writes it into the config file the moment it creates or reattaches
	# an image, because nothing else can tell later invocations that work/ is
	# supposed to be a mount.
	#
	# It has to be recorded rather than derived: `hdiutil attach` is not
	# persistent, so after every reboot work/ is an ordinary EMPTY directory
	# on the (case-insensitive) drive, indistinguishable by inspection from a
	# root that never had an image at all. Without this knob a post-reboot
	# build would fall straight through to that directory and let kas re-clone
	# oe-core onto case-insensitive APFS -- the exact corruption the setup-time
	# gate exists to prevent, silent this time, because that gate already
	# passed once. With it set, ensure_workspace_attached() reattaches, or
	# refuses to touch work/ at all. See docs/storage.md.
	#
	# Unsetting it is the supported way to go back to a plain work/ (after
	# moving the checkouts off the image yourself); mackas never deletes an
	# image or edits this on its own beyond the create/reattach it just did.
	MACKAS_WORKSPACE_IMAGE=""

	# Size of the case-sensitive APFS sparse image `setup` offers to create at
	# work/ when the root turns out to be case-insensitive (see
	# offer_workspace_image()). Sparse, so this is a ceiling, not real disk
	# cost until written -- generous by default since it only holds git
	# checkouts (oe-core, bitbake, meta-*, the project layer), nothing like
	# TMPDIR/sstate.
	MACKAS_WORKSPACE_SIZE="40G"

	MACKAS_FREE_SPACE_MARGIN_GB=20

	# Bitbake progress bridge (TODO.md item 22): OFF by default. Enabling it
	# bind-mounts mackas-uibridge/ into the container, shadows PATH so bitbake
	# resolves to its wrapper first, and publishes a port to the host -- real
	# cost on every build, so it stays opt-in until proven, not a default like
	# MACKAS_OVERHEAD/MACKAS_FSTRIM_AUTO (which cost near nothing).
	MACKAS_MONITOR=0
	MACKAS_MONITOR_PORT=8801

	# Native macOS notification on exactly three transitions -- build started,
	# succeeded, failed -- from 'monitor'. OFF by default: it is a
	# notification, and one nobody asked for is worse than none. Costs nothing
	# when on (one osascript/terminal-notifier exec per transition, never per
	# task) and never affects the build.
	#
	# The honest caveat, which 'monitor --help' repeats: with no Notification
	# Center permission entry for the terminal app, osascript notifications
	# are dropped SILENTLY -- no error, no exit code, indistinguishable from
	# working. terminal-notifier carries its own bundle identity and is
	# preferred automatically when installed.
	MACKAS_MONITOR_NOTIFY=0

	# buildstats.bbclass opens build_stats in APPEND mode and never clears a
	# BUILDNAME dir itself (mkdir -p, not a truncate) -- a project whose
	# BUILDNAME does not vary per build (e.g. Angstrom's
	# `BUILDNAME = "Angstrom ${DISTRO_VERSION}"`, confirmed live) silently
	# accumulates every build it has ever run into one build_stats file, which
	# inflates 'buildstats analyze's numbers (see
	# check_buildstats_accumulation/clear_buildstats_before_build). OFF by
	# default -- i.e. mackas clears tmp/buildstats before each build unless
	# this is set to 1. Set to 1 only if you want raw accumulation and will
	# manage it yourself.
	MACKAS_BUILDSTATS_ACCUMULATE=0

	# Sweep any bitbake.sock/hashserve.sock stranded on the host-visible
	# checkout/work tree before a build starts (see clear_stale_sockets for
	# the virtiofs-stuck-socket mechanism this defends against). ON by
	# default: it only ever touches two exact filenames at two narrow paths,
	# only when nothing is using the volumes, so there is nothing for a
	# default-on sweep to break. Set to 0 to disable.
	MACKAS_SOCKET_SWEEP=1

	# Image `mackas volume fsck` runs e2fsck from. Empty (the default) means
	# the kas image, which mackas apt-gets e2fsprogs into on demand (see
	# fsck_guest_script). Set to an image that already has e2fsprogs to skip
	# that install and work offline -- same shape as the removed
	# MACKAS_RESIZE_IMAGE (f50c9ee), resolved lazily here rather than eagerly
	# defaulted to $KAS_IMAGE because KAS_IMAGE is itself a setting that may
	# be overridden after set_defaults() runs.
	MACKAS_FSCK_IMAGE=""
}

CONFIG_FILE_USED=""

# The pinned project `--project NAME` / $MACKAS_PROJECT_SELECT settled on, for
# `status` to report back. Deliberately NOT in SETTING_NAMES: a selector
# written into the file it selects is circular, and it must not ride the
# snapshot/restore machinery -- it picks WHICH file is sourced, never a value
# in one, so the four-rung precedence chain is untouched by it.
PROJECT_SELECTED=""

# Where a project's pinned, standalone config lives. `adopt` already writes one
# here; `--project NAME` reads exactly this path back.
projects_dir() { printf '%s/.config/mackas/projects' "$HOME"; }

# Refuse a project name before it is ever pasted into a path. The name becomes
# <projects_dir>/<name>.conf, so a '/' or a '..' inside it aims that path
# somewhere else entirely, and a leading '-' makes the value read as a flag to
# whatever later passes it along. The allowed class is the one `adopt` already
# produces (it tr's a checkout name down to [A-Za-z0-9-]), widened by '.' and
# '_' only.
validate_project_select() {
	local name="$1" src="$2" hint
	hint="$SCRIPT_CMD projects  (lists the pinned ones)"
	case "$name" in
		# Both callers reject an empty name before getting here; kept so the
		# function is safe standalone, since "" would name <dir>/.conf -- a
		# perfectly legal hidden file.
		"") die "$src needs a project name" "$hint" ;;
		-*) die "$src: a project name cannot start with '-': $name" "$hint" ;;
		.|..|*..*) die "$src: a project name cannot be '.' or contain '..': $name" "$hint" ;;
		*[!A-Za-z0-9._-]*)
			die "$src: a project name may only contain letters, digits, '.', '_' and '-': $name" \
				"$hint" ;;
	esac
}

# Print FILE's value for setting NAME by GREPPING it, never sourcing it.
# `projects` reads every pinned config in the directory at once, and sourcing a
# directory's worth of them is exactly the code execution the search-path
# restriction exists to prevent -- an unsafe one would have run before anything
# could grade it.
#
# Understands the shq() single-quoted form config_write_setting emits plus a
# hand-written double-quoted or bare value. Anything cleverer -- a $-expansion,
# a command substitution -- is printed raw rather than resolved, because
# resolving it means running it. Returns 1 when NAME is not in the file.
config_grep_setting() {
	local file="$1" name="$2" line v
	line="$(grep -E "^[[:space:]]*(export[[:space:]]+)?$name=" "$file" 2>/dev/null | tail -1 || true)"
	[ -n "$line" ] || return 1
	v="${line#*=}"
	# Trailing whitespace is not part of the value, and leaving it on would
	# stop a quoted value from matching its own closing quote below.
	while [ "$v" != "${v%[[:space:]]}" ]; do v="${v%[[:space:]]}"; done
	case "$v" in
		"'"*"'")
			v="${v#\'}"; v="${v%\'}"
			# shq() renders an embedded apostrophe as the four characters
			# '\'' -- undo that, or a value `$SCRIPT_NAME set` wrote itself
			# reads back mangled here.
			case "$v" in *\'*) v="$(printf '%s' "$v" | sed "s/'\\\\''/'/g")" ;; esac ;;
		'"'*'"') v="${v#\"}"; v="${v%\"}" ;;
		# Unquoted: a shell assignment's bare value ends at the first
		# whitespace, so a trailing '# comment' is shell, not value.
		*) v="${v%%[[:space:]]*}" ;;
	esac
	printf '%s\n' "$v"
}

# Is $1 safe to source without being asked to?
#
# A config file is SHELL, not data: sourcing one runs whatever is in it with
# the invoking user's privileges. "Readable" is nowhere near a good enough bar
# for a file we go looking for on our own, so an implicit candidate must also
# be owned by us (or by root) and be writable by nobody else. The same test is
# applied to the containing directory, because being able to replace the file
# is exactly as good as being able to edit it -- and a group-writable $HOME is
# a real configuration, not a hypothetical one.
#
# Both sides are graded on what is REALLY there, never on a symlink standing
# in for it. `ln -s` applies the umask, so a link's mode records only what the
# umask was when it was made -- measured here: 022 -> 755, 002 -> 775,
# 000 -> 777, 077 -> 700 -- and the usual 755 sails straight through
# path_is_owned_and_unwritable_by_others(). Grading a link therefore grades
# nothing: a config in a symlinked, world-writable projects directory would be
# sourced with the directory it actually sits in never looked at. So resolve
# the directory (`resolve_path` is physical), and walk a symlinked file to the
# bytes that would really run -- grading, at every hop, the directory the link
# itself sits in, since whoever can write that can re-aim it.
#
# This is deliberately NOT applied to --config or $MACKAS_CONF: those are the
# user naming a file on purpose, and refusing them would break the legitimate
# case of a config kept on a shared volume.
config_file_is_safe() {
	local f="$1" d target hops=0
	while [ -L "$f" ]; do
		# A chain this long is a loop or an attack, not a dotfiles setup.
		hops=$((hops + 1))
		[ "$hops" -le 16 ] || return 1
		d="$(resolve_path "$(dirname "$f")")"
		path_is_owned_and_unwritable_by_others "$d" || return 1
		# Flagless readlink only -- BSD and GNU agree on that one form
		# (see check's own readlink note).
		target="$(readlink "$f")" || return 1
		case "$target" in
			/*) f="$target" ;;
			*)  f="$d/$target" ;;
		esac
	done
	path_is_owned_and_unwritable_by_others "$f" || return 1
	d="$(resolve_path "$(dirname "$f")")"
	path_is_owned_and_unwritable_by_others "$d" || return 1
	return 0
}

path_is_owned_and_unwritable_by_others() {
	local p="$1" owner mode grp oth
	# stat(1) below is lstat, and a symlink's own mode is only the umask that
	# made it (022 -> 755), which says nothing about what it points at. Refuse
	# rather than grade a meaningless number: callers resolve first.
	if [ -L "$p" ]; then return 1; fi
	# BSD stat: %u = owner uid, %Lp = the low 3 octal permission digits.
	owner="$(stat -f '%u' "$p" 2>/dev/null)" || return 1
	mode="$(stat -f '%Lp' "$p" 2>/dev/null)" || return 1
	[ "$owner" = "$(id -u)" ] || [ "$owner" = "0" ] || return 1
	# %Lp is zero-padded to 3 digits, so group is the middle and other the last.
	grp="${mode%?}"; grp="${grp#?}"
	oth="${mode#??}"
	case "$grp" in 2|3|6|7) return 1 ;; esac
	case "$oth" in 2|3|6|7) return 1 ;; esac
	return 0
}

# Both selectors named a config file. Printed as die()'s hint, so it follows
# root_hint()'s shape: one command per line, copy-pasteable.
#
# Worth the length because of WHERE this fires. The common case is not a user
# passing both by hand -- it is a --project wrapper meeting a $MACKAS_CONF the
# caller exported in a shell rc, so the selector named in the error is one the
# user never set, and a bare "drop one" tells them to unset something they have
# never heard of. Show both resolved values, and give the escape for whichever
# one they actually control.
# The wrapper's frozen work dir disagrees with the one the config now in
# effect resolves. Name both, and say which knob to drop -- the same shape as
# selector_conflict_hint(), because it is the same class of mistake: something
# ambient re-aiming a build the user thought was pinned.
wrapper_identity_hint() {
	local expect="$1" src=""
	if [ -n "${MACKAS_CONF:-}" ]; then src="\$MACKAS_CONF"; fi
	printf 'the wrapper'"'"'s frozen work directory and the config now in effect disagree, so the volumes about to be mounted are not this project'"'"'s.\n'
	printf '\n'
	printf '    %-22s %s\n' "wrapper built for" "$expect"
	printf '    %-22s %s\n' "config now resolves" "$MACKAS_WORK"
	if [ -n "$src" ]; then
		printf '    %-22s %s\n' "chosen by" "$src = ${MACKAS_CONF}"
	fi
	printf '\n'
	if [ -n "$src" ]; then
		printf 'To build this project, for one command:\n'
		printf '    MACKAS_CONF= <your command>\n'
		printf 'or for the rest of this shell:\n'
		printf '    unset MACKAS_CONF\n'
	else
		printf 'Re-run setup if this root moved:\n'
		printf '    %s setup %s\n' "$SCRIPT_CMD" "$MACKAS_ROOT"
	fi
	printf '\n'
	printf 'To build the other project, use its own generated kas-container.\n'
}

selector_conflict_hint() {
	local sel_src="$1" sel="$2" path_src="$3" path="$4"
	printf 'these are mutually exclusive -- one picks a pinned project, the other names a path outright -- and mackas will not rank them for you.\n'
	printf '\n'
	printf '    %-24s %s\n' "$sel_src" "$sel"
	printf '    %-24s %s\n' "$path_src" "$path"
	printf '\n'
	if [ "$path_src" = "\$MACKAS_CONF" ]; then
		printf 'To keep the project and ignore the path, for one command:\n'
		printf '    MACKAS_CONF= <your command>\n'
		printf 'or for the rest of this shell:\n'
		printf '    unset MACKAS_CONF\n'
	else
		printf 'To keep the project instead, drop the %s flag.\n' "$path_src"
	fi
	printf '\n'
	if [ "$sel_src" = "\$MACKAS_PROJECT_SELECT" ]; then
		printf 'To keep the path instead:\n'
		printf '    unset MACKAS_PROJECT_SELECT\n'
	else
		printf 'To keep the path instead, drop the %s flag.\n' "$sel_src"
	fi
}

load_config() {
	local explicit="${1:-}" allow_missing="${2:-0}" select="${3:-}"
	local f
	local sel="" sel_src="" path="" path_src="" path_hint=""

	# Two ways to name a file outright, two ways to select a pinned project by
	# name. The flag beats the environment WITHIN each pair, exactly as
	# --config has always beaten $MACKAS_CONF. Mixing the pairs is refused
	# rather than ranked: a name and a path are two different answers to "which
	# file", and quietly preferring one hides the other in precisely the
	# invocation that meant it.
	if [ -n "$select" ]; then
		sel="$select"; sel_src="--project"
	elif [ -n "${MACKAS_PROJECT_SELECT:-}" ]; then
		sel="$MACKAS_PROJECT_SELECT"; sel_src="\$MACKAS_PROJECT_SELECT"
	fi
	if [ -n "$explicit" ]; then
		path="$explicit"; path_src="--config"
		path_hint="check the path passed to --config"
	elif [ -n "${MACKAS_CONF:-}" ]; then
		path="${MACKAS_CONF}"; path_src="\$MACKAS_CONF"
		# Same readability check as --config gets. Without it this lands on
		# the `.` below and prints a raw, localized "No such file or
		# directory" with no hint about which knob caused it.
		path_hint="check \$MACKAS_CONF, or unset it to use the default search path"
	fi
	if [ -n "$sel" ] && [ -n "$path" ]; then
		die "$sel_src and $path_src both choose a config file" \
			"$(selector_conflict_hint "$sel_src" "$sel" "$path_src" "$path")"
	fi

	if [ -n "$sel" ]; then
		validate_project_select "$sel" "$sel_src"
		f="$(projects_dir)/$sel.conf"
		if [ ! -r "$f" ]; then
			# Same allowance the typed paths get below: `set` on a project
			# nobody has pinned yet is how its config gets written.
			if [ "$allow_missing" -eq 1 ] && [ ! -e "$f" ]; then
				PROJECT_SELECTED="$sel"
				CONFIG_FILE_USED="$f"
				return 0
			fi
			die "no pinned project '$sel': $f is not readable" \
				"$SCRIPT_CMD projects  (lists the pinned ones)"
		fi
		# A directory (or a fifo) here is readable, and a 0755 directory of
		# ours passes the grade below untouched -- it would reach `. "$f"`
		# and come back out as a raw shell error. -f follows symlinks, so a
		# config kept as a link to a real file still qualifies.
		[ -f "$f" ] || die "not a config file: $f is not a regular file" \
			"$SCRIPT_CMD projects  (lists the pinned ones)"
		# STRICTER than the typed paths below, deliberately. mackas built this
		# path itself out of a bare name, in a fixed and entirely guessable
		# place -- that is the ambush shape the search path is guarded against,
		# not the request shape --config is. Refuse rather than fall through to
		# the search path: the caller asked for THIS project, and silently
		# loading a different one is worse than stopping.
		if ! config_file_is_safe "$f"; then
			die "refusing to source $f: it (or the directory it really lives in) is owned by someone else or writable by group/other" \
				"chmod go-w $(printf '%q' "$f") $(printf '%q' "$(projects_dir)")"
		fi
		# shellcheck disable=SC1090
		. "$f"
		PROJECT_SELECTED="$sel"
		CONFIG_FILE_USED="$f"
		return 0
	fi

	if [ -n "$path" ]; then
		if [ ! -r "$path" ]; then
			# set/get/unset (allow_missing=1, passed by main only for those
			# three) may legitimately target a config file that does not
			# exist yet -- 'set' is exactly the command that creates one,
			# and switching between per-project configs during the day means
			# that "yet" is a real, common state, not a typo. Every OTHER
			# command still refuses a missing --config outright, where a
			# stale or mistyped path is far more likely than an intentional
			# fresh start. A file that exists but is unreadable (permissions,
			# not absence) is refused either way -- 'set' writing there would
			# only fail the same way moments later with a worse message.
			if [ "$allow_missing" -eq 1 ] && [ ! -e "$path" ]; then
				CONFIG_FILE_USED="$path"
				return 0
			fi
			die "config file not readable: $path" "$path_hint"
		fi
		# Same reason as the selector's check above: `.` on a directory is a
		# raw shell error, and a typed path is the likeliest place to land on
		# one (a tab-completed directory name).
		[ -f "$path" ] || die "not a config file: $path is not a regular file" "$path_hint"
		# shellcheck disable=SC1090  # user-supplied config, path known at runtime only
		. "$path"
		CONFIG_FILE_USED="$path"
		return 0
	fi

	# ./mackas.conf is deliberately NOT in this list.
	#
	# It used to be, and it was a remote-code-execution hole with no exploit
	# needed: cd into any untrusted tree that happened to contain a
	# mackas.conf -- an unpacked tarball, a cloned repo, a shared download
	# directory -- run ANY mackas command, and that file's shell ran as you.
	# There is no way to make a cwd-relative config safe, because the whole
	# point of it is that the directory is not yours.
	#
	# Per-project configs still work; they just have to be named out loud:
	#   mackas --config ./mackas.conf status
	# which is a request rather than an ambush.
	for f in \
		"$HOME/.config/mackas/config" \
		"$HOME/.mackas.conf"
	do
		# -f as well as -r: a directory at either name is readable but would
		# reach `. "$f"` as a raw shell error. Not a match, so keep looking.
		if [ -f "$f" ] && [ -r "$f" ]; then
			if ! config_file_is_safe "$f"; then
				warn "ignoring $f: it (or the directory it really lives in) is owned by someone else or writable by group/other"
				warn "  mackas SOURCES this file as shell. To use it: chmod go-w $(printf '%q' "$f")"
				continue
			fi
			# shellcheck disable=SC1090
			. "$f"
			CONFIG_FILE_USED="$f"
			return 0
		fi
	done
	return 0
}

# ---------------------------------------------------------------------------
# set / get / unset -- persist (or read back) ONE setting in the config file
# ---------------------------------------------------------------------------
#
# `--set NAME=VALUE` (see apply_cli_overrides) is an ephemeral, in-memory
# override for a single invocation -- it composes with whatever OTHER command
# runs alongside it, so it stays a flag rather than a command of its own.
# These three are the standalone counterpart: an action in their own right,
# so they get the verb-object shape everything else here uses (see `volume`).

# The file `set`/`unset` write to: whatever config file THIS invocation
# actually loaded (--config, $MACKAS_CONF, --project/$MACKAS_PROJECT_SELECT,
# or the first match of the normal search path), or -- nothing loaded yet, the
# common first-use case -- the same default `load_config` would have picked
# had one existed.
set_target_config_file() {
	if [ -n "$CONFIG_FILE_USED" ]; then
		printf '%s' "$CONFIG_FILE_USED"
	else
		printf '%s' "$HOME/.mackas.conf"
	fi
}

# Rewrite (or append) a single NAME=value line in FILE, leaving every other
# line untouched. Not sed -i: BSD sed's -i needs a (possibly empty)
# backup-suffix argument that GNU sed parses differently, and mackas already
# steers clear of that split elsewhere -- a temp file + mv is portable and
# atomic either way.
#
# The value is written through shq(), the same single-quoting env.sh
# generation uses, so it round-trips exactly when the file is next sourced --
# spaces, '$' and apostrophes survive intact, matching what --set already
# allows on the command line.
#
# OP (4th arg, optional, default "write"): "delete" drops the "$name="* line
# instead of replacing it, and adds nothing when NAME was never there --
# cmd_unset's whole job. In that case VALUE is ignored (callers pass ""), and
# the function returns 1 with the file left untouched (not even created) if
# NAME was not found, so the caller can tell "removed" from "nothing to do".
config_write_setting() {
	local file="$1" name="$2" value="$3" op="${4:-write}" tmp perm found=0 line
	tmp="$(mktemp "${TMPDIR:-/tmp}/mackas-conf.XXXXXX")"
	if [ -f "$file" ]; then
		while IFS= read -r line || [ -n "$line" ]; do
			case "$line" in
				"$name="*)
					found=1
					[ "$op" = "delete" ] || printf '%s=%s\n' "$name" "$(shq "$value")" >>"$tmp"
					;;
				*) printf '%s\n' "$line" >>"$tmp" ;;
			esac
		done <"$file"
	fi
	if [ "$found" -eq 0 ]; then
		if [ "$op" = "delete" ]; then
			rm -f "$tmp"
			return 1
		fi
		printf '%s=%s\n' "$name" "$(shq "$value")" >>"$tmp"
	fi
	# Preserve an existing file's mode; a brand new one gets 600 --
	# config_file_is_safe() only requires "not group/other-writable", but
	# there is no reason to default to more open than that.
	if [ -f "$file" ]; then
		perm="$(stat -f '%Lp' "$file" 2>/dev/null || echo 600)"
	else
		perm="600"
	fi
	chmod "$perm" "$tmp"
	run mv "$tmp" "$file"
	local rc=$?
	# run() only PRINTS the mv under --dry-run, so $tmp is never actually
	# moved onto $file -- clean it up here or it leaks in $TMPDIR forever.
	[ "$DRY_RUN" -eq 1 ] && rm -f "$tmp"
	return "$rc"
}

# Same shape as validate_settings()'s character check, applied unconditionally
# here rather than only to SETTINGS_INTERPOLATED: every value `set` writes
# goes into a file that gets SOURCED as shell, so a stray '"' or backtick
# would corrupt that file's syntax the next time it loads, not just whatever
# mackas itself later generates from it.
refuse_unwritable_setting_value() {
	case "$1" in
		*'"'*|*'`'*|*[[:cntrl:]]*)
			die "value contains a double quote, a backtick or a control character" \
				"$SCRIPT_CMD cannot write that into a config file it will later source as shell"
			;;
	esac
}

set_usage() {
	cat <<EOF
${C_BLD}$SCRIPT_CMD set${C_RST} -- persist one setting in the config file.

${C_BLD}USAGE${C_RST}
  $SCRIPT_CMD set NAME VALUE

Writes (or replaces) a single NAME=VALUE line in the config file this
invocation would otherwise load -- $(set_target_config_file) right now.
Unlike '--set NAME=VALUE', which only affects the ONE command it rides
along with, this persists: every future invocation picks it up too.

'$SCRIPT_CMD status' lists the valid names.
EOF
}

get_usage() {
	cat <<EOF
${C_BLD}$SCRIPT_CMD get${C_RST} -- print one setting's currently resolved value.

${C_BLD}USAGE${C_RST}
  $SCRIPT_CMD get NAME

Resolved through the normal precedence (defaults -> config file ->
environment -> --set), so '$SCRIPT_CMD --set NAME=VALUE get NAME' previews
what an override would produce without running anything else.
EOF
}

unset_usage() {
	cat <<EOF
${C_BLD}$SCRIPT_CMD unset${C_RST} -- remove one persisted setting from the config file.

${C_BLD}USAGE${C_RST}
  $SCRIPT_CMD unset NAME

Removes NAME's line from the config file this invocation would otherwise
load -- $(set_target_config_file) right now. Fine to run on a NAME that was
never persisted; that is a no-op, not an error.
EOF
}

cmd_set() {
	local args=() want_help=0 a
	for a in "$@"; do
		case "$a" in
			--dry-run)     DRY_RUN=1 ;;
			-y|-f|--yes|--force)  ASSUME_YES=1 ;;
			-v|--verbose)  VERBOSE=1 ;;
			-h|--help)     want_help=1 ;;
			--version)     echo "$SCRIPT_NAME $SCRIPT_VERSION"; exit 0 ;;
			--config|--config=*|--project|--project=*|--set|--set=*) die_on_misplaced_global_flag "$a" set ;;
			# Bare 'help' means "show usage" only in NAME's position -- 'set'
			# is the one command here with a free-text positional (VALUE), and
			# VALUE may legitimately BE the literal string "help" (a target
			# name, a path component). Once args already holds NAME, 'help'
			# is data, not a request for help.
			help) if [ "${#args[@]}" -eq 0 ]; then want_help=1; else args+=("$a"); fi ;;
			*)             args+=("$a") ;;
		esac
	done
	if [ "$want_help" -eq 1 ]; then set_usage; return 0; fi

	[ "${#args[@]}" -eq 2 ] || die "'set' needs exactly NAME and VALUE, got ${#args[@]} argument(s)" \
		"$SCRIPT_CMD set --help"
	local name="${args[0]}" value="${args[1]}"
	is_setting_name "$name" || die "'$name' is not a mackas setting" \
		"$SCRIPT_CMD status lists the valid names"
	refuse_unwritable_setting_value "$value"

	# Reject a value that fails the SAME per-setting checks every other
	# command enforces (whitespace-free volume names, integer CPUS/PORT, the
	# MEMORY/VOLUME_SIZE_* shapes...) before writing it, not after. Without
	# this, a bad `set` writes the value successfully, and every LATER
	# invocation -- including `unset`, the only in-tool way back -- dies in
	# main()'s own validate_settings before it ever reaches dispatch, since
	# that call happens unconditionally ahead of cmd_set/cmd_unset alike
	# (issue #106). Reuse validate_settings() itself rather than duplicate
	# its logic here: assign the candidate to $name and run it inside a
	# command-substitution subshell, so its die() (which calls exit) only
	# aborts the SUBSHELL -- $name keeps its real, already-validated value in
	# this live process either way, and the message it would have printed
	# comes back as this command substitution's captured output.
	local validate_output
	if ! validate_output="$(eval "$name=\"\$value\""; validate_settings 2>&1)"; then
		printf '%s\n' "$validate_output" >&2
		exit 1
	fi

	local file; file="$(set_target_config_file)"
	# The target may sit in a directory that does not exist yet -- writing the
	# first pinned project's config under ~/.config/mackas/projects/ is exactly
	# that case, and config_write_setting's mv would fail on it.
	#
	# Created under umask 077, never the ambient one: --project holds this
	# directory to config_file_is_safe(), and under a `umask 002` login (a real
	# configuration, not a hypothetical one) an inherited umask would make the
	# directory group-writable -- so bootstrapping a project config here would
	# produce one --project then refuses to source. The subshell keeps the
	# umask off everything else; run() is a plain function, with no state to
	# lose across it.
	local dir; dir="$(dirname "$file")"
	[ -d "$dir" ] || ( umask 077 && run mkdir -p "$dir" ) || die "could not create $dir"
	config_write_setting "$file" "$name" "$value"
	if [ "$DRY_RUN" -eq 1 ]; then
		info "  would write $name=$value to $file"
	else
		did "$name=$value written to $file"
	fi
}

cmd_get() {
	local args=() want_help=0 a
	for a in "$@"; do
		case "$a" in
			# get reads and prints exactly one value; it mutates nothing, so
			# --dry-run/-y are accepted-and-ignored rather than refused --
			# consistent with set/unset/volume/retrieve accepting them
			# anywhere, so a habitual '-v' after any command does not
			# suddenly become "unknown option" on this one.
			--dry-run)     DRY_RUN=1 ;;
			-y|-f|--yes|--force)  ASSUME_YES=1 ;;
			-v|--verbose)  VERBOSE=1 ;;
			-h|--help|help) want_help=1 ;;
			--version)     echo "$SCRIPT_NAME $SCRIPT_VERSION"; exit 0 ;;
			--config|--config=*|--project|--project=*|--set|--set=*) die_on_misplaced_global_flag "$a" get ;;
			*)              args+=("$a") ;;
		esac
	done
	if [ "$want_help" -eq 1 ]; then get_usage; return 0; fi

	[ "${#args[@]}" -eq 1 ] || die "'get' needs exactly one NAME, got ${#args[@]} argument(s)" \
		"$SCRIPT_CMD get --help"
	local name="${args[0]}"
	is_setting_name "$name" || die "'$name' is not a mackas setting" \
		"$SCRIPT_CMD status lists the valid names"
	eval "printf '%s\n' \"\${$name}\""
}

cmd_unset() {
	local args=() want_help=0 a
	for a in "$@"; do
		case "$a" in
			--dry-run)     DRY_RUN=1 ;;
			-y|-f|--yes|--force)  ASSUME_YES=1 ;;
			-v|--verbose)  VERBOSE=1 ;;
			-h|--help|help) want_help=1 ;;
			--version)     echo "$SCRIPT_NAME $SCRIPT_VERSION"; exit 0 ;;
			--config|--config=*|--project|--project=*|--set|--set=*) die_on_misplaced_global_flag "$a" unset ;;
			*)             args+=("$a") ;;
		esac
	done
	if [ "$want_help" -eq 1 ]; then unset_usage; return 0; fi

	[ "${#args[@]}" -eq 1 ] || die "'unset' needs exactly one NAME, got ${#args[@]} argument(s)" \
		"$SCRIPT_CMD unset --help"
	local name="${args[0]}"
	is_setting_name "$name" || die "'$name' is not a mackas setting" \
		"$SCRIPT_CMD status lists the valid names"

	local file; file="$(set_target_config_file)"
	# config_write_setting's "delete" op does the anchored "$name=" glob
	# match/rewrite/mode-preserve work (a case pattern always matches the
	# whole string, so this cannot false-positive on some OTHER setting whose
	# name merely ends in the same suffix); it returns 1, file untouched, if
	# NAME was never persisted -- including "no config file at all" -- rather
	# than 'unset' hand-rolling that same read/rewrite loop a second time.
	if config_write_setting "$file" "$name" "" delete; then
		if [ "$DRY_RUN" -eq 1 ]; then
			info "  would remove $name from $file"
		else
			did "$name removed from $file"
		fi
	else
		info "$name is not persisted in $file -- nothing to do"
	fi
}

# ---------------------------------------------------------------------------
# projects -- list the pinned per-project configs, without running any of them
# ---------------------------------------------------------------------------

projects_usage() {
	cat <<EOF
${C_BLD}$SCRIPT_CMD projects${C_RST} -- list the pinned per-project configs.

${C_BLD}USAGE${C_RST}
  $SCRIPT_CMD projects

Lists $(projects_dir)/*.conf -- the standalone
configs '$SCRIPT_CMD adopt' and '$SCRIPT_CMD project add' write -- and, for
each, the settings that say where that project's build lives. Select one for
a single command with '$SCRIPT_CMD --project NAME ...', or for a whole shell
with \$MACKAS_PROJECT_SELECT=NAME.

Note the singular sibling: this command LISTS what is already pinned; it
never creates one. '$SCRIPT_CMD project add NAME' does that.

Read-only, and it reads by GREPPING each file rather than sourcing it: a
config is shell, and listing a directory of them must not run any of them.

Options: --dry-run, -y/--yes (or -f/--force) and -v/--verbose work here too,
though this reads only and never prompts.
EOF
}

cmd_projects() {
	local dir name f v s root found=0
	dir="$(projects_dir)"
	hdr "Pinned projects"
	show "directory" "$dir"
	for f in "$dir"/*.conf; do
		[ -f "$f" ] || continue
		found=1
		name="$(basename "$f" .conf)"
		info ""
		if [ "$f" = "$CONFIG_FILE_USED" ]; then
			printf '  %s%s%s  (selected for this command)\n' "$C_BLD" "$name" "$C_RST"
		else
			printf '  %s%s%s\n' "$C_BLD" "$name" "$C_RST"
		fi
		root=""
		for s in MACKAS_ROOT MACKAS_PROJECT_DIR MACKAS_VOLUME_NAME \
		         MACKAS_VOLUME_DL_NAME MACKAS_VOLUME_SSTATE_NAME; do
			v="$(config_grep_setting "$f" "$s")" || v=""
			if [ "$s" = "MACKAS_ROOT" ]; then root="$v"; fi
			if [ -n "$v" ]; then
				printf '    %-26s %s\n' "$s" "$v"
			fi
		done
		if [ -n "$root" ] && [ ! -d "$root" ]; then
			printf '    %s%-26s %s%s\n' "$C_YEL" "stale" \
				"its MACKAS_ROOT does not exist -- moved, or on an unmounted disk" "$C_RST"
		fi
		# The same test --project applies before sourcing, reported here
		# instead of at the moment it would refuse.
		if ! config_file_is_safe "$f"; then
			printf '    %s%-26s %s%s\n' "$C_YEL" "unsafe" \
				"owned by someone else or group/other-writable -- --project refuses it" "$C_RST"
		fi
		printf '    %-26s %s --project %s ...\n' "select with" "$SCRIPT_CMD" "$name"
	done
	if [ "$found" -eq 0 ]; then
		info ""
		info "  none pinned yet."
		info "  '$SCRIPT_CMD adopt <root>' writes a standalone config here."
	fi
}

# The kas files kas-container is actually given: the project's own config
# (MACKAS_KAS_CONFIG) followed by the generated macOS fragment, composed last
# so it wins. Every element is checkout-relative because run_kas() cd's into
# the checkout first, and the fragment physically lives at kas/macos-local.yml
# inside it (kas only mounts files under the repo dir).
#
# If MACKAS_KAS_CONFIG is empty we still hand over the fragment alone rather
# than a leading ':' -- a colon-prefixed list is a kas parse error, not an
# empty one.
compose_kas_files() {
	if [ -n "$MACKAS_KAS_CONFIG" ]; then
		printf '%s:kas/macos-local.yml' "$MACKAS_KAS_CONFIG"
	else
		printf 'kas/macos-local.yml'
	fi
}

# strip_trailing_slash VALUE -- print VALUE with trailing slash(es) removed,
# keeping a bare "/" intact. A path can carry a trailing slash from a user
# typing or tab-completing one, or from a symlink recorded by an OLDER
# mackas that predates this normalization -- comparing such a path against a
# freshly-normalized one with plain string equality reads as "different"
# even though they name the same directory. Used to normalize MACKAS_ROOT
# itself; resolve_path (below) calls this too, so same_dir's comparisons
# get it for free.
strip_trailing_slash() {
	printf '%s' "$1" | sed 's:\(.\)/*$:\1:'
}

# resolve_path PATH -- print PATH's canonical, symlink-free absolute form.
# Falls back to PATH itself (just trailing-slash-stripped) when it doesn't
# exist yet -- a location that will be CREATED can't be resolved, and the
# literal value is already the right comparison target in that case. Plain
# `cd && pwd -P` rather than GNU realpath's `-e`/`--relative-base` (see
# find_gnu_realpath's own comment on why those specific flags need GNU) --
# this only ever needs "what does this path really point at", which BSD's
# own realpath/pwd -P already answer correctly.
#
# Exists because a bare string compare between a symlink path (e.g.
# MACKAS_SHORT_LINK) and a resolved target (e.g. MACKAS_ROOT) reads as
# "different" even when they name the same directory -- confirmed live: this
# exact mismatch made setup_relocate_volumes() conclude a root's own
# relocation symlink belonged to "a different root" and offer to move a
# live project's volumes onto the wrong disk.
resolve_path() {
	local p
	p="$(strip_trailing_slash "$1")"
	if [ -d "$p" ]; then
		(cd -- "$p" 2>/dev/null && pwd -P) || printf '%s\n' "$p"
	elif [ -e "$p" ]; then
		local dir base
		dir="$(dirname -- "$p")"
		base="$(basename -- "$p")"
		(cd -- "$dir" 2>/dev/null && printf '%s/%s\n' "$(pwd -P)" "$base") || printf '%s\n' "$p"
	else
		printf '%s\n' "$p"
	fi
}

# same_dir A B -- true if A and B name the same directory once symlinks are
# fully resolved (see resolve_path's own comment for why a bare string
# compare between a symlink and its target is not enough -- and, the same
# way, why a bare readlink comparison misses a link that reaches its target
# through ANOTHER symlink rather than directly).
same_dir() {
	[ "$(resolve_path "$1")" = "$(resolve_path "$2")" ]
}

# Values that depend on other values, resolved once everything else is final.
#
# This runs for EVERY command, including `help` and a `status` on a machine
# with no config at all, so it must tolerate an unset MACKAS_ROOT rather than
# die on one -- require_mackas_root() is what refuses, per command, and it
# gives a far better message than a half-derived path ever could.
derive_paths() {
	# With no root there is nothing to hang these off. Leave them EMPTY rather
	# than derive from "": "$MACKAS_ROOT/work" would silently become the
	# absolute path "/work", and `status` would print a confident, wrong answer
	# instead of a blank that reads as "unset".
	if [ -z "$MACKAS_ROOT" ]; then
		MACKAS_NFS_MOUNT="${MACKAS_NFS_MOUNT:-}"
		MACKAS_SSTATE_MIRROR_PATH="${MACKAS_SSTATE_MIRROR_PATH:-}"
		MACKAS_DL_MIRROR_PATH="${MACKAS_DL_MIRROR_PATH:-}"
		MACKAS_BASE=""
		MACKAS_BIN=""; MACKAS_WORK=""; MACKAS_KAS=""; MACKAS_LOGS=""
		MACKAS_PROJECT=""; MACKAS_ENV_SH=""; MACKAS_GITCONFIG=""
		KAS_CONTAINER_BIN=""; KAS_CONTAINER_REAL=""; SHIM_DIR=""
		MACKAS_KAS_FRAGMENT_SRC=""; MACKAS_KAS_FRAGMENT_REPO=""
		KAS_FILES_ARG="$(compose_kas_files)"
		derive_volume_names
		return 0
	fi

	# Strip a trailing slash a user-supplied root (typed by hand, or
	# tab-completed, which appends one for a directory) would otherwise
	# double up in every "$MACKAS_ROOT/bin"-style concatenation below --
	# .../Angstrom//bin, not a real bug (a double slash resolves fine), but
	# ugly enough in --dry-run/-v output and status/check to read as one.
	MACKAS_ROOT="$(strip_trailing_slash "$MACKAS_ROOT")"

	[ -n "$MACKAS_NFS_MOUNT" ] || MACKAS_NFS_MOUNT="$MACKAS_ROOT/nfs"
	[ -n "$MACKAS_SSTATE_MIRROR_PATH" ] || MACKAS_SSTATE_MIRROR_PATH="$MACKAS_NFS_MOUNT/angstrom-2026.06/build/sstate-cache"
	[ -n "$MACKAS_DL_MIRROR_PATH" ] || MACKAS_DL_MIRROR_PATH="$MACKAS_NFS_MOUNT/angstrom-2026.06/build/downloads"

	# MACKAS_BASE is the path everything actually runs through: the short,
	# space-free symlink if we have one, else MACKAS_ROOT itself.
	#
	# The link is only adopted when it genuinely resolves to THIS MACKAS_ROOT.
	# Merely existing is not enough, and testing for that was a real bug: [ -L ]
	# is true for a DANGLING link and true for a STALE one still pointing at
	# some older root, so a leftover ~/oe -> /tmp/old-root quietly became the
	# base. Everything downstream hangs off MACKAS_BASE -- env.sh, gitconfig,
	# the shim, the kas fragment, MACKAS_LOGS -- so that leftover link
	# redirected the lot into a tree the user never named, up to and including
	# `clean` doing rm -rf on the wrong logs directory.
	#
	# check_short_link()/setup_short_link() do validate the link, but they only
	# run for `check` and `setup`. derive_paths runs first and for everything,
	# so `status`, `clean`, `shell` and `smoketest` never saw that validation. It
	# has to live here to cover them.
	local link_target=""
	MACKAS_BASE="$MACKAS_ROOT"
	if [ -L "$MACKAS_SHORT_LINK" ]; then
		link_target="$(readlink "$MACKAS_SHORT_LINK" 2>/dev/null || true)"
		# same_dir, not a bare string compare: also catches a link recorded by
		# an older mackas with a trailing slash baked in, or one that reaches
		# MACKAS_ROOT through ANOTHER symlink rather than directly.
		if same_dir "$MACKAS_SHORT_LINK" "$MACKAS_ROOT" && [ -d "$MACKAS_SHORT_LINK" ]; then
			# -d follows the link, so this is also what rules out a dangling one.
			MACKAS_BASE="$MACKAS_SHORT_LINK"
		else
			vrb "ignoring $MACKAS_SHORT_LINK -> ${link_target:-<unreadable>}: it does not resolve to MACKAS_ROOT ($MACKAS_ROOT); using MACKAS_ROOT directly ('$SCRIPT_CMD check' explains)"
		fi
	fi

	MACKAS_BIN="$MACKAS_BASE/bin"
	MACKAS_WORK="$MACKAS_BASE/work"
	MACKAS_KAS="$MACKAS_BASE/kas"
	MACKAS_LOGS="$MACKAS_BASE/logs"
	MACKAS_PROJECT="$(strip_trailing_slash "$MACKAS_WORK/$MACKAS_PROJECT_DIR")"
	MACKAS_ENV_SH="$MACKAS_BASE/env.sh"
	# See setup_gitconfig() for why this file exists at all.
	MACKAS_GITCONFIG="$MACKAS_BASE/gitconfig"
	KAS_CONTAINER_BIN="$MACKAS_BIN/kas-container"
	# KAS_CONTAINER_BIN is the generated protection wrapper that $PATH
	# resolves; KAS_CONTAINER_REAL is the pinned upstream script the wrapper
	# exec's. mackas's own code always calls .real directly so the runtime
	# args are never computed twice (once by the wrapper, once by mackas
	# itself).
	KAS_CONTAINER_REAL="$MACKAS_BIN/kas-container.real"
	SHIM_DIR="$MACKAS_BIN"
	# kas fragment, as seen from the project checkout (kas rewrites paths
	# under the repo dir to /repo/... inside the container, so the fragment
	# has to physically live inside the checkout).
	MACKAS_KAS_FRAGMENT_SRC="$MACKAS_KAS/macos.yml"
	MACKAS_KAS_FRAGMENT_REPO="$MACKAS_PROJECT/kas/macos-local.yml"
	KAS_FILES_ARG="$(compose_kas_files)"

	derive_volume_names

	validate_nfs_mirror_paths
}

# The three ext4 volumes. TMPDIR, downloads and sstate all need real Linux
# filesystem semantics, and none of them may be a host (APFS) directory -- see
# kas_runtime_args() for why they are volumes rather than bind mounts.
#
# Called from BOTH of derive_paths()' branches. `status`, `help` and `volume
# list` on a machine with no MACKAS_ROOT go through the early-return one, so
# deriving in only one branch makes mackas PRINT one set of names and OPERATE
# on another.
#
# The overrides are read here rather than written back into
# MACKAS_VOLUME_DL_NAME/_SSTATE_NAME: derive_paths() runs more than once per
# invocation (adopt re-derives after picking a new stem), and backfilling
# would pin the caches to the stem that was current the first time round.
#
# Same reasoning applies to the selector-derived stem default just below:
# it is recomputed from PROJECT_SELECTED + config_pinned_setting() on every
# call, and never written into __EXPLICIT_MACKAS_VOLUME_NAME, so it stays a
# pure, idempotent default -- exactly like set_defaults()' own output,
# losable to config/env/--set, not layered on top of them (#72's core rule:
# a default, never a fifth precedence rung).
derive_volume_names() {
	# When a project is selected (--project / $MACKAS_PROJECT_SELECT settled
	# on a pinned config) and nothing above the defaults rung pinned
	# MACKAS_VOLUME_NAME to a value of its own, the stem defaults to
	# mackas-<selected name> instead of the factory "oe-build" -- #72/#77's
	# per-project volume naming. This can never trip validate_volume_names()'s
	# empty/whitespace check below: validate_project_select() already
	# restricts PROJECT_SELECTED to [A-Za-z0-9._-], and the literal prefix
	# "mackas-" added here introduces none either.
	#
	# config_pinned_setting(), not setting_is_explicit() alone -- see its own
	# comment for why: MACKAS_VOLUME_NAME's factory default is the non-empty
	# "oe-build", so a project config that explicitly pins that exact value
	# (migration path B of #72, "keep oe-build-*, no data moves") would
	# otherwise read as "untouched" and get silently overridden here.
	if [ -n "$PROJECT_SELECTED" ] && ! config_pinned_setting MACKAS_VOLUME_NAME; then
		MACKAS_VOLUME_NAME="mackas-$PROJECT_SELECTED"
	fi

	MACKAS_VOL_TMP="${MACKAS_VOLUME_NAME}-tmp"
	MACKAS_VOL_DL="${MACKAS_VOLUME_DL_NAME:-${MACKAS_VOLUME_NAME}-dl}"
	MACKAS_VOL_SSTATE="${MACKAS_VOLUME_SSTATE_NAME:-${MACKAS_VOLUME_NAME}-sstate}"
	# The single volume mackas used to create, before the split into three.
	# Nothing uses it any more; `check` and `status` report it so it does not
	# sit there silently eating disk.
	MACKAS_VOL_LEGACY="$MACKAS_VOLUME_NAME"

	# Two of the three resolving to one name is invariant 3 violated from
	# INSIDE a single container: kas_runtime_args() would emit `-v x:/downloads
	# -v x:/sstate`, attaching one ext4 image twice to the same VM. Nothing
	# downstream catches it -- require_volumes_free() only asks what OTHER
	# running containers hold, and setup_volumes() would create the name twice
	# at two different sizes and report success -- so the first sign would be a
	# corrupt filesystem mid-build. Before these two knobs existed the three
	# names were one stem plus three fixed suffixes and could not collide;
	# refuse here, where every caller resolves them.
	if [ "$MACKAS_VOL_DL" = "$MACKAS_VOL_TMP" ]; then
		die_volume_collision "$MACKAS_VOL_DL" "the build volume and the downloads volume"
	fi
	if [ "$MACKAS_VOL_SSTATE" = "$MACKAS_VOL_TMP" ]; then
		die_volume_collision "$MACKAS_VOL_SSTATE" "the build volume and the sstate volume"
	fi
	if [ "$MACKAS_VOL_DL" = "$MACKAS_VOL_SSTATE" ]; then
		die_volume_collision "$MACKAS_VOL_DL" "the downloads volume and the sstate volume"
	fi
}

die_volume_collision() {
	die "$2 both resolve to '$1'" \
		"the three volumes are attached to one container, so they must have three distinct names; set MACKAS_VOLUME_DL_NAME / MACKAS_VOLUME_SSTATE_NAME to differ from each other and from \${MACKAS_VOLUME_NAME}-tmp in $(config_hint)"
}

# kas-container WORD-SPLITS the string it gets from --runtime-args, so every
# value that ends up inside it must be free of whitespace. setup_volumes()
# already refuses a MACKAS_VOLUME_NAME with a space in it; the NFS mirror paths
# go into the very same string, via `-v $path:/sstate-mirror:ro`, and nothing
# was checking them.
#
# This is not a corner case waiting for a weird config. A perfectly ordinary
# MACKAS_ROOT with a space in it -- "/Volumes/My Disk/oe" -- makes the mirror
# paths derive from it, and turning NFS mirrors on then produces
# "-v /Volumes/My", "Disk/oe/...", ... -- separate arguments, mounting
# nonsense. Refuse it with an explanation rather than mount garbage.
#
# Only the NFS path is affected. HTTP mirrors are URLs in the kas fragment and
# never touch --runtime-args, which is one more reason they are the
# recommended option.
validate_nfs_mirror_paths() {
	[ "$MACKAS_USE_NFS_MIRRORS" = "1" ] || return 0
	local p
	for p in "$MACKAS_SSTATE_MIRROR_PATH" "$MACKAS_DL_MIRROR_PATH"; do
		case "$p" in
			"")
				die "MACKAS_USE_NFS_MIRRORS=1 but the NFS mirror paths are empty" \
					"set MACKAS_NFS_MOUNT in $(config_hint), or MACKAS_USE_HTTP_MIRRORS=1 instead"
				;;
			*[[:space:]]*)
				die "NFS mirror path '$p' contains whitespace, which kas-container cannot be given" \
					"set MACKAS_NFS_MOUNT to a space-free path in $(config_hint) (e.g. $MACKAS_SHORT_LINK/nfs), or use MACKAS_USE_HTTP_MIRRORS=1 instead -- HTTP mirrors need no -v mount and so have no such limit"
				;;
		esac
	done
}

# ---------------------------------------------------------------------------
# Small utilities
# ---------------------------------------------------------------------------

# monitor_runtime_args -- the extra --runtime-args tokens that activate the
# bitbake progress bridge (TODO.md item 22) when MACKAS_MONITOR=1. Prints
# nothing (best-effort, never fatal -- MACKAS_MONITOR is opt-in extra
# visibility, not something a build should fail over) when there is nothing
# to mount yet (no project checked out) or when a path involved has a space
# in it: kas-container word-splits --runtime-args on whitespace (see
# kas_runtime_args's own comment), so a spacey path would silently corrupt
# every OTHER token in the string, not just this one.
#
# Finds the real bitbake to mount over from the HOST side: the checkout is a
# plain bind-mount under MACKAS_WORK, not inside an ext4 volume, so a host
# `find` sees it directly, and does not depend on a specific checkout
# directory NAME (kas lets a project's kas.yml name it anything).
monitor_runtime_args() {
	local real_bitbake rel

	case "$SCRIPT_DIR" in
		*' '*)
			warn "MACKAS_MONITOR=1 but mackas's own path has a space in it ($SCRIPT_DIR) -- skipping the progress bridge this run"
			return
			;;
	esac

	if [ ! -d "$MACKAS_WORK" ]; then
		warn "MACKAS_MONITOR=1 but $MACKAS_WORK does not exist yet -- skipping the progress bridge this run ($SCRIPT_CMD setup)"
		return
	fi
	real_bitbake="$(find "$MACKAS_WORK" -maxdepth 3 -type f -path '*/bin/bitbake' 2>/dev/null | head -1)"
	[ -n "$real_bitbake" ] || {
		warn "MACKAS_MONITOR=1 but no bitbake checkout found yet under $MACKAS_WORK -- skipping the progress bridge this run"
		return
	}
	case "$real_bitbake" in
		*' '*)
			warn "MACKAS_MONITOR=1 but the bitbake checkout's path has a space in it -- skipping the progress bridge this run"
			return
			;;
	esac

	rel="${real_bitbake#"$MACKAS_WORK"/}"
	# Both mounted as INDIVIDUAL files, never one whole-directory mount plus
	# a second mount targeting a file inside that same directory -- verified
	# live: Apple's container silently fails the FIRST mount whenever a
	# second -v's HOST source path is nested inside the first -v's host
	# source directory, even when their container-side targets are
	# unrelated. Two single-file mounts from the same host directory (as
	# used here) coexist fine; a directory mount plus a file-inside-it mount
	# does not.
	printf ' -v %s/mackasjson.py:/mackas-uibridge/mackasjson.py:ro -v %s/bitbake:/work/%s:ro -p %s:%s -e MACKAS_MONITOR_PORT=%s' \
		"$SCRIPT_DIR/mackas-uibridge" "$SCRIPT_DIR/mackas-uibridge" "$rel" \
		"$MACKAS_MONITOR_PORT" "$MACKAS_MONITOR_PORT" "$MACKAS_MONITOR_PORT"
}

# The one string that makes the whole tool work. See README's "The ext4
# volumes".
#
# Everything here goes to kas-container's --runtime-args flag, NOT to the
# environment, and that is not a style choice:
#
#   * KAS_EXTRA_RUNTIME_ARGS is NOT an environment variable. kas-container
#     sets it to "" unconditionally before parsing its own arguments, so an
#     exported one is discarded without a word -- and every container then
#     runs at Apple's defaults of cpus=4/memory=1gb, which bitbake would
#     thrash or OOM on. --runtime-args / --docker-args is the only way in.
#
#   * KAS_BUILD_DIR/DL_DIR/SSTATE_DIR must stay UNSET in the environment.
#     kas-container's forward_dir() BIND-MOUNTS whatever host directory they
#     name, so pointing them at an APFS path puts TMPDIR on virtiofs -- the
#     one thing the ext4 volumes exist to prevent. forward_dir() returns
#     early on an empty value, so we blank them and set the container-side
#     paths with -e inside --runtime-args instead, next to the -v that backs
#     each one with a real ext4 volume.
#
# kas-container word-splits this string, so no value in it may contain a
# space. setup_volumes() refuses a volume name that does.
kas_runtime_args() {
	# Named rt_str, not args: several command parsers in this file use an
	# ARRAY named args, and shellcheck (0.11+) tracks variable kinds file-wide,
	# so a string with the same name trips SC2178/SC2128 as a false positive.
	local rt_str="-c $MACKAS_CPUS -m $MACKAS_MEMORY"

	rt_str="$rt_str -v $MACKAS_VOL_TMP:/build -e KAS_BUILD_DIR=/build"
	rt_str="$rt_str -v $MACKAS_VOL_DL:/downloads -e DL_DIR=/downloads"
	rt_str="$rt_str -v $MACKAS_VOL_SSTATE:/sstate -e SSTATE_DIR=/sstate"

	if [ "$MACKAS_USE_NFS_MIRRORS" = "1" ]; then
		rt_str="$rt_str -v $MACKAS_SSTATE_MIRROR_PATH:/sstate-mirror:ro"
		rt_str="$rt_str -v $MACKAS_DL_MIRROR_PATH:/downloads-mirror:ro"
	fi

	[ "$MACKAS_MONITOR" = "1" ] && rt_str="$rt_str $(monitor_runtime_args)"

	printf '%s' "$rt_str"
}

# valid_size_shape SIZE -- true when SIZE is digits optionally followed by a
# unit size_to_gb/size_to_bytes both recognize (t/tb/tib, g/gb/gib, m/mb/mib,
# case-insensitive) or no unit at all (bare digits = GiB). The single source
# of truth for what a volume-size setting or --tmpdir-size/--sstate-size/
# --downloads-size flag is allowed to look like -- validate_settings() and
# validate_setup_size() both call this rather than keeping their own copy.
valid_size_shape() {
	local s="$1" num unit
	num="$(printf '%s' "$s" | sed 's/[^0-9].*$//')"
	unit="$(printf '%s' "$s" | sed 's/^[0-9]*//' | tr '[:upper:]' '[:lower:]')"
	[ -n "$num" ] || return 1
	case "$unit" in
		''|t|tb|tib|g|gb|gib|m|mb|mib) return 0 ;;
		*) return 1 ;;
	esac
}

# Parse "200G" / "42g" / "1024M" -> whole GiB (rounded up). Also fed real
# `du -h` output by status_volume() (e.g. "8.0M") -- NOT covered by
# valid_size_shape(), and its decimal point makes the unit match nothing
# below, so it falls to the catch-all rather than the m|mb|mib case. Keep
# that fallback reading as GiB (not 0): du's smallest unit is K, always
# below the M/G/T this parses, so overestimating whatever slips through
# still lands on the safe side of a near-cap warning.
size_to_gb() {
	local s="$1" num unit
	num="$(printf '%s' "$s" | sed 's/[^0-9].*$//')"
	unit="$(printf '%s' "$s" | sed 's/^[0-9]*//' | tr '[:upper:]' '[:lower:]')"
	[ -n "$num" ] || { echo 0; return; }
	case "$unit" in
		t|tb|tib) echo $((num * 1024)) ;;
		g|gb|gib|"") echo "$num" ;;
		m|mb|mib) echo $(( (num + 1023) / 1024 )) ;;
		*) echo "$num" ;;
	esac
}

# version_ge A B -- true when dotted version A >= dotted version B.
#
# Field-by-field NUMERIC comparison, deliberately not `sort -V` (not in macOS's
# BSD sort) and not a string compare, which gets 1.10.0 < 1.9.0 wrong. Missing
# fields count as 0, so "1.1" and "1.1.0" compare equal. Non-numeric junk in a
# field reads as 0 rather than erroring: this gates advice, and a version
# string mackas cannot parse must never be the reason a command refuses to run.
version_ge() {
	local a="$1" b="$2" i av bv
	for i in 1 2 3; do
		av="$(printf '%s' "$a" | cut -d. -f"$i" 2>/dev/null | tr -cd '0-9')"
		bv="$(printf '%s' "$b" | cut -d. -f"$i" 2>/dev/null | tr -cd '0-9')"
		av="${av:-0}"; bv="${bv:-0}"
		[ "$av" -gt "$bv" ] 2>/dev/null && return 0
		[ "$av" -lt "$bv" ] 2>/dev/null && return 1
	done
	return 0
}

# The bare dotted version out of `container --version`, which prints e.g.
# "container CLI version 1.1.0 (build: release, commit: unspeci)". Empty when
# it cannot be parsed -- callers must treat that as "unknown", never as "old".
container_version() {
	container --version 2>/dev/null | head -1 \
		| sed -n 's/.*[Vv]ersion \([0-9][0-9.]*\).*/\1/p' | head -1
}

# size_to_bytes SIZE -- SIZE ("1T", "500G", "800M", or a bare number meaning
# GiB) as an exact byte count, or 0 if it is not a size at all.
#
# Separate from size_to_gb() on purpose: that one rounds to whole GiB, which is
# right for budgeting against free space but wrong for resizing an image, where
# the byte count is what gets written into entity.json's "sizeInBytes" and what
# the image is truncated to. Powers of 1024 throughout, matching what the
# container daemon itself records (a 50G volume is 53687091200 bytes).
size_to_bytes() {
	local s="$1" num unit
	num="$(printf '%s' "$s" | sed 's/[^0-9].*$//')"
	unit="$(printf '%s' "$s" | sed 's/^[0-9]*//' | tr '[:upper:]' '[:lower:]')"
	[ -n "$num" ] || { echo 0; return; }
	case "$unit" in
		t|tb|tib)    echo $((num * 1024 * 1024 * 1024 * 1024)) ;;
		g|gb|gib|"") echo $((num * 1024 * 1024 * 1024)) ;;
		m|mb|mib)    echo $((num * 1024 * 1024)) ;;
		*)           echo 0 ;;
	esac
}

# Combined GiB the three volumes can grow to. They are sparse, so this is the
# worst case, not what they cost today -- but it is exactly what has to fit on
# the SSD alongside Time Machine.
total_volume_gb() {
	echo $(( $(size_to_gb "$MACKAS_VOLUME_SIZE_TMP") \
		+ $(size_to_gb "$MACKAS_VOLUME_SIZE_DL") \
		+ $(size_to_gb "$MACKAS_VOLUME_SIZE_SSTATE") ))
}

# Same total, but for `status`'s post-hoc report: real cap (container daemon)
# for any of the three volumes that already exist, configured size for ones
# that don't yet -- same real-over-configured preference as status_volume(),
# so the total printed there matches the per-volume caps printed above it
# instead of silently reverting to what setup would create today.
status_total_cap_gb() {
	local tmp="$MACKAS_VOLUME_SIZE_TMP" dl="$MACKAS_VOLUME_SIZE_DL" \
		sstate="$MACKAS_VOLUME_SIZE_SSTATE" real
	if volume_exists "$MACKAS_VOL_TMP"; then
		real="$(volume_size "$MACKAS_VOL_TMP")"; [ -n "$real" ] && tmp="$real"
	fi
	if volume_exists "$MACKAS_VOL_DL"; then
		real="$(volume_size "$MACKAS_VOL_DL")"; [ -n "$real" ] && dl="$real"
	fi
	if volume_exists "$MACKAS_VOL_SSTATE"; then
		real="$(volume_size "$MACKAS_VOL_SSTATE")"; [ -n "$real" ] && sstate="$real"
	fi
	echo $(( $(size_to_gb "$tmp") + $(size_to_gb "$dl") + $(size_to_gb "$sstate") ))
}

# Nearest ancestor of $1 that actually exists. This is what decides whether
# we can mkdir $1 -- NOT the filesystem mount point, which can be far above
# it (e.g. /tmp/a/b's mount point is /System/Volumes/Data).
nearest_existing_dir() {
	local p="$1"
	while [ "$p" != "/" ] && [ ! -d "$p" ]; do
		p="$(dirname "$p")"
	done
	printf '%s' "$p"
}

volume_mount_point() {
	# Longest mounted filesystem prefix of $1 (works for not-yet-existing paths).
	local p="$1"
	while [ "$p" != "/" ] && [ ! -d "$p" ]; do
		p="$(dirname "$p")"
	done
	df -P "$p" 2>/dev/null | awk 'NR==2 {for (i=6;i<=NF;i++) printf "%s%s", $i, (i<NF?" ":"")}'
}

free_gb_for() {
	local p="$1" mp
	mp="$(volume_mount_point "$p")"
	[ -n "$mp" ] || { echo 0; return; }
	df -Pk "$mp" 2>/dev/null | awk 'NR==2 {print int($4/1024/1024)}'
}

# Empirical case-sensitivity probe in an existing writable directory.
# Returns 0 = case-sensitive, 1 = case-insensitive, 2 = could not test.
dir_is_case_sensitive() {
	local d="$1" t
	[ -d "$d" ] && [ -w "$d" ] || return 2
	t="$(mktemp -d "$d/.oecs.XXXXXX" 2>/dev/null)" || return 2
	: > "$t/casetest" 2>/dev/null || { rm -rf "$t"; return 2; }
	if [ -e "$t/CASETEST" ]; then
		rm -rf "$t"; return 1
	fi
	rm -rf "$t"; return 0
}

is_time_machine_dest() {
	local mp="$1"
	[ -e "$mp/backup_manifest.plist" ] && return 0
	tmutil destinationinfo 2>/dev/null | grep -qF "Mount Point   : $mp" && return 0
	return 1
}

# Does FILE have a [safe] directory = * entry? Deliberately a grep, not a
# full gitconfig INI parser -- it only ever needs to recognise the exact form
# setup_gitconfig() writes (and the exact form check/setup tell a user to add
# by hand), not arbitrary gitconfig syntax.
has_safe_directory_star() {
	local f="$1"
	[ -r "$f" ] || return 1
	grep -qE '^[[:space:]]*directory[[:space:]]*=[[:space:]]*\*[[:space:]]*$' "$f" 2>/dev/null
}

container_running() {
	container system status >/dev/null 2>&1 || return 1
	container system status 2>/dev/null | awk '$1=="status" {print $2}' | grep -q '^running$'
}

image_present() {
	container image ls 2>/dev/null | awk 'NR>1 {print $1":"$2}' | grep -qxF "$1"
}

# ensure_container_running -- the same container_running-then-start logic
# setup_runtime() (below) already has, reused by any command about to
# actually touch the runtime outside of 'setup' itself. The daemon does not
# survive a reboot; without this, the first real command after a fresh boot
# surfaces whatever raw error 'container'/'kas-container' produces trying to
# reach it, not a mackas-owned message (issue #33). Never called from
# status/check -- those stay read-only and short-circuit instead (see
# check_state()).
ensure_container_running() {
	container_running && return 0
	run container system start
	container_running || die "container system did not start" \
		"check by hand: container system status"
}

volume_exists() {
	container volume ls 2>/dev/null | awk 'NR>1 {print $1}' | grep -qxF "$1"
}

# require_runtime_for_volumes -- shared by every volume subcommand that would
# otherwise gate on volume_exists()/volume_in_use() (both backed by
# `container volume ls`/`container ls`, which return nothing useful when the
# daemon is simply down, not when the volume itself is absent). Mirrors
# ensure_container_running() being called directly from run_kas()/
# kas_shell_ro(): start the daemon first so a merely-stopped `container`
# reads as exactly that, not as a missing volume (issue #33). Never called
# from volume_list() -- that stays read-only and short-circuits instead, the
# same choice cmd_status/cmd_check already make for their own daemon-down
# case; and never from volume_recover(), which exists specifically to run
# BEFORE assuming a healthy daemon.
require_runtime_for_volumes() {
	ensure_container_running
}

# volume_dirty_bit NAME -- has the kernel ever recorded ext4 errors on NAME's
# volume.img? Host-side, read-only, no daemon and no e2fsprogs: ext4's
# superblock sits at a fixed byte offset inside the plain image file, so
# tools/mackas-ext4-dirty-bit (stdlib-only /usr/bin/python3) reads it
# straight off disk -- the one signal that still works while the container
# system is down, which is exactly when a post-crash volume needs it most.
# 0 clean, 1 dirty (the fix is '$SCRIPT_CMD volume fsck NAME'), 2 unknown
# (no python3, the image does not exist yet, or it is not readable) -- 2 is
# a bonus check quietly missing its answer, never a warning on its own: an
# optional host tool being absent is detected, not required, same as every
# other "prefer X, fall back silently" check in this project. Prints the
# tool's one-line message on stdout for status 1 (or 2, though callers
# generally ignore that); silent (and 2) when the image is simply absent.
volume_dirty_bit() {
	local name="$1" tool img
	tool="$SCRIPT_DIR/tools/mackas-ext4-dirty-bit"
	[ -x /usr/bin/python3 ] && [ -f "$tool" ] || return 2
	img="$CONTAINER_VOLUMES_DIR/$name/volume.img"
	[ -f "$img" ] || return 2
	/usr/bin/python3 "$tool" "$img"
}

# refuse_if_stale_entity NAME -- guard every 'container volume create' against
# a stale daemon index. Returns 0 if it is safe to proceed with create (no
# stale entry found). Returns 1 if NAME turned out to already exist once the
# daemon caught up -- the caller must NOT create it, only treat it as already
# there.
#
# Apple's container daemon (apiserver) scans volumes/*/entity.json into an
# in-memory index ONCE, at its own startup; 'container volume ls' / the
# existence check inside 'volume create' only ever consult that cached index
# afterwards, never the filesystem directly. So right after anything that
# changes what's on disk without the daemon knowing -- relocating
# CONTAINER_VOLUMES_DIR (setup_relocate_volumes), restoring a backup, or
# plugging in an external disk carried over from another Mac -- volume_exists
# can report false for a name whose entity.json is sitting right there on
# disk. Confirmed live: 'container volume create' does NOT refuse cleanly in
# that state. It reformats the EXISTING volume.img to a fresh, empty ext4
# filesystem FIRST, and only THEN errors with "entity already exists" --
# silently destroying whatever was in it. volume_exists() alone is therefore
# never sufficient license to create; call this immediately before every
# 'container volume create' as well.
#
# Restarting the daemon is what actually clears the stale index (a real,
# safe, mackas-issuable action, not a manual instruction) -- offer it instead
# of just refusing. See restart_container_daemon for why that is stop+start.
# Restart the container daemon so it re-reads volumes/*/entity.json.
#
# There is NO 'container system restart' subcommand. container 1.1.0 offers
# start/stop/status/df/dns/kernel/logs/property/version and nothing else
# (confirmed against `container system --help`), so the obvious spelling
# fails with: Error: Unexpected argument 'restart'. Shipped mackas called it
# in two places and it had never worked in either -- found by the opt-in
# tests/volume_resize_real.bats, which is exactly the class of bug a hermetic
# suite cannot see, because the fake `container` accepts whatever it is given.
#
# The stop is tolerant: "already stopped" is a fine state to start from, and
# failing there would abort the caller under set -e for no reason.
restart_container_daemon() {
	# A daemon stop kills EVERY running container, not just anything touching
	# the volume in hand. The one-VM checks callers make (volume_in_use) only
	# ask about one volume, so on their own they would happily restart the
	# daemon out from under an unrelated build -- hours of work, gone, with no
	# warning. Refuse instead, and name what is in the way.
	#
	# Two different risks, and they deserve different answers.
	#
	# A container holding one of the mackas volumes is a BUILD. Killing it
	# loses hours of work, and no prompt makes that a reasonable trade -- so
	# refuse outright, and fail CLOSED if the list cannot be read at all.
	#
	# Any OTHER running container is the user's to weigh. Apple's own
	# `buildkit` image-builder service is the common case here: it is
	# long-lived, holds no volume, and restarts on demand, so refusing
	# because it exists would make resize unusable on any Mac that has ever
	# run `container build`. Say what will be stopped and let them decide.
	local listing ids id detail holders="" others=0
	if ! listing="$(container ls 2>/dev/null)"; then
		die "cannot tell what is running, so refusing to restart the container daemon" \
			"check 'container system status'; a restart would stop every container"
	fi
	ids="$(printf '%s\n' "$listing" | awk 'NR>1 && NF {print $1}')"
	for id in $ids; do
		[ -n "$id" ] || continue
		if ! detail="$(container inspect "$id" 2>/dev/null)"; then
			die "cannot inspect running container '$id', so refusing to restart the daemon" \
				"a restart would stop it; investigate with 'container inspect $id'"
		fi
		if inspect_holds_volume "$detail" "$MACKAS_VOL_TMP" ||
		   inspect_holds_volume "$detail" "$MACKAS_VOL_DL" ||
		   inspect_holds_volume "$detail" "$MACKAS_VOL_SSTATE"; then
			holders="${holders:+$holders }$id"
		else
			others=$((others + 1))
		fi
	done

	if [ -n "$holders" ]; then
		warn "      Restarting the container daemon stops EVERY running container."
		warn "      These hold a mackas build volume, so they are a build in progress:"
		warn "        $holders"
		die "refusing to restart the container daemon while a build is running" \
			"wait for it to finish, then re-run -- '$SCRIPT_CMD volume list' shows what holds each volume"
	fi

	if [ "$others" -gt 0 ]; then
		warn "      Restarting the container daemon stops $others running container(s)"
		warn "      that hold no mackas volume (Apple's 'buildkit' builder is the usual one)."
		confirm "  Stop them and restart the daemon?" || {
			info "  Left unchanged."
			return 1
		}
	fi

	run container system stop >/dev/null 2>&1 || true
	run container system start
}

refuse_if_stale_entity() {
	local name="$1"
	local link="$CONTAINER_VOLUMES_DIR/$name"

	# A DANGLING per-volume symlink means this volume was relocated by
	# 'volume move' onto a drive that is not mounted right now -- not that it
	# is missing. The entity.json probe below cannot see that on its own: -e
	# follows symlinks, so it is false through a dangling one, and the guard
	# would report "safe to create" and let ensure_volume() run
	# 'container volume create' straight over the link. That silently orphans
	# whatever is on the absent drive (the symlink is the ONLY record of where
	# the volume lives -- see volume_real_dir) and hands back an empty volume,
	# which for sstate or downloads reads as a mysteriously cold cache.
	#
	# die() rather than confirm(): the fix mackas would offer -- discard the
	# link and create fresh -- is exactly the destructive one, and the two
	# non-destructive fixes (plug the drive in; re-point the link) are things
	# only the user can decide between. Failing closed here costs a re-run;
	# guessing costs a cache.
	if [ -L "$link" ] && [ ! -e "$link" ]; then
		local target; target="$(readlink "$link" 2>/dev/null || true)"
		warn "      volume '$name' was moved to: ${target:-<unreadable>}"
		warn "      That path does not resolve -- the drive holding it is not mounted."
		die "volume '$name' lives on a drive that is not currently mounted" \
			"plug the drive in and re-run, or '$SCRIPT_CMD volume recover $name' if it moved; to abandon that copy and start empty, remove $link first"
	fi

	[ -e "$link/entity.json" ] || return 0

	warn "      volume '$name' has on-disk data the container daemon's index doesn't know about."
	warn "      This is usually a stale index -- right after relocating"
	warn "      $CONTAINER_VOLUMES_DIR, or attaching a disk carried over from another Mac."
	if ! confirm "      Restart the container daemon now to pick it up?"; then
		die "volume '$name' has on-disk data the container daemon's index does not know about" \
			"restart it yourself, then re-run: container system stop && container system start"
	fi
	restart_container_daemon
	if [ "$DRY_RUN" -eq 1 ]; then
		info "      dry-run: assuming the restart would make '$name' visible"
		return 1
	fi
	if volume_exists "$name"; then
		did "container daemon restarted; '$name' is now recognized"
		return 1
	fi
	die "restarted the container daemon, but '$name' is still not recognized" \
		"investigate by hand: container system status; container volume ls; check $CONTAINER_VOLUMES_DIR/$name/entity.json"
}

# Remove one volume, tolerating both spellings of the subcommand and a volume
# that was already gone. Returns non-zero if the volume is still there.
#
# The report has to be conditional, and it did not used to be: the old form
# ended `|| warn "could not delete..."` and then said `did "removed volume"`
# on the next line unconditionally. warn returns 0, so a volume that both
# spellings failed to remove -- a busy one, typically -- was reported as
# removed anyway, immediately after the warning saying it was not. `destroy`
# then finished with a clean bill of health over a volume that survived.
delete_volume() {
	local name="$1"
	volume_exists "$name" || return 0

	# Where the image REALLY lives, read before anything is deleted. This has
	# to happen first: the per-volume symlink is the only record of a relocated
	# volume's location, and the daemon removes that symlink as part of the
	# delete (verified against container 1.1.0 -- it disappears, while the
	# directory it pointed at does not). Read it afterwards and there is
	# nothing left to read.
	local moved_to=""
	[ -L "$CONTAINER_VOLUMES_DIR/$name" ] && \
		moved_to="$(readlink "$CONTAINER_VOLUMES_DIR/$name" 2>/dev/null || true)"

	if run container volume delete "$name" || run container volume rm "$name"; then
		did "removed volume '$name'"
		# A prior 'volume move' plants a per-volume symlink at
		# $CONTAINER_VOLUMES_DIR/$name pointing at the volume's relocated
		# home (see setup_relocate_volumes()'s own comment on this). The
		# daemon-level delete above never touches it -- confirmed live: three
		# volumes, previously moved onto separate disks, were destroyed
		# (daemon shows them gone) yet the symlinks stayed behind, now
		# dangling at nonexistent paths. Clean it up at the source.
		# Belt and braces: on a runtime that leaves the symlink behind, clear
		# it so nothing is left dangling. container 1.1.0 removes it itself,
		# so this is normally a no-op.
		if [ -L "$CONTAINER_VOLUMES_DIR/$name" ]; then
			run rm -f "$CONTAINER_VOLUMES_DIR/$name"
			did "removed the now-dangling symlink at $CONTAINER_VOLUMES_DIR/$name"
		fi

		# The delete removes what the daemon knows about -- for a relocated
		# volume that is the symlink, NOT the image it pointed at. So
		# destroying a moved volume silently leaves its whole image behind on
		# the other drive: a "destroyed" 300 GB TMPDIR still costing 300 GB,
		# with nothing left referring to it to explain where the space went.
		# Verified live. Say so, and offer to finish the job.
		if [ -n "$moved_to" ] && [ -d "$moved_to" ]; then
			local left; left="$(du -sh "$moved_to" 2>/dev/null | awk '{print $1}')"
			warn "      '$name' lived on another drive, and the delete only removed the reference."
			warn "      Its image is still on disk${left:+ (${left})}:"
			warn "        $moved_to"
			if confirm "      Remove that leftover directory too?"; then
				run rm -rf "${moved_to:?}"
				did "removed the leftover image directory $moved_to"
			else
				warn "      Left in place. Remove it by hand when you are sure:"
				warn "        rm -rf $(quote_cmd "$moved_to")"
			fi
		fi
		return 0
	fi
	warn "could not delete volume '$name'; check what's using it: mackas volume list"
	return 1
}

# inspect_holds_volume DETAIL NAME -- true if `container inspect` output
# DETAIL (one container's JSON) has NAME as the mount block's  "name" : "..."
# key, NOT a bare substring of the whole JSON. A plain grep -qF "$name" over
# the entire inspect output false-positived on the IMAGE field: a volume
# named "kas" "matched" ghcr.io/siemens/kas/kas:5.5 in every running
# container, reporting a free volume as in use. Anchoring to the mount name
# key still fails CLOSED on a malformed inspect (nothing matches -> the
# caller's loop moves on), which is fine, but stops the false positive.
#
# NAME is regex-escaped before going into the ERE, so a volume name that
# happens to contain metacharacters (a dot, brackets, ...) cannot make the
# pattern match some other, similarly-spelled name.
inspect_holds_volume() {
	local detail="$1" name="$2" escaped
	escaped="$(printf '%s' "$name" | sed 's/[][\.^$*+?(){}|/]/\\&/g')"
	printf '%s\n' "$detail" | grep -qE "\"name\"[[:space:]]*:[[:space:]]*\"$escaped\""
}

# volume_in_use NAME -- true if a running container currently has volume NAME
# attached.
#
# The one-VM rule is a hard constraint, not a nicety: an ext4 image mounted by
# two VMs at once corrupts. `mackas retrieve` attaches oe-build-tmp to copy
# files out, so it must refuse while a build ('smoketest' or 'shell') still holds
# it rather than race the running kas container.
#
# There is no single `container` query for "who holds this volume", so this
# lists the RUNNING containers (`container ls` shows only those; the first
# column is the container ID) and inspects each with inspect_holds_volume().
# If the runtime is not up, nothing can hold it.
#
# The guard is UX, not the safety backstop. Virtualization.framework itself
# REFUSES a second attach of the same ext4 image outright --
#   VZErrorDomain Code=2 "The storage device attachment is invalid"
# -- so a missed guard yields an ugly error, not a corrupted build. We keep the
# guard anyway (a clear refusal beats a stack trace) and, on any query FAILURE,
# fail CLOSED: report the volume as in use rather than let a caller attach it a
# second time. A failing query must never read as "free" -- that would fail
# OPEN, the one outcome the guard exists to prevent.
volume_in_use() {
	local name="$1" ids id listing detail
	container_running || return 1
	if ! listing="$(container ls 2>/dev/null)"; then
		warn "could not query running containers; assuming volume '$name' is in use"
		return 0
	fi
	ids="$(printf '%s\n' "$listing" | awk 'NR>1 {print $1}')"
	for id in $ids; do
		[ -n "$id" ] || continue
		if ! detail="$(container inspect "$id" 2>/dev/null)"; then
			warn "could not inspect container '$id'; assuming volume '$name' is in use"
			return 0
		fi
		inspect_holds_volume "$detail" "$name" && return 0
	done
	return 1
}

# require_volumes_free CMDHINT -- one-VM rule: refuse if any of the three
# volumes kas_shell_ro()/kas_runtime_args() attaches is already held by a
# running container. CMDHINT is the "re-run '...'" command shown in the die
# message, so each caller keeps its own wording.
require_volumes_free() {
	local cmd_hint="$1" v
	for v in "$MACKAS_VOL_TMP" "$MACKAS_VOL_DL" "$MACKAS_VOL_SSTATE"; do
		if volume_in_use "$v"; then
			die "volume '$v' is attached to a running container" \
				"only ONE VM may touch an ext4 image at a time; stop the build first (mackas volume list), then re-run '$cmd_hint'"
		fi
	done
}

host_ip() {
	# Primary IPv4 on the default route's interface.
	local iface
	iface="$(route -n get default 2>/dev/null | awk '/interface:/ {print $2; exit}')"
	[ -n "$iface" ] && ipconfig getifaddr "$iface" 2>/dev/null && return 0
	ifconfig 2>/dev/null | awk '/inet /  && $2 != "127.0.0.1" {print $2; exit}'
}

# Is $1 (dotted IPv4) inside CIDR $2? Returns 0/1. Pure bash arithmetic.
ip_in_cidr() {
	local ip="$1" cidr="$2" net bits ipn netn mask
	case "$cidr" in *[!0-9./]*) return 1 ;; esac
	net="${cidr%%/*}"
	bits="${cidr#*/}"
	[ "$net" = "$cidr" ] && bits=32
	# A prefix length above 32 (or a non-numeric one) makes the mask shift by a
	# negative amount below -- undefined, and it silently "matched" before. An
	# IPv4 prefix is 0..32; refuse anything else rather than compute nonsense.
	case "$bits" in ""|*[!0-9]*) return 1 ;; esac
	[ "$bits" -le 32 ] || return 1
	ipn="$(ip_to_int "$ip")" || return 1
	netn="$(ip_to_int "$net")" || return 1
	[ "$bits" -eq 0 ] && return 0
	mask=$(( 0xFFFFFFFF << (32 - bits) & 0xFFFFFFFF ))
	[ $((ipn & mask)) -eq $((netn & mask)) ]
}

ip_to_int() {
	local o1 o2 o3 o4 o
	IFS=. read -r o1 o2 o3 o4 <<EOF
$1
EOF
	# Exactly four octets, each numeric and 0..255. The old check only rejected
	# non-digits, so "300.1.1.1" (or a three-octet "1.2.3") sailed through and
	# produced a bogus integer that then "matched" a CIDR it had no business in.
	for o in "$o1" "$o2" "$o3" "$o4"; do
		case "$o" in ""|*[!0-9]*) return 1 ;; esac
		[ "$o" -le 255 ] || return 1
	done
	echo $(( (o1 << 24) + (o2 << 16) + (o3 << 8) + o4 ))
}

resolved_docker() {
	command -v docker 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# Preflight checks
# ---------------------------------------------------------------------------

check_host() {
	hdr "1. Host"
	local osver major arch
	osver="$(sw_vers -productVersion 2>/dev/null || echo 0)"
	major="${osver%%.*}"
	arch="$(uname -m)"

	if [ "$major" -ge "$MACOS_MIN_MAJOR" ] 2>/dev/null; then
		ck_pass "macOS $osver (>= $MACOS_MIN_MAJOR)"
	else
		ck_fail "macOS $osver -- Apple 'container' needs macOS $MACOS_MIN_MAJOR or newer" \
			"upgrade macOS, or run the build on a Linux host instead"
	fi

	if [ "$arch" = "arm64" ]; then
		ck_pass "arch arm64 (Apple silicon)"
	else
		ck_fail "arch $arch -- Apple 'container' requires Apple silicon" \
			"no remediation on this machine; use a Linux/arm64 or x86_64 Docker host"
	fi

	local mem cores
	mem="$(host_mem_gb)"
	cores="$(host_cores)"
	ck_info "host: ${cores} physical cores, ${mem} GiB RAM"

	if [ "$mem" -lt 8 ]; then
		ck_warn "host RAM ${mem} GiB is below 8 GiB -- bitbake will thrash" \
			"reduce MACKAS_MEMORY and BB_NUMBER_THREADS, or build elsewhere"
	fi

	local want
	want="$(size_to_gb "$MACKAS_MEMORY")"
	if [ "$want" -gt "$mem" ]; then
		ck_fail "MACKAS_MEMORY=$MACKAS_MEMORY exceeds host RAM (${mem} GiB)" \
			"set MACKAS_MEMORY to at most $((mem * 3 / 4))g in $(config_hint)"
	elif [ "$want" -gt $((mem * 3 / 4)) ]; then
		ck_warn "MACKAS_MEMORY=$MACKAS_MEMORY is over 75% of host RAM (${mem} GiB); the host may swap" \
			"set MACKAS_MEMORY=$((mem * 2 / 3))g in $(config_hint)"
	else
		ck_pass "MACKAS_MEMORY=$MACKAS_MEMORY of ${mem} GiB host RAM"
	fi

	if [ "$MACKAS_CPUS" -gt "$cores" ]; then
		ck_warn "MACKAS_CPUS=$MACKAS_CPUS exceeds ${cores} physical cores" \
			"set MACKAS_CPUS=$((cores - 2)) in $(config_hint)"
	else
		ck_pass "MACKAS_CPUS=$MACKAS_CPUS of ${cores} physical cores (nproc inside will report $((MACKAS_CPUS + 1)))"
	fi
}

config_hint() {
	if [ -n "$CONFIG_FILE_USED" ]; then
		printf '%s' "$CONFIG_FILE_USED"
	else
		printf '%s' "$HOME/.mackas.conf"
	fi
}

check_container_runtime() {
	hdr "2. Apple container runtime"

	if [ -x /opt/homebrew/bin/brew ] || command -v brew >/dev/null 2>&1; then
		ck_pass "Homebrew present"
	else
		# shellcheck disable=SC2016  # literal text: this is a command we print
		# for the user to copy-paste, not one we run. $(...) must survive.
		ck_fail "Homebrew not found" \
			'/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"'
	fi

	if command -v container >/dev/null 2>&1; then
		local cver; cver="$(container_version)"
		if [ -z "$cver" ]; then
			# Unparseable is "unknown", never "too old": refusing on a version
			# string mackas cannot read would be worse than proceeding.
			ck_warn "container CLI present but its version could not be parsed: $(container --version 2>&1 | head -1)" \
				"tested against $CONTAINER_TESTED_VERSION; proceed with care"
		elif ! version_ge "$cver" "$CONTAINER_MIN_VERSION"; then
			ck_fail "container $cver is older than the minimum $CONTAINER_MIN_VERSION" \
				"brew upgrade container"
		elif version_ge "$cver" "$CONTAINER_TESTED_VERSION"; then
			ck_pass "container $cver (tested: $CONTAINER_TESTED_VERSION)"
		else
			ck_warn "container $cver is below the tested $CONTAINER_TESTED_VERSION" \
				"brew upgrade container -- mackas issues exact subcommands and that surface moves between releases"
		fi
	else
		ck_fail "'container' CLI not installed" "brew install container"
		return
	fi

	if container_running; then
		ck_pass "container system status = running"
	else
		ck_fail "container system is not running" "container system start"
	fi

	# The kernel has to be set once, or `container run` fails at boot. Probe it
	# by booting a throwaway container -- but ONLY if the image is already
	# pulled. Apple's `container run` auto-FETCHES a missing image (~1GB), and
	# `check` promises to change nothing, so probing with an absent image would
	# silently download the whole kas image on a fresh machine.
	if ! image_present "$KAS_IMAGE"; then
		ck_info "kernel not probed: $KAS_IMAGE not pulled yet (see check 8)"
		ck_info "if 'container run' later fails to boot: container system kernel set --recommended --force"
	elif container system status >/dev/null 2>&1 && \
	     container run --rm "$KAS_IMAGE" true >/dev/null 2>&1; then
		ck_pass "container kernel is usable (test container booted)"
	else
		ck_warn "could not boot a test container with $KAS_IMAGE" \
			"container system kernel set --recommended --force"
	fi
}

# Echo the path to a GNU realpath binary, or return 1. macOS's own /bin/realpath
# is BSD (no -e, no --relative-base -- the exact flags kas-container calls), and
# Homebrew's coreutils installs `grealpath` (g-prefixed), NOT an unprefixed
# `realpath`. Prefer grealpath, then coreutils' gnubin, then any `realpath` on
# PATH that turns out to be GNU. setup_shim_and_env() symlinks the result into
# MACKAS_BIN (first on env.sh PATH) so kas-container always finds it.
find_gnu_realpath() {
	local c p
	for c in grealpath "$(brew --prefix coreutils 2>/dev/null)/libexec/gnubin/realpath" realpath; do
		case "$c" in ''|/libexec/*) continue ;; esac   # empty brew prefix
		p="$(command -v "$c" 2>/dev/null || true)"
		[ -n "$p" ] && [ -x "$p" ] || continue
		if "$p" --version 2>/dev/null | head -1 | grep -q 'GNU coreutils'; then
			printf '%s\n' "$p"
			return 0
		fi
	done
	return 1
}

check_realpath() {
	hdr "3. Host utilities (BSD vs GNU)"
	# After setup the guaranteed answer is our own shim in MACKAS_BIN.
	if [ -x "$SHIM_DIR/realpath" ] &&
		"$SHIM_DIR/realpath" --version 2>/dev/null | head -1 | grep -q 'GNU coreutils'; then
		ck_pass "GNU realpath shim installed at $SHIM_DIR/realpath"
		return
	fi
	local gnu
	if gnu="$(find_gnu_realpath)"; then
		if "$gnu" --relative-base=/tmp /tmp/x >/dev/null 2>&1; then
			ck_pass "GNU realpath at $gnu ('$SCRIPT_CMD setup' will shim it as $SHIM_DIR/realpath)"
		else
			ck_fail "$gnu is GNU coreutils but rejects --relative-base; kas-container will fail" \
				"brew upgrade coreutils"
		fi
	else
		ck_fail "no GNU realpath found -- macOS's BSD realpath lacks -e/--relative-base, so kas-container cannot run" \
			"brew install coreutils"
	fi

	# The other half of the same problem, and the one that bites the other way
	# round. mackas needs GNU realpath (above) but BSD everything-else, because
	# it calls macOS-specific flags directly:
	#
	#   stat -f '%Lp' / '%u' / '%Su:%Sg'   BSD format strings. GNU stat's -f
	#                                      means "display FILESYSTEM status" --
	#                                      a completely different command that
	#                                      silently answers the wrong question.
	#   cp -c                              macOS clonefile (copy-on-write), what
	#                                      makes 'volume duplicate' near-free.
	#                                      GNU cp has no -c at all.
	#
	# `brew install coreutils` with the gnubin PATH shim is the normal way to
	# get GNU realpath, and it is exactly what puts GNU stat/cp ahead of the
	# BSD ones -- so the fix for one requirement is the break for the other.
	# Worth reporting rather than leaving to be discovered mid-build.
	local u path flavour
	for u in stat cp; do
		path="$(command -v "$u" 2>/dev/null)"
		if [ -z "$path" ]; then
			ck_fail "no '$u' on PATH" "this is a base macOS tool; check your PATH"
			continue
		fi
		if "$u" --version 2>/dev/null | head -1 | grep -q 'GNU coreutils'; then
			flavour="GNU"
		else
			flavour="BSD"
		fi
		if [ "$flavour" = "BSD" ]; then
			ck_pass "$u is BSD ($path)"
		else
			ck_fail "$u is GNU ($path), but mackas needs the BSD one" \
				"remove the coreutils gnubin dir from PATH (GNU realpath is found by path, not by shadowing $u)"
		fi
	done

	# Informational: mackas only ever calls readlink with no flags, which BSD
	# and GNU agree on, so either is fine. Reported because a GNU one here is
	# the tell-tale that a gnubin PATH shim is active, which is what breaks
	# stat/cp above.
	path="$(command -v readlink 2>/dev/null)"
	if [ -n "$path" ] && readlink --version 2>/dev/null | head -1 | grep -q 'GNU coreutils'; then
		ck_info "readlink is GNU ($path) -- harmless (mackas uses it flagless), but it means a gnubin PATH shim is active"
	fi
}

check_docker_shim() {
	hdr "4. docker shim resolution (classic footgun)"
	local d ver installed=0
	d="$(resolved_docker)"

	if [ -x "$SHIM_DIR/docker" ]; then
		ck_pass "shim installed at $SHIM_DIR/docker"
		installed=1
	elif [ -x "$SCRIPT_DIR/bin/docker" ]; then
		ck_info "shim source present at $SCRIPT_DIR/bin/docker; '$SCRIPT_CMD setup' installs it to $SHIM_DIR"
	else
		ck_fail "shim not found at $SCRIPT_DIR/bin/docker" \
			"re-clone the mackas repo; the shim ships with this script"
	fi

	if [ -z "$d" ]; then
		ck_fail "no 'docker' on PATH -- kas-container v5.5 selects its engine by finding one" \
			"source $(printf '%q' "$MACKAS_ENV_SH")   (run '$SCRIPT_CMD setup' first if it doesn't exist)"
		return
	fi

	ck_info "command -v docker -> $d"
	ver="$(docker -v 2>&1 | head -1 || true)"
	ck_info "docker -v -> $ver"

	# Report the whole resolution order; this is exactly where people lose
	# an afternoon.
	local all
	all="$( (type -a docker 2>/dev/null || true) | sed 's/^/           /' || true)"
	if [ -n "$all" ]; then
		printf '  %s[info]%s resolution order:\n%s\n' "$C_DIM" "$C_RST" "$all"
	fi

	case "$d" in
		"$SHIM_DIR/docker"|"$SCRIPT_DIR/bin/docker")
			ck_pass "'docker' resolves to our shim"
			;;
		*)
			# Before setup runs there is nothing to put on PATH, so this is
			# expected rather than broken. It only becomes a FAIL once the
			# shim exists and PATH still doesn't pick it up.
			if [ "$installed" -eq 1 ]; then
				ck_fail "'docker' resolves to $d, NOT our shim -- kas would drive real Docker instead of Apple container" \
					"source $(printf '%q' "$MACKAS_ENV_SH")   # puts $SHIM_DIR ahead of /usr/local/bin"
			else
				ck_warn "'docker' resolves to $d (the real Docker CLI); the shim isn't installed yet" \
					"$SCRIPT_CMD setup, then: source $(printf '%q' "$MACKAS_ENV_SH")"
			fi
			;;
	esac

	case "$ver" in
		Docker*) ck_pass "docker -v output starts with 'Docker' (kas-container's engine grep matches)" ;;
		*) ck_fail "docker -v does not start with 'Docker'; kas-container will not select it" \
			"use the shim: export PATH=\"$SHIM_DIR:\$PATH\"" ;;
	esac
}

check_target_volume() {
	hdr "5. Build volume: ${MACKAS_ROOT:-<not set>}"
	if [ -z "$MACKAS_ROOT" ]; then
		ck_warn "MACKAS_ROOT is not set; commands fall back to the current directory ($PWD)"
		ck_info "OE needs a case-sensitive filesystem, which a stock Mac home is not; for a real build point MACKAS_ROOT at one:"
		root_hint | sed 's/^/         /'
		return
	fi
	local mp
	mp="$(volume_mount_point "$MACKAS_ROOT")"
	ck_info "filesystem: $mp"

	if [ ! -d "$mp" ]; then
		ck_fail "$mp is not mounted" "plug in / mount the drive, then re-run '$SCRIPT_CMD check'"
		return
	fi

	# --- writable?
	if [ -d "$MACKAS_ROOT" ] && [ -w "$MACKAS_ROOT" ]; then
		ck_pass "$MACKAS_ROOT exists and is writable"
	elif [ -d "$MACKAS_ROOT" ]; then
		ck_fail "$MACKAS_ROOT exists but is not writable by $(id -un)" \
			"sudo chown $(id -un):$(id -gn) $(printf '%q' "$MACKAS_ROOT")"
	elif [ -w "$(nearest_existing_dir "$MACKAS_ROOT")" ]; then
		ck_info "$MACKAS_ROOT does not exist yet; $(nearest_existing_dir "$MACKAS_ROOT") is writable, 'setup' will create it"
	else
		ck_warn "$MACKAS_ROOT does not exist and $(nearest_existing_dir "$MACKAS_ROOT") is not writable by $(id -un)" \
			"sudo mkdir -p $(printf '%q' "$MACKAS_ROOT") && sudo chown $(id -un):$(id -gn) $(printf '%q' "$MACKAS_ROOT")   ('$SCRIPT_CMD setup' will offer to run this)"
	fi

	# --- case sensitivity, probed empirically (never by parsing diskutil)
	local probe rc
	probe=""
	if [ -d "$MACKAS_ROOT" ] && [ -w "$MACKAS_ROOT" ]; then
		probe="$MACKAS_ROOT"
	elif [ -w "$mp" ]; then
		probe="$mp"
	fi
	if [ -n "$probe" ]; then
		set +e; dir_is_case_sensitive "$probe"; rc=$?; set -e
		case "$rc" in
			0) ck_pass "case-sensitive filesystem (probed by creating files in $probe)" ;;
			1) ck_fail "case-INSENSITIVE filesystem -- OpenEmbedded will fail in confusing ways" \
				"use a case-sensitive volume; reformat with: diskutil apfs addVolume <disk> 'Case-sensitive APFS' oe" ;;
			*) ck_warn "could not probe case sensitivity in $probe" "re-run once $MACKAS_ROOT is writable" ;;
		esac
	else
		# Can't write anywhere on it yet; fall back to diskutil and say so.
		#
		# `|| true` on the assignment: under set -e -o pipefail, a failing
		# diskutil (permission issue, disk unmounted mid-check) fails the
		# WHOLE pipeline even though awk itself never sees a problem, and an
		# unguarded `var="$(cmd | other)"` assignment aborts check_target_
		# volume -- and so all of `mackas check` -- right here instead of
		# falling through to the "unknown" fs handling four lines down, which
		# is what this is actually supposed to do.
		local fs
		fs="$(diskutil info "$mp" 2>/dev/null | awk -F': *' '/File System Personality/ {print $2}')" || true
		if printf '%s' "$fs" | grep -qi 'case-sensitive'; then
			ck_warn "cannot probe empirically (nothing writable yet); diskutil reports: $fs" \
				"re-run '$SCRIPT_CMD check' after 'setup' creates $MACKAS_ROOT to confirm empirically"
		else
			ck_fail "cannot probe empirically; diskutil reports: ${fs:-unknown} -- OE needs case-sensitive" \
				"verify with a case-sensitive volume before building"
		fi
	fi

	# --- the workspace image, if one is configured. Reported right here
	# because it is the answer to the rung above: a case-insensitive root is
	# fine PROVIDED the image is attached at work/, and a detached one turns
	# that pass back into a failure. `check` never mounts anything -- it is the
	# command you run to find out what is wrong -- so this only looks.
	if [ -n "${MACKAS_WORKSPACE_IMAGE:-}" ]; then
		local wst
		set +e; workspace_is_attached; wst=$?; set -e
		case "$wst" in
			0) ck_pass "workspace image attached: $MACKAS_ROOT/work -> $(readlink "$MACKAS_ROOT/work" 2>/dev/null || printf '%s' "$MACKAS_ROOT/work") (from $MACKAS_WORKSPACE_IMAGE)" ;;
			2) ck_fail "something is mounted at $MACKAS_ROOT/work, but it is not the workspace image (no $WORKSPACE_SENTINEL at its root)" \
				"unmount it ('mount | grep work'); builds refuse to run until $MACKAS_ROOT/work is the recorded image" ;;
			*)
				if [ -f "$MACKAS_WORKSPACE_IMAGE" ]; then
					ck_fail "workspace image $MACKAS_WORKSPACE_IMAGE is NOT attached -- $MACKAS_ROOT/work is a plain, case-insensitive directory" \
						"a reboot unmounts it; '$SCRIPT_CMD setup' (or any build command) reattaches it, or by hand: hdiutil attach $(printf '%q' "$MACKAS_WORKSPACE_IMAGE") -nobrowse"
				else
					ck_fail "workspace image is recorded as $MACKAS_WORKSPACE_IMAGE, but no such file exists" \
						"'$SCRIPT_CMD volume recover' finds it with Spotlight and offers to move it back; '$SCRIPT_CMD unset MACKAS_WORKSPACE_IMAGE' if you no longer use an image"
				fi
				;;
		esac
	fi

	# --- fstrim/discard reclaim: informational, never fatal. The three ext4
	# volumes work regardless of this -- they just cannot SHRINK back below
	# their peak usage on a filesystem that does not support it. mackas
	# relocates container's volume storage (CONTAINER_VOLUMES_DIR) under
	# MACKAS_ROOT, so every volume.img physically lives on $mp, and $mp is
	# what Apple's Virtualization.framework actually needs hole-punch support
	# from to advertise DISCARD to the guest -- see docs/storage.md.
	#
	# Measured live, not assumed: a completely fresh volume on an ExFAT
	# MACKAS_ROOT fails 'fstrim' identically to a heavily-used one, so this
	# tracks the filesystem, not anything mackas or a specific volume did.
	# Detected by name, not empirically probed -- an actual probe would mean
	# pulling the kas image and booting a VM just for `check`, which is a
	# multi-minute cost on a cold image cache for a purely informational
	# result. APFS is the only filesystem measured to work; anything else is
	# flagged, not assumed broken, since it has not been measured either way.
	# `|| true`: see the identical note on the case-sensitivity fallback's
	# diskutil call above -- under pipefail a failing diskutil would abort
	# check_target_volume outright instead of falling through to the
	# "could not determine" case below.
	local fs_disc
	fs_disc="$(diskutil info "$mp" 2>/dev/null | awk -F': *' '/File System Personality/ {print $2}')" || true
	case "$fs_disc" in
		*[Aa][Pp][Ff][Ss]*)
			ck_pass "filesystem ($fs_disc) -- 'volume fstrim' should be able to reclaim space"
			;;
		"")
			ck_info "could not determine $mp's filesystem type; 'volume fstrim' reclaim unverified"
			;;
		*)
			ck_warn "filesystem ($fs_disc) is not APFS -- 'volume fstrim' may not be able to reclaim space" \
				"harmless if the volumes never need to shrink; if disk space on $mp is tight, lower MACKAS_VOLUME_SIZE_TMP/_DL/_SSTATE in $(config_hint) instead of relying on fstrim to reclaim it later"
			;;
	esac

	# --- free space
	local free need total
	free="$(free_gb_for "$MACKAS_ROOT")"
	total="$(total_volume_gb)"
	need=$(( total + MACKAS_FREE_SPACE_MARGIN_GB ))
	local sizes="tmp $MACKAS_VOLUME_SIZE_TMP + dl $MACKAS_VOLUME_SIZE_DL + sstate $MACKAS_VOLUME_SIZE_SSTATE = ${total} GiB"
	if [ "$free" -ge "$need" ]; then
		ck_pass "free space ${free} GiB >= ${need} GiB ($sizes, + ${MACKAS_FREE_SPACE_MARGIN_GB} GiB margin)"
	else
		ck_fail "free space ${free} GiB < ${need} GiB needed ($sizes, + ${MACKAS_FREE_SPACE_MARGIN_GB} GiB margin)" \
			"free space on $mp, or lower MACKAS_VOLUME_SIZE_TMP/_DL/_SSTATE in $(config_hint)"
	fi

	# --- Time Machine
	if is_time_machine_dest "$mp"; then
		ck_warn "$mp is an ACTIVE Time Machine destination"
		printf '         %s%s%s\n' "$C_YEL" "Time Machine and this build share ${free} GiB of free space." "$C_RST"
		printf '         %s%s%s\n' "$C_YEL" "If the build fills the disk, backups stop working (and TM will start" "$C_RST"
		printf '         %s%s%s\n' "$C_YEL" "thinning old snapshots to make room -- you lose backup history)." "$C_RST"
		printf '         %sfix:%s FIXED-size ext4 volumes (%s GiB total) cap the damage, which is\n' "$C_BLU" "$C_RST" "$(total_volume_gb)"
		printf '              why this setup uses them, and the generated kas fragment halts the\n'
		printf '              build on low free space inside each. Alternatively point TM elsewhere:\n'
		printf '              tmutil removedestination <ID>   # see: tmutil destinationinfo\n'
	else
		ck_pass "$mp is not a Time Machine destination"
	fi
}

check_short_link() {
	hdr "6. Short path / AF_UNIX socket limit / spaces"
	local sock_host sock_short len_host len_short

	sock_host="$MACKAS_ROOT/build/bitbake.sock"
	sock_short="$MACKAS_SHORT_LINK/build/bitbake.sock"
	len_host=${#sock_host}
	len_short=${#sock_short}

	ck_info "host TOPDIR socket path would be: $sock_host (${len_host} chars)"

	if [ "$len_host" -gt 104 ]; then
		ck_warn "host-side path is ${len_host} chars, over the ~104 char macOS sockaddr_un limit (kas issue #38)" \
			"use the short symlink: MACKAS_SHORT_LINK=$MACKAS_SHORT_LINK (setup creates it)"
	else
		ck_pass "host-side socket path ${len_host} chars, under the ~104 char sockaddr_un limit"
	fi

	# Inside the container, TOPDIR is /build, so the socket bind actually
	# happens in the Linux guest at /build/bitbake.sock. Say so, because it
	# is the reason this is a WARN and not a FAIL.
	ck_info "in-container TOPDIR is /build -> bind path is /build/bitbake.sock (19 chars); the"
	ck_info "  104-char limit only bites if you ever run bitbake natively on the host"

	case "$MACKAS_ROOT" in
		*" "*)
			if [ -L "$MACKAS_SHORT_LINK" ]; then
				ck_pass "MACKAS_ROOT contains spaces, but MACKAS_SHORT_LINK=$MACKAS_SHORT_LINK exists and is used instead"
			else
				ck_warn "MACKAS_ROOT contains spaces ('$MACKAS_ROOT'); some OE/bitbake recipes mishandle them" \
					"'$SCRIPT_CMD setup' creates $MACKAS_SHORT_LINK -> $MACKAS_ROOT and uses that"
			fi
			;;
		*) ck_pass "MACKAS_ROOT has no spaces" ;;
	esac

	if [ -L "$MACKAS_SHORT_LINK" ]; then
		local tgt
		tgt="$(readlink "$MACKAS_SHORT_LINK")"
		# same_dir, not a bare string compare: also passes a link that reaches
		# MACKAS_ROOT through ANOTHER symlink rather than directly.
		if same_dir "$MACKAS_SHORT_LINK" "$MACKAS_ROOT"; then
			ck_pass "short link $MACKAS_SHORT_LINK -> $MACKAS_ROOT (${len_short} chars for the socket path)"
		else
			ck_fail "short link $MACKAS_SHORT_LINK points at '$tgt', not '$MACKAS_ROOT'" \
				"rm $(printf '%q' "$MACKAS_SHORT_LINK") && $SCRIPT_CMD setup"
		fi
	elif [ -e "$MACKAS_SHORT_LINK" ]; then
		ck_fail "$MACKAS_SHORT_LINK exists and is not a symlink" \
			"move it aside, then run '$SCRIPT_CMD setup'"
	else
		ck_info "short link $MACKAS_SHORT_LINK not created yet ('$SCRIPT_CMD setup' will create it)"
		case "$MACKAS_SHORT_LINK" in
			/opt/*)
				if [ ! -w "$(dirname "$MACKAS_SHORT_LINK")" ]; then
					ck_info "  note: $(dirname "$MACKAS_SHORT_LINK") is root-owned; creating the link needs sudo"
				fi
				;;
		esac
	fi
}

check_network() {
	hdr "7. Network"
	# ghcr.io/v2/ answers 401 when unauthenticated -- any HTTP status back at
	# all proves reachability, so test the status, not curl's exit code.
	local code
	code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 https://ghcr.io/v2/ 2>/dev/null)" || code="000"
	if [ "$code" != "000" ]; then
		ck_pass "ghcr.io reachable (HTTP $code; needed to pull $KAS_IMAGE)"
	else
		ck_fail "cannot reach ghcr.io" \
			"check your network/proxy; kas-container honours http_proxy/https_proxy"
	fi

	if [ "$MACKAS_USE_HTTP_MIRRORS" = "1" ]; then
		# A HEAD against the mirror root. mackas-mirrord serves no listing by
		# default, so 404 is the EXPECTED healthy answer -- it proves the
		# daemon is up and answering. 401 means it wants credentials (put them
		# in ~/.netrc); 403 means this host is not in its --allow list. Only
		# 000 (no answer at all) is a failure.
		local mcode
		# NB: on failure curl still prints '000' to stdout AND exits nonzero,
		# so a '|| echo 000' fallback would yield '000\n000' -- which is not
		# equal to '000' and would sail past the check as a pass. Override the
		# variable instead of appending to it.
		mcode="$(curl -s -o /dev/null -I -w '%{http_code}' --max-time 10 "$MACKAS_HTTP_MIRROR_SSTATE/" 2>/dev/null)" || mcode="000"
		case "$mcode" in
			000) ck_fail "HTTP sstate mirror $MACKAS_HTTP_MIRROR_SSTATE not answering" \
					"start mackas-mirrord on the mirror host (see mirror-server/ and README.md), or set MACKAS_USE_HTTP_MIRRORS=0 in $(config_hint)" ;;
			401) ck_info "HTTP sstate mirror answers 401 (auth required); put the credentials in ~/.netrc and export NETRC_FILE" ;;
			403) ck_info "HTTP sstate mirror answers 403; this host's IP is probably not in the daemon's --allow list" ;;
			*)   ck_pass "HTTP sstate mirror reachable ($MACKAS_HTTP_MIRROR_SSTATE, HTTP $mcode)" ;;
		esac
	fi

	if [ "$MACKAS_USE_NFS_MIRRORS" != "1" ]; then
		if [ "$MACKAS_USE_HTTP_MIRRORS" != "1" ]; then
			ck_info "no mirrors enabled -- this is fine, mackas builds from upstream with no mirror at all. Optionally set MACKAS_USE_HTTP_MIRRORS=1 in $(config_hint) to reuse a mirror host's sstate + downloads caches over HTTP instead (see mirror-server/)"
		fi
		return
	fi

	local ip
	ip="$(host_ip)"
	ck_info "this host's primary IP: ${ip:-unknown}"

	if ping -c1 -t3 "$MACKAS_NFS_SERVER" >/dev/null 2>&1; then
		ck_pass "$MACKAS_NFS_SERVER reachable"
	else
		ck_fail "$MACKAS_NFS_SERVER not reachable" \
			"check DNS/mDNS and the host; or set MACKAS_USE_NFS_MIRRORS=0 in $(config_hint)"
		return
	fi

	local exports acl
	exports="$(showmount -e "$MACKAS_NFS_SERVER" 2>/dev/null || true)"
	if [ -z "$exports" ]; then
		ck_fail "showmount -e $MACKAS_NFS_SERVER returned nothing" \
			"is nfsd running on $MACKAS_NFS_SERVER? ssh $MACKAS_NFS_SERVER 'systemctl status nfs-server'"
		return
	fi
	acl="$(printf '%s\n' "$exports" | awk -v e="$MACKAS_NFS_EXPORT" '$1==e {$1=""; print}')"
	if [ -z "$acl" ]; then
		ck_fail "$MACKAS_NFS_SERVER does not export $MACKAS_NFS_EXPORT" \
			"add it to /etc/exports on $MACKAS_NFS_SERVER, then: ssh $MACKAS_NFS_SERVER sudo exportfs -ra"
		return
	fi
	ck_pass "$MACKAS_NFS_SERVER exports $MACKAS_NFS_EXPORT to:$acl"

	# Is our IP inside any of the CIDRs in the ACL?
	local tok matched=0
	if [ -n "$ip" ]; then
		for tok in $acl; do
			# strip trailing "(opts)"
			tok="${tok%%(*}"
			case "$tok" in
				*:*) continue ;;   # IPv6, skip
				"") continue ;;
			esac
			if ip_in_cidr "$ip" "$tok"; then matched=1; break; fi
		done
		if [ "$matched" -eq 1 ]; then
			ck_pass "$ip is inside the export ACL"
		else
			ck_fail "$ip is NOT inside the export ACL for $MACKAS_NFS_EXPORT" \
				"on $MACKAS_NFS_SERVER add this host's subnet to /etc/exports, then sudo exportfs -ra"
		fi
	fi

	if mount | grep -qF " on $MACKAS_NFS_MOUNT "; then
		ck_pass "NFS already mounted at $MACKAS_NFS_MOUNT"
	else
		ck_info "NFS not mounted yet. macOS needs sudo and (almost always) -o resvport:"
		ck_info "  sudo mkdir -p $(printf '%q' "$MACKAS_NFS_MOUNT")"
		ck_info "  sudo mount -t nfs -o resvport,vers=3,ro,nolocks,locallocks ${MACKAS_NFS_SERVER}:${MACKAS_NFS_EXPORT} $(printf '%q' "$MACKAS_NFS_MOUNT")"
		ck_info "  vers=3 is PINNED deliberately: '-o vers=4' kernel-panics macOS (see docs/storage.md)"
		ck_info "  ('$SCRIPT_CMD setup' will offer to run this)"
	fi
}

# Report one ext4 volume: is it there, what does it cost, and -- the bit that
# actually bites -- who owns its root. A fresh volume's root is root:root, and
# kas drops to USER_ID/GROUP_ID before touching it, so an unchowned volume
# fails with EACCES on /build/CACHEDIR.TAG. `setup` chowns; this verifies it.
check_one_volume() {
	local name="$1" size="$2" role="$3" img owner want

	if ! volume_exists "$name"; then
		ck_info "volume '$name' not created yet ($role; will be ${size} ext4)"
		return
	fi

	img="$CONTAINER_VOLUMES_DIR/$name/volume.img"
	if [ -e "$img" ]; then
		ck_pass "volume '$name' exists ($role, ${size} cap, $(du -h "$img" 2>/dev/null | awk '{print $1}') on disk)"
	else
		ck_pass "volume '$name' exists ($role, ${size} cap)"
	fi

	# Needs a booted container to see real Linux ownership; skip rather than
	# guess if the runtime isn't up or the image isn't pulled.
	container_running || return 0
	image_present "$KAS_IMAGE" || return 0

	# Attaching the volume to probe ownership would be a SECOND attach while a
	# build still holds it. Don't: report it and move on rather than warn
	# "could not read the ownership" (misleading) or fight the one-VM rule.
	if volume_in_use "$name"; then
		ck_info "volume '$name' is attached to a running build; skipping the ownership probe"
		return 0
	fi

	want="$(id -u):$(id -g)"
	owner="$(container run --rm -v "$name:/mnt" "$KAS_IMAGE" \
		stat -c '%u:%g' /mnt 2>/dev/null | tr -d '\r')" || owner=""
	if [ -z "$owner" ]; then
		ck_warn "could not read the ownership of volume '$name'" \
			"container run --rm -v $(printf '%q' "$name:/mnt") $KAS_IMAGE stat -c '%u:%g' /mnt"
	elif [ "$owner" = "$want" ]; then
		ck_pass "volume '$name' root is owned by $owner (kas drops to $want and can write it)"
	else
		ck_fail "volume '$name' root is owned by $owner, not $want -- kas will fail with EACCES on /build/CACHEDIR.TAG" \
			"container run --rm -u 0:0 -v $(printf '%q' "$name:/mnt") $KAS_IMAGE chown $want /mnt   ('$SCRIPT_CMD setup' does this)"
	fi
}

# check_volume_dirty_bit NAME -- ck_fail if volume_dirty_bit says NAME's
# volume.img has ext4 errors on record; silent otherwise (clean, not
# created yet, or the check itself is unavailable -- see volume_dirty_bit's
# own comment for why 2 is never a warning). Deliberately NOT gated behind
# container_running: this is the one check in this whole rung that still
# works with the daemon down, so it runs unconditionally, before that gate.
check_volume_dirty_bit() {
	local name="$1" dbout dbrc=0 suffix=""
	dbout="$(volume_dirty_bit "$name")" || dbrc=$?
	[ "$dbrc" -eq 1 ] || return 0
	case "$dbout" in
		*"$name/volume.img"*) suffix="${dbout#*"$name/volume.img"}" ;;
		*) suffix=": $dbout" ;;
	esac
	ck_fail "volume '$name' has ext4 errors recorded on disk$suffix" \
		"$SCRIPT_CMD volume fsck $name"
}

check_state() {
	hdr "8. Existing state (idempotency)"

	# Host-side, no daemon needed (see volume_dirty_bit's own comment) --
	# runs regardless of container_running below, unlike everything else in
	# this rung. This is exactly the check that would have caught the crash
	# this feature was built for, the moment it happened, before the next
	# build ever hit the corrupted directory entry.
	check_volume_dirty_bit "$MACKAS_VOL_TMP"
	check_volume_dirty_bit "$MACKAS_VOL_DL"
	check_volume_dirty_bit "$MACKAS_VOL_SSTATE"

	# Every probe below (image_present, check_one_volume's volume_exists,
	# find_orphaned_volume_images, the legacy-volume volume_exists) asks the
	# daemon, not the filesystem -- 'container volume ls'/'image ls' return
	# nothing when it's not running, which used to read as "not present" /
	# "orphaned" for state that is actually fine, just unreachable (issue
	# #33). check_host() (rung 2) already ck_fail's the daemon-down state
	# itself, so this is ck_info, not a second WARN/FAIL for the same root
	# cause -- just the explanation for why this rung has nothing further to
	# say. One clear line instead of a cascade of misleading per-item
	# findings; the disk-only checks below (relocate symlink, wrapper
	# sha256, stray build dir) are unaffected and still run.
	if ! container_running; then
		ck_info "container system is not running -- image/volume existence cannot be checked this way; everything below this point is UNKNOWN, not necessarily absent"
	else
		if image_present "$KAS_IMAGE"; then
			ck_pass "image $KAS_IMAGE already pulled"
		else
			ck_info "image $KAS_IMAGE not pulled yet ('$SCRIPT_CMD setup' will pull it)"
		fi

		check_one_volume "$MACKAS_VOL_TMP"    "$MACKAS_VOLUME_SIZE_TMP"    "TMPDIR -> /build"
		check_one_volume "$MACKAS_VOL_DL"     "$MACKAS_VOLUME_SIZE_DL"     "DL_DIR -> /downloads"
		check_one_volume "$MACKAS_VOL_SSTATE" "$MACKAS_VOLUME_SIZE_SSTATE" "SSTATE_DIR -> /sstate"

		# Images left behind on another drive by destroying a relocated volume.
		# Nothing points at them any more, so nothing else would ever mention them.
		local orphans orphan n_orph
		orphans="$(find_orphaned_volume_images 2>/dev/null)"
		if [ -n "$orphans" ]; then
			n_orph="$(printf '%s\n' "$orphans" | grep -c .)"
			ck_warn "$n_orph orphaned volume image(s): on disk, but no volume refers to them" \
				"these are what a destroyed RELOCATED volume leaves behind; remove any you do not want"
			printf '%s\n' "$orphans" | while IFS= read -r orphan; do
				[ -n "$orphan" ] || continue
				printf '         %s%s%s (%s)\n' "$C_DIM" "$orphan" "$C_RST" \
					"$(du -sh "$orphan" 2>/dev/null | awk '{print $1}')"
			done
		fi

		# A volume from before the split into three. It is not used any more, and a
		# stale 200G image is exactly the thing this disk cannot spare.
		if volume_exists "$MACKAS_VOL_LEGACY"; then
			ck_warn "volume '$MACKAS_VOL_LEGACY' is left over from the old single-volume scheme and is NOT used" \
				"container volume delete $(printf '%q' "$MACKAS_VOL_LEGACY")   # after checking you want nothing in it"
		fi
	fi

	if [ "$MACKAS_RELOCATE_VOLUMES" = "1" ]; then
		if [ -L "$CONTAINER_VOLUMES_DIR" ]; then
			ck_pass "container volumes dir relocated: $CONTAINER_VOLUMES_DIR -> $(readlink "$CONTAINER_VOLUMES_DIR")"
		else
			ck_info "container volumes dir still on the internal disk ($CONTAINER_VOLUMES_DIR)"
			ck_info "  MACKAS_RELOCATE_VOLUMES=1: 'setup' will symlink it onto $MACKAS_ROOT"
		fi
	fi

	# Report the .real / wrapper split correctly, not just "is something
	# executable at KAS_CONTAINER_BIN" -- that alone can't tell a real
	# protection wrapper apart from the raw upstream script sitting at the
	# same path (see write_kas_wrapper()/setup_kas_container()). Query
	# --version against KAS_CONTAINER_REAL, never the wrapper: the wrapper
	# shells out to `$SCRIPT_CMD runtime-args` before handing off, which is
	# pointless overhead for a version check and the wrong semantics besides.
	if [ -x "$KAS_CONTAINER_REAL" ] && [ -x "$KAS_CONTAINER_BIN" ]; then
		local wrapper_sum
		wrapper_sum="$(shasum -a 256 "$KAS_CONTAINER_BIN" | awk '{print $1}')"
		if [ "$wrapper_sum" = "$KAS_CONTAINER_SHA256" ]; then
			# The single most important check in this whole rung: the wrapper
			# file at KAS_CONTAINER_BIN matches the PINNED UPSTREAM sha256,
			# meaning it is not a wrapper at all any more -- something
			# overwrote the protection wrapper with the raw upstream script.
			# Everything else can be installed correctly and this still
			# silently reopens the bypass write_kas_wrapper() exists to close.
			ck_fail "the protection wrapper at $KAS_CONTAINER_BIN has been overwritten with the raw upstream kas-container script (its sha256 matches the pinned upstream sha256, not a generated wrapper) -- \$PATH-resolved kas-container calls now bypass mackas entirely, with no volumes, no limits, no auto-appended fragment" \
				"$SCRIPT_CMD setup   # regenerates the wrapper from the verified .real copy"
		else
			ck_pass "kas-container present: $("$KAS_CONTAINER_REAL" --version 2>&1 | head -1)"
		fi
	elif [ -x "$KAS_CONTAINER_REAL" ]; then
		# .real is verified and installed, but the wrapper $PATH actually
		# resolves 'kas-container' to is missing or not executable -- this is
		# the exact condition under which a nohup'd or $PATH-resolved build
		# runs unprotected again (the whole point of this split).
		ck_fail "kas-container.real is installed and verified, but the protection wrapper at $KAS_CONTAINER_BIN is missing (or not executable) -- nohup/\$PATH-resolved kas-container invocations run unprotected again: no volumes, no limits, no auto-appended fragment" \
			"$SCRIPT_CMD setup   # regenerates the wrapper"
	else
		ck_info "kas-container not installed yet -> $KAS_CONTAINER_BIN"
	fi

	# A correctly-invoked mackas build never creates a bare "build" directory
	# directly under the work dir -- volumes are attached via --runtime-args
	# and KAS_BUILD_DIR/DL_DIR/SSTATE_DIR stay unset (see AGENTS.md invariant
	# 2). If kas ever ran here with none of that wired up -- exactly what
	# happens when $PATH resolves 'kas-container' straight to KAS_CONTAINER_REAL
	# instead of the protection wrapper -- kas falls back to its own default
	# and creates $MACKAS_WORK/build. Its mere existence is proof-positive
	# that an unprotected build ran at some point (the kas-container bypass,
	# issue #27), even if the wrapper is correctly in place right now. This
	# rung only reports it -- 'check' changes nothing on disk, ever.
	if [ -d "$MACKAS_WORK/build" ]; then
		ck_warn "$MACKAS_WORK/build exists -- a correctly-invoked mackas build never creates this directory, so its mere presence is proof an unprotected \$PATH-resolved kas-container build ran at some point (the kas-container bypass, issue #27)" \
			"rm -rf $(printf '%q' "$MACKAS_WORK/build")"
	fi

	if [ -z "$MACKAS_PROJECT_URL" ]; then
		ck_info "no project configured -- 'setup' skips the checkout step until MACKAS_PROJECT_URL is set"
		ck_info "  set MACKAS_PROJECT_URL/_BRANCH/_DIR in $(config_hint) (see mackas.conf.example), then re-run setup"
	elif [ -d "$MACKAS_PROJECT/.git" ]; then
		local br
		# symbolic-ref, not rev-parse --abbrev-ref: see setup_project's own
		# comment -- the latter prints the literal "HEAD" on a detached
		# checkout instead of empty, which would falsely ck_warn about an
		# adopted, intentionally-detached (no recorded branch) project.
		br="$(git -C "$MACKAS_PROJECT" symbolic-ref --short -q HEAD 2>/dev/null || true)"
		if [ "$br" = "$MACKAS_PROJECT_BRANCH" ]; then
			ck_pass "project checked out at $MACKAS_PROJECT (branch ${br:-<none: detached HEAD>})"
		else
			ck_warn "project at $MACKAS_PROJECT is on branch '$br', wanted '$MACKAS_PROJECT_BRANCH'" \
				"git -C $(printf '%q' "$MACKAS_PROJECT") checkout $MACKAS_PROJECT_BRANCH"
		fi
	else
		ck_info "project not cloned yet -> $MACKAS_PROJECT (branch $MACKAS_PROJECT_BRANCH from $MACKAS_PROJECT_URL)"
	fi

	if [ -f "$MACKAS_ENV_SH" ]; then
		ck_pass "env.sh present: source $MACKAS_ENV_SH"
	else
		ck_info "env.sh not written yet -> $MACKAS_ENV_SH"
	fi
}

# See setup_gitconfig() for the full story: without this, git inside the
# container refuses /repo with "detected dubious ownership", and kas's
# get_root_path() silently falls back to the wrong directory instead of
# failing loudly -- which is what made this THE blocker to track down.
check_gitconfig() {
	hdr "9. git 'dubious ownership' workaround (GITCONFIG_FILE / safe.directory)"

	if [ -n "${GITCONFIG_FILE:-}" ] && [ "$GITCONFIG_FILE" != "$MACKAS_GITCONFIG" ]; then
		if [ -r "$GITCONFIG_FILE" ] && has_safe_directory_star "$GITCONFIG_FILE"; then
			ck_pass "your own GITCONFIG_FILE=$GITCONFIG_FILE already has safe.directory = *"
		else
			ck_warn "GITCONFIG_FILE=$GITCONFIG_FILE is set (yours) but has no 'safe.directory = *' -- git inside the container will refuse /repo with 'dubious ownership'" \
				"add [safe] / directory = * to $GITCONFIG_FILE by hand (mackas will not touch a GITCONFIG_FILE you set yourself)"
		fi
		return
	fi

	if [ -f "$MACKAS_GITCONFIG" ]; then
		if has_safe_directory_star "$MACKAS_GITCONFIG"; then
			ck_pass "gitconfig present: $MACKAS_GITCONFIG (safe.directory = *)"
		else
			ck_fail "gitconfig present at $MACKAS_GITCONFIG but missing safe.directory = *" \
				"$SCRIPT_CMD setup"
		fi
	else
		ck_info "gitconfig not written yet -> $MACKAS_GITCONFIG ('$SCRIPT_CMD setup' will create it)"
	fi
}

check_usage() {
	cat <<EOF
${C_BLD}$SCRIPT_CMD check${C_RST} -- preflight only. Changes nothing. ${C_BLD}This is the
default${C_RST} when no command is given.

${C_BLD}USAGE${C_RST}
  $SCRIPT_CMD check

Runs every preflight probe -- host OS/arch/RAM, the Apple container runtime,
GNU realpath, the docker->container shim, the build volume (case-sensitivity,
free space, Time Machine), the short-path/socket limit, network reachability,
existing state (idempotency), and the git dubious-ownership workaround -- and
prints a pass/warn/fail summary. Exits non-zero on any FAIL.

Options: --dry-run, -y/--yes (or -f/--force) and -v/--verbose work here too,
though check reads only and never prompts, so none of them change anything.
EOF
}

cmd_check() {
	info "${C_BLD}mackas preflight${C_RST}  (config: ${CONFIG_FILE_USED:-none, using built-in defaults})"
	check_host
	check_container_runtime
	check_realpath
	check_docker_shim
	check_target_volume
	check_short_link
	check_network
	check_state
	check_gitconfig

	hdr "Summary"
	printf '  %s%d pass%s, %s%d warn%s, %s%d fail%s\n' \
		"$C_GRN" "$N_PASS" "$C_RST" "$C_YEL" "$N_WARN" "$C_RST" "$C_RED" "$N_FAIL" "$C_RST"
	if [ "$N_FAIL" -gt 0 ]; then
		info "  Fix the FAILs above, then re-run: $SCRIPT_CMD check"
		return 1
	fi
	if [ "$N_WARN" -gt 0 ]; then
		info "  Warnings are non-fatal. When you're happy: $SCRIPT_CMD setup"
	else
		info "  All good. Next: $SCRIPT_CMD setup"
	fi
	return 0
}

# ---------------------------------------------------------------------------
# Setup
# ---------------------------------------------------------------------------
STEP=0
STEP_TOTAL=11

step() {
	STEP=$((STEP + 1))
	printf '\n%s[%d/%d] %s%s\n' "$C_BLD" "$STEP" "$STEP_TOTAL" "$*" "$C_RST"
}

skip() { printf '      %s* already done: %s%s\n' "$C_DIM" "$*" "$C_RST"; }
did()  { printf '      %s+ %s%s\n' "$C_GRN" "$*" "$C_RST"; }

# Run a slow, OPAQUE command with a live elapsed-time spinner, so a multi-second
# step (a container VM boot, an mkfs) never looks hung. It is honestly NOT a
# percentage bar or an ETA: these operations stream no progress, and faking one
# would be worse than none -- so this shows the truth, elapsed seconds ticking.
# For a real byte-copy where the total IS known (the relocate rsync in
# setup_relocate_volumes), rsync's own --info=progress2 shows a genuine bar +
# ETA instead -- that is where a real percentage belongs.
#
# On a non-TTY (piped, CI, `nohup smoketest`) or under --dry-run it degrades to a
# plain run(), so output stays identical where nobody is watching a terminal.
# Usage: spin "label" command args...   (command output is shown only on failure)
spin() {
	local label="$1"; shift
	if [ "$DRY_RUN" -eq 1 ] || [ ! -t 1 ]; then
		run "$@"
		return
	fi
	local out; out="$(mktemp "${TMPDIR:-/tmp}/mackas-spin.XXXXXX")" || { run "$@"; return; }
	"$@" >"$out" 2>&1 &
	local pid=$! i=0 start=$SECONDS el idx rc=0 fr='|/-\'
	while kill -0 "$pid" 2>/dev/null; do
		el=$((SECONDS - start)); idx=$((i % 4))
		printf '\r      %s%s%s %s  %d:%02d ' \
			"$C_DIM" "${fr:idx:1}" "$C_RST" "$label" "$((el / 60))" "$((el % 60))"
		i=$((i + 1)); sleep 0.2
	done
	wait "$pid" || rc=$?
	printf '\r\033[K'          # wipe the spinner line; the caller's did() records the result
	if [ "$rc" -ne 0 ]; then
		err "      $label failed:"
		cat "$out" >&2
	fi
	rm -f "$out"
	return "$rc"
}

setup_runtime() {
	step "Apple container runtime"
	if ! command -v container >/dev/null 2>&1; then
		die "'container' is not installed" "brew install container && $SCRIPT_CMD setup"
	fi
	skip "$(container --version 2>&1 | head -1)"
	if container_running; then
		skip "container system is running"
	else
		run container system start
		did "started container system"
	fi
}

setup_oe_root() {
	step "Build root: $MACKAS_ROOT"
	if [ -d "$MACKAS_ROOT" ] && [ -w "$MACKAS_ROOT" ]; then
		skip "$MACKAS_ROOT exists and is writable"
	elif [ -d "$MACKAS_ROOT" ]; then
		info "      $MACKAS_ROOT exists but is owned by $(stat -f '%Su:%Sg' "$MACKAS_ROOT")"
		if confirm "      Take ownership with sudo?"; then
			run_sudo chown "$(id -un):$(id -gn)" "$MACKAS_ROOT"
			did "chowned $MACKAS_ROOT"
		else
			die "$MACKAS_ROOT is not writable" \
				"sudo chown $(id -un):$(id -gn) $(printf '%q' "$MACKAS_ROOT")"
		fi
	else
		local parent
		parent="$(nearest_existing_dir "$MACKAS_ROOT")"
		if [ -w "$parent" ]; then
			run mkdir -p "$MACKAS_ROOT"
			did "created $MACKAS_ROOT"
		else
			info "      $parent is not writable by $(id -un); creating $MACKAS_ROOT needs sudo."
			if confirm "      Run the sudo mkdir + chown now?"; then
				run_sudo mkdir -p "$MACKAS_ROOT"
				run_sudo chown "$(id -un):$(id -gn)" "$MACKAS_ROOT"
				did "created and chowned $MACKAS_ROOT"
			else
				die "cannot create $MACKAS_ROOT without sudo" \
					"sudo mkdir -p $(printf '%q' "$MACKAS_ROOT") && sudo chown $(id -un):$(id -gn) $(printf '%q' "$MACKAS_ROOT")"
			fi
		fi
	fi

	# No build/downloads/sstate here: those three live in ext4 volumes, not on
	# APFS. See kas_runtime_args().
	local d
	for d in bin kas logs; do
		if [ -d "$MACKAS_ROOT/$d" ]; then
			skip "$MACKAS_ROOT/$d"
		else
			run mkdir -p "$MACKAS_ROOT/$d"
			did "created $MACKAS_ROOT/$d"
		fi
	done

	# work/ gets its own handling: a workspace image (below) makes it a
	# SYMLINK to wherever hdiutil mounted it, and hdiutil attach does not
	# survive a reboot -- the sparse image is still on disk, but the mount
	# point the symlink names is gone. `-d` alone can't tell "never set up"
	# apart from "set up, just not mounted right now" (both read as false),
	# so check -L first: a dangling symlink means reattach, not mkdir over it
	# -- mkdir on a path that is already a (broken) symlink fails confusingly
	# rather than just working.
	if [ -d "$MACKAS_ROOT/work" ]; then
		skip "$MACKAS_ROOT/work"
	elif [ -L "$MACKAS_ROOT/work" ]; then
		reattach_dangling_workspace_symlink
	else
		run mkdir -p "$MACKAS_ROOT/work"
		did "created $MACKAS_ROOT/work"
	fi

	# Only `work/` (KAS_WORK_DIR, the layer checkouts) needs to be
	# case-sensitive -- bin/kas/logs do not care. Probe work/ itself, not
	# MACKAS_ROOT: once a workspace image (below) is mounted there, work/ is
	# case-sensitive even though MACKAS_ROOT's own filesystem never changes.
	if [ "$MACKAS_REQUIRE_CASE_SENSITIVE" = "1" ]; then
		local cs; set +e; dir_is_case_sensitive "$MACKAS_ROOT/work"; cs=$?; set -e
		case "$cs" in
		1)	offer_workspace_image ;;
		2)	warn "      could not verify $MACKAS_ROOT/work is case-sensitive; if a build fails oddly, run '$SCRIPT_CMD check'" ;;
		esac
	fi
}

# workspace_image_base -- the sparse image's path, WITHOUT the .sparseimage
# suffix hdiutil appends on create. Callers needing the actual file add it.
workspace_image_base() { printf '%s/workspace' "$MACKAS_ROOT"; }

# offer_workspace_image -- work/ just failed the case-sensitivity probe.
# Rather than die outright (the old behaviour, still what happens on
# decline), offer a case-sensitive APFS sparse image mounted AT work/ --
# see TODO item 18 for why this shape and not a 4th ext4 volume: it reuses
# the exact virtiofs bind-mount mackas already does for /repo, so work/
# stays host-native (git, bitbake -e keep working from macOS) and needs no
# container-volume machinery. Spiked and confirmed this session: a real git
# commit of case-colliding filenames round-trips correctly through a
# container backed by exactly this mechanism.
# attach_workspace_image IMG -- attach IMG and echo its real mount point.
#
# Deliberately does NOT use `hdiutil attach -mountpoint work/`. Found live:
# `-mountpoint` onto a directory that itself lives on a non-APFS host volume
# (confirmed: ExFAT) fails with "insufficient privileges" even though the
# SAME image attaches fine either with no -mountpoint at all, or with
# -mountpoint onto the boot (APFS) volume. Attaching plain (default
# /Volumes/<name>) is universally reliable regardless of what MACKAS_ROOT
# itself sits on, so that is the only path this uses -- work/ becomes a
# SYMLINK to the real mount point instead, exactly the idiom volume_move/
# volume_recover already use for ext4 volumes ("the symlink is the record").
# A fixed -volname can collide (two workspace images, or a stale leftover
# mount) and hdiutil silently uniquifies it (`mackas-workspace 2`), so the
# real reported path is parsed from hdiutil's own output, never assumed.
attach_workspace_image() {
	local img="$1" out rc=0 mp
	if [ "$DRY_RUN" -eq 1 ]; then
		# Unlike run(), this function's STDOUT is a value the caller captures
		# via command substitution (the mount point), not console text -- so
		# the dry-run notice, unlike run()'s own, has to go to stderr, or it
		# would be captured right along with the path it precedes.
		printf '%s+ hdiutil attach %s -nobrowse%s\n' "$C_DIM" "$(printf '%q' "$img")" "$C_RST" >&2
		printf '/Volumes/mackas-workspace\n'
		return 0
	fi
	vrb "+ hdiutil attach $(printf '%q' "$img") -nobrowse"
	out="$(hdiutil attach "$img" -nobrowse 2>&1)" || rc=$?
	if [ "$rc" -ne 0 ]; then
		printf '%s\n' "$out" >&2
		return "$rc"
	fi
	# hdiutil's table output: the mounted filesystem's line ends in the real
	# path (the EFI/partition-scheme lines above it have no such column).
	mp="$(printf '%s\n' "$out" | grep -E '/Volumes/' | awk '{print $NF}' | tail -1)"
	[ -n "$mp" ] || return 1
	printf '%s\n' "$mp"
}

# path_device PATH -- the st_dev of PATH, or nothing (and non-zero) if it
# cannot be stat'ed. -L follows symlinks deliberately: work/ IS a symlink to
# the mount point whenever an image is attached, and BSD stat reports the
# LINK's own device without it -- i.e. always MACKAS_ROOT's, which would make
# the mounted case indistinguishable from the unmounted one.
#
# Factored out of workspace_is_attached() so the guard's decision table can be
# exercised without a real hdiutil mount (a hermetic test cannot conjure a
# second filesystem); tests override this one line, not the logic above it.
path_device() { stat -L -f '%d' "$1" 2>/dev/null || return 1; }

# workspace_is_attached -- is $MACKAS_ROOT/work our workspace image, right now?
#
#   0  yes: a different filesystem than MACKAS_ROOT, carrying our sentinel
#   1  no: same filesystem (so nothing is mounted), or work/ is missing or a
#      dangling symlink -- all "attach it"
#   2  SOMETHING is mounted there, but it is not ours (no sentinel) -- neither
#      "attached" nor safely "attach over it"; the caller must refuse
#
# Deliberately host-native and cheap (two stats and a test -f, no hdiutil, no
# `mount` parsing): this runs on the way into every build, and `mount`'s
# output is the wrong tool anyway -- macOS reports /private/var-style resolved
# paths that a literal comparison against MACKAS_ROOT gets wrong.
workspace_is_attached() {
	local work="$MACKAS_ROOT/work" dev_work dev_root
	dev_work="$(path_device "$work")" || return 1
	dev_root="$(path_device "$MACKAS_ROOT")" || return 1
	[ "$dev_work" != "$dev_root" ] || return 1
	[ -f "$work/$WORKSPACE_SENTINEL" ] || return 2
	return 0
}

# write_workspace_sentinel MP -- drop WORKSPACE_SENTINEL at the root of a
# freshly mounted workspace image, unless it is already there (an image
# created by an earlier mackas gets one on its next reattach).
#
# Not run(): run() cannot carry a redirection, and this needs to write a file,
# so it does its own --dry-run branch the way attach_workspace_image does.
#
# A failure here is fatal on purpose. The sentinel is load-bearing -- without
# it the NEXT invocation sees a mount it cannot identify and refuses to build
# (case 2 above) -- so a mount we cannot write to is not a working workspace,
# and saying so now beats a baffling refusal tomorrow.
write_workspace_sentinel() {
	local mp="$1" f="$1/$WORKSPACE_SENTINEL"
	# The DRY_RUN branch must come BEFORE the "already there" check, not
	# after: under --dry-run, attach_workspace_image() always returns the
	# same fixed placeholder mount point ('/Volumes/mackas-workspace',
	# regardless of what this invocation would really mount), so checking
	# that path for a real file means checking whatever ELSE happens to be
	# mounted there on THIS Mac right now -- unrelated host state, not
	# anything about the operation being simulated. Found live: a real
	# workspace image already mounted under that same volume name made a
	# --dry-run silently skip printing this line entirely.
	if [ "$DRY_RUN" -eq 1 ]; then
		printf '%s+ (write %s)%s\n' "$C_DIM" "$(printf '%q' "$f")" "$C_RST"
		return 0
	fi
	[ -f "$f" ] && return 0
	vrb "+ (write $(printf '%q' "$f"))"
	printf '%s\n' "mackas workspace image -- do not delete: this file is how mackas tells its own case-sensitive workspace mount apart from any other volume mounted at work/. See docs/storage.md." >"$f" \
		|| die "cannot write $f -- the workspace image mounted at $mp is not writable" \
			"check the mount ('hdiutil info'); a read-only attach cannot hold the layer checkouts anyway"
}

# record_workspace_image IMG -- persist MACKAS_WORKSPACE_IMAGE=IMG.
#
# Called only from the create/reattach paths, i.e. only after the user already
# said yes to this image. It is not separately confirm()ed on purpose: an
# image created but never recorded is precisely the silent-corruption hole the
# knob exists to close (the next reboot leaves work/ a bare directory nothing
# is guarding), so "yes, mount this at work/" has to include "and remember
# that you did".
#
# Writes to whatever config file this invocation loaded, or -- nothing loaded,
# the common first-run case -- creates the same $HOME/.mackas.conf that
# `mackas set` would. The file is named in the output either way, since this
# is the one place setup touches the user's config.
record_workspace_image() {
	local img="$1" file
	[ "${MACKAS_WORKSPACE_IMAGE:-}" = "$img" ] && return 0
	MACKAS_WORKSPACE_IMAGE="$img"
	file="$(set_target_config_file)"
	if [ "$DRY_RUN" -eq 1 ]; then
		printf '%s+ (record MACKAS_WORKSPACE_IMAGE=%s in %s)%s\n' \
			"$C_DIM" "$(printf '%q' "$img")" "$(printf '%q' "$file")" "$C_RST"
		return 0
	fi
	config_write_setting "$file" MACKAS_WORKSPACE_IMAGE "$img"
	did "recorded MACKAS_WORKSPACE_IMAGE=$img in $file (so every later run reattaches it)"
}

# reattach_workspace_image IMG -- attach an EXISTING workspace image and
# (re)point $MACKAS_ROOT/work at wherever it mounts. Shared by
# offer_workspace_image's reattach branch, reattach_dangling_workspace_symlink
# below and ensure_workspace_attached's post-reboot path -- all the same "the
# Mac rebooted" situation reached from different starting states (a
# case-insensitive work/, a dangling symlink, a plain empty directory).
#
# The rm -rf is safe because every caller has already established that work/
# is nothing but a stale pointer -- a dangling symlink, an empty directory, or
# a directory whose contents were moved aside first. Nothing here decides that
# for itself.
reattach_workspace_image() {
	local img="$1" mp
	mp="$(attach_workspace_image "$img")" \
		|| die "hdiutil attach failed for $img" "check 'hdiutil info' and 'hdiutil imageinfo $(printf '%q' "$img")'"
	if [ -e "$MACKAS_ROOT/work" ] || [ -L "$MACKAS_ROOT/work" ]; then
		run rm -rf "$MACKAS_ROOT/work"
	fi
	run ln -s "$mp" "$MACKAS_ROOT/work"
	write_workspace_sentinel "$mp"
	record_workspace_image "$img"
	did "reattached workspace image at $MACKAS_ROOT/work -> $mp"
}

# workspace_unpushed_work_line -- item 19 phase 4. A reboot only unmounts the
# workspace image (attach_workspace_image/ensure_workspace_attached handle
# that); it never destroys it. The one thing genuinely at risk if the image
# itself were ever lost is uncommitted or unpushed work inside it -- a clean,
# pushed layer costs nothing to lose (git clone restores it). Pure reporting,
# no new state: iterate the git repos one level under work/, count dirty
# (git status --porcelain) and ahead-of-upstream (git log @{u}.., tolerating
# no upstream configured), and print one line only when N > 0. Silent when no
# image is configured or the image is not currently attached (nothing safe to
# inspect -- a plain, unmounted work/ is not the checkouts).
workspace_unpushed_work_line() {
	[ -n "${MACKAS_WORKSPACE_IMAGE:-}" ] || return 0
	local wst
	set +e; workspace_is_attached; wst=$?; set -e
	[ "$wst" -eq 0 ] || return 0

	local d n=0 dirty ahead
	for d in "$MACKAS_ROOT"/work/*/; do
		[ -d "${d}.git" ] || continue
		dirty="$(git -C "$d" status --porcelain 2>/dev/null | head -1)" || dirty=""
		# '|| ahead=""': git log fails outright with no upstream configured
		# (the common case for a layer nobody has pushed a branch for yet) --
		# tolerated, per this function's own contract, not a real error. A
		# bare assignment here would trip this script's own set -e/pipefail
		# on that failure before the tolerant fallback below ever ran.
		ahead="$(git -C "$d" log '@{u}..' --oneline 2>/dev/null | head -1)" || ahead=""
		{ [ -n "$dirty" ] || [ -n "$ahead" ]; } && n=$((n + 1))
	done
	[ "$n" -gt 0 ] || return 0
	info ""
	warn "  $n layer(s) have uncommitted or unpushed work inside the workspace image."
	warn "  'git push' is the real backup -- this line is a nudge, not a snapshot."
}

# ensure_workspace_attached -- the fail-closed guard, called on the way into
# anything that touches work/ (run_kas, and the build commands ahead of their
# own "is the project checked out?" tests).
#
# Same idempotency shape as ensure_volume(): do nothing when the state is
# already right, make it right when it is not, die with a remediation when it
# cannot be made right. What makes this one different is that "cannot" must
# never degrade into "carry on": work/ unmounted is not an empty workspace,
# it is a case-INSENSITIVE directory on the host drive, and kas cloning
# oe-core into it corrupts the checkout in ways that surface much later as
# unexplainable git errors. Refusing to build is strictly better.
ensure_workspace_attached() {
	# No image configured is the normal case (a genuinely case-sensitive
	# MACKAS_ROOT), and it must cost nothing. No root configured means
	# require_mackas_root() already had its say.
	[ -n "${MACKAS_WORKSPACE_IMAGE:-}" ] || return 0
	[ -n "${MACKAS_ROOT:-}" ] || return 0

	local work="$MACKAS_ROOT/work" st
	set +e; workspace_is_attached; st=$?; set -e
	case "$st" in
	0)	vrb "workspace image already attached at $work"
		return 0 ;;
	2)	die "$work is a mount point, but not the mackas workspace image -- no $WORKSPACE_SENTINEL at its root" \
			"unmount whatever is there ('mount | grep work'), then re-run; if that mount IS your workspace image (created before mackas recorded a sentinel), adopt it with: touch $(printf '%q' "$work/$WORKSPACE_SENTINEL")" ;;
	esac

	# From here on work/ is NOT a mount, and a build must not be allowed to
	# use it as-is.
	[ -f "$MACKAS_WORKSPACE_IMAGE" ] || die \
		"workspace image $MACKAS_WORKSPACE_IMAGE does not exist, so $work cannot be made case-sensitive" \
		"mount the drive it lives on, or find it with: mdfind -name $(printf '%q' "$(basename "$MACKAS_WORKSPACE_IMAGE")")   (then move it back to that path, or '$SCRIPT_CMD unset MACKAS_WORKSPACE_IMAGE' if you no longer use an image)"

	# A NON-EMPTY plain directory at work/ is the damage case, not a stale
	# pointer: something already wrote layer checkouts onto the underlying
	# case-insensitive drive while the image was detached. Deleting it to make
	# room for the symlink would throw away whatever that is, so stop and let
	# a human look -- offer_workspace_image() is the code that knows how to
	# move such a directory aside and copy it onto the image, and it only runs
	# under `setup`, where the user is expecting exactly that.
	if [ ! -L "$work" ] && [ -d "$work" ] && [ -n "$(ls -A "$work" 2>/dev/null)" ]; then
		die "$work is a non-empty directory on $(volume_mount_point "$MACKAS_ROOT"), but the workspace image $MACKAS_WORKSPACE_IMAGE is not attached -- its contents were written to a CASE-INSENSITIVE filesystem and may already be corrupt" \
			"move it aside (mv $(printf '%q' "$work") $(printf '%q' "$work.bad")) and run '$SCRIPT_CMD setup', which reattaches the image and can copy a checkout back onto it"
	fi

	# The ordinary post-reboot state: work/ is a dangling symlink (or gone).
	# Reattaching is not a decision the user needs to confirm -- it restores
	# the state they already configured, changes nothing on disk, and is
	# undone by a reboot anyway.
	info "workspace image is not attached (a reboot unmounts it) -- reattaching $MACKAS_WORKSPACE_IMAGE"
	reattach_workspace_image "$MACKAS_WORKSPACE_IMAGE"
}

# reattach_dangling_workspace_symlink -- setup_oe_root() found work/ as a
# symlink whose target no longer exists. hdiutil attach does not persist
# across a reboot, so this is almost always just "the Mac restarted since
# the last build" rather than anything actually wrong; offer to reattach the
# still-on-disk image rather than dying on what looks like a plain missing
# directory.
reattach_dangling_workspace_symlink() {
	local base img
	base="$(workspace_image_base)"
	img="${base}.sparseimage"
	if [ ! -f "$img" ]; then
		die "$MACKAS_ROOT/work is a dangling symlink (-> $(readlink "$MACKAS_ROOT/work" 2>/dev/null)), and no workspace image exists at $img to reattach" \
			"investigate by hand: readlink $(printf '%q' "$MACKAS_ROOT/work")"
	fi
	confirm "      work/ points at a workspace image that is no longer mounted (a reboot unmounts it) -- reattach $img?" \
		|| die "$MACKAS_ROOT/work is a dangling symlink to an unmounted workspace image" \
			"reattach by hand: hdiutil attach $(printf '%q' "$img") -nobrowse   (then symlink $(printf '%q' "$MACKAS_ROOT/work") to the mount point it reports)"
	reattach_workspace_image "$img"
}

offer_workspace_image() {
	local base img
	base="$(workspace_image_base)"
	img="${base}.sparseimage"

	if [ -f "$img" ]; then
		# A previous run already created one; hdiutil attach is NOT
		# persistent across a reboot, so the common case here is just "the
		# Mac restarted" -- offer to reattach, not recreate.
		if ! confirm "      work/ is case-insensitive, but a workspace image already exists at $img -- reattach it?"; then
			die "$MACKAS_ROOT/work is on a CASE-INSENSITIVE filesystem -- OpenEmbedded will fail in confusing ways (the oe-core checkout corrupts)" \
				"reattach the existing workspace: hdiutil attach $(printf '%q' "$img") -nobrowse   (then symlink $(printf '%q' "$MACKAS_ROOT/work") to the mount point it reports)"
		fi
		reattach_workspace_image "$img"
	else
		if ! confirm "      work/ is case-insensitive -- create a case-sensitive workspace image and mount it at $MACKAS_ROOT/work?"; then
			die "$MACKAS_ROOT/work is on a CASE-INSENSITIVE filesystem -- OpenEmbedded will fail in confusing ways (the oe-core checkout corrupts)" \
				"point MACKAS_ROOT at a case-sensitive volume ('$SCRIPT_CMD check' shows how), or set MACKAS_REQUIRE_CASE_SENSITIVE=0 if the case-sensitive parts live elsewhere"
		fi

		# work/ may already hold a real checkout (mackas predates this gate,
		# or the user hand-created it before ever running setup). Mounting
		# an image AT work/ would just shadow that content, not merge with
		# it, so move it aside first and copy it BACK onto the fresh image
		# once mounted -- preserving every layer's git remote, branch and
		# any uncommitted work exactly as-is (a plain file copy of a git
		# repo is a perfect copy; there is nothing "git-aware" to do here).
		local preserved="" stash=""
		if [ -n "$(ls -A "$MACKAS_ROOT/work" 2>/dev/null)" ]; then
			stash="$MACKAS_ROOT/work.pre-workspace-$(date +%Y%m%d-%H%M%S)"
			run mv "$MACKAS_ROOT/work" "$stash"
			preserved="$stash"
			did "moved the existing work/ aside to $stash (will be copied onto the new image)"
		fi
		# ln -s onto an EXISTING directory creates the link INSIDE it rather
		# than replacing it, so work/ must not exist here -- it either never
		# did, or the block above just moved it aside.
		[ -e "$MACKAS_ROOT/work" ] && run rm -rf "$MACKAS_ROOT/work"

		run hdiutil create -type SPARSE -fs "Case-sensitive APFS" \
			-size "$MACKAS_WORKSPACE_SIZE" -volname mackas-workspace "$base"
		did "created workspace image: $img ($MACKAS_WORKSPACE_SIZE, sparse)"

		local mp; mp="$(attach_workspace_image "$img")" \
			|| die "hdiutil attach failed for the workspace image just created" \
				"check 'hdiutil info'; the image itself is at $img"
		run ln -s "$mp" "$MACKAS_ROOT/work"
		# The sentinel and the recorded path are what make this survive the
		# first reboot: without them work/ comes back as a bare directory on
		# the case-insensitive drive and nothing downstream knows it should
		# have been a mount. See ensure_workspace_attached().
		write_workspace_sentinel "$mp"
		record_workspace_image "$img"
		did "mounted workspace image at $MACKAS_ROOT/work -> $mp"

		if [ -n "$preserved" ]; then
			run rsync -a "$preserved/" "$MACKAS_ROOT/work/"
			did "copied the preserved checkout onto the new workspace"
			info "      kept a backup at $preserved -- remove it by hand once you have"
			info "      confirmed the copy (git status in each layer, or just 'diff -r')."
		fi
	fi

	# Sanity check: work/ must actually be case-sensitive now, or something
	# above silently failed (a stale mount, a dangling symlink) and
	# continuing would repeat the exact bug this whole gate exists to catch.
	local cs2; set +e; dir_is_case_sensitive "$MACKAS_ROOT/work"; cs2=$?; set -e
	[ "$cs2" -eq 0 ] || [ "$DRY_RUN" -eq 1 ] || die "work/ is still not case-sensitive after mounting the workspace image -- something went wrong" \
		"check 'mount | grep work' and 'hdiutil info'"
}

setup_short_link() {
	step "Short symlink: $MACKAS_SHORT_LINK -> $MACKAS_ROOT"
	if [ -L "$MACKAS_SHORT_LINK" ]; then
		local tgt
		tgt="$(readlink "$MACKAS_SHORT_LINK")"
		# same_dir, not a bare string compare: also passes a link recorded by
		# an older mackas with a trailing slash baked in, or one that reaches
		# MACKAS_ROOT through ANOTHER symlink rather than directly.
		if same_dir "$MACKAS_SHORT_LINK" "$MACKAS_ROOT"; then
			skip "$MACKAS_SHORT_LINK -> $MACKAS_ROOT"
		else
			# A DIFFERENT root than the one just configured -- almost always
			# MACKAS_ROOT changed since this link was made (a renamed
			# volume, a new disk), not a mistake. Offer to fix it rather
			# than just refusing: this used to be a hard die requiring a
			# manual `rm` first, which is needless ceremony for the common
			# case.
			warn "      $MACKAS_SHORT_LINK points at a DIFFERENT root:"
			warn "        $tgt"
			warn "      not this root's own $MACKAS_ROOT."
			if confirm "      Re-point $MACKAS_SHORT_LINK -> $MACKAS_ROOT?"; then
				local parent
				parent="$(dirname "$MACKAS_SHORT_LINK")"
				if [ -w "$parent" ]; then
					run rm -f "$MACKAS_SHORT_LINK"
					run ln -s "$MACKAS_ROOT" "$MACKAS_SHORT_LINK"
				else
					info "      $parent is not writable by $(id -un); re-pointing needs sudo."
					run_sudo rm -f "$MACKAS_SHORT_LINK"
					run_sudo ln -s "$MACKAS_ROOT" "$MACKAS_SHORT_LINK"
				fi
				did "re-pointed $MACKAS_SHORT_LINK -> $MACKAS_ROOT (was -> $tgt)"
			else
				die "$MACKAS_SHORT_LINK still points at '$tgt'" \
					"rm $(printf '%q' "$MACKAS_SHORT_LINK") && $SCRIPT_CMD setup"
			fi
		fi
	elif [ -e "$MACKAS_SHORT_LINK" ]; then
		warn "      $MACKAS_SHORT_LINK exists and is not a symlink (a real file or directory)."
		local backup
		backup="$MACKAS_SHORT_LINK.bak.$(date +%Y%m%d%H%M%S)"
		if confirm "      Move it aside to $backup and continue?"; then
			local parent
			parent="$(dirname "$MACKAS_SHORT_LINK")"
			if [ -w "$parent" ]; then
				run mv "$MACKAS_SHORT_LINK" "$backup"
				run ln -s "$MACKAS_ROOT" "$MACKAS_SHORT_LINK"
			else
				info "      $parent is not writable by $(id -un); this needs sudo."
				run_sudo mv "$MACKAS_SHORT_LINK" "$backup"
				run_sudo ln -s "$MACKAS_ROOT" "$MACKAS_SHORT_LINK"
			fi
			did "moved $MACKAS_SHORT_LINK aside -> $backup, linked -> $MACKAS_ROOT"
		else
			die "$MACKAS_SHORT_LINK exists and is not a symlink" \
				"move it aside, then re-run '$SCRIPT_CMD setup'"
		fi
	else
		local parent
		parent="$(dirname "$MACKAS_SHORT_LINK")"
		if [ -w "$parent" ]; then
			run ln -s "$MACKAS_ROOT" "$MACKAS_SHORT_LINK"
			did "linked $MACKAS_SHORT_LINK -> $MACKAS_ROOT"
		else
			info "      $parent is not writable by $(id -un); the symlink needs sudo."
			if confirm "      Create it with sudo?"; then
				run_sudo ln -s "$MACKAS_ROOT" "$MACKAS_SHORT_LINK"
				did "linked $MACKAS_SHORT_LINK -> $MACKAS_ROOT"
			else
				die "cannot create $MACKAS_SHORT_LINK" \
					"sudo ln -s $(printf '%q' "$MACKAS_ROOT") $(printf '%q' "$MACKAS_SHORT_LINK")   -- or set MACKAS_SHORT_LINK=\$HOME/oe in $(config_hint)"
			fi
		fi
	fi
	# From here on MACKAS_BASE can use the link.
	derive_paths
}

setup_shim_and_env() {
	step "docker shim + GNU realpath + env.sh"

	if [ -x "$SCRIPT_DIR/bin/docker" ]; then
		if [ -f "$SHIM_DIR/docker" ] && cmp -s "$SCRIPT_DIR/bin/docker" "$SHIM_DIR/docker"; then
			skip "$SHIM_DIR/docker is current"
		else
			run mkdir -p "$SHIM_DIR"
			run cp "$SCRIPT_DIR/bin/docker" "$SHIM_DIR/docker"
			run chmod +x "$SHIM_DIR/docker"
			did "installed shim -> $SHIM_DIR/docker"
		fi
	else
		die "shim missing at $SCRIPT_DIR/bin/docker" "re-clone the mackas repo"
	fi

	# GNU realpath: kas-container calls `realpath -e` / `--relative-base`, which
	# macOS's BSD /bin/realpath rejects. `brew install coreutils` installs
	# `grealpath`, not an unprefixed `realpath`, so guarantee a GNU one in our
	# bin dir (first on env.sh PATH) automatically -- do not make the user
	# arrange their own PATH or hand-symlink anything.
	local gnu_rp
	if gnu_rp="$(find_gnu_realpath)"; then
		run mkdir -p "$SHIM_DIR"
		if [ "$(readlink "$SHIM_DIR/realpath" 2>/dev/null || true)" = "$gnu_rp" ]; then
			skip "GNU realpath shim is current ($gnu_rp)"
		else
			run ln -sf "$gnu_rp" "$SHIM_DIR/realpath"
			did "GNU realpath -> $SHIM_DIR/realpath ($gnu_rp)"
		fi
	else
		die "no GNU realpath found -- kas-container needs it (macOS's BSD realpath lacks -e/--relative-base)" \
			"brew install coreutils"
	fi

	local mirrors_note=""
	[ "$MACKAS_USE_NFS_MIRRORS" = "1" ] && mirrors_note="# NFS mirrors enabled; see $MACKAS_KAS_FRAGMENT_SRC"
	[ "$MACKAS_USE_HTTP_MIRRORS" = "1" ] && mirrors_note="# HTTP mirrors enabled ($MACKAS_HTTP_MIRROR_SSTATE); see $MACKAS_KAS_FRAGMENT_SRC"

	# Every value that becomes shell CODE in env.sh is quoted here, before the
	# heredoc, rather than interpolated raw into a "..." in it.
	#
	# The raw form was an injection: the heredoc wrote export PATH="$SHIM_DIR:..."
	# with SHIM_DIR pasted straight between the quotes, so a MACKAS_ROOT
	# containing a double quote closed that string and everything after it was
	# code -- executed by whoever sourced env.sh, which is the user, in their
	# own interactive shell. It is also a plain bug with nobody attacking: a
	# build root with a literal $ or " in it is perfectly legal on APFS and
	# simply produced a broken env.sh.
	#
	# shq() emits a single-quoted string, so the value is inert. Note which
	# things are NOT quoted this way: \$PATH, \$MACKAS_RUNTIME_ARGS and \$@
	# below are escaped in the heredoc instead, because those must survive
	# generation as text and expand when env.sh is SOURCED. That distinction is
	# the whole point -- our values must not expand, the user's shell variables
	# must.
	local q_shim q_work q_image q_gitconfig q_kasbin q_runtime_args
	local q_root q_base q_project q_cpus q_parallel q_scriptdir
	local q_fragrepo q_autofrag q_autoproj q_brew
	q_shim="$(shq "$SHIM_DIR")"
	q_scriptdir="$(shq "$SCRIPT_DIR")"
	q_brew="$(shq "$BREW_BIN")"
	q_work="$(shq "$MACKAS_WORK")"
	q_image="$(shq "$KAS_IMAGE")"
	q_gitconfig="$(shq "$MACKAS_GITCONFIG")"
	# Deliberately KAS_CONTAINER_BIN (the write_kas_wrapper() protection
	# wrapper), NOT KAS_CONTAINER_REAL -- this is the one place in this whole
	# file that is SUPPOSED to call the wrapper rather than the pinned
	# upstream binary. The generated kas-container() function's entire job at
	# the point it uses this is to hand off to that wrapper, which is what
	# supplies the live --runtime-args/volume-blanking/PATH safety net; do not
	# "fix" this to point at .real.
	q_kasbin="$(shq "$KAS_CONTAINER_BIN")"
	q_runtime_args="$(shq "$(kas_runtime_args)")"
	q_root="$(shq "$MACKAS_ROOT")"
	q_base="$(shq "$MACKAS_BASE")"
	q_project="$(shq "$MACKAS_PROJECT")"
	q_cpus="$(shq "$MACKAS_CPUS")"
	q_parallel="$(shq "-j $MACKAS_CPUS")"
	q_fragrepo="$(shq "$MACKAS_KAS_FRAGMENT_REPO")"
	q_autofrag="$(shq "$MACKAS_KAS_AUTO_FRAGMENT")"
	q_autoproj="$(shq "$MACKAS_KAS_AUTO_PROJECT")"

	if [ "$DRY_RUN" -eq 1 ]; then
		printf '%s+ write %s%s\n' "$C_DIM" "$MACKAS_ENV_SH" "$C_RST"
	else
		cat > "$MACKAS_ENV_SH" <<EOF
# Generated by $SCRIPT_NAME v$SCRIPT_VERSION -- source this, don't execute it.
#   source $MACKAS_ENV_SH
#
# The shim MUST come before /usr/local/bin (the real Docker CLI lives there).
# The Homebrew bin dir must come before /usr/bin so kas-container finds GNU
# realpath (it is the second entry below; NOT interpolated into this comment,
# where a newline in it would end the comment and make the rest code).
# $SCRIPT_NAME's own checkout is on PATH too, so '$SCRIPT_NAME ...' works from
# any directory once this is sourced -- no more cd-ing back to the repo first.
$mirrors_note
export PATH=$q_shim:$q_brew:$q_scriptdir:"\$PATH"

# Force kas-container's engine selection instead of relying on its
# 'docker -v | grep ^Docker' probe.
export KAS_CONTAINER_ENGINE=docker

export KAS_WORK_DIR=$q_work

# The FULL image reference, tag included, and no KAS_IMAGE_VERSION alongside
# it: kas-container's set_container_image_var() returns early when
# KAS_CONTAINER_IMAGE is set, so KAS_IMAGE_VERSION is ignored and a tagless
# name would silently run :latest instead of the pinned tag.
export KAS_CONTAINER_IMAGE=$q_image

# See setup_gitconfig() in $SCRIPT_NAME for the full story: under Apple
# container's virtiofs, /repo's mount ROOT shows up owned by 0:0 while its
# contents show as you, and git's dubious-ownership check then refuses to
# touch /repo at all -- which silently broke BBLAYERS resolution, not just
# printed a warning. kas-container forwards GITCONFIG_FILE into the
# container as /var/kas/userdata/.gitconfig if it names a file that exists,
# so this is the mechanism, not a kas patch.
#
# Only set it if THIS shell doesn't already have one: a GITCONFIG_FILE you
# set yourself always wins, and \`setup\`/\`check\` already warned you if it is
# missing 'safe.directory = *'. The check runs when env.sh is SOURCED, not
# when it was generated, so it reflects whatever is exported in your shell
# right now.
if [ -z "\${GITCONFIG_FILE:-}" ]; then
	export GITCONFIG_FILE=$q_gitconfig
fi

# NOTHING here exports KAS_BUILD_DIR, DL_DIR or SSTATE_DIR, and that is
# deliberate -- do not "fix" it by adding them.
#
# kas-container's forward_dir() BIND-MOUNTS the host directory each of those
# names, so setting them to a path on this Mac would put OpenEmbedded's TMPDIR on
# APFS over virtiofs, which cannot give OE the Linux filesystem semantics it
# needs (hardlinks, xattrs, rename()). Left unset, forward_dir() does nothing,
# and the ext4 volumes below take their place.
#
# Likewise KAS_EXTRA_RUNTIME_ARGS is NOT an environment variable: kas-container
# blanks it before parsing arguments, so exporting it does nothing at all. The
# limits and volumes only arrive via the --runtime-args flag.
#
# 'mackas smoketest' and 'mackas shell' pass all of this for you and are the
# supported way to build. Two layers now protect a bare, hand-typed
# 'kas-container ...' from silently building at Apple's cpus=4/memory=1gb
# defaults with no volumes: $KAS_CONTAINER_BIN (a real script generated by
# write_kas_wrapper() in $SCRIPT_NAME) protects EVERY invocation shape --
# nohup, env, an unsourced shell, and this function's own hand-off to it
# below -- while the kas-container() function defined further down in this
# file does only what a subprocess fundamentally cannot do in the SAME shell:
# derive MACKAS_PROJECT_DIR/MACKAS_KAS_CONFIG and append the macos-local.yml
# fragment, both before handing off to that wrapper.
#
# This is the value at the moment 'setup' generated this file, and nothing
# reads it: the kas-container() function below delegates --runtime-args
# entirely to the wrapper, which recomputes it live on every call and
# REFUSES rather than fall back if that fails (issue #96). Kept exported
# anyway, unchanged, so a shell that already sourced an older env.sh keeps
# seeing the name it had -- removing it out from under an already-sourced
# shell is the breaking change, not keeping an unread export. Never treat it
# as a fallback: a stale copy of these values is exactly what #96 removed.
export MACKAS_RUNTIME_ARGS=$q_runtime_args

# Absolute path to the generated fragment (empty project -> a path that
# simply does not exist yet, which the wrapper below treats as "nothing to
# append"), and whether the wrapper appends it automatically. See
# MACKAS_KAS_AUTO_FRAGMENT in $SCRIPT_NAME for the full story.
export MACKAS_KAS_FRAGMENT_REPO=$q_fragrepo

# ':-' so a value already exported in THIS shell wins, exactly like
# GITCONFIG_FILE above. A bare assignment here would silently clobber
# 'MACKAS_KAS_AUTO_PROJECT=0' set in a shell rc BEFORE env.sh is sourced,
# which is a perfectly reasonable way to turn either of these off.
export MACKAS_KAS_AUTO_FRAGMENT=\${MACKAS_KAS_AUTO_FRAGMENT:-$q_autofrag}
export MACKAS_KAS_AUTO_PROJECT=\${MACKAS_KAS_AUTO_PROJECT:-$q_autoproj}

# _mackas_derive_project needs this to tell "cwd is work/" from "cwd is a
# checkout under work/". Same value as KAS_WORK_DIR above, under the name the
# rest of mackas uses.
export MACKAS_WORK=$q_work

# Derive MACKAS_PROJECT_DIR/MACKAS_KAS_CONFIG from the file list a hand-typed
# 'kas-container build/shell/... <files>' just used, and export them into THIS
# shell so a later 'mackas retrieve'/'buildstats analyze' in the same shell
# resolves paths through bitbake instead of refusing. See
# MACKAS_KAS_AUTO_PROJECT in $SCRIPT_NAME for the full story. Never writes a
# config file, and never overrides a value that is already set.
_mackas_derive_project() {
	[ "\${MACKAS_KAS_AUTO_PROJECT:-0}" = "1" ] || return 0
	local files="\${1:-}" proj="" rest entry stripped out=""
	[ -n "\$files" ] || return 0
	[ -n "\${MACKAS_WORK:-}" ] || return 0

	if [ "\$PWD" = "\$MACKAS_WORK" ]; then
		# The documented flow: cwd is work/, so every entry is
		# <checkout>/path/to.yml and the leading component names the checkout.
		case "\$files" in
			*/*) proj="\${files%%/*}" ;;
			*) return 0 ;;
		esac
		# Strip that component off every entry to get the checkout-relative
		# form compose_kas_files uses. A chain spanning SIBLING layers (e.g.
		# meta-angstrom/... plus meta-ti/...) cannot be expressed that way at
		# all -- mackas commands cd INTO the checkout, so a sibling would sit
		# outside the /repo mount -- so derive nothing rather than something
		# that parses but resolves wrong.
		rest="\$files"
		while [ -n "\$rest" ]; do
			entry="\${rest%%:*}"
			case "\$rest" in
				*:*) rest="\${rest#*:}" ;;
				*)   rest="" ;;
			esac
			case "\$entry" in
				"\$proj"/*) stripped="\${entry#"\$proj"/}" ;;
				*) proj=""; break ;;
			esac
			out="\${out:+\$out:}\$stripped"
		done
	elif [ "\${PWD%/*}" = "\$MACKAS_WORK" ]; then
		# cwd is the checkout itself, so the entries are already relative.
		proj="\${PWD##*/}"
		out="\$files"
	fi
	[ -n "\$proj" ] || return 0

	# Only fill in what is genuinely unset: an explicit value, wherever it
	# came from, always wins.
	local did=""
	if [ -z "\${MACKAS_PROJECT_DIR:-}" ]; then
		export MACKAS_PROJECT_DIR="\$proj"
		export MACKAS_PROJECT="\$MACKAS_WORK/\$proj"
		did="MACKAS_PROJECT_DIR=\$proj"
	fi
	if [ -z "\${MACKAS_KAS_CONFIG:-}" ] && [ -n "\$out" ]; then
		export MACKAS_KAS_CONFIG="\$out"
		did="\${did:+\$did }MACKAS_KAS_CONFIG=\$out"
	fi
	# Say it once per shell -- useful the first time, noise on every call.
	if [ -n "\$did" ] && [ -z "\${_MACKAS_PROJECT_NOTED:-}" ]; then
		_MACKAS_PROJECT_NOTED=1
		printf '%s: derived %s for this shell\n' "$SCRIPT_NAME" "\$did" >&2
	fi
	return 0
}

kas-container() {
	# Prepend our bin dir so kas-container ALWAYS finds the GNU realpath shim
	# installed there, no matter what \$PATH looks like when this is called.
	# kas-container calls \`realpath -e\` / \`--relative-base\`, which macOS's BSD
	# realpath rejects with "illegal option -- e"; the shim (a symlink to GNU
	# coreutils' realpath) is what makes a bare 'kas-container ...' just work.
	#
	# Auto-append the macos-local.yml fragment (parallelism, BB_DISKMON_DIRS,
	# BB_HASHSERVE_DB_DIR, mirrors) onto the file-list argument every kas
	# subcommand below takes, the same way compose_kas_files() already does
	# for every mackas subcommand that drives kas -- unless
	# MACKAS_KAS_AUTO_FRAGMENT=0, the fragment is not installed yet (no
	# project), or the file list already names macos-local.yml itself
	# (composed by hand, per README). The relative path is resolved fresh
	# from \$PWD every call, not baked in at generation time, because
	# README's own supported flow cd's to work/ (the parent of every layer
	# checkout) rather than into the project itself, so the correct relative
	# prefix depends on where THIS call runs from.
	#
	# The file-list argument is NOT always \$2: kas's own config argument is
	# \`nargs='?'\` (kas/libkas.py setup_parser_config_arg, confirmed against
	# real kas 5.5 source) and every subcommand accepts options before it --
	# 'shell -k <files>' is exactly what bitbake_getvar() itself passes, and
	# '--skip STEP' (repeatable) is the surgical, repo-state-preserving
	# alternative to -k this project's own docs now recommend. Scan past a
	# known BOOLEAN flag (kas/libkas.py setup_parser_common_args and
	# setup_parser_keep_config_unchanged_arg, kas/plugins/shell.py's own -E)
	# or a known VALUE flag (consuming its separate argument too, '--x=y'
	# single-token form included) to find the real file list; any OTHER
	# '-'-prefixed option makes this back off entirely rather than guess
	# which token is the file list and mis-splice the fragment into the
	# wrong one. 'dump'/'menu' are deliberately not in this list: their
	# positional argument is not a kas file list the same way (dump has many
	# more pre-config flags; menu's positional is a kconfig file, not
	# \`config\` at all).
	# The scan runs for its own sake, NOT only when the fragment is about to be
	# appended: _mackas_derive_project needs the same file list, and the case
	# it exists to fix is precisely the one where no project is configured yet
	# (so MACKAS_KAS_FRAGMENT_REPO does not exist and the append is skipped).
	local _mackas_sub="\${1:-}" _mackas_arg _mackas_files="" _mackas_frag
	local _mackas_before=()
	case "\$_mackas_sub" in
		build|shell|checkout)
			shift
			while [ \$# -gt 0 ]; do
				_mackas_arg="\$1"
				case "\$_mackas_arg" in
					-k|--keep-config-unchanged)
						_mackas_before+=("\$_mackas_arg"); shift
						echo "\$SCRIPT_NAME: -k/--keep-config-unchanged skips write_bbconfig this run -- any local.conf/bblayers.conf change in the file list (including an auto-appended macos-local.yml) will not take effect until a build without -k" >&2
						;;
					--force-checkout|--update|-E|--preserve-env)
						_mackas_before+=("\$_mackas_arg"); shift ;;
					--skip=*|--target=*|--cmd=*|--task=*|--provenance=*)
						_mackas_before+=("\$_mackas_arg"); shift ;;
					--skip|--target|-c|--cmd|--task|--provenance)
						_mackas_before+=("\$_mackas_arg"); shift
						if [ \$# -gt 0 ]; then
							_mackas_before+=("\$1"); shift
						fi
						;;
					-*)
						break ;;
					*)
						_mackas_files="\$_mackas_arg"; shift; break ;;
				esac
			done
			# Derive BEFORE the fragment is appended, so the fragment never
			# lands in the derived MACKAS_KAS_CONFIG (compose_kas_files adds
			# it back itself, and a doubled entry is a kas parse error).
			_mackas_derive_project "\$_mackas_files"
			if [ "\${MACKAS_KAS_AUTO_FRAGMENT:-0}" = "1" ] && [ -f "\$MACKAS_KAS_FRAGMENT_REPO" ]; then
				case "\$_mackas_files" in
					''|*macos-local.yml) ;;
					*)
						_mackas_frag="\$(PATH=$q_shim:"\$PATH" realpath --relative-to="\$PWD" "\$MACKAS_KAS_FRAGMENT_REPO" 2>/dev/null || true)"
						[ -n "\$_mackas_frag" ] && _mackas_files="\$_mackas_files:\$_mackas_frag"
						;;
				esac
			fi
			set -- "\$_mackas_sub" "\${_mackas_before[@]}" \${_mackas_files:+"\$_mackas_files"} "\$@"
			;;
	esac
	# Hand off to $KAS_CONTAINER_BIN, the protection wrapper SCRIPT
	# write_kas_wrapper() generates in $SCRIPT_NAME (see q_kasbin's own
	# assignment above for why this must stay the wrapper, never .real). IT
	# computes --runtime-args live and refuses to launch if that fails,
	# applies the one-VM rule, blanks KAS_BUILD_DIR/DL_DIR/SSTATE_DIR,
	# prepends the shim dir to PATH, and sets up the container
	# engine/image/gitconfig -- none of that belongs here anymore.
	# MACKAS_KAS_FRAGMENT_DONE=1 tells it the fragment-append above already
	# ran in this shell, so its own "did this bypass the function?" stderr
	# note stays quiet for this call.
	MACKAS_KAS_FRAGMENT_DONE=1 $q_kasbin "\$@"
}

export BB_NUMBER_THREADS=$q_cpus
export PARALLEL_MAKE=$q_parallel

# Convenience
export MACKAS_ROOT=$q_root
export MACKAS_BASE=$q_base
export MACKAS_PROJECT=$q_project
EOF
		did "wrote $MACKAS_ENV_SH"
	fi
}

# A gitconfig forwarded into the container via kas-container's own
# GITCONFIG_FILE mechanism (kas-container v5.5 ~line 743: it -v mounts the
# file at /var/kas/userdata/.gitconfig:ro and exports GITCONFIG_FILE inside
# the container when the host env var names a file that exists).
#
# WHY THIS IS NEEDED AT ALL, i.e. what "THE blocker" actually was:
#
# Under Apple's `container` runtime, the virtiofs bind mount that puts the
# project checkout at /repo inside the guest shows the mount ROOT as owned by
# 0:0 (root), while every file and directory INSIDE it (created by the host
# user) shows up owned by the host user. That split is a virtiofs/bind-mount
# ownership artifact of crossing the macOS/Linux boundary -- it is NOT a kas
# bug and NOT something mackas' privilege-drop got wrong.
#
# git's own dubious-ownership protection (the CVE-2022-24765 fix) then
# refuses to operate on /repo at all:
#   fatal: detected dubious ownership in repository at '/repo'
# kas's Repo.get_root_path() (kas/repos.py ~line 322) runs
# `git rev-parse --show-toplevel` to resolve the root of a url-less repo --
# the project's own local 'kas:' entry is exactly such a repo -- and SILENTLY
# FALLS BACK to the input path (the config file's own directory) when git
# exits non-zero. So this one git refusal was not just a scary warning: it
# quietly mis-resolved BBLAYERS to .../kas instead of the real repo root, and
# bitbake died on a missing layer.conf far away from the actual cause.
#
# `safe.directory = *` trusts every path git is ever pointed at, which reads
# as alarming out of context. It is acceptable HERE, and ONLY here: this file
# is forwarded exclusively into a throwaway, single-user, ephemeral
# container (see the GITCONFIG_FILE mechanism above) -- never onto the host,
# never into a shared or long-lived environment. Do not copy this file's
# contents into a real ~/.gitconfig.
# write_gitconfig_content PATH -- the exact content that satisfies
# has_safe_directory_star, shared between the file mackas manages
# ($MACKAS_GITCONFIG) and a GITCONFIG_FILE path the user set themselves that
# turned out not to exist.
write_gitconfig_content() {
	cat > "$1" <<EOF
# Generated by $SCRIPT_NAME v$SCRIPT_VERSION -- forwarded into the kas
# container as /var/kas/userdata/.gitconfig via kas-container's GITCONFIG_FILE
# mechanism. See the comment above setup_gitconfig() in $SCRIPT_NAME for the
# full story: this is a macOS/virtiofs ownership quirk, not a kas bug, and
# 'directory = *' is safe here specifically because this file only ever
# reaches a throwaway, single-user, ephemeral container. Do not copy this
# into your real ~/.gitconfig.
[safe]
	directory = *
EOF
}

setup_gitconfig() {
	step "gitconfig for container git (macOS/virtiofs 'dubious ownership' workaround)"

	if [ -n "${GITCONFIG_FILE:-}" ]; then
		# The user already forwards their own gitconfig via this env var --
		# never silently overwrite it. But an env var mackas cannot itself
		# unset in the CALLING shell is a different problem from the file it
		# names being missing 'safe.directory = *' (or missing outright,
		# e.g. after a MACKAS_ROOT change left this pointing at a path that
		# no longer has anything at it): that part mackas CAN fix, with
		# permission, respecting whatever path the user chose.
		if [ -r "$GITCONFIG_FILE" ] && has_safe_directory_star "$GITCONFIG_FILE"; then
			skip "GITCONFIG_FILE=$GITCONFIG_FILE (yours) already has safe.directory = *"
			return
		fi

		if [ -r "$GITCONFIG_FILE" ]; then
			warn "      GITCONFIG_FILE=$GITCONFIG_FILE is set (yours) but has no"
			warn "      'safe.directory = *' -- git inside the container will refuse /repo"
			warn "      with 'detected dubious ownership' (see README)."
			if confirm "      Append '[safe] / directory = *' to it now?"; then
				if [ "$DRY_RUN" -eq 1 ]; then
					printf '%s+ append safe.directory = * to %s%s\n' "$C_DIM" "$GITCONFIG_FILE" "$C_RST"
				else
					printf '\n# Added by %s: kas-container forwards this file into the container as\n# GITCONFIG_FILE; without this, git inside it refuses /repo (dubious\n# ownership -- a virtiofs artifact, not a real ownership problem).\n[safe]\n\tdirectory = *\n' \
						"$SCRIPT_NAME" >> "$GITCONFIG_FILE"
					did "appended safe.directory = * to $GITCONFIG_FILE"
				fi
			else
				warn "      Add it by hand, or unset GITCONFIG_FILE and re-run '$SCRIPT_CMD setup'"
				warn "      to let it manage one for you."
			fi
		else
			warn "      GITCONFIG_FILE=$GITCONFIG_FILE is set but that file does not exist --"
			warn "      nothing gets forwarded, so git inside the container will refuse /repo"
			warn "      with 'detected dubious ownership' (see README) exactly as if this"
			warn "      were never set at all."
			if confirm "      Create it now with the required content?"; then
				if [ "$DRY_RUN" -eq 1 ]; then
					printf '%s+ write %s%s\n' "$C_DIM" "$GITCONFIG_FILE" "$C_RST"
				else
					mkdir -p "$(dirname "$GITCONFIG_FILE")"
					write_gitconfig_content "$GITCONFIG_FILE"
					did "wrote $GITCONFIG_FILE"
				fi
			else
				warn "      Create it by hand, or unset GITCONFIG_FILE and re-run '$SCRIPT_CMD setup'"
				warn "      to let it manage one for you."
			fi
		fi
		return
	fi

	if [ -f "$MACKAS_GITCONFIG" ] && has_safe_directory_star "$MACKAS_GITCONFIG"; then
		skip "$MACKAS_GITCONFIG already has safe.directory = *"
		return
	fi

	if [ "$DRY_RUN" -eq 1 ]; then
		printf '%s+ write %s%s\n' "$C_DIM" "$MACKAS_GITCONFIG" "$C_RST"
		return
	fi

	mkdir -p "$(dirname "$MACKAS_GITCONFIG")"
	write_gitconfig_content "$MACKAS_GITCONFIG"
	did "wrote $MACKAS_GITCONFIG"
}

setup_relocate_volumes() {
	step "Relocate container volumes to the SSD"
	if [ "$MACKAS_RELOCATE_VOLUMES" != "1" ]; then
		skip "MACKAS_RELOCATE_VOLUMES=0, leaving $CONTAINER_VOLUMES_DIR alone"
		return
	fi

	local dest="$MACKAS_ROOT/container-volumes"

	if [ -L "$CONTAINER_VOLUMES_DIR" ]; then
		local cur
		cur="$(strip_trailing_slash "$(readlink "$CONTAINER_VOLUMES_DIR")")"
		# Resolved comparison, not a bare string compare: MACKAS_ROOT can
		# itself be a symlink (e.g. set to MACKAS_SHORT_LINK's own path
		# rather than its target) -- confirmed live, this made a root's own
		# relocation symlink read as "belongs to a different root" and
		# offered to move a live project's volumes onto the wrong disk.
		if [ "$(resolve_path "$cur")" = "$(resolve_path "$dest")" ]; then
			skip "already a symlink -> $dest"
			return
		fi
		# Apple's container has exactly ONE volumes directory for the whole
		# machine, not one per MACKAS_ROOT -- a symlink to a DIFFERENT
		# location almost always means an earlier setup against a different
		# root (a previous test disk, a previous project). Silently treating
		# "is a symlink" as "is done" -- the old bug here -- would leave every
		# volume this run creates/uses physically on THAT other disk, not
		# this one, with nothing said about it.
		warn "      $CONTAINER_VOLUMES_DIR is a symlink to a DIFFERENT root's volumes:"
		warn "        $cur"
		warn "      not this root's own $dest."
		if [ -d "$cur" ]; then
			if ! confirm "      Move its contents to $dest and re-point the symlink here?"; then
				warn "      Leaving it as-is. This root's volumes will live at $cur too,"
				warn "      not under $MACKAS_ROOT, until you re-run and accept, or move them"
				warn "      by hand."
				return
			fi
		else
			# Nothing left at the old location -- almost always a renamed
			# volume/mountpoint: the real data never moved, it is just
			# reachable under a different path now (which, if MACKAS_ROOT was
			# updated to match, is exactly $dest already). Nothing to copy;
			# just fix the symlink -- "move its contents" would be a lie here.
			if ! confirm "      Re-point the symlink to $dest? (nothing exists at the old location any more)"; then
				warn "      Leaving the symlink pointing at a location that no longer exists."
				warn "      Re-run and accept, or fix it by hand:"
				warn "        ln -sfn $(printf '%q' "$dest") $(printf '%q' "$CONTAINER_VOLUMES_DIR")"
				return
			fi
		fi
		[ -d "$dest" ] || { run mkdir -p "$dest"; did "created $dest"; }
		if [ -d "$cur" ]; then
			local n
			# shellcheck disable=SC2012  # only counting entries; names irrelevant
			n="$(ls -A "$cur" 2>/dev/null | wc -l | tr -d ' ')"
			if [ "$n" -gt 0 ]; then
				if [ -t 1 ] && [ "$DRY_RUN" -eq 0 ] && rsync --info=progress2 --version >/dev/null 2>&1; then
					run rsync -a --info=progress2 "$cur/" "$dest/"
				else
					run rsync -a "$cur/" "$dest/"
				fi
				did "copied $n entries from $cur to $dest"
			fi
		fi
		run rm -f "$CONTAINER_VOLUMES_DIR"
		run ln -s "$dest" "$CONTAINER_VOLUMES_DIR"
		did "re-symlinked $CONTAINER_VOLUMES_DIR -> $dest (was -> $cur)"
		return
	fi

	[ -d "$dest" ] || { run mkdir -p "$dest"; did "created $dest"; }

	if [ -d "$CONTAINER_VOLUMES_DIR" ]; then
		local n
		# shellcheck disable=SC2012  # only counting entries; names irrelevant
		n="$(ls -A "$CONTAINER_VOLUMES_DIR" 2>/dev/null | wc -l | tr -d ' ')"
		if [ "$n" -gt 0 ]; then
			warn "      $CONTAINER_VOLUMES_DIR is not empty ($n entries)."
			if ! confirm "      Move its contents to $dest and replace it with a symlink?"; then
				warn "      Skipping relocation. Volume images will stay on the internal disk."
				return
			fi
			# rsync so a crash mid-move leaves the source intact. -a implies -l
			# (copy symlinks AS symlinks, never follow), so a per-volume symlink
			# a prior `volume move` planted here is preserved verbatim rather
			# than dereferenced and clobbered -- move and setup do not fight.
			#
			# On a terminal, --info=progress2 gives a real % bar + ETA (the total
			# IS known here). Keep it plain when piped, under --dry-run, or if the
			# host rsync is too old to know the flag (macOS 26 ships rsync 3.4).
			if [ -t 1 ] && [ "$DRY_RUN" -eq 0 ] && rsync --info=progress2 --version >/dev/null 2>&1; then
				run rsync -a --info=progress2 "$CONTAINER_VOLUMES_DIR/" "$dest/"
			else
				run rsync -a "$CONTAINER_VOLUMES_DIR/" "$dest/"
			fi
			did "copied $n entries to $dest"
		fi
		run rm -rf "$CONTAINER_VOLUMES_DIR"
	fi
	run ln -s "$dest" "$CONTAINER_VOLUMES_DIR"
	did "symlinked $CONTAINER_VOLUMES_DIR -> $dest"
}

# ensure_volume NAME SIZE ROLE -- create it if missing, and chown its root.
#
# The chown is not optional. `container volume create` makes a fresh ext4
# whose root is root:root, and that ownership is REAL: a named volume is a
# genuine Linux filesystem, not an APFS bind mount (where Apple's virtiofs
# forces host-user ownership and hides the whole problem). kas correctly drops
# to USER_ID/GROUP_ID and then dies with
#   PermissionError: [Errno 13] Permission denied: '/build/CACHEDIR.TAG'
# One chown at create time, and it stays right forever after.
ensure_volume() {
	local name="$1" size="$2" role="$3"

	if volume_exists "$name"; then
		skip "volume '$name' exists ($role)"
	elif refuse_if_stale_entity "$name"; then
		run container volume create -s "$size" "$name"
		did "created ext4 volume '$name' ($size, $role, sparse until used)"
	elif [ "$DRY_RUN" -eq 1 ]; then
		skip "volume '$name' exists ($role) -- dry-run, restart not actually performed"
	else
		skip "volume '$name' exists ($role) -- found after restarting the container daemon"
	fi

	# The chown attaches the volume. If a build still holds it, that would be a
	# SECOND attach -- which the runtime refuses, aborting setup mid-run under
	# set -e. A held volume was already created and chowned once, so skip it
	# rather than fight the one-VM rule.
	if volume_in_use "$name"; then
		warn "      volume '$name' is attached to a running build; skipping the chown"
		warn "      (re-run '$SCRIPT_CMD setup' once it finishes if ownership looks wrong)"
		return 0
	fi

	# Chown unconditionally, not just on create. `container volume create` and
	# the chown are two separate operations, so a crash (or a failing chown)
	# between them leaves a volume that exists but is still root-owned. Bailing
	# out early on "exists" would then skip the chown forever and leave kas
	# permanently unable to write it. The chown is idempotent, so just redo it.
	# -u 0:0 is mandatory. The kas image's default user is uid 30000 (builder),
	# which cannot chown anything, and the run dies with
	#   chown: changing ownership of '/mnt': Operation not permitted
	# This boots a throwaway VM to set ownership -- a few seconds with no progress
	# to report, so spin() ticks elapsed time rather than leaving the step silent.
	spin "chowning '$name' (booting a VM)" \
		container run --rm -u 0:0 -v "$name:/mnt" "$KAS_IMAGE" chown "$(id -u):$(id -g)" /mnt
	did "chowned '$name' root to $(id -u):$(id -g) so kas can write it"
}

setup_volumes() {
	step "ext4 volumes: $MACKAS_VOL_TMP, $MACKAS_VOL_DL, $MACKAS_VOL_SSTATE ($(total_volume_gb) GiB total)"

	# Backstop for callers (tests included) that reach this function directly
	# without going through main()'s validate_settings first.
	validate_volume_names

	ensure_volume "$MACKAS_VOL_TMP"    "$MACKAS_VOLUME_SIZE_TMP"    "TMPDIR -> /build"
	ensure_volume "$MACKAS_VOL_DL"     "$MACKAS_VOLUME_SIZE_DL"     "DL_DIR -> /downloads"
	ensure_volume "$MACKAS_VOL_SSTATE" "$MACKAS_VOLUME_SIZE_SSTATE" "SSTATE_DIR -> /sstate"

	if volume_exists "$MACKAS_VOL_LEGACY"; then
		warn "      volume '$MACKAS_VOL_LEGACY' is left over from the old single-volume"
		warn "      scheme and is no longer used by anything. Nothing here will touch it."
		warn "      Remove it once you are sure you want nothing in it:"
		warn "        container volume delete $(printf '%q' "$MACKAS_VOL_LEGACY")"
	fi

	info "      These are reached via '$SCRIPT_CMD smoketest' / '$SCRIPT_CMD shell', which pass"
	info "      them to kas with --runtime-args. They are NOT visible on the host."
}

setup_kas_container() {
	step "kas-container v$KAS_CONTAINER_VERSION"
	local want_sum have_sum

	# Migration, before anything else: every Mac that ran an older mackas has
	# the raw upstream script sitting directly at KAS_CONTAINER_BIN (the path
	# $PATH resolves for 'kas-container'). Move it aside to .real -- a pure
	# `mv`, no re-download -- so write_kas_wrapper() below can put a
	# protection wrapper where $PATH actually finds it. Only when it already
	# verifies against the pin: an unverified file is exactly what the
	# re-fetch path below exists to replace, so let it fall through to that
	# instead of migrating something we cannot trust.
	if [ ! -e "$KAS_CONTAINER_REAL" ] && [ -x "$KAS_CONTAINER_BIN" ]; then
		have_sum="$(shasum -a 256 "$KAS_CONTAINER_BIN" | awk '{print $1}')"
		if [ "$have_sum" = "$KAS_CONTAINER_SHA256" ]; then
			run mv "$KAS_CONTAINER_BIN" "$KAS_CONTAINER_REAL"
			did "moved raw kas-container aside -> $KAS_CONTAINER_REAL so a protection wrapper can take its place"
		fi
	fi

	if [ -x "$KAS_CONTAINER_REAL" ]; then
		have_sum="$(shasum -a 256 "$KAS_CONTAINER_REAL" | awk '{print $1}')"
		if [ "$have_sum" = "$KAS_CONTAINER_SHA256" ]; then
			skip "kas-container $KAS_CONTAINER_VERSION verified (sha256 ok)"
			# Regenerate unconditionally -- see write_kas_wrapper()'s own
			# comment for why returning here without it would be the bug.
			write_kas_wrapper
			return
		fi
		warn "      existing kas-container has unexpected sha256; re-fetching"
	fi

	run mkdir -p "$MACKAS_BIN"
	run curl -fsSL -o "$KAS_CONTAINER_REAL" "$KAS_CONTAINER_URL"
	run chmod +x "$KAS_CONTAINER_REAL"

	if [ "$DRY_RUN" -eq 1 ]; then
		printf '%s+ verify sha256 == %s%s\n' "$C_DIM" "$KAS_CONTAINER_SHA256" "$C_RST"
		write_kas_wrapper
		return
	fi

	have_sum="$(shasum -a 256 "$KAS_CONTAINER_REAL" | awk '{print $1}')"
	if [ "$have_sum" != "$KAS_CONTAINER_SHA256" ]; then
		rm -f "$KAS_CONTAINER_REAL"
		die "kas-container sha256 mismatch (got $have_sum, want $KAS_CONTAINER_SHA256)" \
			"the upstream tag may have moved; verify $KAS_CONTAINER_URL by hand"
	fi
	want_sum="$("$KAS_CONTAINER_REAL" --version 2>&1 | head -1 || true)"
	did "installed $KAS_CONTAINER_REAL ($want_sum, sha256 ok)"
	write_kas_wrapper
}

# write_kas_wrapper -- (re)generate the protection wrapper that lands at
# KAS_CONTAINER_BIN, the path $PATH actually resolves 'kas-container' to.
# KAS_CONTAINER_REAL (the pinned upstream script) never sits on $PATH itself.
#
# Called unconditionally at the end of setup_kas_container(), on every path
# including the skip path where .real was already verified and nothing else
# changed -- exactly like env.sh/gitconfig regeneration elsewhere in this
# file: deterministic, idempotent, cheap to redo. Returning early on that
# skip path without writing this file would leave a verified .real with no
# wrapper in front of it, which is the exact bug this mechanism exists to
# close: a bare, hand-typed 'kas-container build ...' on $PATH would run the
# raw upstream script directly, at Apple's cpus=4/memory=1gb defaults, with
# no ext4 volumes attached at all.
#
# Quoting discipline copies setup_shim_and_env()'s own generated env.sh:
# every interpolated value goes through shq() before it lands in the
# heredoc, never raw inside a "..." -- a MACKAS_ROOT or gitconfig path with a
# double quote or $ in it is a legal APFS path, not an edge case, and pasting
# it straight into the heredoc would make it code the wrapper's own shell
# executes rather than an inert value.
write_kas_wrapper() {
	if [ "$DRY_RUN" -eq 1 ]; then
		printf '%s+ write %s%s\n' "$C_DIM" "$KAS_CONTAINER_BIN" "$C_RST"
		return
	fi

	# Every value that becomes CODE below is shq()-quoted first, for the reason
	# spelled out in setup_shim_and_env(): the raw form was an injection.
	# BREW_BIN is on this list because it used to be a hardcoded literal --
	# turning it into a variable put it straight back inside a raw "..." until
	# this line existed. No q_rtargs: the frozen --runtime-args string is gone
	# from the generated file entirely (issue #96) -- there is nothing to quote.
	local q_real q_shim q_brew q_self q_work q_image q_gitconfig q_scriptname q_projsel
	q_real="$(shq "$KAS_CONTAINER_REAL")"
	q_shim="$(shq "$SHIM_DIR")"
	q_brew="$(shq "$BREW_BIN")"
	q_self="$(shq "$SCRIPT_DIR/$SCRIPT_NAME")"
	q_work="$(shq "$MACKAS_WORK")"
	q_image="$(shq "$KAS_IMAGE")"
	q_gitconfig="$(shq "$MACKAS_GITCONFIG")"
	q_scriptname="$(shq "$SCRIPT_NAME")"
	# Empty unless this setup ran under --project/$MACKAS_PROJECT_SELECT.
	q_projsel="$(shq "$PROJECT_SELECTED")"

	run mkdir -p "$MACKAS_BIN"
	cat > "$KAS_CONTAINER_BIN" <<EOF
#!/bin/sh
# Generated by $SCRIPT_NAME v$SCRIPT_VERSION -- a protection wrapper, not the
# real kas-container. Do not edit by hand; re-run '$SCRIPT_NAME setup' to
# regenerate it (cheap, deterministic, safe to redo any time).
#
# \$PATH resolves 'kas-container' to THIS file, never KAS_CONTAINER_REAL (the
# real upstream script, baked in below) directly -- so a bare, hand-typed
# 'kas-container build ...' gets the same volumes/limits/gitconfig treatment
# as '$SCRIPT_NAME smoketest'/'$SCRIPT_NAME shell', instead of silently
# launching at Apple's cpus=4/memory=1gb defaults with NO ext4 volumes
# attached (see kas_runtime_args() in $SCRIPT_NAME for why bind-mounting
# APFS in their place would be actively wrong, not merely slower).
#
# POSIX /bin/sh only, no bash-only syntax (no arrays, no 'local') -- this may
# be invoked by any shell that happens to be on \$PATH, not just the one
# $SCRIPT_NAME itself runs under.

KAS_CONTAINER_REAL=$q_real
SHIM_DIR=$q_shim
BREW_BIN=$q_brew
MACKAS_SELF=$q_self
MACKAS_WORK=$q_work
KAS_IMAGE=$q_image
MACKAS_GITCONFIG=$q_gitconfig
SCRIPT_NAME=$q_scriptname

# Which pinned project's config every value above was frozen from, empty for
# the default search path. Replayed into the live recompute below: without it,
# a wrapper written by '$SCRIPT_NAME --project A setup' would recompute
# --runtime-args off whatever the default search path finds, and hand another
# project's ext4 volumes to a build whose work dir and gitconfig are A's.
# Passed explicitly even when empty, which also stops an exported
# \$MACKAS_PROJECT_SELECT in the calling shell from re-aiming this wrapper at
# a project it was not built for.
#
# This pins the SELECTOR only, not \$MACKAS_CONF -- so it does NOT guarantee
# the recompute resolves the same config this file was generated from. With
# this pin empty, an exported \$MACKAS_CONF still re-aims the recompute at
# another config's volume names while the values above stay frozen to the
# first: the same hazard, through the other door. Freezing a typed path into
# a generated file is a separate design call (a path is a per-invocation
# request and can go stale), tracked in issue #96 -- do not read this pin as
# closing that case.
MACKAS_PROJECT_PIN=$q_projsel

# There is deliberately NO frozen copy of --runtime-args in this file any
# more (issue #96). It used to be the fallback for a failed live recompute,
# which made every guard $SCRIPT_NAME applies while computing that string --
# a volume-name collision, a held volume, an ambiguous project -- degrade to
# a warning plus a build on setup-time values through this path alone.

# Re-entry guard. KAS_CONTAINER_REAL must never lead back to this wrapper --
# a symlink loop, or .real somehow replaced by a copy of this file -- would
# otherwise re-inject --runtime-args and call itself again forever, a fork
# bomb instead of a clean failure.
if [ "\$MACKAS_KAS_WRAPPED" = "1" ]; then
	echo "\$SCRIPT_NAME: kas-container wrapper re-entry detected; execing the real binary directly" >&2
	exec "\$KAS_CONTAINER_REAL" "\$@"
fi

# Auto-start the container runtime if it is not up yet -- the same
# container_running()/ensure_container_running() check $SCRIPT_NAME itself
# runs before 'shell'/'exec'/'smoketest' (issue #33). The daemon does not
# survive a reboot; without this, a hand-typed kas-container invocation would
# hit whatever raw error the daemon-down state produces instead of a clear
# message.
if ! container system status >/dev/null 2>&1 || \\
   ! container system status 2>/dev/null | awk '\$1=="status" {print \$2}' | grep -q '^running\$'; then
	container system start
	if ! container system status >/dev/null 2>&1 || \\
	   ! container system status 2>/dev/null | awk '\$1=="status" {print \$2}' | grep -q '^running\$'; then
		echo "\$SCRIPT_NAME: container system did not start; check by hand: container system status" >&2
		exit 1
	fi
fi

# If the caller already passed --runtime-args/--docker-args itself, do not
# inject a second one: kas-container ACCUMULATES repeated --runtime-args
# values instead of the last one winning, so adding ours alongside the
# caller's own would double every -v mount rather than replace it. Only the
# LEADING options are scanned -- up to the first token that is not itself an
# option, kas's own subcommand/file-list argument -- so a later, unrelated
# positional value can never be mistaken for this flag.
for _mackas_kas_arg in "\$@"; do
	case "\$_mackas_kas_arg" in
		--runtime-args|--docker-args|--runtime-args=*|--docker-args=*)
			MACKAS_KAS_WRAPPED=1 exec "\$KAS_CONTAINER_REAL" "\$@"
			;;
		-*)
			;;
		*)
			break
			;;
	esac
done

# Live recompute: ask $SCRIPT_NAME itself for today's --runtime-args string,
# so a setting change (MACKAS_MONITOR, MACKAS_USE_NFS_MIRRORS, a
# MACKAS_VOLUME_NAME override, ...) reaches a hand-typed 'kas-container ...'
# the same way it already reaches '$SCRIPT_NAME smoketest'/'shell', not just
# after the next '$SCRIPT_NAME setup'.
#
# --require-volumes-free asks that same call for run_kas()'s one-VM check
# too: a hand-typed 'kas-container build' is a second, independent way into
# the very hazard that guard exists to close, and only \$SCRIPT_NAME can
# answer it (see cmd_runtime_args() for why the check rides on this call
# rather than being reimplemented here or asked for separately). It runs
# after the daemon start above on purpose -- the query reads "nothing holds
# it" with the runtime down.
#
# stderr is NOT redirected: whatever \$SCRIPT_NAME says -- a die() naming the
# held volume or the colliding names, a warning that MACKAS_MONITOR=1 could
# not be wired up -- is the diagnosis, and it belongs in front of the person
# who typed the command, verbatim and in order.
#
# '|| _mackas_rt_rc=\$?' rather than a bare assignment: under 'set -e' a
# failing command substitution would abort this script before the refusal
# below could explain itself, and it also keeps the exit status, which a
# bare assignment discards.
_mackas_rt_rc=0
rt="\$(MACKAS_PROJECT_SELECT="\$MACKAS_PROJECT_PIN" "\$MACKAS_SELF" runtime-args --require-volumes-free --expect-work "\$MACKAS_WORK")" || _mackas_rt_rc=\$?

# FATAL, never a fallback (issue #96). Everything \$SCRIPT_NAME refuses while
# computing this string is a safety guard -- a held volume, two volume names
# resolving to one, a project that cannot be derived unambiguously -- and
# each of them means the setup-time values are no longer known to be right,
# which is exactly when quietly reusing them does the damage. Failing here
# is the same outcome the equivalent '\$SCRIPT_NAME shell' would produce; a
# wrapper that is more permissive than the command it wraps is a bypass, not
# a convenience.
if [ "\$_mackas_rt_rc" -ne 0 ]; then
	echo "\$SCRIPT_NAME: refusing to launch kas-container -- '\$SCRIPT_NAME runtime-args' exited \$_mackas_rt_rc (its message is above)" >&2
	echo "\$SCRIPT_NAME: not falling back to the values baked in at setup time: they may name volumes this build must not touch" >&2
	exit 1
fi

# Validate the string that is about to be used: it must be non-empty and
# name all three ext4 volumes kas_runtime_args() always emits. This catches
# what a zero exit status cannot -- a truncated or empty answer from a
# stale/incompatible \$SCRIPT_NAME that still returns success. Refusing here,
# rather than exec'ing anyway, is deliberate -- a multi-hour build with no
# protected storage attached is strictly worse than failing fast before it
# ever starts.
_mackas_kas_ok=1
case "\$rt" in
	*":/build"*) ;;
	*) _mackas_kas_ok=0 ;;
esac
case "\$rt" in
	*":/downloads"*) ;;
	*) _mackas_kas_ok=0 ;;
esac
case "\$rt" in
	*":/sstate"*) ;;
	*) _mackas_kas_ok=0 ;;
esac
if [ -z "\$rt" ] || [ "\$_mackas_kas_ok" != "1" ]; then
	echo "\$SCRIPT_NAME: refusing to launch kas-container -- --runtime-args is empty or missing an ext4 volume (/build, /downloads, /sstate); this would build with NO protected storage attached" >&2
	echo "\$SCRIPT_NAME: next: \$SCRIPT_NAME setup   # reinstalls the wrapper against this \$SCRIPT_NAME" >&2
	exit 1
fi

# The fragment-append (macos-local.yml: parallelism, BB_DISKMON_DIRS,
# BB_HASHSERVE_DB_DIR, mirrors) only happens in env.sh's kas-container() shell
# function, which sets MACKAS_KAS_FRAGMENT_DONE=1 right before handing off
# here -- so this note stays quiet for any call that went through it. It
# prints only when THIS invocation bypassed that function entirely (nohup,
# env, a bare \$PATH lookup, or a shell that never sourced env.sh), the one
# case where the fragment genuinely was never appended.
if [ "\$MACKAS_KAS_FRAGMENT_DONE" != "1" ]; then
	echo "\$SCRIPT_NAME: macos-local.yml was not appended to this invocation (it did not go through the env.sh shell function) -- '$SCRIPT_NAME smoketest'/'$SCRIPT_NAME shell' are the fully-featured path" >&2
fi

# KAS_BUILD_DIR/DL_DIR/SSTATE_DIR are set EMPTY, not unset: an old env.sh
# sourced in this shell may still export them at an APFS path, and a
# non-empty value would make kas-container's forward_dir() bind-mount that
# path over the ext4 volume \$rt just asked for. forward_dir() returns early
# only on an empty value, not on an unset one -- see run_kas()'s own comment
# in $SCRIPT_NAME for the fuller story.
#
# --runtime-args must be given BEFORE \$@: kas-container's own argument
# parser stops recognizing its own flags at the first non-option token (the
# subcommand), so appending it after \$@ would leave it unparsed.
#
# GITCONFIG_FILE honours one already in the environment (":-", exactly like
# env.sh's own GITCONFIG_FILE handling) -- a value the user exported
# themselves always wins over the one baked in here at generation time.
exec env PATH="\$SHIM_DIR:\$BREW_BIN:\$PATH" \\
	MACKAS_KAS_WRAPPED=1 \\
	KAS_CONTAINER_ENGINE=$MACKAS_KAS_ENGINE \\
	KAS_WORK_DIR="\$MACKAS_WORK" \\
	KAS_CONTAINER_IMAGE="\$KAS_IMAGE" \\
	GITCONFIG_FILE="\${GITCONFIG_FILE:-\$MACKAS_GITCONFIG}" \\
	KAS_BUILD_DIR= DL_DIR= SSTATE_DIR= \\
	"\$KAS_CONTAINER_REAL" --runtime-args "\$rt" "\$@"
EOF
	run chmod +x "$KAS_CONTAINER_BIN"
	did "wrote $KAS_CONTAINER_BIN"
}

setup_project() {
	step "project $MACKAS_PROJECT_DIR (branch $MACKAS_PROJECT_BRANCH)"
	if [ -d "$MACKAS_PROJECT/.git" ]; then
		local br
		# symbolic-ref, not rev-parse --abbrev-ref: the latter prints the
		# literal string "HEAD" (not empty) on a detached checkout -- the
		# normal state for an adopted, kas-pinned layer. MACKAS_PROJECT_BRANCH
		# is empty for exactly that case (see adopt_introspect_project), so
		# both sides read empty and this correctly takes the "leave it alone"
		# branch below instead of trying to fetch/checkout an empty ref.
		br="$(git -C "$MACKAS_PROJECT" symbolic-ref --short -q HEAD 2>/dev/null || true)"
		if [ "$br" = "$MACKAS_PROJECT_BRANCH" ]; then
			# Already on the wanted branch: leave it alone. A live checkout may
			# have uncommitted work or fetched layers -- never re-clone over it.
			skip "$MACKAS_PROJECT_DIR on branch $MACKAS_PROJECT_BRANCH at $MACKAS_PROJECT"
		else
			run git -C "$MACKAS_PROJECT" fetch origin "$MACKAS_PROJECT_BRANCH"
			run git -C "$MACKAS_PROJECT" checkout "$MACKAS_PROJECT_BRANCH"
			did "switched $MACKAS_PROJECT_DIR to $MACKAS_PROJECT_BRANCH"
		fi
	else
		run mkdir -p "$MACKAS_WORK"
		run git clone --branch "$MACKAS_PROJECT_BRANCH" "$MACKAS_PROJECT_URL" "$MACKAS_PROJECT"
		did "cloned $MACKAS_PROJECT_DIR -> $MACKAS_PROJECT"
	fi
	info "      The remaining layers kas composes (openembedded-core and friends"
	info "      for the meta-ai example) are fetched by kas on the first build."
}

setup_kas_fragment() {
	step "kas fragment: $MACKAS_KAS_FRAGMENT_SRC"
	local mirrors=""

	if [ "$MACKAS_USE_NFS_MIRRORS" = "1" ] && [ "$MACKAS_USE_HTTP_MIRRORS" = "1" ]; then
		# Both would emit an SSTATE_MIRRORS line into the same fragment.
		# bitbake's '?=' makes the first one win silently, which is exactly the
		# kind of thing you debug for an hour. Refuse instead of guessing.
		die "MACKAS_USE_NFS_MIRRORS and MACKAS_USE_HTTP_MIRRORS are both 1" \
			"pick one in $(config_hint); HTTP is the recommended path (see README)"
	fi

	if [ "$MACKAS_USE_HTTP_MIRRORS" = "1" ]; then
		# The recommended path. No virtiofs, no NFS-in-guest, no sudo: the
		# container reaches the mirror host over its vmnet NAT and speaks
		# plain HTTP, which is bitbake's own officially-supported mechanism.
		#
		# ';downloadfilename=PATH' IS valid here and IS needed: for an http://
		# sstate mirror bitbake must be told what to call the file it fetches,
		# and 'PATH' is the same literal placeholder as in the URL. It is NOT
		# valid for the file:// mirrors above -- that asymmetry is real, not a
		# copy-paste slip.
		mirrors="$(cat <<FRAG
    SSTATE_MIRRORS ?= "file://.* ${MACKAS_HTTP_MIRROR_SSTATE}/PATH;downloadfilename=PATH"
    SOURCE_MIRROR_URL ?= "${MACKAS_HTTP_MIRROR_DL}"
    INHERIT += "own-mirrors"
    BB_GENERATE_MIRROR_TARBALLS ?= "0"
FRAG
)"
	elif [ "$MACKAS_USE_NFS_MIRRORS" = "1" ]; then
		# Read-only mirrors, mounted into the container by --runtime-args.
		#
		# SSTATE_MIRRORS: 'PATH' is a literal placeholder that bitbake
		# substitutes with the sstate object's own hashed subpath, so the
		# mirror is searched using the same layout sstate-cache has on disk.
		# (The ';downloadfilename=PATH' suffix seen in the OpenEmbedded docs is only
		# needed for http:// sstate mirrors, not local file:// ones.)
		#
		# Downloads: own-mirrors + SOURCE_MIRROR_URL is the supported way to
		# add a pre-mirror for source fetches; it expands into PREMIRRORS for
		# every fetcher. file:// URLs need no auth and fall through to the
		# real upstream if the tarball isn't in the mirror.
		mirrors="$(cat <<'FRAG'
    SSTATE_MIRRORS ?= "file://.* file:///sstate-mirror/PATH"
    SOURCE_MIRROR_URL ?= "file:///downloads-mirror"
    INHERIT += "own-mirrors"
    BB_GENERATE_MIRROR_TARBALLS ?= "0"
FRAG
)"
	fi

	# Built as its own single-quoted variable, NOT typed inline in the heredoc
	# below -- this is a proven-shipped bug (see README/TODO), and the cause is
	# subtle enough to write down. bash's unquoted-heredoc processing treats a
	# literal "\" immediately followed by a real newline as a line
	# CONTINUATION and SPLICES IT AWAY -- and it does this even when that "\"
	# was itself the product of unescaping a typed "\\", because the splice
	# scan runs over the raw source text before "\\" -> "\" unescaping is
	# applied. So the obvious way to write this --
	#   BB_DISKMON_DIRS ??= "\\
	#       HALT,\${TMPDIR},2G,100K \\
	# -- collapsed at generation time into ONE line: a single "\" followed by
	# a run of spaces where each newline used to be, which is exactly what
	# shipped. A single-quoted variable assignment has NO escape processing at
	# all, so its embedded backslashes and newlines survive completely
	# literally; interpolating "$diskmon_dirs" into the heredoc below is then
	# a plain parameter expansion, which never re-parses for continuations.
	# Do not "simplify" this back into an inline heredoc. Verified by `cat`ing
	# the actual generated file on disk, not just eyeballing the source --
	# see tests/volumes.bats.
	local diskmon_dirs
	# shellcheck disable=SC2016  # deliberately single-quoted: ${TMPDIR} etc.
	# must reach bitbake literally, not be expanded by this shell.
	diskmon_dirs='    BB_DISKMON_DIRS ??= "\
      HALT,${TMPDIR},2G,100K \
      HALT,${DL_DIR},2G,100K \
      HALT,${SSTATE_DIR},2G,100K"'

	# Precomputed, not embedded as a $(...) substitution inside the heredoc
	# below -- see the quote-parity note just above the heredoc for why.
	local mirrors_block=""
	[ -n "$mirrors" ] && mirrors_block="$(printf '  macos-mirrors: |\n%s\n' "$mirrors")"

	# NOTE FOR FUTURE EDITS: bash's unquoted-heredoc lexer (this one included,
	# 3.2 and later alike) tracks single-quote (') balance across the WHOLE
	# heredoc body even though the body is otherwise literal text -- an ODD
	# total count of literal "'" characters anywhere in it is enough to make
	# bash 3.2 report "unexpected EOF while looking for matching `''" at the
	# very end of the script, nowhere near the real cause. This bit mackas
	# once already (adding the macos-hashserve block below tipped an
	# until-then-even apostrophe count to odd). So: no apostrophes/contractions
	# and no scare-quoted 'words' in the heredoc body below -- rephrase
	# instead of reaching for a quote mark. Verify any change here with
	# /bin/bash -n (the real macOS 3.2, not just Homebrew's bash 5).
	local content
	content="$(cat <<EOF
# Generated by $SCRIPT_NAME v$SCRIPT_VERSION -- macOS / Apple container tuning.
# Canonical copy: $MACKAS_KAS_FRAGMENT_SRC
# Installed into the project checkout as kas/macos-local.yml because
# kas-container only mounts files that live under the repo directory.
#
# Compose it last so it wins:
#   kas-container build $KAS_FILES_ARG
header:
  version: 14

local_conf_header:
  macos-parallelism: |
    BB_NUMBER_THREADS ?= "$MACKAS_CPUS"
    PARALLEL_MAKE ?= "-j $MACKAS_CPUS"
  macos-diskmon: |
    # Each of these is a separate, fixed-size ext4 volume, so disk full here
    # means one volume, not the Mac. HALT (not WARN) because bitbake filling a
    # TMPDIR mid-task leaves half-written sstate objects behind, which is far
    # more annoying to unpick than a stopped build. The 2G/100K thresholds are
    # the exact shape bitbake documents: halt with 2 GiB or 100k inodes left.
    #
    # This is a backstop for the volume, NOT for the SSD -- the volume caps
    # are what keep a runaway build away from the free space Time Machine
    # needs.
$diskmon_dirs
  macos-hashserve: |
    # bitbake warns at parse time if this is left unset: SSTATE_DIR is an
    # ext4 volume SHARED across builds, but the hash-equivalence database
    # defaults to living inside the per-build /build volume, which mackas
    # clean throws away -- silently discarding sstate reuse on every clean
    # instead of just TMPDIR. Put the database in the same volume as the
    # sstate it indexes so it survives exactly as long as the cache does.
    #
    # NOT the same fix as the BB_HASHSERVE_DB_DIR forward built into
    # kas-container as of v5.5 (line 642, forward_dir BB_HASHSERVE_DB_DIR
    # "/bb-hashserve-db" "rw" -- absent in 5.4, confirmed against both
    # versions' source directly): it only activates if the HOST shell has
    # BB_HASHSERVE_DB_DIR set, which mackas deliberately never does (see
    # tests/volumes.bats' env.sh assertion), so it stays inert either way --
    # but using it on purpose would -v bind-mount a HOST directory at
    # /bb-hashserve-db, putting this database back on APFS over virtiofs,
    # which is the exact bug the ext4 volumes exist to avoid. Setting it
    # here, in local.conf, keeps it inside the /sstate volume instead -- no
    # env var, no bind mount, no virtiofs.
    BB_HASHSERVE_DB_DIR = "\${SSTATE_DIR}"
$mirrors_block
EOF
)"

	if [ "$DRY_RUN" -eq 1 ]; then
		printf '%s+ write %s and %s%s\n' "$C_DIM" "$MACKAS_KAS_FRAGMENT_SRC" "$MACKAS_KAS_FRAGMENT_REPO" "$C_RST"
		return
	fi

	mkdir -p "$MACKAS_KAS"
	printf '%s\n' "$content" > "$MACKAS_KAS_FRAGMENT_SRC"
	did "wrote $MACKAS_KAS_FRAGMENT_SRC"

	# The fragment must land at kas/macos-local.yml UNDER the checkout, because
	# kas-container only mounts files below the repo dir and KAS_FILES_ARG
	# refers to it by that relative path. Create the kas/ dir if this project
	# does not already ship one -- not every layer repo does.
	if [ -d "$MACKAS_PROJECT/.git" ]; then
		mkdir -p "$MACKAS_PROJECT/kas"
		cp "$MACKAS_KAS_FRAGMENT_SRC" "$MACKAS_KAS_FRAGMENT_REPO"
		did "installed $MACKAS_KAS_FRAGMENT_REPO"
		# Keep the checkout clean.
		local excl="$MACKAS_PROJECT/.git/info/exclude"
		if [ -f "$excl" ] && ! grep -qxF "kas/macos-local.yml" "$excl"; then
			printf 'kas/macos-local.yml\n' >> "$excl"
			did "added kas/macos-local.yml to the checkout's .git/info/exclude"
		fi
	else
		warn "      $MACKAS_PROJECT not cloned yet; re-run setup after the project checkout exists"
	fi
}

setup_image() {
	step "Pull $KAS_IMAGE"
	if image_present "$KAS_IMAGE"; then
		skip "$KAS_IMAGE already present"
		return
	fi
	run container image pull "$KAS_IMAGE"
	did "pulled $KAS_IMAGE"
}

setup_usage() {
	cat <<EOF
${C_BLD}$SCRIPT_CMD setup${C_RST} -- do the full setup. Idempotent -- safe to re-run
after a crash, or after changing settings.

${C_BLD}USAGE${C_RST}
  $SCRIPT_CMD setup [<root>] [--tmpdir-size <size>] [--sstate-size <size>]
                    [--downloads-size <size>]

  <root>               MACKAS_ROOT for this run (a case-sensitive volume).
  --tmpdir-size <size>    TMPDIR volume size, e.g. 1T, 200G (default 120G).
  --sstate-size <size>    sstate volume size (default 40G).
  --downloads-size <size> Downloads volume size (default 40G).

These are one-shot for this invocation, exactly like --set -- they are not
written to the config file. If <root> or a size is not given here, and is
not already set by --set/the environment/the config file, and this is
running on a terminal, setup ASKS for it interactively (Enter keeps the
current value).

Downloads the pinned, sha256-verified kas-container release; installs the
docker->container shim; creates the three ext4 volumes (TMPDIR, downloads,
sstate); and writes env.sh, the git dubious-ownership workaround, and the
generated kas fragment. Each step is skipped if it is already done, so
re-running is always safe -- nothing here is destructive. If no project is
configured (MACKAS_PROJECT_URL is empty), the project checkout and its kas
fragment are skipped -- not required for the rest of this to work -- with a
message on how to add one and re-run.

Options: --dry-run (print every mutating command, change nothing), -y/--yes
(or -f/--force, for the sudo prompts an external volume may need) and
-v/--verbose all work here too.
EOF
}

# validate_setup_size FLAG VALUE -- keeps whitespace/garbage out of a size
# given directly on setup's own command line or typed at its interactive
# prompt, before it ever reaches MACKAS_VOLUME_SIZE_*. Same shape
# valid_size_shape()/size_to_gb()/size_to_bytes() all agree on: digits,
# optionally followed by t/tb/tib, g/gb/gib or m/mb/mib -- so e.g. "512K"
# is refused here rather than silently read as 512 GiB by the budgeting math.
validate_setup_size() {
	local flag="$1" val="$2"
	valid_size_shape "$val" || die "$flag '$val' is not a size like 1T, 200G or 512M" "$SCRIPT_CMD setup --help"
}

# prompt_setup_settings -- ask for whichever of the root path / three volume
# sizes is not already resolved (setting_is_explicit) via this invocation's
# own flag, --set, the environment or the config file -- one prompt per
# setting, never a single lump, so anything already pinned down another way
# is never re-asked. Enter keeps the current value (the factory default, for
# a size never configured at all). Never runs when stdin is not a terminal,
# same guard confirm() uses -- a non-interactive invocation behaves exactly
# as it always has: sizes stay at their defaults, MACKAS_ROOT falls through
# to require_mackas_root's own $PWD fallback.
prompt_setup_settings() {
	[ -t 0 ] || return 0
	local reply

	if ! setting_is_explicit MACKAS_ROOT; then
		printf '%sRoot path for OpenEmbedded builds%s [nothing configured, falls back to the current directory]: ' \
			"$C_BLD" "$C_RST"
		read -r reply || reply=""
		[ -n "$reply" ] && MACKAS_ROOT="$reply"
	fi

	if ! setting_is_explicit MACKAS_VOLUME_SIZE_TMP; then
		printf '%sTMPDIR volume size%s [%s]: ' "$C_BLD" "$C_RST" "$MACKAS_VOLUME_SIZE_TMP"
		read -r reply || reply=""
		if [ -n "$reply" ]; then
			validate_setup_size "TMPDIR volume size" "$reply"
			MACKAS_VOLUME_SIZE_TMP="$reply"
		fi
	fi

	if ! setting_is_explicit MACKAS_VOLUME_SIZE_DL; then
		printf '%sDownloads volume size%s [%s]: ' "$C_BLD" "$C_RST" "$MACKAS_VOLUME_SIZE_DL"
		read -r reply || reply=""
		if [ -n "$reply" ]; then
			validate_setup_size "Downloads volume size" "$reply"
			MACKAS_VOLUME_SIZE_DL="$reply"
		fi
	fi

	if ! setting_is_explicit MACKAS_VOLUME_SIZE_SSTATE; then
		printf '%ssstate volume size%s [%s]: ' "$C_BLD" "$C_RST" "$MACKAS_VOLUME_SIZE_SSTATE"
		read -r reply || reply=""
		if [ -n "$reply" ]; then
			validate_setup_size "sstate volume size" "$reply"
			MACKAS_VOLUME_SIZE_SSTATE="$reply"
		fi
	fi
}

cmd_setup() {
	local a val root="" want_help=0
	while [ "$#" -gt 0 ]; do
		case "$1" in
			# -h/--help/bare 'help' anywhere means help, the same shape
			# cmd_volume's own tail-parsing already established: 'setup' owns
			# everything after it (main()'s own -h/--help/help only fires
			# BEFORE the word 'setup' is seen), so it has to recognise these
			# itself rather than fall through to "unknown option"/"the root
			# path is literally the word help".
			-h|--help|help) want_help=1; shift ;;
			--dry-run)     DRY_RUN=1; shift; continue ;;
			-y|-f|--yes|--force)  ASSUME_YES=1; shift; continue ;;
			-v|--verbose)  VERBOSE=1; shift; continue ;;
			--version)     echo "$SCRIPT_NAME $SCRIPT_VERSION"; exit 0 ;;
			--config|--config=*|--project|--project=*|--set|--set=*) die_on_misplaced_global_flag "$1" setup ;;
			--tmpdir-size|--sstate-size|--downloads-size)
				a="$1"; val="${2:-}"
				[ -n "$val" ] || die "$a needs a value" "$SCRIPT_CMD setup --help"
				shift 2 ;;
			--tmpdir-size=*|--sstate-size=*|--downloads-size=*)
				a="${1%%=*}"; val="${1#*=}"
				shift ;;
			-*) die "unknown option for 'setup': $1" "$SCRIPT_CMD setup --help" ;;
			*)
				[ -z "$root" ] || die "'setup' takes one root path at most" "$SCRIPT_CMD setup --help"
				root="$1"
				shift
				continue ;;
		esac
		[ "$want_help" -eq 1 ] && continue
		validate_setup_size "$a" "$val"
		case "$a" in
			--tmpdir-size)    MACKAS_VOLUME_SIZE_TMP="$val";    __EXPLICIT_MACKAS_VOLUME_SIZE_TMP=1 ;;
			--sstate-size)    MACKAS_VOLUME_SIZE_SSTATE="$val"; __EXPLICIT_MACKAS_VOLUME_SIZE_SSTATE=1 ;;
			--downloads-size) MACKAS_VOLUME_SIZE_DL="$val";     __EXPLICIT_MACKAS_VOLUME_SIZE_DL=1 ;;
		esac
	done
	if [ "$want_help" -eq 1 ]; then
		setup_usage
		return 0
	fi
	if [ -n "$root" ]; then
		MACKAS_ROOT="$root"
		__EXPLICIT_MACKAS_ROOT=1
	fi

	prompt_setup_settings

	# MACKAS_ROOT/the sizes may just have changed above (own flag, or the
	# interactive prompt) -- main() already ran validate_settings/derive_paths
	# once, against the OLD values. Redo both: derive_paths is what computes
	# MACKAS_WORK/MACKAS_BASE/etc. from MACKAS_ROOT, and require_mackas_root's
	# own re-derive (see its own comment) only fires when IT is the one
	# setting MACKAS_ROOT, which no longer happens here if a value was just
	# given.
	validate_settings
	derive_paths

	require_mackas_root
	info "${C_BLD}mackas setup${C_RST}  (config: ${CONFIG_FILE_USED:-none, using built-in defaults})"
	if [ "$DRY_RUN" -eq 1 ]; then
		warn "--dry-run: printing mutating commands, changing nothing."
	fi

	# Set STEP_TOTAL based on whether project steps are needed. When no
	# project is configured, the setup_project and setup_kas_fragment steps
	# are skipped, so only 9 of the 11 steps run.
	if [ -n "$MACKAS_PROJECT_URL" ]; then
		STEP_TOTAL=11
	else
		STEP_TOTAL=9
	fi

	setup_runtime
	setup_oe_root
	setup_short_link
	setup_shim_and_env
	setup_gitconfig
	setup_relocate_volumes
	# The image comes before the volumes: chowning a fresh volume's root runs a
	# throwaway container from it.
	setup_image
	setup_volumes
	setup_kas_container
	if [ -n "$MACKAS_PROJECT_URL" ]; then
		setup_project
		setup_kas_fragment
	else
		info "no project configured (MACKAS_PROJECT_URL is empty) -- skipping project checkout"
		info "  set MACKAS_PROJECT_URL/_BRANCH/_DIR/_KAS_CONFIG in $(config_hint), then re-run setup"
	fi

	hdr "Done"
	info "  source $MACKAS_ENV_SH"
	info "  $SCRIPT_CMD check     # confirm the shim now wins on PATH"
	info "  $SCRIPT_CMD smoketest # parse-only, then the small-target ladder"
	if [ "$MACKAS_USE_NFS_MIRRORS" = "1" ] && ! mount | grep -qF " on $MACKAS_NFS_MOUNT "; then
		info ""
		info "  NFS mirrors are enabled but not mounted. Run:"
		info "    sudo mkdir -p $(printf '%q' "$MACKAS_NFS_MOUNT")"
		info "    sudo mount -t nfs -o resvport,vers=3,ro,nolocks,locallocks ${MACKAS_NFS_SERVER}:${MACKAS_NFS_EXPORT} $(printf '%q' "$MACKAS_NFS_MOUNT")"
		info "    (vers=3 is PINNED: '-o vers=4' kernel-panics macOS -- see docs/storage.md)"
	fi
}

# ---------------------------------------------------------------------------
# adopt -- bring a foreign MACKAS_ROOT (another Mac's mackas set it up) back
# to a working build on THIS Mac, without clobbering anything this Mac
# already has for an unrelated project. See TODO.md item 23 for the full
# design/risk writeup this implements.
# ---------------------------------------------------------------------------

adopt_usage() {
	cat <<EOF
${C_BLD}$SCRIPT_CMD adopt${C_RST} -- bring a foreign MACKAS_ROOT (set up by a
different Mac's mackas -- an external drive moved over, or a network share)
back to a working build on THIS Mac.

${C_BLD}USAGE${C_RST}
  $SCRIPT_CMD adopt <path> [--project-dir NAME] [--write-config FILE]

Reuses whatever survived the move (an existing project checkout, relocated
volume images '$SCRIPT_CMD volume recover' can find), regenerates whatever is
host-specific (env.sh, gitconfig, the short link, the kas fragment), and
gives the adopted root its own volume name and short link so it never
collides with anything this Mac already has for an unrelated project.
Refuses outright if <path> turns out to already BE this Mac's own root --
that is '$SCRIPT_CMD setup'/'$SCRIPT_CMD check' territory, not adopt.

${C_BLD}OPTIONS${C_RST}
  --project-dir NAME   Which checkout under <path>/work/ to adopt, when more
                       than one exists (or none can be found automatically).
  --write-config FILE  Where to persist the new, per-project config (NOT
                       the global --config, which loads an EXISTING one).
                       Default: derived under ~/.config/mackas/projects/,
                       which is what makes it reachable later as
                       '$SCRIPT_CMD --project <name>' ('$SCRIPT_CMD projects').

Ends by handing off to '$SCRIPT_CMD setup', with the new config in scope, for
everything setup already does correctly on its own (project checkout,
volumes, kas-container, the shim, gitconfig).

If this Mac's machine-wide volume-relocation symlink already belongs to a
different, still-live local project, '$SCRIPT_CMD setup' (via
setup_relocate_volumes) will detect that and offer -- never silently do --
to switch it to this adopted root, leaving that other project's volumes
un-relocated until it is itself re-adopted/re-setup.

Options: --dry-run, -y/--yes (or -f/--force) and -v/--verbose work here too;
put them before or after 'adopt'.
EOF
}

# adopt_introspect_project PATH [PROJECT_DIR] -- print three lines (dir name,
# git remote URL, current branch) for the one project checkout to adopt, or
# die with a clear message when none/more than one is found and no
# PROJECT_DIR was given to disambiguate. Prints nothing (silently) when PATH
# has no work/ at all or no checkout inside it -- adopting infra only, no
# project, is a valid outcome (see cmd_setup's own "no project configured"
# path), not an error.
adopt_introspect_project() {
	local root="$1" want="${2:-}" dir candidates=() chosen=""

	if [ -n "$want" ]; then
		chosen="$root/work/$want"
		[ -d "$chosen/.git" ] || die "no git checkout at $chosen" \
			"check the directory name under $root/work/"
	else
		if [ -d "$root/work" ]; then
			for dir in "$root"/work/*/; do
				[ -d "${dir}.git" ] || continue
				candidates+=("${dir%/}")
			done
		fi
		case "${#candidates[@]}" in
			0) return 0 ;;
			1) chosen="${candidates[0]}" ;;
			*)
				warn "  more than one checkout under $root/work/:"
				for dir in "${candidates[@]}"; do warn "    $(basename "$dir")"; done
				die "'adopt' needs to know which one" \
					"$SCRIPT_CMD adopt $(printf '%q' "$root") --project-dir <name>"
				;;
		esac
	fi

	printf '%s\n' "$(basename "$chosen")"
	git -C "$chosen" remote get-url origin 2>/dev/null || printf '\n'
	# symbolic-ref, not rev-parse --abbrev-ref: the latter prints the literal
	# string "HEAD" (exit 0, not empty) on a detached checkout -- which is the
	# NORMAL state for a kas-managed layer (checked out to a pinned revision)
	# -- so the caller's "no branch" fallback below would never fire and a
	# later setup_project() would `git checkout HEAD`, re-detaching to
	# whatever HEAD resolves to instead of leaving it alone.
	git -C "$chosen" symbolic-ref --short -q HEAD 2>/dev/null || printf '\n'
}

# adopt_unique_volume_name BASE -- BASE disambiguated against every volume
# name already in use for something else, machine-wide (no per-root ownership
# record exists to check against, so collision-avoidance, not "is this
# already mine", is the honest guarantee here).
adopt_unique_volume_name() {
	local base="$1" n=2
	local candidate="mackas-$base"
	while volume_exists "${candidate}-tmp" || volume_exists "${candidate}-dl" \
	   || volume_exists "${candidate}-sstate"; do
		candidate="mackas-$base-$n"
		n=$((n + 1))
	done
	printf '%s\n' "$candidate"
}

# adopt_unique_short_link BASE REAL_TARGET -- a short link name distinct from
# anything else on this Mac, unless an existing one already points at
# REAL_TARGET itself (a re-adopt of the same root), in which case reuse it.
adopt_unique_short_link() {
	local base="$1" real_target="$2" n=2
	local candidate="$HOME/oe-$base"
	while [ -e "$candidate" ] || [ -L "$candidate" ]; do
		if [ -L "$candidate" ] && \
		   [ "$(resolve_path "$(readlink "$candidate")")" = "$real_target" ]; then
			break
		fi
		candidate="$HOME/oe-$base-$n"
		n=$((n + 1))
	done
	printf '%s\n' "$candidate"
}

# adopt_check_ownership ROOT -- Gap B. setup_oe_root's own chown offer (run
# later, via cmd_setup) only ever fixes ROOT's own top-level ownership, never
# what is underneath -- an adopted tree's work/ can carry files owned by the
# OTHER Mac's account throughout. macOS commonly mounts external volumes
# 'noowners' (every file already reads as the current user; nothing to
# fix) -- checked first so this never bothers asking when it plainly does
# not need to.
adopt_check_ownership() {
	local root="$1" mountpoint
	# volume_mount_point, not a bare `df -P | awk '{print $NF}'`: the
	# "Mounted on" column is field 6..NF, not just $NF -- a Finder-named
	# external drive routinely has a space in it (e.g. "1TB WD Blue"), and
	# $NF alone silently truncates to the last WORD, never matching the
	# `mount` line below and defeating this whole fast path.
	mountpoint="$(volume_mount_point "$root")"
	if [ -n "$mountpoint" ] && mount 2>/dev/null | grep -qF " on $mountpoint (" \
		&& mount 2>/dev/null | grep -F " on $mountpoint (" | grep -q 'noowners'; then
		return 0
	fi

	[ -d "$root/work" ] || return 0
	local foreign
	foreign="$(find "$root/work" ! -user "$(id -u)" -print -quit 2>/dev/null)"
	[ -n "$foreign" ] || return 0

	warn "  files under $root/work are owned by a different user (e.g. $foreign)."
	warn "  Likely the other Mac's account -- a recursive chown is a much bigger"
	warn "  blast radius than setup's own single-directory one (this can take a"
	warn "  while over a large checkout tree)."
	if confirm "  Recursively chown $root/work to $(id -un):$(id -gn) now?"; then
		run_sudo chown -R "$(id -un):$(id -gn)" "$root/work"
		did "chowned $root/work recursively"
	else
		warn "  Leaving ownership as-is. Fix later with:"
		warn "    sudo chown -R $(id -un):$(id -gn) $(printf '%q' "$root/work")"
	fi
}

cmd_adopt() {
	local path="" project_dir_opt="" config_opt="" want_help=0
	while [ "$#" -gt 0 ]; do
		case "$1" in
			-h|--help|help) want_help=1; shift ;;
			--dry-run)     DRY_RUN=1; shift ;;
			-y|-f|--yes|--force)  ASSUME_YES=1; shift ;;
			-v|--verbose)  VERBOSE=1; shift ;;
			--version)     echo "$SCRIPT_NAME $SCRIPT_VERSION"; exit 0 ;;
			--project-dir)   project_dir_opt="${2:-}"
				[ -n "$project_dir_opt" ] || die "--project-dir needs a value" "$SCRIPT_CMD adopt --help"
				shift 2 ;;
			--project-dir=*) project_dir_opt="${1#*=}"; shift ;;
			# NOT --config: that is the EXISTING global flag (an EXISTING
			# file to load, only valid before the command word -- see
			# die_on_misplaced_global_flag). This one names a NEW file
			# adopt is about to WRITE; reusing the same name would mean
			# two conflicting things depending only on word order.
			--write-config)   config_opt="${2:-}"
				[ -n "$config_opt" ] || die "--write-config needs a value" "$SCRIPT_CMD adopt --help"
				shift 2 ;;
			--write-config=*) config_opt="${1#*=}"; shift ;;
			--config|--config=*|--project|--project=*|--set|--set=*) die_on_misplaced_global_flag "$1" adopt ;;
			-*) die "unknown option for 'adopt': $1" "$SCRIPT_CMD adopt --help" ;;
			*)
				[ -z "$path" ] || die "'adopt' takes one path" "$SCRIPT_CMD adopt --help"
				path="$1"; shift ;;
		esac
	done

	if [ "$want_help" -eq 1 ]; then
		adopt_usage
		return 0
	fi

	[ -n "$path" ] || die "'adopt' needs a path" "$SCRIPT_CMD adopt <path>"
	[ -d "$path" ] || die "not a directory: $path" "$SCRIPT_CMD adopt <path>"
	local real_target
	real_target="$(resolve_path "$path")"

	# Refuse a path that is already THIS Mac's own root -- via MACKAS_ROOT
	# directly, or via the short link -- before touching anything. That is
	# 'setup'/'mackas doctor' (item 6) territory, not adopt.
	if [ -n "$MACKAS_ROOT" ] && [ "$real_target" = "$(resolve_path "$MACKAS_ROOT")" ]; then
		die "'$path' is already this Mac's own MACKAS_ROOT" \
			"nothing to adopt here -- use '$SCRIPT_CMD setup'/'$SCRIPT_CMD check' instead"
	fi
	if [ -L "$MACKAS_SHORT_LINK" ] && \
	   [ "$real_target" = "$(resolve_path "$(readlink "$MACKAS_SHORT_LINK")")" ]; then
		die "'$path' is already this Mac's own root (via $MACKAS_SHORT_LINK)" \
			"nothing to adopt here -- use '$SCRIPT_CMD setup'/'$SCRIPT_CMD check' instead"
	fi

	if [ ! -d "$real_target/work" ] && [ ! -d "$real_target/bin" ] \
	   && [ ! -d "$real_target/container-volumes" ]; then
		die "'$path' does not look like a mackas root (no work/, bin/ or container-volumes/)" \
			"point adopt at the directory 'setup' originally created there"
	fi

	hdr "mackas adopt: $real_target"

	local proj_name="" proj_url="" proj_branch="" base_name derived_name derived_link
	local introspected
	introspected="$(adopt_introspect_project "$real_target" "$project_dir_opt")"
	if [ -n "$introspected" ]; then
		proj_name="$(printf '%s\n' "$introspected" | sed -n '1p')"
		proj_url="$(printf '%s\n' "$introspected" | sed -n '2p')"
		proj_branch="$(printf '%s\n' "$introspected" | sed -n '3p')"
		info "  project    : $proj_name"
		info "    url      : ${proj_url:-<none: no 'origin' remote>}"
		info "    branch   : ${proj_branch:-<none: detached HEAD>}"
	else
		warn "  no git checkout found under $real_target/work/ -- adopting infra only,"
		warn "  no project (matches '$SCRIPT_CMD setup's own \"no project configured\" path)."
	fi

	base_name="$(printf '%s' "${proj_name:-$(basename "$real_target")}" | tr -c 'A-Za-z0-9-' '-')"
	derived_name="$(adopt_unique_volume_name "$base_name")"
	derived_link="$(adopt_unique_short_link "$base_name" "$real_target")"
	info "  volume name: $derived_name"
	info "  short link : $derived_link"

	local config_file="${config_opt:-$(projects_dir)/$base_name.conf}"
	if [ -f "$config_file" ]; then
		confirm "  $config_file already exists -- overwrite its settings with this adoption?" \
			|| die "declined -- nothing written" \
				"pick a different destination: $SCRIPT_CMD adopt $(printf '%q' "$path") --write-config <file>"
	fi
	run mkdir -p "$(dirname "$config_file")"
	config_write_setting "$config_file" MACKAS_ROOT "$real_target"
	config_write_setting "$config_file" MACKAS_SHORT_LINK "$derived_link"
	config_write_setting "$config_file" MACKAS_VOLUME_NAME "$derived_name"
	if [ -n "$proj_name" ]; then
		config_write_setting "$config_file" MACKAS_PROJECT_URL "$proj_url"
		config_write_setting "$config_file" MACKAS_PROJECT_BRANCH "$proj_branch"
		config_write_setting "$config_file" MACKAS_PROJECT_DIR "$proj_name"
	fi
	did "wrote $config_file"

	# Apply for THIS invocation too, so setup can run in the same command --
	# main() already ran validate_settings/derive_paths once, against the OLD
	# values (same reasoning as cmd_setup's own positional-root handling).
	MACKAS_ROOT="$real_target"; __EXPLICIT_MACKAS_ROOT=1
	MACKAS_SHORT_LINK="$derived_link"
	MACKAS_VOLUME_NAME="$derived_name"
	if [ -n "$proj_name" ]; then
		MACKAS_PROJECT_URL="$proj_url"
		MACKAS_PROJECT_BRANCH="$proj_branch"
		MACKAS_PROJECT_DIR="$proj_name"
	fi
	CONFIG_FILE_USED="$config_file"
	validate_settings
	derive_paths

	# Gap-C guard is setup_relocate_volumes() itself (now resolved-path-aware,
	# see resolve_path's own comment) -- it already detects "the machine-wide
	# symlink belongs to a different root" and OFFERS (never silently does)
	# to move that root's volumes here, which is exactly this project's
	# chosen behaviour for this scenario. No separate check needed.

	# Before setup_volumes ever gets a chance to treat "not found" as "create
	# fresh": if a relocated volume under this NEW name is Spotlight-findable
	# (adopted from the source Mac), re-point it now.
	volume_recover

	adopt_check_ownership "$real_target"

	cmd_setup

	hdr "Adopted"
	info "  config file : $config_file"
	info "  from now on : $SCRIPT_CMD --config $(printf '%q' "$config_file") ..."
	if [ "$config_file" = "$(projects_dir)/$base_name.conf" ]; then
		info "                or, pinned as it is: $SCRIPT_CMD --project $base_name ..."
	fi
}

# ---------------------------------------------------------------------------
# project add -- pin a project workspace under THIS Mac's own MACKAS_ROOT.
# The in-root sibling of `adopt` (which pins a whole FOREIGN root instead):
# both write the same kind of artifact, a standalone config at
# ~/.config/mackas/projects/<name>.conf. See #72/#77.
# ---------------------------------------------------------------------------

project_usage() {
	cat <<EOF
${C_BLD}$SCRIPT_CMD project${C_RST} -- pin a project workspace under THIS Mac's own
MACKAS_ROOT. The in-root sibling of '$SCRIPT_CMD adopt' (which pins a whole
FOREIGN root instead): both write the same artifact, a standalone config at
~/.config/mackas/projects/<name>.conf.

${C_BLD}USAGE${C_RST}
  $SCRIPT_CMD project add <name> [--url URL --branch BRANCH | --from <checkout>]

${C_BLD}SUBCOMMANDS${C_RST}
  add <name>   Pin a project. '$SCRIPT_CMD project add --help' for the full
               flag list.

Note the plural sibling: '$SCRIPT_CMD projects' LISTS the projects already
pinned (by either 'project add' or 'adopt'); this singular command instead
CREATES one. '$SCRIPT_CMD projects --help' has the reading side.
EOF
}

project_add_usage() {
	cat <<EOF
${C_BLD}$SCRIPT_CMD project add${C_RST} -- pin <name> as a project workspace under
this Mac's own MACKAS_ROOT: creates \$MACKAS_WORK/<name>/ (that project's
entire KAS_WORK_DIR -- the checkout and whatever siblings kas clones next to
it, private to <name>; see #72) and writes a standalone config to
~/.config/mackas/projects/<name>.conf, seeded from the settings in effect
right now. It PINS; it does not build -- run
'$SCRIPT_CMD --project <name> setup' afterwards for that.

${C_BLD}USAGE${C_RST}
  $SCRIPT_CMD project add <name> --url URL --branch BRANCH
  $SCRIPT_CMD project add <name> --from <checkout>
  $SCRIPT_CMD project add <name>

${C_BLD}OPTIONS${C_RST}
  --url URL            The project's git remote. Needs --branch too. Nothing
                       is cloned yet -- that is what 'setup' does next.
  --branch BRANCH      The branch to build. Needs --url too.
  --from <checkout>    Convert an EXISTING checkout already at
                       \$MACKAS_WORK/<name>/ into a pinned project, in place --
                       reads its remote URL and current branch instead of
                       asking for --url/--branch. Mutually exclusive with
                       --url/--branch. <checkout> must name that very
                       directory (bare '<name>', 'work/<name>', or a path
                       resolving to it) -- 'project add' never renames or
                       moves a checkout to make names line up.
  --keep-volumes       With --from only: keep building against whatever
                       volumes the checkout already used (e.g. oe-build-*),
                       explicitly -- migration path B from the multi-project
                       design (#72): a fully supported end state, no data
                       ever moved.
  --derive-volumes     With --from only: the opposite -- switch this project
                       to mackas-<name>-* going forward. The OLD volumes are
                       left exactly as they are, not moved or deleted; only a
                       FUTURE build reads/writes the new ones.

  Neither --keep-volumes nor --derive-volumes given, --from used, and this is
  running interactively: asked as a yes/no question. Non-interactive (no
  tty, or -y) and neither given: keeps the existing volumes -- the choice
  that changes nothing and never invalidates a cache is the safe default for
  an unattended run.

  Omitting --url/--branch and --from entirely pins <name> with no checkout
  configured yet, same as an unconfigured 'setup' -- fill in
  MACKAS_PROJECT_URL/_BRANCH later with '$SCRIPT_CMD --project <name> set
  MACKAS_PROJECT_URL ...'.

'project add <name>' refuses outright if \$MACKAS_WORK/<name>/ already exists
and --from was not given -- a plain checkout that happens to share the name
is not automatically adopted (#72: filesystem shape alone never decides
anything). An already-pinned <name> is offered for overwrite, exactly like
'$SCRIPT_CMD adopt' does for its own config file.

Options: --dry-run, -y/--yes (or -f/--force) and -v/--verbose work here too;
put them before or after 'project add'.

See also: '$SCRIPT_CMD projects' lists what is already pinned; '$SCRIPT_CMD
adopt' pins a whole FOREIGN root instead of a project inside this one.
EOF
}

cmd_project_add() {
	local name="" url="" branch="" from="" keep_flag="" derive_flag="" want_help=0
	while [ "$#" -gt 0 ]; do
		case "$1" in
			-h|--help|help) want_help=1; shift ;;
			--url)     url="${2:-}"
				[ -n "$url" ] || die "--url needs a value" "$SCRIPT_CMD project add --help"
				shift 2 ;;
			--url=*)   url="${1#*=}"; shift ;;
			--branch)  branch="${2:-}"
				[ -n "$branch" ] || die "--branch needs a value" "$SCRIPT_CMD project add --help"
				shift 2 ;;
			--branch=*) branch="${1#*=}"; shift ;;
			--from)    from="${2:-}"
				[ -n "$from" ] || die "--from needs a value" "$SCRIPT_CMD project add --help"
				shift 2 ;;
			--from=*)  from="${1#*=}"; shift ;;
			--keep-volumes)   keep_flag=1; shift ;;
			--derive-volumes) derive_flag=1; shift ;;
			-*) die "unknown option for 'project add': $1" "$SCRIPT_CMD project add --help" ;;
			*)
				[ -z "$name" ] || die "'project add' takes one name" "$SCRIPT_CMD project add --help"
				name="$1"; shift ;;
		esac
	done

	if [ "$want_help" -eq 1 ]; then
		project_add_usage
		return 0
	fi

	[ -n "$name" ] || die "'project add' needs a name" "$SCRIPT_CMD project add <name> --help"
	validate_project_select "$name" "project add"

	# --from vs --url/--branch: two different ways to answer "what does this
	# project check out", never both.
	if [ -n "$from" ] && { [ -n "$url" ] || [ -n "$branch" ]; }; then
		die "'--from' and '--url'/'--branch' are mutually exclusive" \
			"pick one way to give '$name' its checkout"
	fi
	if [ -n "$url" ] && [ -z "$branch" ]; then
		die "'--url' needs '--branch' too" "$SCRIPT_CMD project add --help"
	fi
	if [ -n "$branch" ] && [ -z "$url" ]; then
		die "'--branch' needs '--url' too" "$SCRIPT_CMD project add --help"
	fi
	if [ -n "$keep_flag" ] && [ -n "$derive_flag" ]; then
		die "'--keep-volumes' and '--derive-volumes' are mutually exclusive" \
			"$SCRIPT_CMD project add --help"
	fi
	if { [ -n "$keep_flag" ] || [ -n "$derive_flag" ]; } && [ -z "$from" ]; then
		die "'--keep-volumes'/'--derive-volumes' only apply to a '--from' conversion" \
			"a freshly added project has no prior volumes to keep or leave behind"
	fi

	# Mutating: it creates a directory inside work/. Same gate 'setup' and
	# 'adopt's own hand-off to setup use.
	require_mackas_root

	hdr "mackas project add: $name"

	local config_file; config_file="$(projects_dir)/$name.conf"
	local workspace_dir; workspace_dir="$MACKAS_WORK/$name"

	local proj_url="" proj_branch=""
	if [ -n "$from" ]; then
		# --from converts THAT VERY ENTRY in place -- #72's own wording for the
		# work/-collision-refusal rule below. Accepting an arbitrary OTHER
		# directory here would mean either silently renaming/moving a checkout
		# (never -- see #72) or minting a project whose pinned
		# MACKAS_PROJECT_DIR points at a directory with a different name than
		# the project itself, for no benefit -- work/<name>/ IS the workspace
		# (#72). So the value is accepted in the forms a user is likely to
		# type (a bare name, 'work/<name>', a path) purely to give a typo a
		# clear message, not to allow converting anything other than
		# work/<name> itself.
		local from_resolved
		case "$from" in
			/*)  from_resolved="$(resolve_path "$from")" ;;
			*/*) from_resolved="$(resolve_path "$MACKAS_ROOT/$from")" ;;
			*)   from_resolved="$(resolve_path "$MACKAS_WORK/$from")" ;;
		esac
		local workspace_resolved; workspace_resolved="$(resolve_path "$workspace_dir")"
		if [ "$from_resolved" != "$workspace_resolved" ]; then
			die "'--from $from' does not name $workspace_dir" \
				"'project add' converts an existing checkout in place -- it never renames or moves one; use '$SCRIPT_CMD project add $name --from $name'"
		fi
		[ -d "$workspace_dir" ] || die "no checkout to convert: $workspace_dir does not exist" \
			"drop --from to create a fresh workspace, or check the directory name"

		# adopt_introspect_project itself dies with a clear message if
		# $workspace_dir/.git turns out not to exist -- same check, same
		# wording, reused rather than duplicated.
		local introspected
		introspected="$(adopt_introspect_project "$MACKAS_BASE" "$name")"
		proj_url="$(printf '%s\n' "$introspected" | sed -n '2p')"
		proj_branch="$(printf '%s\n' "$introspected" | sed -n '3p')"
		info "  converting : $workspace_dir"
		info "    url      : ${proj_url:-<none: no 'origin' remote>}"
		info "    branch   : ${proj_branch:-<none: detached HEAD>}"
	else
		# The collision refusal (#72): a first-level directory under work/ is
		# a project workspace IFF a pinned config for that name exists.
		# work/<name>/ existing already, with no --from, means it is just an
		# ordinary checkout that happens to share the name -- filesystem
		# shape alone never decides anything.
		#
		# EXCEPT when it is empty: 'run mkdir -p "$workspace_dir"' below is the
		# very first mutation this command performs, strictly before the config
		# file is written -- so an interrupted or partially-failed prior run
		# (Ctrl-C, a full disk, anything dying between that mkdir and the last
		# config_write_setting call) can leave exactly an empty work/<name>/
		# behind with no pinned config to show for it. Refusing THAT unchanged
		# would make on_interrupt()'s own promise ("nothing is left half-written
		# that a re-run won't fix") false for this one command: a plain retry
		# would hit this refusal, and the --from retry it suggests would in turn
		# refuse too (adopt_introspect_project requires a real .git, which an
		# empty directory never has) -- stranding the name with no way through
		# except an out-of-band 'rmdir'. An empty directory carries no content
		# that could be silently folded in or lost, so it is safe to treat as
		# "nothing here yet" and proceed; anything containing so much as a
		# stray file still refuses, unchanged.
		if [ -d "$workspace_dir" ] && [ -n "$(ls -A "$workspace_dir" 2>/dev/null)" ]; then
			die "'$workspace_dir' already exists and is not being converted" \
				"pin it in place with '$SCRIPT_CMD project add $name --from $name', or pick a different name"
		fi
		proj_url="$url"
		proj_branch="$branch"
	fi

	if [ -f "$config_file" ]; then
		confirm "  $config_file already exists -- overwrite its settings with this project?" \
			|| die "declined -- nothing written" \
				"pick a different name, or edit $config_file directly"
	fi

	# THE MIGRATION QUESTION (#72 path B), --from only: a checkout that
	# already existed before being pinned may already have built against
	# whatever $MACKAS_VOLUME_NAME currently resolves to (oe-build, on an
	# untouched install). Ask once whether to keep that explicitly, or switch
	# to mackas-<name>-* going forward -- either way nothing on disk moves; a
	# fresh project (no --from) has no prior volumes to have this opinion
	# about at all.
	local keep=1
	if [ -n "$from" ]; then
		if [ -n "$keep_flag" ]; then
			keep=1
		elif [ -n "$derive_flag" ]; then
			keep=0
		elif [ "$ASSUME_YES" -eq 1 ] || [ "$DRY_RUN" -eq 1 ] || [ ! -t 0 ]; then
			# Non-interactive default: KEEP. It writes nothing new to disk,
			# changes no command's behaviour today (the checkout already
			# built against $MACKAS_VOLUME_NAME-*), and never invalidates an
			# existing download/sstate cache the way defaulting to a
			# brand-new mackas-<name>-* stem would. Switching volumes is a
			# deliberate, visible choice a human should make with eyes open
			# (--derive-volumes, or the interactive prompt below) -- not
			# something a script or CI run should trigger by accident.
			keep=1
			info "  non-interactive: keeping the existing '$MACKAS_VOLUME_NAME' volumes for '$name'"
			info "    (pass --derive-volumes to switch to mackas-$name-* instead; nothing moves either way)"
		else
			if confirm "  Keep the existing volumes ($MACKAS_VOLUME_NAME-tmp/-dl/-sstate) for '$name'? Declining switches it to mackas-$name-* volumes going forward -- nothing already on disk is moved either way."; then
				keep=1
			else
				keep=0
			fi
		fi
	fi

	# Which volume-name settings actually belong in a STANDALONE config:
	# MACKAS_VOLUME_NAME is written explicitly only when this project is
	# deliberately keeping a non-default stem (the migration answer above),
	# or when THIS invocation's own settings already pinned one explicitly
	# (config_pinned_setting, not a bare value check -- see its own comment on
	# why: MACKAS_VOLUME_NAME's factory default is the non-empty "oe-build",
	# so a plain value check cannot tell "explicitly oe-build" from "never
	# touched"). Otherwise it is left unset, so mackas-<name>-* derives once
	# --project <name> selects this file (#77 slice 1). The DL/SSTATE
	# overrides are independent of the migration question (M1: opt-in sharing
	# is available to any project, not just a converted one) and are carried
	# forward under the exact same explicit-only rule.
	local want_explicit_stem=0
	if [ -n "$from" ]; then
		[ "$keep" -eq 1 ] && want_explicit_stem=1
	elif config_pinned_setting MACKAS_VOLUME_NAME; then
		want_explicit_stem=1
	fi

	run mkdir -p "$workspace_dir"

	# Created under umask 077, never the ambient one -- same reasoning as
	# cmd_set's own bootstrap of this directory: --project holds it to
	# config_file_is_safe(), and an inherited `umask 002` would otherwise
	# produce a group-writable directory that then refuses to be sourced.
	local cfg_dir; cfg_dir="$(dirname "$config_file")"
	[ -d "$cfg_dir" ] || ( umask 077 && run mkdir -p "$cfg_dir" ) || die "could not create $cfg_dir"

	# What a STANDALONE config needs, and no more: MACKAS_ROOT (which root)
	# and MACKAS_PROJECT_DIR (which checkout under work/ -- always <name> for
	# a project this command itself created) make it self-sufficient; the
	# project's own identity (its git remote/branch, if any) and any
	# volume-name override this invocation's settings are already explicit
	# about carry the CHOICE that got the user here into the new file too.
	# Deliberately NOT seeded: volume SIZES, CPUS/MEMORY, mirror settings,
	# MACKAS_KAS_CONFIG -- machine-wide or build-time choices that belong to
	# defaults/config, not to project identity. Freezing today's value of any
	# of those into every new project's file forever is exactly the
	# "unreadable, frozen-forever" failure mode a standalone config has to
	# avoid (same reasoning as the M1 MACKAS_VOLUME_DL_NAME/_SSTATE_NAME
	# design, applied here to the whole file rather than just the stem).
	# Every value below is written OR explicitly deleted, never just
	# conditionally written -- 'project add' on an already-pinned NAME is an
	# overwrite (confirmed above), and config_write_setting only ever
	# edits/appends a line, it never removes one on its own. Without the
	# delete branches, re-running with a different answer (say,
	# --derive-volumes after a prior --keep-volumes) would leave the OLD
	# MACKAS_VOLUME_NAME line sitting in the file, silently disagreeing with
	# what this run just decided. delete's own "line was not there" return of
	# 1 is not a failure here, so it is swallowed.
	config_write_setting "$config_file" MACKAS_ROOT "$MACKAS_ROOT"
	config_write_setting "$config_file" MACKAS_PROJECT_DIR "$name"
	if [ -n "$proj_url" ]; then
		config_write_setting "$config_file" MACKAS_PROJECT_URL "$proj_url"
		config_write_setting "$config_file" MACKAS_PROJECT_BRANCH "$proj_branch"
	else
		config_write_setting "$config_file" MACKAS_PROJECT_URL "" delete || true
		config_write_setting "$config_file" MACKAS_PROJECT_BRANCH "" delete || true
	fi
	if [ "$want_explicit_stem" -eq 1 ]; then
		config_write_setting "$config_file" MACKAS_VOLUME_NAME "$MACKAS_VOLUME_NAME"
	else
		config_write_setting "$config_file" MACKAS_VOLUME_NAME "" delete || true
	fi
	local s sval
	for s in MACKAS_VOLUME_DL_NAME MACKAS_VOLUME_SSTATE_NAME; do
		if config_pinned_setting "$s"; then
			eval "sval=\"\${$s}\""
			config_write_setting "$config_file" "$s" "$sval"
		else
			config_write_setting "$config_file" "$s" "" delete || true
		fi
	done
	did "wrote $config_file"
	did "workspace directory: $workspace_dir"

	hdr "Done"
	if [ -n "$proj_url" ]; then
		info "  next: $SCRIPT_CMD --project $name setup   # clones $proj_url (branch $proj_branch) and builds out the rest"
	else
		info "  no project URL set yet -- '$SCRIPT_CMD --project $name setup' will skip the checkout step"
		info "    until MACKAS_PROJECT_URL/_BRANCH are set: $SCRIPT_CMD --project $name set MACKAS_PROJECT_URL <url>"
	fi
	info "  from now on : $SCRIPT_CMD --project $name ...   ($SCRIPT_CMD projects lists every pinned project)"
}

cmd_project() {
	local sub="" rest=() a want_help=0
	for a in "$@"; do
		case "$a" in
			--dry-run)     DRY_RUN=1 ;;
			-y|-f|--yes|--force)  ASSUME_YES=1 ;;
			-v|--verbose)  VERBOSE=1 ;;
			-h|--help)     want_help=1 ;;
			--version)     echo "$SCRIPT_NAME $SCRIPT_VERSION"; exit 0 ;;
			--config|--config=*|--project|--project=*|--set|--set=*) die_on_misplaced_global_flag "$a" project ;;
			*) if [ -z "$sub" ]; then sub="$a"; else rest+=("$a"); fi ;;
		esac
	done

	case "${sub:-help}" in
		add)
			# -h/--help caught above is consumed here, never forwarded, unless
			# re-appended -- same reason cmd_volume's subcommands need it back:
			# 'project add --help' must show project_add_usage (the specific
			# one), not this function's own generic project_usage.
			[ "$want_help" -eq 1 ] && rest+=("--help")
			cmd_project_add ${rest+"${rest[@]}"} ;;
		help)  project_usage ;;
		*) die "unknown 'project' subcommand: $sub" \
			"$SCRIPT_CMD project --help  (add)" ;;
	esac
}

# ---------------------------------------------------------------------------
# smoketest
# ---------------------------------------------------------------------------

# kas_env_vars WANT_BUILD_VARS -- the VAR=value words kas_invoke_env exports
# ahead of the real kas-container binary (PATH/engine/work-dir/gitconfig/
# image, plus BB_NUMBER_THREADS/PARALLEL_MAKE when WANT_BUILD_VARS=1), with
# no command word or --runtime-args after them. Shared by kas_env_prefix()
# below (the log-header shape, documentation text rather than a runnable
# line -- there is no command word between its VARs and --runtime-args) and
# by any dry-run preview that needs the same VARs immediately before the
# real binary name, to stay a genuinely pasteable command line.
# KAS_BUILD_DIR/DL_DIR/SSTATE_DIR are deliberately blanked, not set: see
# kas_runtime_args().
# shellcheck disable=SC2016  # literal text: $PATH must appear verbatim in
# the printed command line, to be expanded by the user's shell, not ours.
kas_env_vars() {
	local want_build_vars="$1"
	printf 'PATH=%s:%s:$PATH KAS_CONTAINER_ENGINE=%s KAS_WORK_DIR=%s KAS_BUILD_DIR= DL_DIR= SSTATE_DIR= GITCONFIG_FILE=%s KAS_CONTAINER_IMAGE=%s' \
		"$SHIM_DIR" "$BREW_BIN" "$MACKAS_KAS_ENGINE" "$MACKAS_WORK" "${GITCONFIG_FILE:-$MACKAS_GITCONFIG}" "$KAS_IMAGE"
	[ "$want_build_vars" = "1" ] && printf ' BB_NUMBER_THREADS=%s PARALLEL_MAKE=%s' "$MACKAS_CPUS" "-j $MACKAS_CPUS"
}

kas_env_prefix() {
	# Emitted for the log header so a failure is reproducible by hand. Must
	# mirror run_kas()'s own _kas_exec invocation (via kas_invoke_env(),
	# below) variable for variable -- it used to omit KAS_CONTAINER_ENGINE,
	# KAS_CONTAINER_IMAGE, BB_NUMBER_THREADS and PARALLEL_MAKE, so pasting the
	# printed header back verbatim did not actually reproduce a real build.
	# Always the build-vars shape: every caller here is a real build/shell rung.
	printf '%s --runtime-args %s' "$(kas_env_vars 1)" "$(printf '%q' "$(kas_runtime_args)")"
}

# kas_invoke_env RT_ARGS GITCONFIG WANT_BUILD_VARS CMD... -- exec
# KAS_CONTAINER_REAL with the invocation environment every direct
# kas-container call site in this file needs (PATH prepended with the shim
# dir, the container engine/image, KAS_WORK_DIR, GITCONFIG_FILE, and
# KAS_BUILD_DIR/DL_DIR/SSTATE_DIR deliberately blanked rather than unset --
# see kas_runtime_args() for why a non-empty value here would make
# kas-container's forward_dir() bind-mount an APFS path over the ext4 volume
# RT_ARGS just asked for). Was four copy-pasted blocks (run_kas()'s own
# _kas_exec, kas_shell_ro(), cmd_lock(), cmd_dump()); now the one place that
# shape lives, so it cannot drift between them.
#
# WANT_BUILD_VARS (0/1) gates BB_NUMBER_THREADS/PARALLEL_MAKE: run_kas() and
# kas_shell_ro() set them (a real build/shell needs bitbake's own parallelism
# told what MACKAS_CPUS is), cmd_lock()/cmd_dump() never did and still don't
# -- neither runs bitbake, so there is nothing for either variable to tune.
# Left unset rather than exported empty in that case, matching the pre-refactor
# behaviour exactly: an unset BB_NUMBER_THREADS/PARALLEL_MAKE lets kas-container
# fall back to its own default, which an explicit empty value would not.
#
# The caller is responsible for `cd`-ing into MACKAS_PROJECT first (some
# callers need to do that inside their own subshell, before rt_args/gitconfig
# are even computed) and for capturing/propagating the exit status.
kas_invoke_env() {
	local rt_args="$1" gitconfig="$2" want_build_vars="$3"; shift 3
	if [ "$want_build_vars" = "1" ]; then
		PATH="$SHIM_DIR:$BREW_BIN:$PATH" \
		KAS_CONTAINER_ENGINE="$MACKAS_KAS_ENGINE" \
		KAS_WORK_DIR="$MACKAS_WORK" \
		KAS_BUILD_DIR='' \
		DL_DIR='' \
		SSTATE_DIR='' \
		GITCONFIG_FILE="$gitconfig" \
		KAS_CONTAINER_IMAGE="$KAS_IMAGE" \
		BB_NUMBER_THREADS="$MACKAS_CPUS" \
		PARALLEL_MAKE="-j $MACKAS_CPUS" \
		"$KAS_CONTAINER_REAL" --runtime-args "$rt_args" "$@"
	else
		PATH="$SHIM_DIR:$BREW_BIN:$PATH" \
		KAS_CONTAINER_ENGINE="$MACKAS_KAS_ENGINE" \
		KAS_WORK_DIR="$MACKAS_WORK" \
		KAS_BUILD_DIR='' \
		DL_DIR='' \
		SSTATE_DIR='' \
		GITCONFIG_FILE="$gitconfig" \
		KAS_CONTAINER_IMAGE="$KAS_IMAGE" \
		"$KAS_CONTAINER_REAL" --runtime-args "$rt_args" "$@"
	fi
}

# auto_fstrim <before|after> [<log>] -- reclaim the three sparse volume images
# around a kas run when MACKAS_FSTRIM_AUTO=1. Safe with the one-VM rule: it runs
# before the kas container starts and after it exits, when nothing holds the
# volumes. STRICTLY non-fatal -- a trim hiccup must never change a build's exit
# status -- which is why it reuses volume_fstrim_one in its from_all mode (that
# skips a busy or missing volume with a warning and returns rather than dies)
# and swallows the rest with `|| true`. Detail goes to the build log when there
# is one, so a multi-rung smoketest does not flood the console.
auto_fstrim() {
	[ "${MACKAS_FSTRIM_AUTO:-1}" = "1" ] || return 0
	local phase="$1" log="${2:-}" v
	info "auto-fstrim ($phase run)"
	for v in "$MACKAS_VOL_TMP" "$MACKAS_VOL_DL" "$MACKAS_VOL_SSTATE"; do
		volume_exists "$v" || continue
		if [ -n "$log" ]; then
			volume_fstrim_one "$v" 1 >>"$log" 2>&1 || true
		else
			volume_fstrim_one "$v" 1 || true
		fi
	done
	return 0
}

# clear_stale_sockets [LOG] -- remove any bitbake.sock/hashserve.sock that
# ended up on the host-visible checkout/work tree (a virtiofs bind mount)
# instead of inside an ext4 volume. This only happens when a build bypasses
# mackas's normal invocation (a stale kas-container binary still on $PATH, a
# config error, etc. -- see issue #27), but once it happens the socket is
# stuck FOREVER from the guest's point of view: bind() succeeds once, but
# every later stat/unlink on that same path fails with ENOTSUP. It is,
# however, an ordinary special file from macOS's own side, so a host-side rm
# clears it -- this is that sweep, run before a build starts so a leftover
# from a past bypassed/failed build cannot make the NEXT one fail to bind.
# Gated by MACKAS_SOCKET_SWEEP (default on) and by all three volumes
# reporting NOT in use -- the same nothing-holds-the-volumes window
# auto_fstrim/clear_buildstats_before_build use -- so it can never run while a
# real build might plausibly be listening on one of these paths. STRICTLY
# non-fatal, like its neighbors: a sweep failure must never change a build's
# exit status.
clear_stale_sockets() {
	[ "${MACKAS_SOCKET_SWEEP:-1}" = "1" ] || return 0
	local log="${1:-}" v

	for v in "$MACKAS_VOL_TMP" "$MACKAS_VOL_DL" "$MACKAS_VOL_SSTATE"; do
		volume_in_use "$v" && return 0
	done

	_sweep_stale_sockets_in() {
		local dir="$1" maxdepth="$2" f
		[ -d "$dir" ] || return 0
		find "$dir" -maxdepth "$maxdepth" -type s \
			\( -name bitbake.sock -o -name hashserve.sock \) 2>/dev/null |
		while IFS= read -r f; do
			if [ -n "$log" ]; then
				warn "removing stale socket $f (left behind by a build whose control connection ended up on the host-visible checkout/work tree instead of the ext4 volume; virtiofs makes it permanently stuck from the guest's side, but it is an ordinary file from macOS's own side)" >>"$log" 2>&1 || true
			else
				warn "removing stale socket $f (left behind by a build whose control connection ended up on the host-visible checkout/work tree instead of the ext4 volume; virtiofs makes it permanently stuck from the guest's side, but it is an ordinary file from macOS's own side)"
			fi
			rm -f "$f" || true
		done
		return 0
	}

	_sweep_stale_sockets_in "$MACKAS_WORK/build" 2
	_sweep_stale_sockets_in "$MACKAS_PROJECT" 1
	return 0
}

# clear_buildstats_before_build [LOG] -- delete tmp/buildstats in the TMPDIR
# volume right before a build starts, unless MACKAS_BUILDSTATS_ACCUMULATE=1.
# ON by default: buildstats.bbclass opens build_stats in APPEND mode and never
# clears a BUILDNAME dir itself (mkdir -p, not a truncate), so a project whose
# BUILDNAME does not vary per build (confirmed live: Angstrom's distro conf
# hardcodes `BUILDNAME = "Angstrom ${DISTRO_VERSION}"`) would otherwise
# accumulate every build it has ever run into one build_stats file, inflating
# 'buildstats analyze's numbers -- see check_buildstats_accumulation, the
# same symptom caught after the fact, for a project where this was left off
# or was only just turned on. Safe with the one-VM rule: runs before the kas
# container starts, the same window auto_fstrim's own "before" step uses, so
# nothing holds the volume yet. STRICTLY non-fatal, like auto_fstrim -- a
# clear failing here must never change a build's exit status.
clear_buildstats_before_build() {
	[ "${MACKAS_BUILDSTATS_ACCUMULATE:-0}" != "1" ] || return 0
	local log="${1:-}"
	volume_exists "$MACKAS_VOL_TMP" || return 0
	info "clearing tmp/buildstats (MACKAS_BUILDSTATS_ACCUMULATE=0)"
	vrb "+ $(quote_cmd container run --rm -u 0:0 -v "$MACKAS_VOL_TMP:/build" "$KAS_IMAGE" rm -rf /build/tmp/buildstats)"
	if [ -n "$log" ]; then
		container run --rm -u 0:0 -v "$MACKAS_VOL_TMP:/build" "$KAS_IMAGE" \
			rm -rf /build/tmp/buildstats >>"$log" 2>&1 || true
	else
		container run --rm -u 0:0 -v "$MACKAS_VOL_TMP:/build" "$KAS_IMAGE" \
			rm -rf /build/tmp/buildstats || true
	fi
	return 0
}

run_kas() {
	# run_kas <logfile|""> <kas args...>
	# An empty logfile means "don't pipe through tee" -- required for the
	# interactive `shell` command, which needs a real TTY on stdout.
	# Both callers (cmd_smoketest, cmd_shell) already refuse with a clear,
	# specific message before ever reaching here if $MACKAS_PROJECT/.git does
	# not exist -- true whether no project is configured at all or one is
	# configured but setup hasn't cloned it yet -- so this has nothing further
	# to check on that front.
	local log="$1"; shift
	local rt_args gitconfig rc

	# Before anything else, and before --dry-run's early return: kas is about
	# to write the layer checkouts into KAS_WORK_DIR, and if a workspace image
	# is configured but not attached that path is a case-INSENSITIVE directory
	# on the host drive. A no-op when no image is configured.
	ensure_workspace_attached
	ensure_container_running

	rt_args="$(kas_runtime_args)"
	# A GITCONFIG_FILE already in this shell's environment always wins; see
	# setup_gitconfig() for why this exists and why we never override one the
	# user set themselves. Otherwise fall back to the one 'setup' generates.
	gitconfig="${GITCONFIG_FILE:-$MACKAS_GITCONFIG}"

	# Catch it HERE, not just at 'setup' time: GITCONFIG_FILE can go stale
	# between the two (a different shell exporting it from an earlier
	# MACKAS_ROOT, the file deleted by hand, MACKAS_ROOT changed since
	# setup last ran) with no warning ever seen in THIS session, and the
	# actual failure mode -- git silently never getting the container's
	# forwarded config, so it refuses /repo with "dubious ownership" deep
	# inside the build -- is far harder to connect back to the cause than a
	# refusal right here, before kas ever runs.
	if [ ! -r "$gitconfig" ] || ! has_safe_directory_star "$gitconfig"; then
		die "gitconfig for the container's dubious-ownership workaround is missing or incomplete: $gitconfig" \
			"$SCRIPT_CMD setup   # offers to fix a GITCONFIG_FILE you set yourself too, not just the one it generates"
	fi

	if [ "$DRY_RUN" -eq 1 ]; then
		printf '%s+ (cd %s && %s --runtime-args %s %s)%s\n' \
			"$C_DIM" "$(printf '%q' "$MACKAS_PROJECT")" \
			"$(printf '%q' "$KAS_CONTAINER_REAL")" "$(printf '%q' "$rt_args")" \
			"$(quote_cmd "$@")" "$C_RST"
		return 0
	fi

	# One-VM rule, for the last entrypoint that lacked it: 'shell' and every
	# smoketest rung land here. It sits AFTER ensure_container_running above,
	# because volume_in_use() short-circuits to "not in use" with the daemon
	# down (see kas_project_subcommand_preflight for the same ordering), and
	# after the --dry-run return, so --dry-run queries no volume state.
	require_volumes_free "$SCRIPT_CMD $SCRIPT_SUBCOMMAND"

	# The one place a user finds out MACKAS_MONITOR=1 actually took effect.
	# monitor_runtime_args() already warns on every path that skips the
	# bridge, so silence here means it is genuinely in rt_args -- checking
	# the string is simpler than threading a second return value out of
	# kas_runtime_args() for this alone.
	if [ "$MACKAS_MONITOR" = "1" ]; then
		case "$rt_args" in
			*mackas-uibridge*)
				printf '%slive progress bridge: publishing 127.0.0.1:%s (watch with: %s monitor)%s\n' \
					"$C_DIM" "$MACKAS_MONITOR_PORT" "$SCRIPT_CMD" "$C_RST" >&2
				;;
		esac
	fi

	_kas_exec() {
		cd "$MACKAS_PROJECT" || return 1
		# The invocation environment (KAS_BUILD_DIR/DL_DIR/SSTATE_DIR set EMPTY
		# rather than unset among it -- see kas_invoke_env()'s own comment) is
		# shared with kas_shell_ro()/cmd_lock()/cmd_dump() via kas_invoke_env();
		# "1" here asks for BB_NUMBER_THREADS/PARALLEL_MAKE too, same as
		# kas_shell_ro() -- a real build/shell needs bitbake told MACKAS_CPUS.
		kas_invoke_env "$rt_args" "$gitconfig" 1 "$@"
	}

	# Reclaim the images before the run (they may have ratcheted up last time)
	# and after (this run's peak is now dead space). Both happen while nothing
	# holds the volumes -- the kas container has not started / has exited.
	auto_fstrim before "$log"

	# Same window: nothing holds the volumes yet, so sweeping any stranded
	# bitbake.sock/hashserve.sock is safe here too (see clear_stale_sockets
	# for the virtiofs-stuck-socket mechanism this defends against).
	clear_stale_sockets "$log"

	# Same window: nothing holds the volume yet, so clearing tmp/buildstats is
	# safe here too (see clear_buildstats_before_build for why this defaults on).
	clear_buildstats_before_build "$log"

	# Capture the exit code in a TESTED context (`|| rc=$?`). A bare
	# `( _kas_exec ); rc=$?` would let `set -e` abort run_kas the moment kas
	# exits non-zero -- before rc is read AND before the after-trim below -- so
	# `shell` (which calls run_kas bare under set -e) would skip the after-trim
	# on any failed build. With pipefail on, the tee pipeline's status is kas's
	# own exit code, so no PIPESTATUS is needed.
	rc=0
	if [ -z "$log" ]; then
		# No tee: keep stdout a real TTY so the interactive shell works.
		( _kas_exec "$@" ) || rc=$?
	else
		( _kas_exec "$@" ) 2>&1 | tee -a "$log" || rc=$?
	fi

	auto_fstrim after "$log"
	return "$rc"
}

# bitbake_getvar VAR -- resolve VAR's REAL, distro-configured value by asking
# bitbake itself (bitbake-getvar), instead of assuming OE-core's own textbook
# default. Found live: DEPLOY_DIR's OE-core default is ${TMPDIR}/deploy, but
# a distro is free to -- and Angstrom's own conf/distro/angstrom.conf does --
# redefine it (to ${TOPDIR}/deploy, a completely different location), and
# 'retrieve' used to just assume the textbook default, silently retrieving
# nothing (or the wrong thing) for any distro that redefines it.
#
# Always runs, dry-run or not: a read-only query, not a mutation, and
# 'retrieve --dry-run' needs the REAL path to report accurately. Goes
# through the exact same kas-container invocation shape run_kas's own
# _kas_exec uses (never raw `container` -- see the project's own hard rule
# on that), just without run_kas's tee/auto_fstrim machinery, which a fast
# metadata query has no use for.
#
# Prints the resolved value on stdout and returns 0, or prints nothing and
# returns 1 if the query itself failed -- callers fall back to their own
# best-guess default rather than treating this as fatal, matching
# 'retrieve's existing best-effort, per-object style.
# kas_shell_ro CMDSTRING -- run CMDSTRING inside a kas shell for the project's
# kas config, with kas's own repo-mutating setup steps always skipped, via the
# shared KAS_SKIP_REPO_STEPS constant (rationale, including the data-loss
# history, is on the kflag assignment below).
#
# Returns 1 (with a warn already printed) on a precondition failure -- no real
# checkout, no readable/safe gitconfig -- rather than ever letting the
# invocation run against a wrong or missing MACKAS_PROJECT. Otherwise runs
# CMDSTRING with stdout/stderr inherited from the caller and returns its exit
# status: bitbake_getvar() wraps the call in a command substitution to capture
# stdout (with its own stderr redirect for the errfile diagnostics below);
# cmd_exec() calls it directly so the command's own output streams straight
# through, live, to whoever ran 'mackas exec'.
kas_shell_ro() {
	local cmdstring="$1" rt_args gitconfig
	ensure_container_running
	rt_args="$(kas_runtime_args)"
	gitconfig="${GITCONFIG_FILE:-$MACKAS_GITCONFIG}"
	if [ ! -r "$gitconfig" ] || ! has_safe_directory_star "$gitconfig"; then
		warn "  gitconfig for the container's dubious-ownership workaround is missing or incomplete: $gitconfig"
		warn "  $SCRIPT_CMD setup   # offers to fix a GITCONFIG_FILE you set yourself too, not just the one it generates"
		return 1
	fi

	# MACKAS_KAS_CONFIG alone does not say WHERE to run kas-container from --
	# that is MACKAS_PROJECT_DIR's job (it is what MACKAS_PROJECT derives
	# from). Setting only the former, a real and easy mistake, leaves
	# MACKAS_PROJECT at whatever it already was -- kas-container then looks
	# for the configured kas files relative to the WRONG directory and fails
	# outright. Caught here, up front, with a specific diagnostic, rather
	# than only surfacing as a generic "could not resolve" from the caller.
	if [ ! -d "$MACKAS_PROJECT/.git" ]; then
		warn "  kas_shell_ro needs a real checkout at MACKAS_PROJECT ($MACKAS_PROJECT) -- set MACKAS_PROJECT_DIR too, not just MACKAS_KAS_CONFIG"
		return 1
	fi

	# The real workflow this project supports -- 'mackas setup' once for
	# shared infra (volumes, kas-container, shim), then plain 'git clone' plus
	# a directly-driven kas-container per project under work/ -- never runs
	# 'setup' again for each newly-cloned project. So KAS_FILES_ARG's
	# always-appended kas/macos-local.yml (compose_kas_files) may simply not
	# exist yet for THIS project even though the shared kas/macos.yml does.
	# Write it: deterministic, idempotent, no different from env.sh/gitconfig
	# regenerating unconditionally, and setup_kas_fragment() already honours
	# --dry-run itself (prints the plan, writes nothing). Redirected to
	# stderr: bitbake_getvar() captures this call's stdout via command
	# substitution as the resolved value, and setup_kas_fragment's own
	# step/did progress lines would otherwise leak into that value.
	if [ ! -f "$MACKAS_KAS_FRAGMENT_REPO" ]; then
		setup_kas_fragment 1>&2
	fi

	# kas's own 'shell' (and 'build') unconditionally re-runs its repo setup
	# steps every invocation -- checkout, patch application, writing
	# local.conf/bblayers.conf -- unless told '-k'/--keep-config-unchanged to
	# skip them (confirmed against the real kas source: kas/libkas.py's
	# setup_parser_keep_config_unchanged_arg lists exactly those steps).
	# Both callers here run this once per read-only command, not a build --
	# without -k, every call would needlessly re-checkout/re-patch every
	# declared repo, real cost and real risk (repo state churn) for something
	# that only wants to read something. Never add -k to run_kas()'s own
	# shared invocation: an actual build/shell session SHOULD go through
	# kas's normal setup.
	#
	# -k also skips write_bbconfig, though, so it can only be used once a
	# parseable state already exists -- a checkout that has never been
	# queried before has no local.conf/bblayers.conf yet, and -k would leave
	# it with nothing to parse. KAS_BUILD_DIR is blanked here (same reasoning
	# as run_kas()'s own comment: kas-container's forward_dir would otherwise
	# bind-mount a host path over the volumes), which makes kas default its
	# build dir to $KAS_REPO_DIR itself (confirmed against the real source:
	# Context.__init__ falls back to KAS_WORK_DIR/build only when
	# KAS_BUILD_DIR is UNSET, not when it's blank -- os.environ.get's default
	# never fires for an explicitly-empty value -- so build_dir becomes
	# os.path.abspath('') = cwd = /repo = $MACKAS_PROJECT here). So
	# conf/local.conf and conf/bblayers.conf under $MACKAS_PROJECT are the
	# real, host-visible signal for "has this ever been configured before".
	# NEVER let kas touch the checkouts. This is read-only by contract, and
	# it must not be capable of modifying a single repo.
	#
	# The old form used -k when conf/local.conf existed and NOTHING otherwise.
	# That "otherwise" was a data-loss bug, hit for real: with no local.conf
	# yet, kas ran its full setup -- including repos_checkout and
	# repos_apply_patches -- which resets every declared repo to its pinned
	# revision and wipes local commits in the layer checkouts under work/.
	# `mackas retrieve` calls this (via bitbake_getvar), so merely copying
	# build output off a volume could destroy unpushed work in a layer,
	# silently. That same manual mistake -- typing kas-container by hand
	# without any of this -- has since reset a real checkout twice; cmd_exec()
	# exists specifically so a one-off manual check never has to type
	# kas-container directly again.
	#
	# Skipping the four repo-touching steps INDIVIDUALLY is the fix, and is
	# strictly better than either old branch: -k also skips write_bbconfig,
	# which is exactly what a checkout with no conf/ yet still needs, while
	# these four are the only ones that mutate a repo. So this is safe on a
	# fresh checkout AND on a configured one, with no conditional at all.
	# (kas/libkas.py's setup_parser_keep_config_unchanged_arg lists the five
	# steps -k bundles; write_bbconfig is the one deliberately left in.)
	local kflag="$KAS_SKIP_REPO_STEPS"

	(
		cd "$MACKAS_PROJECT" 2>/dev/null || exit 1
		kas_invoke_env "$rt_args" "$gitconfig" 1 shell $kflag "$KAS_FILES_ARG" -c "$cmdstring"
	)
}

bitbake_getvar() {
	# QUIET_UNDEFINED (2nd arg, opt-in): when bitbake-getvar's own error is
	# exactly "The variable 'X' is not defined" -- its wording when NOTHING
	# in the parsed config ever set X, as opposed to a real resolution
	# failure -- swallow it and signal that specific case with return 2
	# instead of the generic 1, rather than printing it as a warning. Only
	# BUILDHISTORY_DIR and DEPLOY_DIR_SPDX's callers opt in: BUILDHISTORY_DIR
	# is defined nowhere but inside buildhistory.bbclass, and DEPLOY_DIR_SPDX
	# is defined nowhere but inside spdx-common.bbclass (pulled in by
	# create-spdx), so "not defined" in either case just means "this project
	# doesn't INHERIT it" -- the overwhelmingly common case for buildhistory,
	# already explained in the caller's own follow-up message, not a
	# bitbake-getvar problem worth a generic warning about. Every other caller
	# queries a variable bitbake.conf itself always sets, where this exact
	# wording would be a genuine surprise worth keeping visible.
	local var="$1" quiet_undefined="${2:-0}" out rc errfile errmsg

	# kas-container's own stderr (e.g. "configuration file '...' not found",
	# the exact symptom of the MACKAS_KAS_CONFIG-without-MACKAS_PROJECT_DIR
	# mistake kas_shell_ro() catches surviving some OTHER way) is captured,
	# not discarded -- a bare "could not resolve" with no reason was hard to
	# debug live.
	errfile="$(mktemp "${TMPDIR:-/tmp}/mackas-getvar.XXXXXX" 2>/dev/null)" || errfile=/dev/null
	out="$(kas_shell_ro "bitbake-getvar --value -q $(printf '%q' "$var")" 2>"$errfile")"
	rc=$?
	if [ "$rc" -ne 0 ] || [ -z "$out" ]; then
		errmsg="$(tail -1 "$errfile" 2>/dev/null)"
		rm -f "$errfile"
		case "$errmsg" in
			"The variable '$var' is not defined"*)
				[ "$quiet_undefined" = "1" ] && return 2 ;;
		esac
		[ -n "$errmsg" ] && warn "  bitbake-getvar failed for $var: $errmsg"
		return 1
	fi
	rm -f "$errfile"
	# BUILDSTATS_BASE's own OE-core default carries a trailing slash
	# ("${TMPDIR}/buildstats/") -- strip it so callers get a plain path to
	# join with, the same shape DEPLOY_DIR/LOG_DIR already resolve to.
	printf '%s\n' "${out%/}"
}

# ---------------------------------------------------------------------------
# Host-side overhead sampling, folded into `smoketest`
# ---------------------------------------------------------------------------
#
# buildstats measures the GUEST. Nothing recorded what a build costs the Mac
# itself, so tools/mackas-overhead samples the host process set -- the
# Virtualization.framework VM plus the container daemons -- with cheap `ps`
# snapshots and reports host CPU-seconds and peak RSS around each smoketest rung.
#
# It is best-effort and MUST NEVER fail a build: every call is guarded, the
# sampler runs backgrounded, and its exit status is ignored. /usr/bin/python3
# (stock macOS) is used explicitly -- /opt/homebrew/bin/python3 may be absent.
#
# Honest limits, spelled out in docs/testing.md and the sampler's own caveats:
#   * A fully-cached rung does almost no VM work, so its host figure is near
#     zero -- correct, not a bug.
#   * The guest buildstats live inside the volume until `mackas retrieve
#     buildstats` extracts them, so the host figure is NOT yet differenced
#     against guest CPU here. It is host cost, not isolated overhead.
#
# MACKAS_OVERHEAD_BIN is an undocumented test seam (cf. MACKAS_CONTAINER_BIN):
# it points the sampler invocation at a fake so the hook is assertable without
# a real build.
overhead_start() {
	OVERHEAD_PID=""
	OVERHEAD_OUT=""
	[ "${MACKAS_OVERHEAD:-1}" = "1" ] || return 0
	[ "$DRY_RUN" -eq 0 ] || return 0
	local bin="${MACKAS_OVERHEAD_BIN:-$SCRIPT_DIR/tools/mackas-overhead}"
	[ -f "$bin" ] || { vrb "overhead: no sampler at $bin; skipping"; return 0; }
	[ -x /usr/bin/python3 ] || { vrb "overhead: /usr/bin/python3 missing; skipping"; return 0; }
	OVERHEAD_OUT="$(mktemp "${TMPDIR:-/tmp}/mackas-overhead.XXXXXX" 2>/dev/null)" \
		|| { OVERHEAD_OUT=""; return 0; }
	/usr/bin/python3 "$bin" --interval "$MACKAS_OVERHEAD_INTERVAL" \
		> "$OVERHEAD_OUT" 2>&1 &
	OVERHEAD_PID=$!
	vrb "overhead: sampling host (pid $OVERHEAD_PID, interval ${MACKAS_OVERHEAD_INTERVAL}s)"
	return 0
}

# overhead_stop LOG -- stop the sampler (if any), fold its summary into LOG and
# print the headline host figures. Never fails, never affects the rung result.
overhead_stop() {
	local log="$1"
	[ -n "${OVERHEAD_PID:-}" ] || return 0
	kill -TERM "$OVERHEAD_PID" 2>/dev/null || true
	wait "$OVERHEAD_PID" 2>/dev/null || true
	if [ -n "${OVERHEAD_OUT:-}" ] && [ -s "$OVERHEAD_OUT" ]; then
		{
			printf '\n=== host-side overhead (mackas-overhead) ===\n'
			cat "$OVERHEAD_OUT"
		} >> "$log" 2>/dev/null || true
		# Headline lines to the console: host CPU-seconds and peak RSS.
		grep -E '^host (CPU|RSS)' "$OVERHEAD_OUT" 2>/dev/null | sed 's/^/      /' || true
	fi
	[ -n "${OVERHEAD_OUT:-}" ] && rm -f "$OVERHEAD_OUT" 2>/dev/null
	OVERHEAD_PID=""
	OVERHEAD_OUT=""
	return 0
}

smoketest_rung() {
	# smoketest_rung <n> <total> <label> <expect> <kas args...>
	local n="$1" total="$2" label="$3" expect="$4"; shift 4
	local log slug rc=0 is_build=0 start_s end_s
	slug="$(printf '%s' "$label" | tr ' /:' '---')"
	log="$MACKAS_LOGS/smoketest-${n}-${slug}.log"
	# 'build' vs 'shell' (parse-only) -- only a real build rung gets item 16's
	# completion summary; parse-only builds nothing to summarise.
	[ "${1:-}" = "build" ] && is_build=1

	printf '\n%s[rung %s/%s] %s%s\n' "$C_BLD" "$n" "$total" "$label" "$C_RST"
	printf '      %sexpect: %s%s\n' "$C_DIM" "$expect" "$C_RST"
	printf '      %slog:    %s%s\n' "$C_DIM" "$log" "$C_RST"

	[ "$DRY_RUN" -eq 1 ] || mkdir -p "$MACKAS_LOGS"
	[ "$DRY_RUN" -eq 1 ] || {
		{
			printf '=== %s\n=== %s\n=== cwd: %s\n=== %s\n\n' \
				"$label" "$(date)" "$MACKAS_PROJECT" "$(kas_env_prefix)"
		} > "$log"
	}

	# Wrap the build in the host-side sampler. Everything overhead-related sits
	# inside `set +e` so a sampler hiccup can never abort the rung, and
	# overhead_stop() runs AFTER rc is captured so it cannot change the result.
	# start_s/end_s are real wall-clock around run_kas, independent of
	# MACKAS_OVERHEAD (which may be off, or its sampler unavailable) -- item
	# 16's completion summary needs elapsed time regardless of that setting.
	set +e
	overhead_start
	start_s=$(date +%s)
	run_kas "$log" "$@"
	rc=$?
	end_s=$(date +%s)
	overhead_stop "$log"
	set -e

	if [ "$rc" -eq 0 ]; then
		printf '      %s[OK]%s %s\n' "$C_GRN" "$C_RST" "$label"
		[ "$is_build" -eq 1 ] && [ "$DRY_RUN" -eq 0 ] && print_build_summary "$label" "$log" "$start_s" "$end_s"
	else
		printf '      %s[FAILED]%s %s (exit %s)\n' "$C_RED" "$C_RST" "$label" "$rc"
		printf '      %ssee: %s%s\n' "$C_BLU" "$log" "$C_RST"
		printf '      %slast 20 lines:%s\n' "$C_DIM" "$C_RST"
		[ -f "$log" ] && tail -20 "$log" | sed 's/^/        /'
	fi
	return "$rc"
}

# print_build_summary LABEL LOG START END -- item 16: a one-line completion
# summary after a genuinely successful build rung (never on parse-only or a
# failure -- smoketest_rung only calls this on rc=0 for a 'build' rung), in
# the shape the README demo shows: '✓ TARGET built  (X.Y min, N tasks)'.
# Elapsed time is real, measured around run_kas regardless of MACKAS_OVERHEAD.
# The task count comes from bitbake's own "NOTE: Tasks Summary: Attempted N
# tasks" line in LOG -- omitted, never guessed, when that line is not found
# (an unusual kas output shape, or bitbake wording this differently).
print_build_summary() {
	local label="$1" log="$2" start_s="$3" end_s="$4" target elapsed_s elapsed_min tasks suffix
	target="${label#build }"
	# The no-explicit-target rung's label is the parenthesised
	# "(kas config's own default target)" -- strip the parens so the summary
	# reads as a sentence ("kas config's own default target built ...")
	# instead of carrying them into the middle of one.
	case "$target" in
		\(*\)) target="${target#(}"; target="${target%)}" ;;
	esac
	elapsed_s=$(( end_s - start_s ))
	elapsed_min="$(LC_ALL=C awk -v s="$elapsed_s" 'BEGIN { printf "%.1f", s / 60 }')"
	tasks="$(grep -oE 'Attempted [0-9]+ tasks' "$log" 2>/dev/null | tail -1 | grep -oE '[0-9]+' || true)"
	suffix="$elapsed_min min"
	[ -n "$tasks" ] && suffix="$suffix, $tasks tasks"
	printf '      %s✓ %s built  (%s)%s\n' "$C_GRN" "$target" "$suffix" "$C_RST"
}

smoketest_usage() {
	cat <<EOF
${C_BLD}$SCRIPT_CMD smoketest${C_RST} -- run the validation ladder: parse-only, then
MACKAS_SMOKETEST_TARGETS (or the kas config's own default target, if unset).

${C_BLD}USAGE${C_RST}
  $SCRIPT_CMD smoketest

Two rungs. First, parse-only (\`kas shell ... -c "bitbake -p"\`) -- confirms
every layer fetches and every recipe parses, with no build. Then, one build
rung per target in MACKAS_SMOKETEST_TARGETS -- or, if that is empty (the
default), whatever \`bitbake\` builds with no --target, i.e. the project's
own kas config default. \`auto-fstrim\` reclaims the sparse ext4 volumes
before and after. Logs land in \$MACKAS_LOGS/smoketest-*.log; host CPU/RSS
overhead is sampled around each rung. Each build rung that genuinely
succeeds prints a one-line summary, e.g. '✓ core-image-base built (35.5 min,
6253 tasks)' -- the task count is omitted, never guessed, if bitbake's own
Tasks Summary line cannot be found in that rung's log.

If no project is configured at all, smoketest OFFERS the qualcomm-linux/
meta-ai example for that one run only -- never persisted, never the default,
removed again (checkout + generated kas fragment) once the ladder finishes.
Declining exits smoketest without running anything.

Options: --dry-run, -y/--yes (or -f/--force) and -v/--verbose work here too.

${C_BLD}ONE-VM RULE${C_RST}
  Only one VM may access an ext4 image at a time. smoketest refuses while
  another build ($SCRIPT_CMD shell, a second smoketest, or a raw
  kas-container) still holds any of the three volumes -- stop it first.
EOF
}

# The example project smoketest offers when NOTHING is configured -- the
# same qualcomm-linux/meta-ai coordinates that used to be mackas's baked-in
# default, before that was removed. Never written to set_defaults(), never
# persisted anywhere, not a real SETTING_NAMES entry (no --set/config-file
# override -- the example's identity is fixed): offer_example_project
# assigns these in-memory for ONE smoketest invocation, and
# cleanup_example_project removes every trace again afterward.
#
# The ${VAR:-default} form (an undocumented test seam, cf. MACKAS_OVERHEAD_BIN)
# lets a test point this at a local fixture repo instead of the real GitHub
# URL, without making it a real user-facing setting.
MACKAS_EXAMPLE_PROJECT_URL="${MACKAS_EXAMPLE_PROJECT_URL:-https://github.com/qualcomm-linux/meta-ai.git}"
MACKAS_EXAMPLE_PROJECT_BRANCH="${MACKAS_EXAMPLE_PROJECT_BRANCH:-wrynose}"
MACKAS_EXAMPLE_PROJECT_DIR="${MACKAS_EXAMPLE_PROJECT_DIR:-meta-ai}"
MACKAS_EXAMPLE_KAS_CONFIG="${MACKAS_EXAMPLE_KAS_CONFIG:-kas/base.yml:kas/qemuarm64.yml}"

# offer_example_project -- smoketest's fallback when no project is configured
# at all. Confirms with the user (same confirm() semantics as everywhere
# else: --dry-run auto-yeses and prints, -y/-f auto-yeses for real, a
# declined/non-interactive answer returns 1), wires the example project's
# settings in for THIS invocation only, and clones it / writes its kas
# fragment right here -- setup() skips both of those steps when no project
# is configured, so smoketest has to do them itself for an ephemeral run.
offer_example_project() {
	confirm "No project is configured. Use the qualcomm-linux/meta-ai example (branch $MACKAS_EXAMPLE_PROJECT_BRANCH) for THIS smoketest only? It is removed again afterward and never becomes the default." \
		|| return 1

	MACKAS_PROJECT_URL="$MACKAS_EXAMPLE_PROJECT_URL"
	MACKAS_PROJECT_BRANCH="$MACKAS_EXAMPLE_PROJECT_BRANCH"
	MACKAS_PROJECT_DIR="$MACKAS_EXAMPLE_PROJECT_DIR"
	[ -n "$MACKAS_KAS_CONFIG" ] || MACKAS_KAS_CONFIG="$MACKAS_EXAMPLE_KAS_CONFIG"
	# MACKAS_PROJECT/MACKAS_KAS_FRAGMENT_*/KAS_FILES_ARG all derive from the
	# settings just assigned above.
	derive_paths

	hdr "Cloning the meta-ai example (this invocation only)"
	setup_project
	setup_kas_fragment
	return 0
}

# cleanup_example_project -- undo offer_example_project(), success or failure
# alike. Only ever called when offer_example_project just returned 0, so
# MACKAS_PROJECT/MACKAS_KAS_FRAGMENT_SRC genuinely name what it just created,
# never a real project the user configured (that path never reaches here --
# see cmd_smoketest).
cleanup_example_project() {
	info ""
	info "Removing the meta-ai example project (never the default, not kept around)..."
	run rm -rf "$MACKAS_PROJECT"
	run rm -f "$MACKAS_KAS_FRAGMENT_SRC"
	did "removed $MACKAS_PROJECT and $MACKAS_KAS_FRAGMENT_SRC"
}

# ensure_kas_container_installed -- offer to run setup_kas_container (the
# same pinned-download-and-sha256-verify step 'setup' does) instead of just
# refusing. Very likely to be hit -- anyone running smoketest/shell before a
# full 'setup' lands here -- and nothing external needs installing (unlike a
# missing 'container' or Homebrew), so mackas can just do it.
ensure_kas_container_installed() {
	# Both files must be present: KAS_CONTAINER_BIN alone could be a wrapper
	# with no .real behind it to exec (fails at build time, not here), and
	# KAS_CONTAINER_REAL alone means $PATH still resolves 'kas-container' to
	# nothing -- the exact unprotected-invocation bug this wrapper exists to
	# close. Either half-state must be treated as "not installed".
	[ -x "$KAS_CONTAINER_REAL" ] && [ -x "$KAS_CONTAINER_BIN" ] && return 0
	warn "      kas-container is not installed yet."
	if ! confirm "      Install it now (setup's own step)?"; then
		die "kas-container not installed" "$SCRIPT_CMD setup"
	fi
	setup_kas_container
}

# ensure_project_checked_out -- offer to run setup_project (the exact
# clone/fetch+checkout logic 'setup' uses) instead of just refusing, when a
# project IS configured but hasn't been cloned yet. Safe to call
# unconditionally: refuses with a clear, specific message (no auto-clone
# offered) when no project is configured at all, rather than attempting to
# clone an empty URL.
ensure_project_checked_out() {
	[ -d "$MACKAS_PROJECT/.git" ] && return 0
	if [ -z "$MACKAS_PROJECT_URL" ]; then
		die "no project configured (MACKAS_PROJECT_URL is empty)" \
			"set MACKAS_PROJECT_URL/_BRANCH/_DIR in $(config_hint) (see mackas.conf.example), then re-run"
	fi
	warn "      $MACKAS_PROJECT_DIR is not checked out yet at $MACKAS_PROJECT."
	if ! confirm "      Clone it now (setup's own step)?"; then
		die "project not checked out at $MACKAS_PROJECT" "$SCRIPT_CMD setup"
	fi
	setup_project
}

cmd_smoketest() {
	require_mackas_root
	# Before anything that reads or writes the checkout, not just inside
	# run_kas: with the workspace image detached (any reboot) $MACKAS_PROJECT
	# points into a mount that is not there, so ensure_project_checked_out()
	# below sees a perfectly good checkout as missing -- and offers to CLONE
	# it onto the case-insensitive drive, which is the corruption the image
	# exists to prevent. Idempotent, so run_kas's own call still covers every
	# other path into it.
	ensure_workspace_attached
	ensure_kas_container_installed

	# A checkout already on disk (a real project, however it got there) always
	# wins -- only fall back to offering the example when there is genuinely
	# nothing to build: no checkout AND no project configured at all. A
	# project configured but not yet cloned goes through
	# ensure_project_checked_out (clone-or-refuse); that case is not what the
	# example offer is for.
	local example_active=0
	if [ ! -d "$MACKAS_PROJECT/.git" ]; then
		if [ -n "$MACKAS_PROJECT_URL" ]; then
			ensure_project_checked_out
		elif offer_example_project; then
			example_active=1
		else
			info "  Declined -- smoketest needs a project to build against."
			info "  Set MACKAS_PROJECT_URL/_BRANCH/_DIR (see mackas.conf.example) to configure your own, or answer yes next time to use the example."
			return 1
		fi
	fi
	if [ ! -f "$MACKAS_KAS_FRAGMENT_REPO" ]; then
		warn "      kas fragment missing at $MACKAS_KAS_FRAGMENT_REPO."
		if ! confirm "      Write it now (setup's own step)?"; then
			die "kas fragment missing at $MACKAS_KAS_FRAGMENT_REPO" "$SCRIPT_CMD setup"
		fi
		setup_kas_fragment
	fi

	local rc=0
	smoketest_ladder || rc=$?
	[ "$example_active" -eq 1 ] && cleanup_example_project
	return "$rc"
}

# The ladder itself, split out from cmd_smoketest so the latter can run
# cleanup_example_project afterward -- success or failure alike -- without
# losing the ladder's own exit code.
smoketest_ladder() {
	# The ladder is rung 1 (parse-only, universal) followed by one build rung
	# per target in MACKAS_SMOKETEST_TARGETS. When that list is empty (the
	# default), there is still exactly one build rung, but it passes no
	# --target at all, so kas/bitbake builds whatever default target the kas
	# config itself names -- exactly what `kas build <config>` does with no
	# target. Set your own project's targets to exercise more than that.
	local total=1 t
	for t in $MACKAS_SMOKETEST_TARGETS; do total=$((total + 1)); done
	[ -n "$MACKAS_SMOKETEST_TARGETS" ] || total=$((total + 1))

	info "${C_BLD}mackas smoketest${C_RST}"
	info "  kas files : $KAS_FILES_ARG"
	info "  targets   : ${MACKAS_SMOKETEST_TARGETS:-<none: no --target, kas builds its own default>}"
	info "  resources : -c $MACKAS_CPUS -m $MACKAS_MEMORY"
	info "  logs      : $MACKAS_LOGS/"
	info ""
	if [ "$total" -gt 1 ]; then
		warn "  Rungs 2-$total are real builds. A large target can take HOURS on a cold"
		warn "  sstate cache. Ctrl-C is safe; re-running resumes."
	fi

	if [ "$DRY_RUN" -eq 0 ] && ! confirm "  Start the ladder?"; then
		info "  Aborted. Nothing ran."
		return 0
	fi

	# The progress bridge wraps every bitbake invocation in the container for
	# that container's whole life, parse-only included -- so with
	# MACKAS_MONITOR=1 left on here, this rung's own "bitbake -p" would
	# publish a bridge, reach status "success" once parsing finishes, and a
	# caller watching for the ladder's completion (mackas monitor, or
	# anything polling the same port) would see a false "done" minutes
	# before any real build has even started. Suppress the bridge for this
	# one rung only; it comes back for the real build rungs below.
	local saved_monitor="$MACKAS_MONITOR"
	MACKAS_MONITOR=0
	smoketest_rung 1 "$total" "parse-only (bitbake -p)" \
		"all layers fetched, recipes parse, no build" \
		shell "$KAS_FILES_ARG" -c "bitbake -p" || { MACKAS_MONITOR="$saved_monitor"; return 1; }
	MACKAS_MONITOR="$saved_monitor"

	local n=1
	if [ -n "$MACKAS_SMOKETEST_TARGETS" ]; then
		for t in $MACKAS_SMOKETEST_TARGETS; do
			n=$((n + 1))
			smoketest_rung "$n" "$total" "build $t" \
				"$t builds from source or sstate" \
				build "$KAS_FILES_ARG" --target "$t" || return 1
		done
	else
		n=$((n + 1))
		smoketest_rung "$n" "$total" "build (kas config's own default target)" \
			"the kas config's own default target builds from source or sstate" \
			build "$KAS_FILES_ARG" || return 1
	fi

	hdr "Smoketest ladder passed"
	info "  Logs: $MACKAS_LOGS/"
	return 0
}

