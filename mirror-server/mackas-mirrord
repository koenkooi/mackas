# Request-line and header limits.
#
# The checks in parse_request() below are NOT what bounds our memory, and the
# comment that used to live here claimed otherwise. It was wrong. By the time
# parse_request() can look at self.headers, http.client.parse_headers() has
# already read the whole header block into memory: its _read_headers() loop
# accepts up to _MAXHEADERS (100) lines of up to _MAXLINE (65536) bytes, so
# ~6.6 MB per connection is buffered *before* our first check runs, and the
# 431 we then send is an autopsy, not a defence. At --max-connections 64 that
# is ~420 MB an unauthenticated client can pin.
#
# So the limits have to be enforced by the loop doing the reading, and the only
# knobs that loop has are http.client's two module globals. We set them.
#
# WHY TOUCHING A PRIVATE GLOBAL IS THE RIGHT TRADE HERE, HONESTLY STATED:
#
#   * The alternatives are worse. MessageClass is useless -- it is handed to
#     the email parser only after _read_headers() has already buffered
#     everything. There is no hook: http.server calls
#     http.client.parse_headers() inline, so the only way to bound the read
#     without patching a private name is to reimplement parse_request()
#     wholesale, and a hand-rolled HTTP header parser is a far bigger security
#     liability than an underscore.
#   * The blast radius is nil. These globals affect http.client, and this
#     program never acts as an HTTP *client* -- there is no outbound request
#     anywhere in this file. We are a single-purpose daemon, not a library, so
#     we are not changing behaviour out from under someone else's code.
#   * It fails safe. If a future CPython renames them, the hasattr() check
#     below skips the tightening and we are back to the stock 6.6 MB -- worse,
#     but not broken. The regression test asserts the tightening works, so we
#     find out.
#
# With these, the worst case is MAX_HEADERS * MAX_HEADER_LINE = 512 KiB per
# connection (32 MB at the default cap) instead of 6.6 MB (420 MB). The
# MAX_HEADER_BYTES total is still checked afterwards, and is what actually
# holds bitbake-shaped traffic to something sane.
MAX_REQUEST_LINE = 8192
MAX_HEADERS = 64
MAX_HEADER_LINE = 8192
MAX_HEADER_BYTES = 16384

# Largest request body we will read and throw away before answering 413. No
# method here takes a body at all; this only exists so that a body cannot be
# left in the socket to be re-parsed as the next request. See
# consume_request_body().
MAX_REQUEST_BODY = 65536

if hasattr(http.client, "_MAXLINE"):
    http.client._MAXLINE = MAX_HEADER_LINE
if hasattr(http.client, "_MAXHEADERS"):
    http.client._MAXHEADERS = MAX_HEADERS

# PBKDF2 cost for the stored credential. 200k SHA-256 iterations is ~0.1s on
# modest server hardware: irrelevant next to a 47G cache fetch, and expensive
# enough that an offline attacker who steals the credential file gains little.
PBKDF2_ITERATIONS = 200_000
PBKDF2_ALGO = "sha256"
SALT_BYTES = 16

log = logging.getLogger(PROGRAM)


# ---------------------------------------------------------------------------
# Logging hygiene
# ---------------------------------------------------------------------------

# Control characters and newlines in a request path let a client forge log
# lines ("log injection"): a GET for "/a\n2026-01-01 ... 200 OK GET /admin"
# writes a second, fake entry into the log an operator or a parser will read
# as real. bitbake never needs a control character in a URL, so we do not try
# to preserve them -- everything outside printable ASCII becomes an escape.
_UNSAFE_LOG_CHARS = re.compile(r"[^\x20-\x7e]")


def sanitize_for_log(text: str, limit: int = 512) -> str:
    """Make an untrusted string safe to write to a line-oriented log.

    Threat: log injection / terminal escape-sequence injection. Anything a
    client controls (path, User-Agent, username) reaches the log, and a log is
    read by humans in terminals and by parsers that split on newlines.
    """
    if not isinstance(text, str):
        text = str(text)
    if len(text) > limit:
        text = text[:limit] + "...<truncated>"
    return _UNSAFE_LOG_CHARS.sub(lambda m: "\\x%02x" % ord(m.group()), text)


