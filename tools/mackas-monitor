"""Poll http://127.0.0.1:<port>/ (published by kas_runtime_args() when
MACKAS_MONITOR=1 -- see docs/monitor-app.md for the JSON contract) and print
progress lines until the build reports success/failed or this process is
interrupted. Stdlib only, matching every other mackas-side tool.

`mackas monitor` is a thin wrapper: it does not start anything, it only
polls an already-running build's already-published bridge.
"""

import argparse
import json
import os
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request


def _float_env(name, default):
    """os.environ.get with the shell ${VAR:-default} semantics the rest of
    mackas uses -- an unset OR unparseable value falls back, never raises."""
    try:
        return float(os.environ.get(name, "") or default)
    except ValueError:
        return float(default)


POLL_INTERVAL = _float_env("MACKAS_MONITOR_POLL_INTERVAL", 2.0)
REQUEST_TIMEOUT = 2.0

# Distinct exit codes so a script can tell "no bridge reachable at all" apart
# from "reached it, and the build itself failed" -- both used to return 1.
EXIT_OK = 0
EXIT_BUILD_FAILED = 1
EXIT_UNREACHABLE = 2

# A notifier that hangs must not stall the poll loop; it is a side-channel,
# not the job.
NOTIFY_TIMEOUT = 5.0

# terminal-notifier coalesces on -group: a later notification with the same
# group replaces the earlier one in Notification Center, so a build leaves
# one current line there instead of three stale ones.
NOTIFY_GROUP = "net.thruhere.mackas.build"

# The separator mackas already uses for this shape elsewhere (the build
# summary line in the README demo reads "core-image-base . rb1-core-kit built").
SEP = " \u00b7 "

NOTIFY_HELP = """\
NOTIFICATIONS (--notify / MACKAS_MONITOR_NOTIFY=1)

Fires on exactly three transitions -- build started (idle -> building),
build succeeded, build failed -- never once per task. terminal-notifier is
used when it is on PATH (detected, never required); otherwise osascript.

THE OSASCRIPT GOTCHA: if the terminal application running this has no
entry under System Settings > Notifications, osascript notifications are
SILENTLY DROPPED -- exit status 0, no output, nothing on screen. The
feature is not broken; macOS needs a one-time per-application grant that
no CLI can perform for you. Run one build to make the entry appear (or
`brew install terminal-notifier`, which brings its own), then enable it in
System Settings > Notifications.

A notifier that is missing, broken or slow never fails this tool: the text
output and the exit status are unchanged either way.
"""


def fetch(port):
    with urllib.request.urlopen(
        f"http://127.0.0.1:{port}/", timeout=REQUEST_TIMEOUT
    ) as resp:
        return json.loads(resp.read().decode("utf-8"))


def _underlying_os_error(exc):
    """The OSError a failure actually is, whether urllib wrapped it in a
    URLError or it propagated bare -- both forms are observed in practice
    depending on exactly where in the socket/HTTP stack the failure lands,
    and the caller wants to switch on the real errno either way."""
    if isinstance(exc, urllib.error.URLError) and isinstance(exc.reason, OSError):
        return exc.reason
    if isinstance(exc, OSError):
        return exc
    return None


def connection_error_message(port, exc):
    """One of three genuinely different situations, not one errno. A user
    hitting this needs to know which before they know what to do next."""
    real = _underlying_os_error(exc)
    if isinstance(real, ConnectionRefusedError):
        return (
            f"nothing is listening on 127.0.0.1:{port} -- no monitored build "
            f"is running right now (MACKAS_MONITOR=1 has to be set before a "
            f"build starts, not after)"
        )
    if isinstance(real, ConnectionResetError):
        return (
            f"something is publishing 127.0.0.1:{port} but reset the "
            f"connection instead of answering -- the build may not have "
            f"reached bitbake yet, or the progress bridge did not come up "
            f"inside the container; try again in a few seconds"
        )
    if isinstance(real, TimeoutError) or isinstance(exc, TimeoutError):
        return f"127.0.0.1:{port} did not respond within {REQUEST_TIMEOUT}s -- try again"
    return f"could not reach the bridge at 127.0.0.1:{port}: {exc}"


def _format_elapsed(seconds):
    """H:MM:SS, or M:SS under an hour -- no leading zero on the leftmost unit."""
    seconds = max(0, int(seconds))
    h, rem = divmod(seconds, 3600)
    m, s = divmod(rem, 60)
    if h:
        return f"{h}:{m:02d}:{s:02d}"
    return f"{m}:{s:02d}"


def new_render_context():
    """Per-run state render() needs that a single JSON payload does not
    carry: when the build actually started (progress.total jumps between
    phases -- see docs/monitor-app.md -- so elapsed wall time is tracked
    locally, not derived from it), whether the one-time header line has
    printed yet, the last line shown (to de-duplicate an unchanged poll),
    and whether stdout is a real terminal at all."""
    return {
        "started_at": None,
        "header_printed": False,
        "last_line": None,
        "last_len": 0,
        "is_tty": sys.stdout.isatty(),
    }


def render(state, ctx):
    status = state.get("status", "?")

    if ctx["started_at"] is None and status not in ("idle", "?"):
        ctx["started_at"] = time.monotonic()

    if not ctx["header_printed"] and status != "idle":
        header = describe_targets(state)
        if header:
            print(f"watching: {header}", flush=True)
        ctx["header_printed"] = True

    if status == "idle":
        line = "waiting for the build to start..."
    else:
        current = state.get("current") or {}
        progress = state.get("progress") or {}
        recipe = current.get("recipe") or "-"
        task = current.get("task") or "-"
        done = progress.get("done", 0)
        total = progress.get("total", 0)
        # The core "[status] done/total  recipe:task" shape is unchanged --
        # percent/elapsed/failures are appended after it, never inserted
        # into it, so anything that greps for that substring still matches.
        line = f"[{status}] {done}/{total}  {recipe}:{task}"
        if total:
            line += f"  {done * 100 // total}%"
        if ctx["started_at"] is not None:
            line += f"  {_format_elapsed(time.monotonic() - ctx['started_at'])}"
        failed = state.get("failed_count") or 0
        if failed and status == "building":
            line += f"  ({failed} failed so far)"

    changed = line != ctx["last_line"]
    if ctx["is_tty"]:
        # Overwrite the previous line in place instead of scrolling -- a
        # ~2s poll over a 90-minute build would otherwise print roughly
        # 2700 near-identical lines. Only committed to a real newline (so
        # the shell prompt lands cleanly below it) once the build reaches
        # a terminal status.
        if changed or status in ("success", "failed"):
            pad = max(0, ctx["last_len"] - len(line))
            print("\r" + line + (" " * pad), end="", flush=True)
            ctx["last_len"] = len(line)
            if status in ("success", "failed"):
                print(flush=True)
    else:
        if changed:
            print(line, flush=True)
    ctx["last_line"] = line


# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------


def applescript_string(value):
    """Quote VALUE as an AppleScript string literal, delimiters included.

    This is a real injection surface, not paranoia: recipe and task names
    come out of the build, land in `osascript -e <source>`, and osascript
    parses that argument as AppleScript SOURCE. An unescaped double quote
    ends the literal and everything after it is executed as script. Both
    " and \\ are escaped; control characters (a newline would also end the
    statement) become spaces. Note the argv is passed as a list, never
    through a shell, so shell quoting is not part of this problem.
    """
    out = []
    for ch in str(value):
        if ch in ('"', "\\"):
            out.append("\\" + ch)
        elif ch == "\n" or ch == "\r" or ch == "\t" or ord(ch) < 32 or ord(ch) == 127:
            out.append(" ")
        else:
            out.append(ch)
    return '"' + "".join(out) + '"'


def _run_quiet(argv):
    """True only if the command ran and exited 0. Never raises for the
    caller's benefit -- notify() treats an exception as 'did not fire'."""
    proc = subprocess.run(
        argv,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=NOTIFY_TIMEOUT,
        check=False,
    )
    return proc.returncode == 0


def _notify_terminal_notifier(title, message):
    exe = shutil.which("terminal-notifier")
    if not exe:
        return False
    return _run_quiet(
        [exe, "-title", title, "-message", message, "-group", NOTIFY_GROUP]
    )


def _notify_osascript(title, message):
    exe = shutil.which("osascript")
    if not exe:
        return False
    script = "display notification {} with title {}".format(
        applescript_string(message), applescript_string(title)
    )
    return _run_quiet([exe, "-e", script])


def notify(title, message):
    """Best-effort native notification. Tries terminal-notifier first (more
    reliable, and it carries its own Notification Center entry), then
    osascript. Returns True if one of them claims to have fired.

    Nothing in here may propagate: a notification is a courtesy, and a
    monitor that dies because a notifier is missing is worse than one that
    prints its lines quietly."""
    for send in (_notify_terminal_notifier, _notify_osascript):
        try:
            if send(title, message):
                return True
        except Exception:
            continue
    return False


def _targets_of(state):
    """The target list, capped so a 20-target build does not fill the screen."""
    targets = state.get("targets") or []
    if not targets:
        return ""
    if len(targets) <= 3:
        return " ".join(str(t) for t in targets)
    return f"{' '.join(str(t) for t in targets[:3])} +{len(targets) - 3} more"


def _where_of(state):
    """MACHINE/DISTRO, in that order, skipping whichever is unknown.

    The slash is only a separator when both are present -- a bare "/angstrom"
    would read as a path, and inventing a placeholder for the missing half
    would be worse than saying less."""
    return "/".join(str(v) for v in (state.get("machine"), state.get("distro")) if v)


def describe_targets(state):
    """What the build was asked to produce, for the 'started' notification.

    At the moment status flips to 'building' no task is running yet, so the
    old 'recipe:task' body was almost always 'no task detail reported'. The
    targets are known before the build begins (the bridge reads them from
    bitbake's own parsed command line), which is the one genuinely useful
    thing to say at that point. An empty string means say nothing rather
    than pad the notification with filler."""
    what = _targets_of(state)
    where = _where_of(state)
    if what and where:
        return f"{what} for {where}"
    # Either alone still says something useful: MACHINE/DISTRO matters even
    # when no explicit target was given (bitbake then builds whatever the kas
    # config names), and targets matter even if the cooker would not say what
    # they are for.
    return what or where


def describe_failures(state):
    """The tasks that actually failed, for the 'failed' notification.

    NOT the current task: on a parallel build that is merely whatever
    happened to be running when the build stopped, so naming it reads as an
    accusation of an innocent recipe. The bridge tracks real
    runQueueTaskFailed events (never setscene ones, which are not failures).
    Empty string when it has none -- better to say nothing than to guess."""
    failed = state.get("failed_tasks") or []
    if not failed:
        return ""
    shown = [
        f"{f.get('recipe') or '?'}:{f.get('task') or '?'}"
        for f in failed[:3]
    ]
    total = state.get("failed_count") or len(failed)
    if total > len(shown):
        return f"{', '.join(shown)} +{total - len(shown)} more"
    return ", ".join(shown)


def describe_success(state):
    """What was built, and how much of it, for the 'succeeded' notification.

    Leads with the targets for the same reason 'started' does: the thing you
    want confirmed is WHAT finished, not how many tasks it took. The counts
    follow as detail, and any part that is unknown is simply left out rather
    than padded."""
    progress = state.get("progress") or {}
    total = progress.get("total", 0)
    done = progress.get("done", 0)
    parts = []
    what = describe_targets(state)
    if what:
        parts.append(what)
    if total:
        parts.append(f"{done}/{total} tasks")
    return SEP.join(parts)


def describe_failed(state):
    """What failed, and which build it was -- MACHINE/DISTRO, not the targets.

    The failing task is the subject here; the targets are what you were
    trying to get, which matters less than what stopped you. MACHINE/DISTRO
    stays because it is what tells two concurrent-ish builds apart."""
    failures = describe_failures(state)
    where = _where_of(state)
    return SEP.join([p for p in (failures, where) if p])


def transition_message(prev_status, state):
    """(title, message) for the one notification this poll warrants, or None.

    Only a CHANGE of status notifies, which is what keeps a build's many
    'building' polls to a single 'started'. prev_status is None before the
    first poll, so attaching to a build already in progress still announces
    it once -- a monitor started late should say what it found."""
    status = state.get("status") or "?"
    if status == prev_status:
        return None
    if status == "building" and prev_status in (None, "idle"):
        return ("mackas: build started", describe_targets(state))
    if status == "success":
        return ("mackas: build succeeded", describe_success(state))
    if status == "failed":
        return ("mackas: build failed", describe_failed(state))
    return None


def main(argv=None):
    p = argparse.ArgumentParser(
        description=__doc__,
        epilog=NOTIFY_HELP,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("--port", type=int, required=True,
                    help="port to poll (MACKAS_MONITOR_PORT)")
    p.add_argument("--once", action="store_true",
                    help="fetch and print a single snapshot, then exit")
    p.add_argument("--notify", action="store_true",
                    help="post a native macOS notification on build "
                         "start/success/failure (never per task). Equivalent: "
                         "MACKAS_MONITOR_NOTIFY=1. See NOTIFICATIONS below -- "
                         "osascript notifications are silently dropped until "
                         "the terminal has a Notification Center entry.")
    args = p.parse_args(argv)

    want_notify = args.notify or os.environ.get("MACKAS_MONITOR_NOTIFY", "0") == "1"
    prev_status = None
    ctx = new_render_context()

    try:
        while True:
            try:
                state = fetch(args.port)
            except (urllib.error.URLError, ConnectionError, TimeoutError) as exc:
                print(connection_error_message(args.port, exc), file=sys.stderr)
                return EXIT_UNREACHABLE
            render(state, ctx)
            if want_notify:
                message = transition_message(prev_status, state)
                if message:
                    notify(*message)
            prev_status = state.get("status") or "?"
            if args.once or state.get("status") in ("success", "failed"):
                return EXIT_BUILD_FAILED if state.get("status") == "failed" else EXIT_OK
            time.sleep(POLL_INTERVAL)
    except KeyboardInterrupt:
        return EXIT_OK


if __name__ == "__main__":
    sys.exit(main())
