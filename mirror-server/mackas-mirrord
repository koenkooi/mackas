class RateLimiter:
    """A per-IP token bucket. Honest about what it is: a blunt instrument.

    This is not a WAF and does not pretend to be one. It stops one broken or
    looping client from monopolising the server; it does not stop a
    distributed attacker, and a spoofed source IP defeats it entirely (though
    not usefully, since TCP needs the handshake to complete).

    The table is bounded so that the limiter itself cannot be turned into a
    memory-exhaustion vector by a source-IP flood.
    """

    MAX_ENTRIES = 4096

    def __init__(self, rate: float, burst: int) -> None:
        self.rate = rate
        self.burst = burst
        self._buckets: Dict[str, Tuple[float, float]] = {}
        self._lock = threading.Lock()

    def allow(self, key: str) -> bool:
        if self.rate <= 0:
            return True
        now = time.monotonic()
        with self._lock:
            tokens, last = self._buckets.get(key, (float(self.burst), now))
            tokens = min(self.burst, tokens + (now - last) * self.rate)
            if tokens < 1.0:
                self._buckets[key] = (tokens, now)
                return False
            tokens -= 1.0
            if key not in self._buckets and len(self._buckets) >= self.MAX_ENTRIES:
                self._prune(now)
            self._buckets[key] = (tokens, now)
            return True

    def _prune(self, now: float) -> None:
        """Drop buckets that have refilled to full; they carry no state."""
        if self.rate <= 0:
            return
        full_after = self.burst / self.rate
        stale = [k for k, (_, last) in self._buckets.items()
                 if now - last > full_after]
        for k in stale:
            del self._buckets[k]
        if len(self._buckets) >= self.MAX_ENTRIES:
            # Still full of active talkers: forget the oldest half rather than
            # grow without bound. Forgetting is fail-open for those IPs, which
            # is the right trade -- the alternative is OOM.
            oldest = sorted(self._buckets.items(), key=lambda kv: kv[1][1])
            for k, _ in oldest[: len(oldest) // 2]:
                del self._buckets[k]


# ---------------------------------------------------------------------------
# Local file cache -- the server's FIRST real disk-write path
# ---------------------------------------------------------------------------
#
# Everything above this comment reads. This section is the one place
# mackas-mirrord writes, and it is opt-in: --cache-dir unset (the default)
# means none of this code ever runs, and behaviour is byte-for-byte what it
# was before this feature existed.
#
# THE INVARIANT THIS MUST NOT BREAK
#
# _reject_method(), below, says every mutating HTTP method 405s because
# there is no code that turns a CLIENT REQUEST into a write. That is still
# true: a request body is never opened as a file, a request path is never
# passed to open(..., "wb"). The write path that follows is reached only
# from inside serve_file(), AFTER resolve_under_root() and
# open_under_root() have already validated and opened the object being
# served -- the same fully-resolved real path that is about to be (or just
# was) streamed to the client. Nothing here re-parses the URL and nothing
# here accepts a caller-supplied filename: the on-disk cache filename is
# always sha256(resolved real path).hexdigest(), computed from a string
# THIS SERVER produced, never from one a client sent.
#
# WHERE A CACHED FILE LIVES, AND WHY
#
#   <cache_dir>/<YYYY-MM-DD>/<sha256(target_real).hexdigest()>
#
# The date directory is what makes "purge anything not touched today" a
# single shutil.rmtree() of a handful of stale directories rather than a
# scan of every file's mtime -- and it means a file cached yesterday is
# simply not found by today's lookup (the day component of its path
# changed), so it stops being served the instant the calendar rolls over,
# even before anything sweeps the old directory away.
#
# ATOMICITY
#
# A cache write is: mkstemp() a temp file in the SAME day directory as the
# final name (so the eventual os.replace() is a same-filesystem rename,
# which POSIX guarantees is atomic), write the whole file, then
# os.replace() over the final name. fsync is deliberately skipped: this is
# a disposable accelerator, not a WAL -- a write torn by a crash just means
# an orphaned temp file that a later sweep or eviction pass removes, never
# a corrupt file visible under its final name. A reader that calls
# open_cached() a microsecond before the rename either does not find the
# file yet (ENOENT, falls back to the source root) or finds the fully
# written file after it -- there is no window in which the final name
# refers to a partial file.
#
# WHAT NEVER HAPPENS ON THE REQUEST PATH
#
# Promotion (the actual copy) never runs on the thread answering the
# request that triggered it -- it is handed to a small bounded pool of
# background threads (see CacheManager.maybe_promote()). The triggering
# request is served from the source root exactly as it always was; only
# requests AFTER a promotion completes see the cache. That keeps this what
# its name says it is -- a hit-rate optimization for FUTURE requests -- and
# never a source of added latency on the request that happens to cross the
# threshold.

_CACHE_DAY_FMT = "%Y-%m-%d"
_CACHE_DAY_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
_CACHE_TMP_PREFIX = ".tmp-"
_CACHE_PROMOTE_WORKERS = 4
_CACHE_HITS_MAX = 200_000


class CacheManager:
    """Promote hot objects from a (possibly slow) root into a local cache.

    Policy, exactly as specified:

      * A resolved path is promoted to the cache once it has been requested
        MORE than `min_hits - 1` times today -- i.e. on the `min_hits`-th
        request (default 3: the 1st and 2nd requests are misses, the 3rd
        triggers promotion; subsequent requests are served from cache once
        the background copy finishes).
      * Eviction is hybrid:
          (a) Daily rotation -- anything not under TODAY's date directory
              is purged. This is what actually bounds steady-state size;
              see the module comment above for why the day-keyed filename
              makes it cheap (a directory removal, not a per-file scan).
          (b) A size cap, enforced by deleting least-recently-used files
              (oldest atime first) until back under budget. This is the
              backstop WITHIN a single day -- daily rotation alone does not
              stop one day's traffic from growing the cache past what the
              disk can hold before the day rolls over.

    "Recently used" is atime, bumped explicitly on every cache-served
    request (see open_cached()) rather than relied on from the filesystem,
    because noatime is a common, sane mount option and this code must not
    assume the host running the cache has not chosen it.

    mtime is deliberately NOT used for recency: a cached copy's mtime is
    set to the SOURCE file's mtime (see _promote_once()), not the copy
    time, so Last-Modified / If-Modified-Since behave identically whether a
    request is served from cache or from the root. Using mtime for LRU too
    would make caching change what If-Modified-Since means for a resource
    -- exactly the kind of externally-visible behaviour change a "private
    cache-hit optimization" must not have.
    """

    def __init__(self, cache_dir_real: str, min_hits: int,
                 max_size_bytes: int) -> None:
        self.cache_dir = cache_dir_real
        self.min_hits = min_hits
        self.max_size_bytes = max_size_bytes
        self._lock = threading.Lock()
        self._hits: Dict[str, Tuple[str, int]] = {}  # target -> (day, count)
        self._promoting: Set[str] = set()
        self._promote_slots = threading.BoundedSemaphore(_CACHE_PROMOTE_WORKERS)
        # A fresh process may start well after a day boundary it never saw
        # (long downtime, first run after install). Catch up once here, in
        # addition to the lazy sweep on every subsequent promotion below.
        self._sweep_daily()

    # -- naming --------------------------------------------------------

    @staticmethod
    def _today() -> str:
        # UTC, not local time: HTTP dates are GMT for the same reason this
        # is -- "today" should not depend on which timezone the operator
        # (or a DST transition) happens to be in right now.
        return time.strftime(_CACHE_DAY_FMT, time.gmtime())

    @staticmethod
    def _key_for(target_real: str) -> str:
        # The cache key is a hash of the RESOLVED path handle_download()
        # already validated and is about to (or just did) open -- never the
        # raw request path. See the module comment above for why that is
        # load-bearing.
        return hashlib.sha256(
            target_real.encode("utf-8", "surrogateescape")).hexdigest()

    def _cache_path(self, target_real: str,
                    day: Optional[str] = None) -> Tuple[str, str]:
        day = day or self._today()
        day_dir = os.path.join(self.cache_dir, day)
        return day_dir, os.path.join(day_dir, self._key_for(target_real))

    # -- hit tracking ----------------------------------------------------

    def record_hit(self, target_real: str) -> int:
        """Count one request for `target_real` today; return today's total.

        Only called by serve_file() AFTER the source file has been opened
        and confirmed to be a regular file -- i.e. never on the sstate-MISS
        path, which is the dominant request pattern here (see
        docs/mirror-server.md). Counting misses too would make this dict
        grow one entry per DISTINCT object bitbake ever probed for, most of
        which never exist; counting only confirmed hits keeps it bounded by
        the number of objects actually ever served, which is the cache's
        legitimate working set.
        """
        today = self._today()
        with self._lock:
            day, count = self._hits.get(target_real, (today, 0))
            count = count + 1 if day == today else 1
            if (len(self._hits) >= _CACHE_HITS_MAX
                    and target_real not in self._hits):
                self._prune_hits(today)
            self._hits[target_real] = (today, count)
            return count

    def _prune_hits(self, today: str) -> None:
        """Bounded, same idea as CredentialStore._remember: drop stale
        entries first; if that is not enough, drop everything rather than
        grow without bound. Called with the lock already held."""
        stale = [k for k, (day, _) in self._hits.items() if day != today]
        for k in stale:
            del self._hits[k]
        if len(self._hits) >= _CACHE_HITS_MAX:
            self._hits.clear()

    # -- serving from cache ------------------------------------------------

    def open_cached(self, target_real: str) -> Optional[int]:
        """Open today's cached copy of `target_real`, or return None.

        The path opened here is entirely of this server's own construction
        (a date string this process generated plus a hex digest), never a
        client-supplied name, so there are no untrusted intermediate
        components to walk one at a time the way open_under_root() must for
        the served roots -- see the module comment for why that asymmetry
        is safe. O_NOFOLLOW is still used, defensively: nothing in this
        program ever creates a symlink here, but refusing to follow one
        costs nothing, and it means a cache directory an operator manually
        tampered with cannot redirect a read somewhere unexpected.
        """
        _, path = self._cache_path(target_real)
        try:
            fd = os.open(path, os.O_RDONLY | _O_NOFOLLOW | _O_NONBLOCK)
        except OSError as exc:
            if exc.errno in (errno.ENOENT, errno.ENOTDIR, errno.ELOOP,
                             errno.ENAMETOOLONG):
                return None
            raise
        ok = False
        try:
            st = os.fstat(fd)
            if not stat.S_ISREG(st.st_mode):
                return None
            if hasattr(os, "O_NONBLOCK"):
                import fcntl
                fl = fcntl.fcntl(fd, fcntl.F_GETFL)
                fcntl.fcntl(fd, fcntl.F_SETFL, fl & ~os.O_NONBLOCK)
            # Bump atime to "now" so the LRU sweep treats this object as
            # freshly used; mtime is left exactly as _promote_once() set it
            # (the SOURCE file's mtime) -- not touched here.
            try:
                os.utime(fd, (time.time(), st.st_mtime))
            except OSError:
                pass  # best-effort: a failed atime bump only skews LRU order
            ok = True
            return fd
        finally:
            if not ok:
                os.close(fd)

    # -- promotion -----------------------------------------------------

    def maybe_promote(self, root_real: str, target_real: str) -> None:
        """Kick off a background copy of `target_real` into the cache, once.

        Idempotent under concurrency: the check-and-mark against
        `_promoting` happens under the lock, so if two threads both decide
        "this path just crossed the threshold" for the same path at the
        same moment, only one of them submits a copy. The other just
        returns -- the file will show up in the cache once the first one
        finishes, and if the copy fails, `_promoting` is cleared in
        `_do_promote`'s `finally`, so a LATER request (there will be one:
        every request past the threshold calls this) gets to retry.

        Bounded, not unbounded: a bounded semaphore caps how many
        promotions run at once. If it is full, this call is a no-op --
        again, a later request retries. The alternative (blocking here)
        would mean a slow NFS copy for path A delays the response for path
        B, and B's request has nothing to do with A's promotion.
        """
        with self._lock:
            if target_real in self._promoting:
                return
            if not self._promote_slots.acquire(blocking=False):
                return
            self._promoting.add(target_real)
        thread = threading.Thread(
            target=self._do_promote, args=(root_real, target_real),
            name="mirrord-cache-promote", daemon=True)
        try:
            thread.start()
        except RuntimeError:
            with self._lock:
                self._promoting.discard(target_real)
            self._promote_slots.release()

    def _do_promote(self, root_real: str, target_real: str) -> None:
        try:
            self._promote_once(root_real, target_real)
        except Exception:
            log.exception("cache promotion failed")
        finally:
            with self._lock:
                self._promoting.discard(target_real)
            self._promote_slots.release()

    def _promote_once(self, root_real: str, target_real: str) -> None:
        """The actual copy. See the module comment for the atomicity story.

        Reopens `target_real` through open_under_root() -- the SAME
        containment-by-descriptor mechanism serve_file() uses, with the
        same (root_real, target_real) pair resolve_under_root() already
        produced and validated. This function never receives, and never
        derives a filename from, anything else.
        """
        fd = open_under_root(root_real, target_real)
        try:
            st = os.fstat(fd)
            if not stat.S_ISREG(st.st_mode):
                return  # a directory or special file raced in; not cacheable

            self._sweep_daily()
            day_dir, final_path = self._cache_path(target_real)
            os.makedirs(day_dir, mode=0o700, exist_ok=True)

            tmp_fd, tmp_path = tempfile.mkstemp(
                dir=day_dir, prefix=_CACHE_TMP_PREFIX)
            try:
                with os.fdopen(tmp_fd, "wb") as out:
                    while True:
                        chunk = os.read(fd, 262144)
                        if not chunk:
                            break
                        out.write(chunk)
                # atime=now (freshly created counts as freshly used),
                # mtime=the SOURCE's mtime -- see the class docstring.
                os.utime(tmp_path, (time.time(), st.st_mtime))
                os.chmod(tmp_path, 0o600)
                os.replace(tmp_path, final_path)  # atomic: same directory
            except BaseException:
                try:
                    os.unlink(tmp_path)
                except OSError:
                    pass
                raise
        finally:
            os.close(fd)

        self._enforce_size_cap()

    # -- eviction --------------------------------------------------------

    def _sweep_daily(self) -> None:
        """Delete every day-directory that is not today's.

        Triggered lazily, from _promote_once(), i.e. on cache WRITES -- not
        by a dedicated background thread on a timer. A write already means
        "we are about to touch this filesystem"; piggy-backing the sweep
        there means idle periods cost nothing, and a server that only ever
        gets exactly enough traffic to promote a handful of objects a day
        still rotates correctly without a thread sitting in a sleep loop
        for its entire lifetime. Also run once at construction (see
        __init__) to catch up after a restart that crossed a day boundary
        with no writes since.

        Only ever removes entries matching our own YYYY-MM-DD naming
        convention, so an operator who (against the docs) points
        --cache-dir at a directory holding something else loses nothing but
        obviously misnamed lookalikes.
        """
        today = self._today()
        try:
            names = os.listdir(self.cache_dir)
        except OSError:
            return
        for name in names:
            if name == today or not _CACHE_DAY_RE.match(name):
                continue
            path = os.path.join(self.cache_dir, name)
            if os.path.isdir(path) and not os.path.islink(path):
                shutil.rmtree(path, ignore_errors=True)

    def _enforce_size_cap(self) -> None:
        """LRU eviction (oldest atime first) until under `max_size_bytes`.

        This is the single-day backstop: daily rotation is what keeps
        steady-state size down (see the module comment), but within one
        calendar day nothing else stops traffic from writing more than the
        disk can hold before rotation gets a chance to run. Walking the
        whole tree on every promotion is O(files in the cache); acceptable
        because daily rotation keeps that count to roughly one day's worth
        of promoted objects, and because this only ever runs after an
        actual write, never on the far hotter read path.
        """
        entries = []  # (atime, size, path)
        total = 0
        for dirpath, _dirnames, filenames in os.walk(self.cache_dir):
            for name in filenames:
                if name.startswith(_CACHE_TMP_PREFIX):
                    continue  # an in-progress or orphaned write; leave it
                path = os.path.join(dirpath, name)
                try:
                    st = os.stat(path)
                except OSError:
                    continue
                total += st.st_size
                entries.append((st.st_atime, st.st_size, path))
        if total <= self.max_size_bytes:
            return
        entries.sort(key=lambda e: e[0])  # oldest atime first
        for _atime, size, path in entries:
            if total <= self.max_size_bytes:
                break
            try:
                os.unlink(path)
                total -= size
            except OSError:
                pass


def validate_cache_dir(path: str, roots: Dict[str, str]) -> str:
    """Resolve, create if needed, and lock down --cache-dir.

    This directory is the server's first write target, so it gets the same
    discipline as a credential file (refuse if group/world writable) plus a
    containment check against every served root: the cache dir must be
    OUTSIDE every root, in both directions. A root nested inside the cache
    dir would risk a cached copy being re-served as though it were source
    content under a root's own URL space; a cache dir nested inside a root
    would let cached copies be fetched directly through the mirror,
    bypassing the promotion policy (and the hit-count bookkeeping)
    entirely.
    """
    try:
        os.makedirs(path, mode=0o700, exist_ok=True)
    except OSError as exc:
        raise ConfigError("cannot create cache dir %s: %s" % (path, exc))

    real = os.path.realpath(path)
    if not os.path.isdir(real):
        raise ConfigError("cache dir is not a directory: %s" % path)
    if not os.access(real, os.R_OK | os.W_OK | os.X_OK):
        raise ConfigError("cache dir is not readable/writable: %s" % path)

    try:
        st = os.stat(real)
    except OSError as exc:
        raise ConfigError("cannot stat cache dir: %s" % exc)
    if st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
        raise ConfigError(
            "cache dir %s is group/world writable (mode %o); chmod 700 it "
            "-- this is the server's write path, and anyone who can write "
            "here can plant a file that gets served as though it were a "
            "cache hit" % (real, st.st_mode & 0o777))

    for name, root_real in roots.items():
        try:
            common = os.path.commonpath([root_real, real])
        except ValueError:
            continue  # mixed absolute/relative or, on Windows, mixed drives
        if common in (root_real, real):
            raise ConfigError(
                "cache dir %s overlaps with served root /%s (%s); the "
                "cache dir must be outside every served root"
                % (real, name, root_real))
    return real


